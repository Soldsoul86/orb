package @PKG@;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * The first signal's logic, on a desktop JVM.
 *
 * Every question here is about a *set changing over time*, which is where the
 * bugs are, and none of it needs Android. What does need the device is whether
 * the three settings can be read at all — answered on 2026-09-26, all three
 * confirmed (`DEVICE_LOOP.md` §7).
 */
final class GrantsTest {

    static void run() {
        detectsWhatAppeared();
        reorderingIsNotAChange();
        aBaselineIsNotAnAlarm();
        unreadableIsNotEmpty();
        readsBackOutOfAStoredLine();
        packagesAreASetLikeAnyOther();
        aChangeOfLookIsNotAChangeOfDevice();
        aScanIsComparedAgainstTheLastScan();
    }

    private static void detectsWhatAppeared() {
        Harness.suite("a grant appearing is reported, with what it was");
        Map<String, Object> d = Grants.diff(
            Arrays.asList("com.known/.Svc"),
            Arrays.asList("com.known/.Svc", "com.new/.Accessibility"));

        Harness.check("the change is worth an event", Grants.changed(d));
        Harness.equal("and names what appeared",
            Json.canonical(d.get("gained")), "[\"com.new/.Accessibility\"]");
        Harness.equal("nothing was lost", Json.canonical(d.get("lost")), "[]");
        Harness.equal("and the whole holding set is recorded, not just the delta",
            d.get("holding"), "com.known/.Svc:com.new/.Accessibility");
        Harness.equal("counts are whole numbers", d.get("gainedCount"), 1L);

        Harness.suite("a grant disappearing is reported too");
        Map<String, Object> gone = Grants.diff(
            Arrays.asList("com.known/.Svc"), new ArrayList<String>());
        // Revocation is evidence as much as a grant is: `MOBILE_SENSING.md` §4.4
        // — *your own app's permissions being revoked is itself evidence*.
        Harness.check("it is worth an event", Grants.changed(gone));
        Harness.equal("and names what went", Json.canonical(gone.get("lost")),
            "[\"com.known/.Svc\"]");
        Harness.equal("and the emptied set records as empty, not as absent",
            gone.get("holding"), "");
    }

    private static void reorderingIsNotAChange() {
        Harness.suite("the platform reordering a list is not a change");
        // §7 R6: false positives cost trust, and trust is the product.
        Map<String, Object> d = Grants.diff(
            Arrays.asList("b/.B", "a/.A", "c/.C"),
            Arrays.asList("c/.C", "a/.A", "b/.B"));
        Harness.check("no event", !Grants.changed(d));

        Map<String, Object> dupes = Grants.diff(
            Arrays.asList("a/.A", "a/.A"), Arrays.asList("a/.A"));
        Harness.check("nor is a duplicate the platform repeated", !Grants.changed(dupes));

        Harness.suite("the same set recorded twice is byte-identical");
        // What the sorting is for, and it is not noise suppression. The holding
        // set is written into history and read back as the next comparison's
        // `before`. If the platform's ordering reached the record, two
        // observations of one unchanged device would produce two different
        // lines — different bytes, different hashes, a journal that looks like
        // it moved when nothing did.
        Harness.equal("order does not reach the record",
            Grants.join(Arrays.asList("b/.B", "a/.A")),
            Grants.join(Arrays.asList("a/.A", "b/.B")));
        Harness.equal("nor does a repeat", Grants.join(Arrays.asList("a/.A", "a/.A")), "a/.A");
        Harness.equal("and the round trip is exact",
            Json.canonical(Grants.split(Grants.join(Arrays.asList("b/.B", "a/.A")))),
            "[\"a/.A\",\"b/.B\"]");
    }

    private static void aBaselineIsNotAnAlarm() {
        Harness.suite("the first look at a kind is a baseline, not an alarm");
        // The lesson §5j taught on the real phone: a self-test that reported a
        // pre-existing break as a new failure said FAILED forever and meant
        // nothing. Whatever was already installed when Orb arrived is not news.
        Map<String, List<String>> observed = new HashMap<>();
        observed.put("accessibility", Arrays.asList("com.already/.Here"));
        observed.put("notificationListener", new ArrayList<String>());
        observed.put("deviceAdmin", new ArrayList<String>());

        Map<String, Object> first = Grants.report("process.start", observed, null);
        Harness.equal("the kind says it is a baseline",
            first.get("accessibilityBaseline"), Boolean.TRUE);
        Harness.equal("nothing is reported as gained", first.get("accessibilityGained"), null);
        Harness.equal("and the event as a whole is not a change",
            first.get("changed"), Boolean.FALSE);
        Harness.equal("but it records what was already there",
            first.get("accessibilityHolding"), "com.already/.Here");

        // Baseline is per kind, not per event: one list can be new to us while
        // another has history. An event-level flag would have to pick one and be
        // wrong about the other.
        Map<String, List<String>> known = new HashMap<>();
        known.put("accessibility", Arrays.asList("com.already/.Here"));
        Map<String, Object> mixed = Grants.report("process.start", observed, known);
        Harness.equal("a known kind diffs", mixed.get("accessibilityBaseline"), Boolean.FALSE);
        Harness.equal("while an unknown one baselines in the same event",
            mixed.get("deviceAdminBaseline"), Boolean.TRUE);
        Harness.equal("and an unchanged known kind is silent",
            mixed.get("changed"), Boolean.FALSE);
    }

    private static void unreadableIsNotEmpty() {
        Harness.suite("a setting that cannot be read is not an empty one");
        Harness.equal("null splits to empty, for the caller to interpret",
            Json.canonical(Grants.split(null)), "[]");
        Harness.equal("and so does a blank setting", Json.canonical(Grants.split("")), "[]");
        Harness.equal("a real list splits on colons",
            Json.canonical(Grants.split("a/.A:b/.B")), "[\"a/.A\",\"b/.B\"]");
        Harness.equal("with whitespace and empty segments dropped",
            Json.canonical(Grants.split(" a/.A : : b/.B ")), "[\"a/.A\",\"b/.B\"]");

        Map<String, List<String>> unreadable = new HashMap<>();
        unreadable.put("accessibility", null);
        unreadable.put("notificationListener", new ArrayList<String>());
        unreadable.put("deviceAdmin", new ArrayList<String>());
        Map<String, Object> report = Grants.report("process.start", unreadable, null);

        Harness.equal("it records that it could not read",
            report.get("accessibilityReadable"), Boolean.FALSE);
        Harness.equal("and records no holding set at all, rather than an empty one",
            report.get("accessibilityHolding"), null);
        Harness.equal("a kind that genuinely has none records an empty set",
            report.get("notificationListenerHolding"), "");
        Harness.equal("and says it could be read",
            report.get("notificationListenerReadable"), Boolean.TRUE);

        // The regression this guards, stated as the comparison it would cause.
        // If an unreadable setting were recorded as an empty set, the next
        // successful read would diff against nothing and announce that every
        // service on the device had just been granted — an alarm manufactured
        // out of a failed read. Worse than silence, because it is loud and wrong.
        String line = line(report);
        Harness.check("an unreadable kind reads back as unknown, never as none",
            Grants.previous(line, "accessibility") == null);
        Harness.equal("while an empty one reads back as a set that is empty",
            Json.canonical(Grants.previous(line, "notificationListener")), "[]");

        Map<String, List<String>> now = new HashMap<>();
        now.put("accessibility", Arrays.asList("com.was/.There", "com.also/.There"));
        now.put("notificationListener", new ArrayList<String>());
        now.put("deviceAdmin", new ArrayList<String>());
        Map<String, List<String>> before = new HashMap<>();
        for (String kind : Grants.GRANT_KINDS) before.put(kind, Grants.previous(line, kind));
        Map<String, Object> next = Grants.report("process.start", now, before);
        Harness.equal("so a read that recovers does not claim two grants just appeared",
            next.get("accessibilityBaseline"), Boolean.TRUE);
        Harness.equal("and raises no alarm", next.get("changed"), Boolean.FALSE);
    }

    private static void readsBackOutOfAStoredLine() {
        Harness.suite("the previous set comes out of the journal, not a side file");
        // Art. IX §33 — no duplicate sources of truth. The last observation is
        // in the journal; a cache beside it would be a second one, and would
        // survive an erasure that removed the events it describes. `Journal` has
        // no JSON parser, so the holding set is stored in the platform's own
        // colon-joined form and recovered by a single-field extraction — the
        // same thing `Journal.last()` already does.
        Map<String, List<String>> observed = new HashMap<>();
        observed.put("accessibility", Arrays.asList("com.b/.Svc", "com.a/.Svc"));
        observed.put("notificationListener", Arrays.asList("com.n/.Listener$Inner"));
        observed.put("deviceAdmin", new ArrayList<String>());
        String line = line(Grants.report("process.start", observed, null));

        Harness.equal("the set survives the round trip, sorted",
            Json.canonical(Grants.previous(line, "accessibility")),
            "[\"com.a/.Svc\",\"com.b/.Svc\"]");
        Harness.equal("including a component with an inner class in its name",
            Json.canonical(Grants.previous(line, "notificationListener")),
            "[\"com.n/.Listener$Inner\"]");
        Harness.equal("and an empty set is a set", 
            Json.canonical(Grants.previous(line, "deviceAdmin")), "[]");

        // Reading one kind must not pick up another's value. The three keys share
        // no prefix, and this is what says so rather than the eye.
        Harness.check("kinds do not read each other's fields",
            !Grants.previous(line, "accessibility")
                .equals(Grants.previous(line, "notificationListener")));

        // The next comparison, built entirely from the stored line.
        Map<String, List<String>> before = new HashMap<>();
        for (String kind : Grants.GRANT_KINDS) before.put(kind, Grants.previous(line, kind));
        Map<String, List<String>> now = new HashMap<>();
        now.put("accessibility", Arrays.asList("com.a/.Svc", "com.b/.Svc", "com.new/.Svc"));
        now.put("notificationListener", Arrays.asList("com.n/.Listener$Inner"));
        now.put("deviceAdmin", new ArrayList<String>());
        Map<String, Object> next = Grants.report("settings.changed", now, before);

        Harness.equal("a grant that appeared since the stored line is caught",
            Json.canonical(next.get("accessibilityGained")), "[\"com.new/.Svc\"]");
        Harness.equal("the kinds that did not move say nothing",
            Json.canonical(next.get("notificationListenerGained")), "[]");
        Harness.equal("the event is a change", next.get("changed"), Boolean.TRUE);
        Harness.equal("and it carries why it was taken",
            next.get("because"), "settings.changed");

        Harness.check("a line from before this shape existed re-baselines rather than alarms",
            Grants.previous("{\"type\":\"probe.process.start\",\"payload\":{}}",
                "accessibility") == null);
        Harness.check("and so does no line at all", Grants.previous(null, "accessibility") == null);
    }

    private static void packagesAreASetLikeAnyOther() {
        Harness.suite("an installed package is compared against history like a grant");
        // The whole point of DEVICE_LOOP.md §7b5: a broadcast reports an event and
        // is lost if it is missed, a set compares and is not. Nothing here is
        // special-cased for packages — it is the same `report` over a fourth kind,
        // which is what makes the missed broadcast recoverable.
        Map<String, List<String>> observed = new HashMap<>();
        observed.put("installedPackage", Arrays.asList("com.b.app", "com.a.app"));
        Map<String, String> scopes = new HashMap<>();
        scopes.put("installedPackage", "all");
        String line = line(
            Grants.report(Grants.PACKAGE_KINDS, "process.start", observed, null, scopes));

        Harness.equal("the scope is recorded with the set",
            Grants.previousScope(line, "installedPackage"), "all");
        Harness.equal("and the set reads back sorted",
            Json.canonical(Grants.previous(line, "installedPackage", "all")),
            "[\"com.a.app\",\"com.b.app\"]");

        Map<String, List<String>> before = new HashMap<>();
        before.put("installedPackage", Grants.previous(line, "installedPackage", "all"));
        Map<String, List<String>> now = new HashMap<>();
        now.put("installedPackage", Arrays.asList("com.a.app", "com.new.app"));
        Map<String, Object> next =
            Grants.report(Grants.PACKAGE_KINDS, "process.start", now, before, scopes);

        Harness.equal("an install nobody was awake for is still caught",
            Json.canonical(next.get("installedPackageGained")), "[\"com.new.app\"]");
        Harness.equal("and so is the uninstall of 2026-09-28",
            Json.canonical(next.get("installedPackageLost")), "[\"com.b.app\"]");
        Harness.equal("it is a change", next.get("changed"), Boolean.TRUE);

        // GRANT_KINDS is what "grant" means. An app appearing is not an app being
        // given power, and the two lists exist so that nothing downstream can say
        // it is by accident.
        Harness.check("and it is not counted among the grants",
            !Arrays.asList(Grants.GRANT_KINDS).contains("installedPackage"));
        Harness.check("it is the set a scan reports",
            Arrays.asList(Grants.PACKAGE_KINDS).contains("installedPackage"));
        // The reason the two lists are separate arrays and not one with a filter:
        // an observation that named this kind and skipped the read would have to
        // record it as unreadable, which is a different fact from not looking.
        Harness.equal("and an observation writes no field for it at all",
            Grants.report(Grants.GRANT_KINDS, "process.start", observed, null, scopes)
                .get("installedPackageReadable"),
            null);
    }

    private static void aChangeOfLookIsNotAChangeOfDevice() {
        Harness.suite("a scope change re-baselines instead of reporting a mass change");
        // The failure this prevents: a complete list compared against a filtered
        // one reports every package the filtered look could not see as *lost*.
        // Two hundred uninstalls that never happened, in the signal whose only
        // value is that it does not cry wolf (§7 R6).
        Map<String, List<String>> observed = new HashMap<>();
        observed.put("installedPackage", Arrays.asList("com.a.app", "com.b.app", "com.c.app"));
        Map<String, String> all = new HashMap<>();
        all.put("installedPackage", "all");
        String line = line(
            Grants.report(Grants.PACKAGE_KINDS, "process.start", observed, null, all));

        Harness.check("a set read under a different scope is not a prior reading of it",
            Grants.previous(line, "installedPackage", "visible") == null);
        Harness.check("nor is one read with no scope at all",
            Grants.previous(line, "installedPackage", null) == null);
        Harness.check("a check that threw is its own answer, not a filtered look",
            Grants.previous(line, "installedPackage", "unknown") == null);
        Harness.check("and the matching scope still compares",
            Grants.previous(line, "installedPackage", "all") != null);

        // End to end: the permission is dropped from the manifest, so the next
        // reading is filtered. It must be silent, not loud.
        Map<String, String> visible = new HashMap<>();
        visible.put("installedPackage", "visible");
        Map<String, List<String>> before = new HashMap<>();
        before.put("installedPackage",
            Grants.previous(line, "installedPackage", "visible"));
        Map<String, List<String>> now = new HashMap<>();
        now.put("installedPackage", Arrays.asList("com.a.app"));
        Map<String, Object> next =
            Grants.report(Grants.PACKAGE_KINDS, "process.start", now, before, visible);

        Harness.equal("the narrowed look is a baseline",
            next.get("installedPackageBaseline"), Boolean.TRUE);
        Harness.equal("so nothing is reported as lost",
            next.get("installedPackageLost"), null);
        Harness.equal("and the event is not a change", next.get("changed"), Boolean.FALSE);
        Harness.equal("while the scope it was taken under is on the record",
            next.get("installedPackageScope"), "visible");

        // A kind with no scope must look exactly as it did before scopes existed,
        // or every reading taken before 2026-09-28 re-baselines on the next start.
        Harness.suite("a kind with no scope is unchanged by any of this");
        Map<String, List<String>> grants = new HashMap<>();
        grants.put("accessibility", Arrays.asList("com.a/.Svc"));
        String plain = line(
            Grants.report(Grants.GRANT_KINDS, "process.start", grants, null, all));
        Harness.check("it records no scope field",
            Grants.previousScope(plain, "accessibility") == null);
        Harness.equal("and reads back by the old two-argument call",
            Json.canonical(Grants.previous(plain, "accessibility")), "[\"com.a/.Svc\"]");
    }

    private static void aScanIsComparedAgainstTheLastScan() {
        Harness.suite("an observation line is not a prior reading of the package set");
        // Why `Pass2.scanPackages` looks up `lastOfType(PACKAGES)` and not the last
        // observation. Scanning less often than we observe means the most recent
        // event is usually an observation, which carries no package fields at all.
        // Read as a prior record it means *no usable history*, so the set would
        // re-baseline at every scan: a signal that never reports a change and never
        // says why. The separate event type is what makes the older scan findable.
        Map<String, String> all = new HashMap<>();
        all.put("installedPackage", "all");

        Map<String, List<String>> scanned = new HashMap<>();
        scanned.put("installedPackage", Arrays.asList("com.a.app", "com.b.app"));
        String scan = line(
            Grants.report(Grants.PACKAGE_KINDS, "operator.scan", scanned, null, all));

        Map<String, List<String>> grants = new HashMap<>();
        grants.put("accessibility", Arrays.asList("com.a/.Svc"));
        String observation = line(
            Grants.report(Grants.GRANT_KINDS, "process.start", grants, null, all));

        Harness.check("the scan line holds the set",
            Grants.previous(scan, "installedPackage", "all") != null);
        Harness.check("the observation line holds nothing about it",
            Grants.previous(observation, "installedPackage", "all") == null);
        // And the observation is not claiming the read failed either — there is no
        // field at all, which is *this event is not about that*.
        Harness.equal("and does not claim it was unreadable",
            Grants.previousScope(observation, "installedPackage"), null);

        // The comparison a later scan actually makes: against the earlier scan,
        // however many observations came between.
        Map<String, List<String>> before = new HashMap<>();
        before.put("installedPackage", Grants.previous(scan, "installedPackage", "all"));
        Map<String, List<String>> now = new HashMap<>();
        now.put("installedPackage", Arrays.asList("com.a.app", "com.b.app", "com.late.app"));
        Map<String, Object> next =
            Grants.report(Grants.PACKAGE_KINDS, "process.start", now, before, all);

        Harness.equal("so a scan catches what happened since the last scan",
            Json.canonical(next.get("installedPackageGained")), "[\"com.late.app\"]");
        Harness.equal("and it is not a baseline",
            next.get("installedPackageBaseline"), Boolean.FALSE);
    }

    /** A payload as it is actually stored: canonical JSON, nested in an event. */
    private static String line(Map<String, Object> payload) {
        return "{\"type\":\"grants.report\",\"payload\":" + Json.canonical(payload)
            + ",\"wallClock\":1790000000000}";
    }
}
