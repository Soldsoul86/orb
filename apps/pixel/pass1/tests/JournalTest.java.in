package @PKG@;

import android.content.Context;
import java.io.File;
import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * Tests for the journal the phone actually writes.
 *
 * These exist because of `DEVICE_LOOP.md` section 5d. A defect in `restore()`
 * -- reading a hex hash with the digits-only extractor -- forked the chain at
 * every process restart, and nothing caught it until it ran on the operator's
 * phone. The chain caught its own author, which is the strongest evidence this
 * project has that the design works; it is also evidence that the instrument
 * was shipped untested.
 *
 * The regression test for it is `restartsContinueTheChain`, and it is written
 * to fail the way the phone failed: many restarts, so a hash beginning with a
 * letter is certain to occur, because that is the only case in which the old
 * defect bit.
 */
final class JournalTest {

    static void run() throws IOException {
        restartsContinueTheChain();
        deletingAnEventIsDetected();
        editingAHashIsDetected();
        reorderingIsDetected();
        editingAPayloadIsNotDetected();
        everyBreakIsReported();
        anUnreadableHeadIsDeclaredDiscontinuous();
        v2WritesACoarseEnvelope();
        v1IsWhatThisBuildWrites();
        lookupsSurviveTheV2Envelope();
        aTypeNamedInsideAPayloadIsNotAMatch();
        anUnreadableTypeIsRefusedNotSkipped();
        bookkeepingMatchesTheSharedList();
        anEventCanCiteItsCauses();
    }

    /**
     * Lineage (`ERASURE.md` §3): a derived event cites what it came from, in the envelope and
     * in the hash. The one-argument append still writes none, and a cause that cannot be
     * followed is refused rather than written.
     */
    private static void anEventCanCiteItsCauses() throws IOException {
        Harness.suite("an event can cite its causes");
        File dir = temp("causes");
        Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
        Map<String, Object> first = journal.append("orb.shared", beat(1));
        String cause = (String) first.get("id");
        Harness.check("the plain append cites nothing", ((List<?>) first.get("causes")).isEmpty());

        Map<String, Object> derived = journal.append("orb.observation", beat(2), java.util.Arrays.asList(cause));
        Harness.check("a derived event is written", derived != null);
        Harness.equal("and names its cause", ((List<?>) derived.get("causes")).get(0), cause);
        Harness.equal("the chain still verifies", journal.verify(), "ok (2 events)");
        Harness.check("the cause is on the line as written", lastLine(dir).contains("\"causes\":[\"" + cause + "\"]"));

        Harness.equal("a null cause list is refused", journal.append("orb.observation", beat(3), null), null);
        Harness.equal("an empty cause is refused", journal.append("orb.observation", beat(3), java.util.Arrays.asList("")), null);
        Harness.equal("a null cause is refused",
            journal.append("orb.observation", beat(3), java.util.Arrays.asList((String) null)), null);
        Harness.equal("and nothing was written for any refusal", journal.count(), 2);

        // The phone can only check linkage, so a cause edited after the fact is for the TypeScript
        // verifier to catch (`verifyLane`) — here the cause must at least be *inside the hash*:
        // re-deriving the event's hash from its own fields, with its causes, must reproduce it.
        @SuppressWarnings("unchecked") Map<String, Object> integrity = (Map<String, Object>) derived.get("integrity");
        @SuppressWarnings("unchecked") List<String> citedBack = (List<String>) derived.get("causes");
        @SuppressWarnings("unchecked") Map<String, Object> schema = (Map<String, Object>) derived.get("schema");
        @SuppressWarnings("unchecked") Map<String, Object> hlc = (Map<String, Object>) derived.get("hlc");
        String withCause = Journal.sha256(Json.canonical(Journal.preimage(1, (String) derived.get("id"), "pixel", "test-device",
            hlc, ((Number) derived.get("wallClock")).longValue(), "orb.observation", schema, citedBack,
            (String) integrity.get("payloadHash"), (String) integrity.get("previous"))));
        Harness.equal("the cause is inside the hash", withCause, integrity.get("hash"));
        String withoutCause = Journal.sha256(Json.canonical(Journal.preimage(1, (String) derived.get("id"), "pixel", "test-device",
            hlc, ((Number) derived.get("wallClock")).longValue(), "orb.observation", schema, new java.util.ArrayList<String>(),
            (String) integrity.get("payloadHash"), (String) integrity.get("previous"))));
        Harness.check("and dropping it changes the hash", !withoutCause.equals(integrity.get("hash")));
    }

    /**
     * `Journal.md` §5: moving to v2 must not silently stop a lookup matching.
     * Under v2 the envelope says only `orb.content`, and a lookup that read the
     * type off the envelope would find nothing, for ever, while every caller
     * treated that as "no earlier reading" and re-baselined.
     */
    private static void lookupsSurviveTheV2Envelope() throws IOException {
        Harness.suite("a lookup finds the real type under v2, not the envelope's");
        File dir = temp("v2-lookup");
        Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
        journal.append("grants.packages", beat(1));
        journal.useEnvelopeVersion(2);
        journal.append("grants.observed", beat(2));
        journal.append("grants.packages", beat(3));

        List<String> all = lines(dir);
        Harness.equal("the v2 envelope names only content",
            Journal.envelopeType(all.get(2)), Journal.CONTENT_TYPE);
        Harness.equal("but the real type is still read", Journal.typeOf(all.get(2)), "grants.packages");
        Harness.equal("and a v1 line reads as it always did", Journal.typeOf(all.get(0)), "grants.packages");

        Map<String, String> packages = journal.lastOfType("grants.packages");
        Harness.check("the lookup finds it", packages != null);
        Harness.equal("the newest one, across the version switch", packages.get("line"), all.get(2));
        Map<String, String> observed = journal.lastOfType("grants.observed");
        Harness.equal("a type written only under v2 is found too",
            observed == null ? null : observed.get("line"), all.get(1));
        Harness.equal("last() reports the real type, not orb.content", journal.last().get("type"), "grants.packages");
    }

    /**
     * The fault the old substring match had even under v1: a payload that merely
     * contains `"type":"X"` looked like an event of type X.
     */
    private static void aTypeNamedInsideAPayloadIsNotAMatch() throws IOException {
        Harness.suite("a payload that mentions a type is not an event of that type");
        File dir = temp("decoy");
        Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
        Map<String, Object> decoy = Json.obj();
        decoy.put("type", "grants.packages");
        journal.append("orb.shared", decoy);
        journal.useEnvelopeVersion(2);
        journal.append("orb.shared", decoy);

        Harness.check("no grants.packages event exists, so none is found",
            journal.lastOfType("grants.packages") == null);
        Map<String, String> shared = journal.lastOfType("orb.shared");
        Harness.equal("the event is found by its own type, under v2 as well",
            shared == null ? null : shared.get("line"), lines(dir).get(1));
    }

    /**
     * A sealed v2 payload hides the real type from anything without the key.
     * Nothing in this build writes one; the lookup must still not guess, and must
     * not step over it to an older match as though it did not exist.
     */
    private static void anUnreadableTypeIsRefusedNotSkipped() throws IOException {
        Harness.suite("an event whose type cannot be read stops the lookup");
        File dir = temp("unreadable");
        Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
        journal.append("grants.packages", beat(1));
        String sealed = "{\"device\":\"test-device\",\"hlc\":{\"counter\":0,\"physical\":2},"
            + "\"id\":\"01SEALED\",\"integrity\":{\"hash\":\"h\",\"payloadHash\":\"p\",\"previous\":null},"
            + "\"lane\":\"pixel\",\"payload\":\"c2VhbGVk\",\"schema\":{\"id\":\"orb.content\",\"version\":1},"
            + "\"type\":\"orb.content\",\"v\":2,\"wallClock\":2}";
        List<String> all = lines(dir);
        all.add(sealed);
        rewrite(dir, all);

        Harness.equal("its type is unknown, not guessed", Journal.typeOf(sealed), null);
        boolean refused = false;
        try {
            journal.lastOfType("grants.packages");
        } catch (IOException expected) {
            refused = true;
        }
        Harness.check("the lookup refuses rather than returning the older match", refused);
    }

    /**
     * The phone once kept three names legible under v2 while TypeScript kept
     * four. One shared list, checked from both sides, is what stops that.
     */
    private static void bookkeepingMatchesTheSharedList() throws IOException {
        Harness.suite("the types that stay legible under v2 match TypeScript's");
        List<String> ours = new ArrayList<>(Journal.bookkeepingTypes());
        java.util.Collections.sort(ours);
        Harness.equal("the same list as the shared vectors",
            ours, java.util.Arrays.asList(Vectors.BOOKKEEPING_TYPES));

        File dir = temp("revoked");
        Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
        journal.useEnvelopeVersion(2);
        Map<String, Object> event = journal.append("orb.device.revoked", beat(1));
        Harness.equal("a revocation keeps its name on a v2 envelope", event.get("type"), "orb.device.revoked");
        Harness.check("and is found by it", journal.lastOfType("orb.device.revoked") != null);
    }

    /**
     * What `append` puts on disk under v2.
     *
     * `JsonTest` pins the *encoding* against the TypeScript vectors. This pins
     * the *journal*: that it coarsens the type, drops `causes`, wraps the
     * payload, and still chains. An encoder that agreed with the vectors while
     * the journal fed it the wrong object would pass there and fail here.
     */
    private static void v2WritesACoarseEnvelope() throws IOException {
        Harness.suite("under v2 the envelope says an event happened, and no more");
        File dir = temp("v2");
        Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
        journal.useEnvelopeVersion(2);

        Map<String, Object> event = journal.append("probe.heartbeat", beat(1));
        Harness.check("the append succeeded", event != null);

        Harness.equal("the envelope carries the coarse type", event.get("type"), Journal.CONTENT_TYPE);
        Harness.equal("and a schema describing an encrypted payload",
            Json.canonical(event.get("schema")), "{\"id\":\"orb.content\",\"version\":1}");
        Harness.check("and states no lineage at all", !event.containsKey("causes"));
        Harness.equal("and names its format, so a reader knows which rule to apply",
            event.get("v"), 2L);

        // The real type is inside the payload, with the nonce and the real
        // schema. Erasing the payload takes all three with it.
        String payload = Json.canonical(event.get("payload"));
        Harness.check("the real type is in the payload", payload.contains("\"type\":\"probe.heartbeat\""));
        Harness.check("with a 128-bit nonce", payload.matches(".*\"nonce\":\"[0-9a-f]{32}\".*"));
        Harness.check("and the real schema", payload.contains("\"id\":\"probe.heartbeat\""));
        Harness.check("the envelope names nothing about the subject",
            !Json.canonical(withoutPayload(event)).contains("heartbeat"));

        // The nonce means a caller's own object no longer hashes to the
        // commitment. That is the confirmation oracle closing, not a defect.
        @SuppressWarnings("unchecked")
        Map<String, Object> integrity = (Map<String, Object>) event.get("integrity");
        Harness.equal("payloadHash commits to the wrapper",
            Journal.sha256(payload), integrity.get("payloadHash"));
        Harness.check("and not to the caller's payload",
            !Journal.sha256(Json.canonical(beat(1))).equals(integrity.get("payloadHash")));

        journal.append("probe.heartbeat", beat(2));
        Harness.equal("a v2 lane still verifies", journal.verify(), "ok (2 events)");
    }

    /**
     * The negative control on the default, and the reason it is a test rather
     * than a comment: a build that quietly started writing v2 would put a
     * version seam through a running measurement.
     */
    private static void v1IsWhatThisBuildWrites() throws IOException {
        Harness.suite("this build still writes v1, deliberately");
        File dir = temp("v1-default");
        Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
        Map<String, Object> event = journal.append("probe.heartbeat", beat(1));
        Harness.check("the append succeeded", event != null);

        Harness.equal("the default is 1", Journal.DEFAULT_ENVELOPE_VERSION, 1);
        Harness.check("so no version field is written", !event.containsKey("v"));
        Harness.equal("and the fine type is on the envelope", event.get("type"), "probe.heartbeat");
        Harness.check("and the payload is the caller's own object",
            !Json.canonical(event.get("payload")).contains("nonce"));
    }

    /** An event with its payload removed, for asking what the envelope alone says. */
    private static Map<String, Object> withoutPayload(Map<String, Object> event) {
        Map<String, Object> envelope = Json.obj();
        for (Map.Entry<String, Object> entry : event.entrySet()) {
            if (!entry.getKey().equals("payload")) envelope.put(entry.getKey(), entry.getValue());
        }
        return envelope;
    }

    /**
     * The section 5d regression. Each cycle is a fresh `open()`, which is what a
     * restarted process does; the chain must span all of them.
     */
    private static void restartsContinueTheChain() throws IOException {
        Harness.suite("a restarted process continues the chain (section 5d)");
        File dir = temp("restart");
        boolean sawLetterLeadingHash = false;

        for (int cycle = 0; cycle < 20; cycle++) {
            Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
            Harness.check("cycle " + cycle + " opens continuous", !journal.discontinuous());
            journal.append("probe.heartbeat", beat(cycle));
            String head = hashOf(lastLine(dir));
            if (!Character.isDigit(head.charAt(0))) sawLetterLeadingHash = true;
        }

        // Without this the suite could pass on a run where every hash happened to
        // start with a digit -- the exact case the old defect survived.
        Harness.check("exercised a hash beginning with a letter", sawLetterLeadingHash);

        Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
        Harness.equal("chain verifies across 20 restarts", journal.verify(), "ok (20 events)");
        Harness.equal("every event is present", journal.count(), 20);
    }

    private static void deletingAnEventIsDetected() throws IOException {
        Harness.suite("a deleted event is detected");
        File dir = temp("delete");
        Journal journal = write(dir, 5);

        List<String> lines = lines(dir);
        lines.remove(2);
        rewrite(dir, lines);

        Harness.equal("the break is reported at the join",
            journal.verify(), "1 break in 4 events, at line 2");
    }

    private static void editingAHashIsDetected() throws IOException {
        Harness.suite("an edited hash is detected");
        File dir = temp("edit-hash");
        Journal journal = write(dir, 4);

        List<String> lines = lines(dir);
        String line = lines.get(1);
        String hash = hashOf(line);
        lines.set(1, line.replace("\"hash\":\"" + hash + "\"",
            "\"hash\":\"" + hash.substring(0, 63) + (hash.endsWith("a") ? "b" : "a") + "\""));
        rewrite(dir, lines);

        // The edited line still links to its own predecessor; the line after it
        // no longer links to the edited one. One edit, one break, at line 2.
        Harness.equal("the break is reported after the edit",
            journal.verify(), "1 break in 4 events, at line 2");
    }

    private static void reorderingIsDetected() throws IOException {
        Harness.suite("reordering is detected");
        File dir = temp("reorder");
        Journal journal = write(dir, 4);

        List<String> lines = lines(dir);
        String second = lines.get(1);
        lines.set(1, lines.get(2));
        lines.set(2, second);
        rewrite(dir, lines);

        Harness.check("swapping two events breaks the chain",
            !journal.verify().startsWith("ok"));
    }

    /**
     * A limit, recorded as a passing assertion rather than left implicit.
     *
     * `verify()` compares each event's `previous` against the recorded hash of
     * the line before it. It never recomputes a hash from the stored fields, so
     * an edit that leaves the hash fields alone -- changing what an event says
     * happened, while keeping the linkage intact -- passes.
     *
     * The chain as shipped is therefore evidence against deletion, insertion and
     * reordering, and NOT against alteration in place. `CLAIMS.md` C2a must say
     * so. Re-derivation needs a JSON parser the probe does not have, and adding
     * one is an instrument change, which does not happen mid-run
     * (`DEVICE_LOOP.md` section 7 R4).
     */
    private static void editingAPayloadIsNotDetected() throws IOException {
        Harness.suite("an edited payload is NOT detected -- a stated limit");
        File dir = temp("edit-payload");
        Journal journal = write(dir, 3);

        List<String> lines = lines(dir);
        Harness.check("the fixture's payload is what we think it is",
            lines.get(1).contains("\"beat\":1"));
        lines.set(1, lines.get(1).replace("\"beat\":1", "\"beat\":9"));
        rewrite(dir, lines);

        Harness.equal("linkage still verifies, so the edit passes unseen",
            journal.verify(), "ok (3 events)");
        Harness.check("the altered value is what the journal now reports",
            lines(dir).get(1).contains("\"beat\":9"));
    }

    private static void everyBreakIsReported() throws IOException {
        Harness.suite("every break is reported, not just the first");
        File dir = temp("breaks");
        Journal journal = write(dir, 6);

        List<String> lines = lines(dir);
        lines.remove(4);
        lines.remove(1);
        rewrite(dir, lines);

        // An earlier break must not hide a later one; that is when a hidden
        // break matters most.
        Harness.equal("both breaks are named",
            journal.verify(), "2 breaks in 4 events, at lines 1, 3");
    }

    private static void anUnreadableHeadIsDeclaredDiscontinuous() throws IOException {
        Harness.suite("a lane whose head cannot be read is declared discontinuous");
        File dir = temp("discontinuous");
        write(dir, 2);

        List<String> lines = lines(dir);
        lines.add("{\"this line has no hash\":true}");
        rewrite(dir, lines);

        // The trailing line has no hash, but an earlier one does: restore walks
        // back and finds it, so this is continuous.
        Journal recovered = Journal.open(new Context(dir), "pixel", "test-device");
        Harness.check("a readable head further back is still a head",
            !recovered.discontinuous());

        rewrite(dir, List.of("{\"no hash here\":1}", "{\"nor here\":2}"));
        Journal lost = Journal.open(new Context(dir), "pixel", "test-device");
        Harness.check("no readable head anywhere is declared, not hidden",
            lost.discontinuous());
    }

    // -- helpers ------------------------------------------------------------

    private static Map<String, Object> beat(int n) {
        Map<String, Object> payload = Json.obj();
        payload.put("beat", (long) n);
        payload.put("service", "dataSync");
        return payload;
    }

    private static Journal write(File dir, int events) throws IOException {
        Journal journal = Journal.open(new Context(dir), "pixel", "test-device");
        for (int i = 0; i < events; i++) journal.append("probe.heartbeat", beat(i));
        return journal;
    }

    private static String hashOf(String line) {
        int at = line.indexOf("\"hash\":\"") + 8;
        return line.substring(at, line.indexOf('"', at));
    }

    private static File temp(String name) throws IOException {
        Path dir = Files.createTempDirectory("orb-pass1-" + name);
        dir.toFile().deleteOnExit();
        return dir.toFile();
    }

    private static File lane(File dir) {
        return new File(dir, "pixel.lane.jsonl");
    }

    private static List<String> lines(File dir) throws IOException {
        return new ArrayList<>(Files.readAllLines(lane(dir).toPath(), StandardCharsets.UTF_8));
    }

    private static String lastLine(File dir) throws IOException {
        List<String> lines = lines(dir);
        return lines.get(lines.size() - 1);
    }

    private static void rewrite(File dir, List<String> lines) throws IOException {
        StringBuilder out = new StringBuilder();
        for (String line : lines) out.append(line).append('\n');
        Files.write(lane(dir).toPath(), out.toString().getBytes(StandardCharsets.UTF_8));
    }
}
