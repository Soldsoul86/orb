package @PKG@;

import java.util.Map;

/**
 * The cross-implementation vectors, run from the Java side.
 *
 * `runtime/journal/tests/vectors.test.ts` has always checked these from
 * TypeScript. The Java half of the agreement was checked once, by hand, and
 * then trusted -- which is the weaker half, because it is the half that runs on
 * the device.
 *
 * A disagreement here would not surface as a wrong answer. It would surface as
 * two devices that can never agree they hold the same history, long after the
 * cause was introduced (`DEVICE_LOOP.md` section 7 R2).
 *
 * `Vectors` is generated from `tests/vectors.json` at test time, so the fixture
 * stays the single source of truth for both implementations.
 */
final class JsonTest {

    static void run() {
        Harness.suite("canonical JSON matches the shared vectors");

        Harness.equal("the payload encodes to the pinned canonical form",
            Json.canonical(Vectors.payload()), Vectors.PAYLOAD_CANONICAL);

        Harness.equal("the payload hashes to the pinned digest",
            Journal.sha256(Json.canonical(Vectors.payload())), Vectors.PAYLOAD_HASH);

        // Guards the fixture itself: a vector whose stated canonical form and
        // stated hash disagree would pin nothing and still look like a pass.
        Harness.equal("the fixture's own canonical form hashes to its digest",
            Journal.sha256(Vectors.PAYLOAD_CANONICAL), Vectors.PAYLOAD_HASH);

        Map<String, Object> preimage = Vectors.preimageInput();
        preimage.put("payloadHash", Vectors.PAYLOAD_HASH);
        Harness.equal("the event preimage hashes to the pinned digest",
            Journal.sha256(Json.canonical(preimage)), Vectors.HASH);

        Harness.suite("envelope v2 matches the shared vectors");

        // The v2 sections were computed by the TypeScript encoder and written
        // into the fixture, so these are a genuine cross-implementation check
        // rather than this encoder agreeing with itself.
        //
        // `preimageInput` deliberately carries no `type`. Each side derives it
        // with its own coarsening rule, so one check pins the rule and the bytes
        // together: a Java `coarseType` that disagreed with the TypeScript one
        // would fail here even though both encoders were byte-perfect.
        v2Case("content", Vectors.V2_FINE_TYPE, Vectors.v2Payload(), Vectors.V2_PAYLOAD_CANONICAL,
            Vectors.V2_PAYLOAD_HASH, Vectors.v2PreimageInput(), Vectors.V2_PREIMAGE_CANONICAL,
            Vectors.V2_HASH);

        // The other branch. A bookkeeping type keeps its real name, because a
        // device holding no keys reads it and can never decrypt to find out.
        v2Case("bookkeeping", Vectors.V2BK_FINE_TYPE, Vectors.v2bkPayload(),
            Vectors.V2BK_PAYLOAD_CANONICAL, Vectors.V2BK_PAYLOAD_HASH,
            Vectors.v2bkPreimageInput(), Vectors.V2BK_PREIMAGE_CANONICAL, Vectors.V2BK_HASH);

        Harness.equal("a content type is coarsened", Journal.coarseType("probe.heartbeat"),
            Journal.CONTENT_TYPE);
        Harness.equal("coarsening is idempotent, so the preimage rule is form-independent",
            Journal.coarseType(Journal.CONTENT_TYPE), Journal.CONTENT_TYPE);
        Harness.equal("a bookkeeping type is not", Journal.coarseType("orb.erasure"), "orb.erasure");

        Harness.suite("encoding edge cases the fixture does not reach");

        Map<String, Object> sorted = Json.obj();
        sorted.put("b", "second");
        sorted.put("a", "first");
        Harness.equal("keys sort regardless of insertion order",
            Json.canonical(sorted), "{\"a\":\"first\",\"b\":\"second\"}");

        Harness.equal("a null value is emitted, not dropped",
            Json.canonical(nullValued()), "{\"previous\":null}");

        Harness.equal("controls below 0x20 escape as \\u00xx",
            Json.canonical("\u0001\u001f"), "\"\\u0001\\u001f\"");

        Harness.equal("DEL and the C1 range stay raw, as JSON.stringify leaves them",
            Json.canonical("\u007f\u0080"), "\"\u007f\u0080\"");

        Harness.equal("a lone surrogate survives the encoder unaltered",
            Json.canonical("\ud800").length(), 3);

        Harness.equal("an astral codepoint stays raw",
            Json.canonical("😀"), "\"😀\"");

        Harness.equal("an empty object and an empty array",
            Json.canonical(pair()), "{\"array\":[],\"object\":{}}");
    }

    private static Map<String, Object> nullValued() {
        Map<String, Object> map = Json.obj();
        map.put("previous", null);
        return map;
    }

    private static Map<String, Object> pair() {
        Map<String, Object> map = Json.obj();
        map.put("object", Json.obj());
        map.put("array", new java.util.ArrayList<>());
        return map;
    }

    /**
     * One v2 vector, checked end to end against the **journal's own**
     * construction.
     *
     * Deliberately not `Json.canonical(fixtureObject)`. That form pins the
     * encoding of data the test assembled, so a Java encoder that built the
     * wrapper or the preimage differently would agree with itself, pass, and
     * diverge from the TypeScript runtime in production. A negative control
     * found exactly that hole: keeping `causes` in the v2 preimage failed
     * nothing. So `wrapPayload` and `preimage` are called here, with the fine
     * type, and the bytes they produce are what the fixture pins.
     */
    private static void v2Case(
        String label, String fineType, Map<String, Object> fixturePayload, String payloadCanonical,
        String payloadHash, Map<String, Object> preimageInput, String preimageCanonical,
        String hash) {
        Map<String, Object> schema = Json.obj();
        schema.put("id", fineType);
        schema.put("version", 1L);

        // The caller's data and the fixed nonce, taken out of the pinned wrapper
        // so the fixture stays the single source of truth for both sides.
        Object data = fixturePayload.get("data");
        String nonce = (String) fixturePayload.get("nonce");

        Map<String, Object> wrapped =
            Journal.wrapPayload(fineType, schema, java.util.Collections.<String>emptyList(), data, nonce);
        Harness.equal(label + ": the journal's wrapper encodes to the pinned canonical form",
            Json.canonical(wrapped), payloadCanonical);
        Harness.equal(label + ": and hashes to the pinned digest",
            Journal.sha256(Json.canonical(wrapped)), payloadHash);
        Harness.equal(label + ": the fixture's own canonical form hashes to its digest",
            Journal.sha256(payloadCanonical), payloadHash);

        @SuppressWarnings("unchecked")
        Map<String, Object> hlc = (Map<String, Object>) preimageInput.get("hlc");
        Map<String, Object> preimage = Journal.preimage(
            2,
            (String) preimageInput.get("id"),
            (String) preimageInput.get("lane"),
            (String) preimageInput.get("device"),
            hlc,
            (Long) preimageInput.get("wallClock"),
            fineType,
            schema,
            java.util.Collections.<String>emptyList(),
            payloadHash,
            (String) preimageInput.get("previous"));
        Harness.equal(label + ": the journal's preimage encodes to the pinned canonical form",
            Json.canonical(preimage), preimageCanonical);
        Harness.equal(label + ": and hashes to the pinned digest",
            Journal.sha256(Json.canonical(preimage)), hash);
    }
}
