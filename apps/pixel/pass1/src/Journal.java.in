package @PKG@;

import android.content.Context;
import java.io.File;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.RandomAccessFile;
import java.nio.charset.StandardCharsets;
import java.security.MessageDigest;
import java.util.ArrayList;
import java.util.Collections;
import java.util.List;
import java.util.Map;

/**
 * The phone's lane: append-only, hash-chained, one JSON object per line.
 *
 * A thin peer, not a second Orb (`docs/DEVICE_LOOP.md` §5). It appends and
 * verifies and does nothing else — no projections, no interpretation — so there
 * is no second interpretation layer that could drift from the Mac's.
 *
 * Written to the app's external files directory so it can be pulled with
 * `adb pull` on an unrooted device. That is a deliberate trade: the journal is
 * readable by anything with storage access, which is wrong for a real runtime
 * and right for an instrument whose entire output is the evidence it produces.
 */
final class Journal {
    private static final int SCHEMA_VERSION = 1;

    /**
     * Envelope format this build writes. **Absent means 1** on the wire.
     *
     * v2 is the coarse envelope (`docs/ERASURE.md` §2a, §2b): the real type,
     * schema and causes move inside the payload together with a nonce, and the
     * envelope carries only a coarse label. Both encodings are implemented here
     * and both are pinned against the TypeScript runtime by
     * `tests/vectors.json`, so the two implementations cannot drift apart on
     * either rule.
     *
     * **Deliberately still 1.** Pass 1 is a measuring instrument and its journal
     * is evidence about the phone, not about a life — a heartbeat's fine type
     * discloses that a heartbeat happened. Migrating mid-run would put a version
     * seam through a measurement for no gain in what the measurement says.
     * Flipping this to 2 is the pass-2 decision, and it is one line so that it
     * is a deliberate act rather than a drift.
     */
    static final int DEFAULT_ENVELOPE_VERSION = 1;

    /** The only type a v2 content envelope carries. `vocabulary.ts`. */
    static final String CONTENT_TYPE = "orb.content";

    /**
     * Types that stay legible in a v2 envelope, because machinery on devices
     * holding no keys reads them (`ERASURE.md` §2b).
     *
     * This phone writes none of them. They are here so the two implementations
     * agree on the **rule** rather than on this probe's subset of it — the
     * exception is exactly the branch that would diverge unnoticed.
     */
    private static final List<String> BOOKKEEPING = Collections.unmodifiableList(
        java.util.Arrays.asList("orb.custody.receipt", "orb.sync.policy", "orb.erasure"));

    private final File file;
    private final String lane;
    private final String device;

    private String head;
    private Hlc clock;
    private int envelopeVersion = DEFAULT_ENVELOPE_VERSION;

    private Journal(File file, String lane, String device) {
        this.file = file;
        this.lane = lane;
        this.device = device;
    }

    static Journal open(Context context, String lane, String device) throws IOException {
        File dir = context.getExternalFilesDir(null);
        if (dir == null) dir = context.getFilesDir();
        Journal journal = new Journal(new File(dir, lane + ".lane.jsonl"), lane, device);
        journal.restore();
        return journal;
    }

    File file() {
        return file;
    }

    /** Test seam: writes the named envelope version instead of the default. */
    void useEnvelopeVersion(int version) {
        if (version != 1 && version != 2) throw new IllegalArgumentException("unknown envelope version");
        this.envelopeVersion = version;
    }

    static boolean isBookkeeping(String type) {
        return BOOKKEEPING.contains(type);
    }

    /** What a v2 envelope says, given what the event actually is. */
    static String coarseType(String type) {
        return isBookkeeping(type) ? type : CONTENT_TYPE;
    }

    /** What a v2 envelope's schema says. Content gets one describing *an encrypted payload*. */
    static Map<String, Object> coarseSchema(String type, Map<String, Object> schema) {
        if (isBookkeeping(type)) return schema;
        Map<String, Object> coarse = Json.obj();
        coarse.put("id", CONTENT_TYPE);
        coarse.put("version", 1L);
        return coarse;
    }

    /**
     * The v2 payload: the caller's data plus everything the envelope stopped
     * saying, and a nonce.
     *
     * The nonce is inside what `payloadHash` covers, which is the whole point —
     * `payloadHash` sits in a plaintext envelope, so a guessable payload with a
     * bare hash is a confirmation oracle. A nonce the hash does not cover
     * defeats nothing (`ERASURE.md` §2a).
     */
    static Map<String, Object> wrapPayload(
        String type, Map<String, Object> schema, List<String> causes, Object data, String nonce) {
        Map<String, Object> wrapped = Json.obj();
        wrapped.put("causes", causes);
        wrapped.put("data", data);
        wrapped.put("nonce", nonce);
        wrapped.put("schema", schema);
        wrapped.put("type", type);
        return wrapped;
    }

    /**
     * The exact object a version's hash is taken over.
     *
     * Extracted from `append` so `tests/vectors.json` pins **this** rather than
     * the encoding of a fixture the test assembled itself. A Java encoder that
     * was internally consistent and disagreed with the TypeScript runtime would
     * otherwise pass every check and diverge in production — which is the whole
     * failure the vectors exist to prevent, and it slipped through until a
     * negative control found it.
     *
     * Takes the **fine** type and schema and coarsens them here, so a caller
     * cannot pass the coarse form and accidentally test nothing.
     */
    static Map<String, Object> preimage(
        int version, String id, String lane, String device, Map<String, Object> hlc,
        long wallClock, String fineType, Map<String, Object> schema, List<String> causes,
        String payloadHash, String previous) {
        boolean v2 = version == 2;
        Map<String, Object> preimage = Json.obj();
        // `v` is inside the preimage so it cannot be flipped to make a verifier
        // apply the wrong rule, and in the envelope rather than the payload so a
        // device holding no keys can still tell which rule to use.
        if (v2) preimage.put("v", 2L);
        preimage.put("id", id);
        preimage.put("lane", lane);
        preimage.put("device", device);
        preimage.put("hlc", hlc);
        preimage.put("wallClock", wallClock);
        preimage.put("type", v2 ? coarseType(fineType) : fineType);
        // v2 drops both: they are payload now, so erasing a payload erases the
        // event's kind and its stated lineage with it.
        if (!v2) {
            preimage.put("causes", causes);
            preimage.put("schema", schema);
        }
        preimage.put("payloadHash", payloadHash);
        preimage.put("previous", previous);
        return preimage;
    }

    /** 128 bits, so a payload's plaintext cannot be enumerated. */
    static String newNonce() {
        byte[] bytes = new byte[16];
        new java.security.SecureRandom().nextBytes(bytes);
        StringBuilder out = new StringBuilder(32);
        for (byte b : bytes) out.append(String.format("%02x", b));
        return out.toString();
    }

    /**
     * Re-reads the tail so a restarted process continues the chain rather than
     * forking it.
     *
     * The hash is a string field and must be read with the string extractor.
     * Reading it with the numeric one returns null, `head` stays null, and the
     * next append claims no predecessor — which forks the chain at every
     * process restart. That was the defect the verifier caught on this probe's
     * first real run (`DEVICE_LOOP.md` §5d).
     */
    private synchronized void restore() throws IOException {
        if (!file.exists()) return;
        List<String> lines = readLines();
        if (lines.isEmpty()) return;

        for (int i = lines.size() - 1; i >= 0; i--) {
            String line = lines.get(i);
            String hash = extractString(line, "\"hash\":\"");
            if (hash == null) continue;

            head = hash;
            String physical = extract(line, "\"physical\":");
            String counter = extract(line, "\"counter\":");
            if (physical != null && counter != null) {
                clock = new Hlc(Long.parseLong(physical), Long.parseLong(counter));
            }
            return;
        }

        // A non-empty lane whose head cannot be resolved. The next append will
        // start a new chain segment, and saying so is the only honest option:
        // a journal that cannot link to its own past must not look as though it
        // did (Constitution Art. I §5).
        discontinuous = true;
    }

    /** True when the previous chain head could not be recovered on open. */
    private boolean discontinuous;

    boolean discontinuous() {
        return discontinuous;
    }

    synchronized List<String> readLines() throws IOException {
        List<String> out = new ArrayList<>();
        if (!file.exists()) return out;
        try (RandomAccessFile raf = new RandomAccessFile(file, "r")) {
            String line;
            while ((line = raf.readLine()) != null) {
                if (!line.isEmpty()) out.add(new String(line.getBytes(StandardCharsets.ISO_8859_1), StandardCharsets.UTF_8));
            }
        }
        return out;
    }

    synchronized int count() throws IOException {
        return readLines().size();
    }

    /**
     * Appends one event and returns it.
     *
     * Synchronized because sensors fire from arbitrary threads and the chain is
     * a single sequence: two appends interleaving would produce two events
     * claiming the same predecessor, which is the one corruption the hash chain
     * is there to make impossible.
     */
    synchronized Map<String, Object> append(String type, Map<String, Object> payload) {
        long wallClock = System.currentTimeMillis();
        clock = Hlc.tick(clock, wallClock);

        Map<String, Object> schema = Json.obj();
        schema.put("id", type);
        schema.put("version", (long) SCHEMA_VERSION);

        List<String> causes = Collections.emptyList();
        String id = Ids.newEventId(wallClock);
        boolean v2 = envelopeVersion == 2;

        // v2 hashes the wrapped payload, not the caller's object. The nonce must
        // be inside the hash or the oracle it closes stays open.
        Object stored = v2 ? wrapPayload(type, schema, causes, payload, newNonce()) : payload;
        String payloadHash = sha256(Json.canonical(stored));

        String envelopeType = v2 ? coarseType(type) : type;
        Map<String, Object> envelopeSchema = v2 ? coarseSchema(type, schema) : schema;

        String hash = sha256(Json.canonical(preimage(
            envelopeVersion, id, lane, device, clock.toMap(), wallClock,
            type, schema, causes, payloadHash, head)));

        Map<String, Object> integrity = Json.obj();
        integrity.put("previous", head);
        integrity.put("hash", hash);
        integrity.put("payloadHash", payloadHash);

        Map<String, Object> event = Json.obj();
        if (v2) event.put("v", 2L);
        event.put("id", id);
        event.put("lane", lane);
        event.put("device", device);
        event.put("hlc", clock.toMap());
        event.put("wallClock", wallClock);
        event.put("type", envelopeType);
        if (!v2) event.put("causes", causes);
        event.put("schema", envelopeSchema);
        event.put("payload", stored);
        event.put("integrity", integrity);

        try {
            try (FileOutputStream out = new FileOutputStream(file, true)) {
                out.write((Json.canonical(event) + "\n").getBytes(StandardCharsets.UTF_8));
                // fsync: a resolved append must survive the process being killed,
                // which on this device is the event most likely to happen next.
                out.getFD().sync();
            }
        } catch (IOException error) {
            // An append that cannot be durable is not history. Nothing to do but
            // let the next open detect the gap; never pretend it was written.
            return null;
        }

        head = hash;
        return event;
    }

    /** Reads the last event of a given type, or null. Used to reconstruct gaps. */
    synchronized Map<String, String> lastOfType(String type) throws IOException {
        List<String> lines = readLines();
        for (int i = lines.size() - 1; i >= 0; i--) {
            String line = lines.get(i);
            if (!line.contains("\"type\":\"" + type + "\"")) continue;
            Map<String, String> out = new java.util.HashMap<>();
            out.put("wallClock", extract(line, "\"wallClock\":"));
            out.put("line", line);
            return out;
        }
        return null;
    }

    /** The last event of any type, or null. */
    synchronized Map<String, String> last() throws IOException {
        List<String> lines = readLines();
        if (lines.isEmpty()) return null;
        String line = lines.get(lines.size() - 1);
        Map<String, String> out = new java.util.HashMap<>();
        out.put("wallClock", extract(line, "\"wallClock\":"));
        out.put("type", extractString(line, "\"type\":\""));
        out.put("line", line);
        return out;
    }

    /**
     * Verifies the whole chain: every hash self-consistent, every event
     * committing to its predecessor.
     *
     * Checks LINKAGE ONLY: that each event's `previous` is the recorded hash of
     * the event before it. It does not re-derive any hash from the stored
     * fields, so it detects deletion, insertion and reordering -- and does NOT
     * detect an edit that leaves the hash fields alone. An altered payload
     * verifies clean (`tests/JournalTest.java.in`, and `CLAIMS.md` C2a).
     *
     * Re-derivation needs a JSON parser this probe does not have. Adding one is
     * an instrument change and does not happen mid-run (`DEVICE_LOOP.md` §7 R4);
     * the desktop analyser is the better home for it anyway, since a chain
     * checked only by the device that wrote it is the weaker check.
     */
    /**
     * The line numbers where linkage fails, in order.
     *
     * Separate from {@link #verify} because a break's *position* is the durable
     * fact and the rendered sentence is not: positions are stable forever in an
     * append-only file, so they can be compared across runs to tell an old break
     * from a new one (`SelfTest`). A line that carries no hash at all is
     * reported as `-1 - index` so it is distinguishable from a linkage break at
     * the same place.
     */
    synchronized List<Integer> chainBreaks() throws IOException {
        List<String> lines = readLines();
        List<Integer> breaks = new ArrayList<>();
        String previous = null;

        for (int i = 0; i < lines.size(); i++) {
            String line = lines.get(i);
            String recorded = extractString(line, "\"hash\":\"");
            if (recorded == null) {
                breaks.add(-1 - i);
                continue;
            }

            String claimed = line.contains("\"previous\":null")
                ? null
                : extractString(line, "\"previous\":\"");

            // Report every break rather than stopping at the first. A single
            // known break earlier in the file would otherwise hide every one
            // after it, which is exactly when a hidden break matters most.
            if (previous == null ? claimed != null : !previous.equals(claimed)) {
                breaks.add(i);
            }
            previous = recorded;
        }
        return breaks;
    }

    synchronized String verify() throws IOException {
        List<String> lines = readLines();
        List<Integer> breaks = chainBreaks();

        for (Integer at : breaks) {
            if (at < 0) return "line " + (-1 - at) + ": no hash";
        }

        if (breaks.isEmpty()) return "ok (" + lines.size() + " events)";
        StringBuilder out = new StringBuilder();
        out.append(breaks.size()).append(breaks.size() == 1 ? " break" : " breaks")
           .append(" in ").append(lines.size()).append(" events, at line");
        if (breaks.size() > 1) out.append('s');
        for (int i = 0; i < breaks.size(); i++) {
            out.append(i == 0 ? " " : ", ").append(breaks.get(i));
        }
        return out.toString();
    }

    private static String extract(String line, String key) {
        int at = line.indexOf(key);
        if (at < 0) return null;
        int start = at + key.length();
        int end = start;
        while (end < line.length() && (Character.isDigit(line.charAt(end)) || line.charAt(end) == '-')) end++;
        return end > start ? line.substring(start, end) : null;
    }

    private static String extractString(String line, String key) {
        int at = line.indexOf(key);
        if (at < 0) return null;
        int start = at + key.length();
        int end = line.indexOf('"', start);
        return end < 0 ? null : line.substring(start, end);
    }

    static String sha256(String input) {
        try {
            MessageDigest digest = MessageDigest.getInstance("SHA-256");
            byte[] bytes = digest.digest(input.getBytes(StandardCharsets.UTF_8));
            StringBuilder out = new StringBuilder(64);
            for (byte b : bytes) out.append(String.format("%02x", b));
            return out.toString();
        } catch (Exception error) {
            throw new IllegalStateException("SHA-256 unavailable", error);
        }
    }
}
