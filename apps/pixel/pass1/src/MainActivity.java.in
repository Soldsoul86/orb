package @PKG@;

import android.Manifest;
import android.app.Activity;
import android.content.ContentResolver;
import android.content.ContentValues;
import android.content.Intent;
import android.content.pm.PackageManager;
import android.net.Uri;
import android.os.Environment;
import android.provider.MediaStore;
import android.graphics.Color;
import android.os.Bundle;
import android.os.Handler;
import android.os.Looper;
import android.view.Gravity;
import android.view.View;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import java.io.IOException;
import java.io.OutputStream;
import java.nio.charset.StandardCharsets;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;
import java.util.Locale;
import java.util.Map;

/**
 * Enough interface to start the probe and see that it is recording.
 *
 * Deliberately not a product surface (`docs/DEVICE_LOOP.md` §5). The real
 * output of pass 1 is the journal file, pulled over the cable; this screen
 * exists so a human can confirm the thing is alive without one.
 */
public final class MainActivity extends Activity {
    private final Handler handler = new Handler(Looper.getMainLooper());
    private TextView status;

    private final Runnable refresh = new Runnable() {
        @Override
        public void run() {
            render();
            handler.postDelayed(this, 2_000L);
        }
    };

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(48, 96, 48, 48);

        Button start = new Button(this);
        start.setText("Start recording");
        start.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { startServices(); }
        });
        root.addView(start);

        Button stop = new Button(this);
        stop.setText("Stop recording");
        stop.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { stopServices(); }
        });
        root.addView(stop);

        Button export = new Button(this);
        export.setText("Export journal to Downloads");
        export.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { export(); }
        });
        root.addView(export);

        status = new TextView(this);
        status.setTextSize(13);
        status.setTextIsSelectable(true);
        ScrollView scroll = new ScrollView(this);
        scroll.addView(status);
        root.addView(scroll);

        setContentView(root);

        // The foreground-service notification needs this on API 33+. It is the
        // only runtime permission the probe asks for, and nothing it measures
        // depends on the answer.
        if (checkSelfPermission(Manifest.permission.POST_NOTIFICATIONS)
                != PackageManager.PERMISSION_GRANTED) {
            requestPermissions(new String[] {Manifest.permission.POST_NOTIFICATIONS}, 1);
        }
    }

    private void startServices() {
        startForegroundService(new Intent(this, DataSyncService.class));
        startForegroundService(new Intent(this, SpecialUseService.class));
    }

    private void stopServices() {
        stopService(new Intent(this, DataSyncService.class));
        stopService(new Intent(this, SpecialUseService.class));
    }

    /**
     * Copies the journal into the public Downloads folder.
     *
     * Without this the journal is unreachable on a phone with developer mode
     * off: since Android 11 the Files app cannot browse into another app's
     * `Android/data`, so `adb pull` was the only way out. A cable-free device
     * needs a cable-free export or it produces no evidence at all.
     *
     * The export is itself appended to the journal before it happens.
     * `SECURITY.md` §7 requires that data leaving the device is recorded as
     * history, and a copy into shared storage that anything can read is exactly
     * that — the fact that it is convenient does not make it not a disclosure.
     */
    private void export() {
        Journal journal = Probe.get() == null ? null : Probe.get().journal();
        if (journal == null) {
            status.setText("journal unavailable");
            return;
        }

        try {
            List<String> lines = journal.readLines();
            String name = "orb-pass1-"
                + new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(new Date())
                + ".jsonl";

            Map<String, Object> record = Json.obj();
            record.put("destination", "Downloads/" + name);
            record.put("events", (long) lines.size());
            record.put("reason", "operator export");
            journal.append("probe.export", record);

            // Re-read, so the export contains the record of itself. A disclosure
            // that is missing from the copy it produced would be a gap in the
            // very history the copy exists to carry.
            lines = journal.readLines();

            ContentValues values = new ContentValues();
            values.put(MediaStore.Downloads.DISPLAY_NAME, name);
            values.put(MediaStore.Downloads.MIME_TYPE, "application/x-ndjson");
            values.put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);

            ContentResolver resolver = getContentResolver();
            Uri target = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
            if (target == null) {
                status.setText("export failed: no destination");
                return;
            }

            try (OutputStream out = resolver.openOutputStream(target)) {
                for (String line : lines) {
                    out.write((line + "\n").getBytes(StandardCharsets.UTF_8));
                }
            }

            status.setText("exported " + lines.size() + " events\nDownloads/" + name
                + "\n\nOpen Files > Downloads to share it.");
        } catch (IOException error) {
            status.setText("export failed: " + error);
        }
    }

    private void render() {
        Journal journal = Probe.get() == null ? null : Probe.get().journal();
        if (journal == null) {
            status.setText("journal unavailable");
            return;
        }
        try {
            List<String> lines = journal.readLines();
            StringBuilder out = new StringBuilder();
            out.append("events: ").append(lines.size()).append('\n');
            out.append("chain:  ").append(journal.verify()).append('\n');
            out.append("file:   ").append(journal.file().getAbsolutePath()).append("\n\n");
            out.append("last 12:\n");
            for (int i = Math.max(0, lines.size() - 12); i < lines.size(); i++) {
                String line = lines.get(i);
                out.append("  ").append(summarise(line)).append('\n');
            }
            status.setText(out.toString());
        } catch (IOException error) {
            status.setText("read failed: " + error);
        }
    }

    private static String summarise(String line) {
        int typeAt = line.indexOf("\"type\":\"");
        String type = typeAt < 0 ? "?" : line.substring(typeAt + 8, line.indexOf('"', typeAt + 8));
        int clockAt = line.indexOf("\"wallClock\":");
        String at = "?";
        if (clockAt >= 0) {
            int start = clockAt + 12;
            int end = start;
            while (end < line.length() && Character.isDigit(line.charAt(end))) end++;
            at = new java.text.SimpleDateFormat("HH:mm:ss", java.util.Locale.US)
                .format(new java.util.Date(Long.parseLong(line.substring(start, end))));
        }
        return at + "  " + type;
    }

    @Override
    protected void onResume() {
        super.onResume();
        handler.post(refresh);
    }

    @Override
    protected void onPause() {
        handler.removeCallbacks(refresh);
        super.onPause();
    }
}
