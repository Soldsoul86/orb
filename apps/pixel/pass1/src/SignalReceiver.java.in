package @PKG@;

import android.content.BroadcastReceiver;
import android.content.Context;
import android.content.Intent;
import android.os.SystemClock;
import java.util.Map;

/**
 * Manifest-declared receivers: the signals that arrive with no service running.
 *
 * This is P6. Package install and removal are among the broadcasts still
 * delivered to a declared receiver on a modern Android, and if they are, the
 * cheapest and highest-value sensor in `MOBILE_SENSING.md` §8 costs no
 * foreground service at all — which would make the whole integrity sensor
 * nearly free. If they are not, that recommendation is wrong.
 *
 * `BOOT_COMPLETED` is P2: whether anything at all resumes after a restart
 * without the user opening the app.
 */
public final class SignalReceiver extends BroadcastReceiver {
    @Override
    public void onReceive(Context context, Intent intent) {
        Probe probe = Probe.get();
        if (probe == null || intent.getAction() == null) return;
        Journal journal = probe.journal();
        if (journal == null) return;

        String action = intent.getAction();
        Map<String, Object> payload = Json.obj();
        payload.put("action", action);
        payload.put("registration", "manifest");
        payload.put("elapsedRealtimeMs", SystemClock.elapsedRealtime());
        if (intent.getData() != null) {
            payload.put("data", intent.getData().toString());
        }
        journal.append("probe.signal", payload);

        // A boot that revives the process is only half of P2. The other half is
        // whether the services come back, so try — and let the journal record
        // whether the attempt was permitted.
        if (Intent.ACTION_BOOT_COMPLETED.equals(action)) {
            Map<String, Object> attempt = Json.obj();
            attempt.put("trigger", "BOOT_COMPLETED");
            try {
                context.startForegroundService(new Intent(context, DataSyncService.class));
                context.startForegroundService(new Intent(context, SpecialUseService.class));
                attempt.put("outcome", "requested");
            } catch (Throwable error) {
                // Android 15+ forbids starting most foreground-service types
                // from BOOT_COMPLETED. The refusal is the finding, so it is
                // recorded rather than allowed to crash the receiver.
                attempt.put("outcome", "refused");
                attempt.put("error", error.getClass().getName());
                attempt.put("message", String.valueOf(error.getMessage()));
            }
            journal.append("probe.boot.restart", attempt);
        }
    }
}
