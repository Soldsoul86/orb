package @PKG@;

import java.security.SecureRandom;

/**
 * ULID-class event identifiers, matching `runtime/journal/src/ids.ts`.
 *
 * 48 bits of time then 80 bits of randomness, Crockford base32: sortable by
 * creation time, and unique across devices without coordination.
 */
final class Ids {
    private static final String CROCKFORD = "0123456789ABCDEFGHJKMNPQRSTVWXYZ";
    private static final SecureRandom RANDOM = new SecureRandom();

    private Ids() {}

    static String newEventId(long timestampMs) {
        StringBuilder out = new StringBuilder(26);
        encode(out, timestampMs & ((1L << 48) - 1), 10);

        byte[] bytes = new byte[10];
        RANDOM.nextBytes(bytes);
        // Two halves, because 80 bits does not fit in a long.
        long high = 0;
        for (int i = 0; i < 5; i++) high = (high << 8) | (bytes[i] & 0xFFL);
        long low = 0;
        for (int i = 5; i < 10; i++) low = (low << 8) | (bytes[i] & 0xFFL);
        encode(out, high, 8);
        encode(out, low, 8);
        return out.toString();
    }

    private static void encode(StringBuilder out, long value, int length) {
        char[] chars = new char[length];
        long remaining = value;
        for (int i = length - 1; i >= 0; i--) {
            chars[i] = CROCKFORD.charAt((int) (remaining & 31));
            remaining >>>= 5;
        }
        out.append(chars);
    }
}
