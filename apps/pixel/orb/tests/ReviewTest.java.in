package @PKG@;

import android.content.Context;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import java.util.Map;
import java.util.Random;
import java.util.TimeZone;

/**
 * Money slice B (`docs/MONEY_PHONE.md` \u00a76, \u00a717; DR-46): the review. What the person is asked to judge, from the kept facts alone; that an answer is a **label** that
 * opens, closes and changes nothing; what the answer records and what it must never hold; and the precision, reported and never read by anything that decides.
 */
final class ReviewTest {
    private ReviewTest() {}

    private static final long DAY = 86_400_000L;
    private static final long NOW = 200L * DAY + 12 * 3_600_000L;
    private static final TimeZone UTC = TimeZone.getTimeZone("UTC");

    private static Observation bill(String source, String owner, long minor, long day) {
        return Observation.of(Observation.OBLIGATION_STATED).source("sms.sender", source, Observation.T0).times(day * DAY + 3_600_000L, day * DAY + 3_600_000L)
            .bearer(owner).object(Observation.MONEY, minor, "INR").confidence(80).build();
    }

    private static Observation moved(String source, String direction, long minor, long day) {
        return Observation.of(Observation.VALUE_MOVED).source("sms.sender", source, Observation.T0).times(day * DAY + 7_200_000L, day * DAY + 7_200_000L)
            .direction(direction).object(Observation.MONEY, minor, "INR").confidence(90).build();
    }

    /** A deterministic stand-in for Orb's blinded key: a hash of what it is given, sixteen hex characters. */
    private static final ReviewFacts.Keyer KEYER = new ReviewFacts.Keyer() {
        @Override public String key(String namespaced) throws Exception {
            byte[] d = java.security.MessageDigest.getInstance("SHA-256").digest(namespaced.getBytes(StandardCharsets.UTF_8));
            StringBuilder out = new StringBuilder();
            for (int i = 0; i < 8; i++) out.append(String.format(java.util.Locale.ROOT, "%02x", d[i]));
            return out.toString();
        }
    };

    private static final ReviewFacts.Keyer BROKEN = new ReviewFacts.Keyer() {
        @Override public String key(String namespaced) throws Exception {
            throw new Exception("no key");
        }
    };

    private static List<ReviewRules.Item> review(List<Observation> facts, ReviewFacts.Judged judged) {
        return ReviewRules.build(facts, judged, KEYER, NOW);
    }

    private static List<ReviewRules.Item> review(List<Observation> facts) {
        return review(facts, new ReviewFacts.Judged());
    }

    private static int count(List<ReviewRules.Item> items, String kind) {
        int n = 0;
        for (ReviewRules.Item i : items) if (kind.equals(i.kind)) n++;
        return n;
    }

    static void run() throws Exception {
        items();
        answers();
        roundTrip();
        event();
        precision();
        guards();
    }

    private static void items() throws Exception {
        Harness.suite("review: what the person is asked to judge");
        List<ReviewRules.Item> one = review(Arrays.asList(bill("BANKA", "me", 100000L, 190L), moved("BANKA", "out", 100000L, 192L)));
        Harness.check("a bill and the payment that matches it: one candidate, shown with the bill and the payment", one.size() == 1 && ReviewFacts.CANDIDATE.equals(one.get(0).kind)
            && ReviewRules.line(one.get(0), UTC).startsWith("From BANKA: a bill of \u20b91,000.00") && ReviewRules.line(one.get(0), UTC).contains("a payment of \u20b91,000.00 on"));
        Harness.equal("it asks in the words that fit: this was paid", ReviewRules.question(one.get(0)) + "|" + ReviewRules.yes(one.get(0)), "Looks like this was paid|Mark paid");
        Harness.check("a payment before the bill, a different amount, or a different source is not a candidate",
            count(review(Arrays.asList(bill("BANKA", "me", 100000L, 190L), moved("BANKA", "out", 100000L, 188L))), ReviewFacts.CANDIDATE) == 0
            && count(review(Arrays.asList(bill("BANKA", "me", 100000L, 190L), moved("BANKA", "out", 100001L, 192L))), ReviewFacts.CANDIDATE) == 0
            && count(review(Arrays.asList(bill("BANKA", "me", 100000L, 190L), moved("BANKB", "out", 100000L, 192L))), ReviewFacts.CANDIDATE) == 0);

        Harness.check("an obligation 60 days old is offered Already paid", count(review(Arrays.asList(bill("BANKA", "me", 5000L, 140L))), ReviewFacts.OPEN) == 1);
        Harness.check("an obligation 61 days old is not", review(Arrays.asList(bill("BANKA", "me", 5000L, 139L))).isEmpty());
        Harness.check("an obligation dated in the future is not offered either", review(Arrays.asList(bill("BANKA", "me", 5000L, 205L))).isEmpty());
        Harness.equal("the window is a policy constant, not data", ReviewRules.OPEN_WINDOW_DAYS, 60);

        // Two bills 50 days apart are two obligations; each has its payment.
        Observation b1 = bill("BANKA", "me", 7000L, 150L), b2 = bill("BANKA", "me", 7000L, 200L);
        Observation p1 = moved("BANKA", "out", 7000L, 152L), p2 = moved("BANKA", "out", 7000L, 202L);
        List<Observation> both = Arrays.asList(b1, b2, p1, p2);
        List<ReviewRules.Item> two = review(both);
        Harness.equal("two bills far apart and a payment for each: two candidates", count(two, ReviewFacts.CANDIDATE), 2);
        ReviewRules.Item first = null;
        for (ReviewRules.Item i : two) if (i.opener.id.equals(b1.id)) first = i;
        ReviewFacts.Judged refused = new ReviewFacts.Judged();
        refused.refused.add(ReviewFacts.pairKey(first.obligationKey, first.paymentKey));
        List<ReviewRules.Item> after = review(both, refused);
        Harness.check("Not this hides that pair only: the other bill is still asked about, and the refused bill is an open obligation again, not settled",
            count(after, ReviewFacts.CANDIDATE) == 1 && count(after, ReviewFacts.OPEN) == 1 && after.get(0).opener.id.equals(b2.id) && after.get(1).opener.id.equals(b1.id));
        ReviewFacts.Judged paid = new ReviewFacts.Judged();
        paid.settled.add(first.obligationKey);
        paid.paidPairs.add(ReviewFacts.pairKey(first.obligationKey, first.paymentKey));
        List<ReviewRules.Item> settled = review(both, paid);
        Harness.check("Mark paid hides that pair and settles the bill: neither is listed again, and the other bill is untouched", settled.size() == 1 && settled.get(0).opener.id.equals(b2.id));
        Harness.check("a verdict about another obligation does not hide this one", review(both, otherSettled()).size() == 2);

        List<ReviewRules.Item> open = review(Arrays.asList(bill("BANKA", "me", 5000L, 190L)));
        ReviewFacts.Judged already = new ReviewFacts.Judged();
        already.settled.add(open.get(0).obligationKey);
        Harness.check("Already paid settles the obligation: it is not offered again", review(Arrays.asList(bill("BANKA", "me", 5000L, 190L)), already).isEmpty());

        Harness.check("a fact whose key cannot be made is not listed: a doubt never asks a question the journal cannot hold the answer to",
            ReviewRules.build(both, new ReviewFacts.Judged(), BROKEN, NOW).isEmpty());
        Harness.check("with nothing kept there is nothing to ask", review(new ArrayList<Observation>()).isEmpty());

        List<ReviewRules.Item> ordered = review(Arrays.asList(bill("BANKA", "me", 7000L, 150L), moved("BANKA", "out", 7000L, 152L), bill("BANKB", "me", 8000L, 195L), moved("BANKB", "out", 8000L, 197L),
            bill("BANKC", "me", 9000L, 170L), bill("BANKD", "me", 9100L, 180L)));
        List<String> kinds = new ArrayList<>(), days = new ArrayList<>();
        for (ReviewRules.Item i : ordered) { kinds.add(i.kind); days.add(i.closer == null ? "-" : Long.toString(Math.floorDiv(i.closer.occurredMs, DAY))); }
        Harness.equal("candidates come newest payment first, then open obligations newest first", kinds + "|" + days, "[candidate, candidate, open, open]|[197, 152, -, -]");
        Harness.equal("and the open ones, newest bill first: D then C", ordered.get(2).opener.sourceId + ordered.get(3).opener.sourceId, "BANKDBANKC");

        List<Observation> mixed = new ArrayList<>(Arrays.asList(bill("BANKA", "me", 7000L, 150L), moved("BANKA", "out", 7000L, 152L), bill("BANKB", "me", 8000L, 195L), moved("BANKB", "out", 8000L, 197L),
            bill("BANKC", "me", 9000L, 170L), bill("BANKD", "me", 9100L, 180L), bill("BANKA", "me", 7000L, 200L)));
        String want = keysOf(review(mixed));
        boolean same = true;
        for (int seed = 0; seed < 25; seed++) {
            List<Observation> shuffled = new ArrayList<>(mixed);
            Collections.shuffle(shuffled, new Random(seed));
            same &= keysOf(review(shuffled)).equals(want);
        }
        Harness.check("the same facts in any order give the same review", same);

        // What the first mutation round of this slice found: behaviours with no test.
        List<ReviewRules.Item> grown = review(Arrays.asList(bill("BANKA", "me", 4400L, 120L), bill("BANKA", "me", 4400L, 160L)));
        Harness.check("an obligation of two reminders is as old as its last reminder: 80 days since the first, 40 since the last, is still asked about", grown.size() == 1 && ReviewFacts.OPEN.equals(grown.get(0).kind));
        Harness.equal("and its open question is about its newest reminder, keyed by that reminder", ReviewFacts.OPEN + "|" + grown.get(0).obligationKey, ReviewFacts.OPEN + "|" + KEYER.key("cand:ob:" + grown.get(0).last.id));
        List<ReviewRules.Item> alone = review(Arrays.asList(bill("BANKA", "me", 4400L, 160L)));
        List<ReviewRules.Item> later = review(Arrays.asList(bill("BANKA", "me", 4400L, 160L), bill("BANKA", "me", 4400L, 175L)));
        Harness.check("a newer reminder of a chain is a new question: an answer given before it does not silence it", !alone.get(0).obligationKey.equals(later.get(0).obligationKey));
        List<ReviewRules.Item> earlierSealed = review(Arrays.asList(bill("BANKA", "me", 4400L, 140L), bill("BANKA", "me", 4400L, 160L)));
        Harness.equal("an earlier reminder sealed later does not change the question about the newest", alone.get(0).obligationKey, earlierSealed.get(0).obligationKey);
        List<ReviewRules.Item> pairs = review(Arrays.asList(bill("BANKA", "me", 4400L, 150L), bill("BANKA", "me", 4400L, 170L), moved("BANKA", "out", 4400L, 175L), moved("BANKA", "out", 4400L, 176L)));
        Harness.check("one chain, two payments matched to its two reminders: two candidates, each keyed by its own payment, both about the chain's newest reminder",
            pairs.size() == 2 && !pairs.get(0).paymentKey.equals(pairs.get(1).paymentKey) && pairs.get(0).obligationKey.equals(pairs.get(1).obligationKey)
            && pairs.get(0).paymentKey.equals(KEYER.key("cand:pay:" + pairs.get(0).closer.id)) && pairs.get(1).paymentKey.equals(KEYER.key("cand:pay:" + pairs.get(1).closer.id))
            && pairs.get(0).obligationKey.equals(KEYER.key("cand:ob:" + pairs.get(0).last.id)));   // payments 175 and 176 both come after the newest reminder (170)
        List<ReviewRules.Item> single = review(Arrays.asList(bill("BANKA", "me", 4400L, 150L), moved("BANKA", "out", 4400L, 175L)));
        ReviewRules.Item sameQuestion = null;
        for (ReviewRules.Item i : pairs) if (i.paymentKey.equals(single.get(0).paymentKey)) sameQuestion = i;
        Harness.check("a question is identified by its payment, so a reminder added to the chain does not change a question already answered",
            single.size() == 1 && sameQuestion != null && ReviewFacts.pairKey(single.get(0).obligationKey, single.get(0).paymentKey).equals(ReviewFacts.pairKey(sameQuestion.obligationKey, sameQuestion.paymentKey)));
        ReviewFacts.Judged oneRefused = new ReviewFacts.Judged();
        oneRefused.refused.add(ReviewFacts.pairKey(pairs.get(0).obligationKey, pairs.get(0).paymentKey));
        List<ReviewRules.Item> remaining = review(Arrays.asList(bill("BANKA", "me", 4400L, 150L), bill("BANKA", "me", 4400L, 170L), moved("BANKA", "out", 4400L, 175L), moved("BANKA", "out", 4400L, 176L)), oneRefused);
        Harness.check("refusing one payment of an obligation leaves its other payment to be asked about", remaining.size() == 1 && remaining.get(0).paymentKey.equals(pairs.get(1).paymentKey));
        ReviewFacts.Judged onePaid = new ReviewFacts.Judged();
        onePaid.settled.add(pairs.get(0).obligationKey);
        onePaid.paidPairs.add(ReviewFacts.pairKey(pairs.get(0).obligationKey, pairs.get(0).paymentKey));
        List<ReviewRules.Item> chainLeft = review(Arrays.asList(bill("BANKA", "me", 4400L, 150L), bill("BANKA", "me", 4400L, 170L), moved("BANKA", "out", 4400L, 175L), moved("BANKA", "out", 4400L, 176L)), onePaid);
        Harness.check("in a chain of reminders, marking one payment paid does not hide the question about the next, and the settled chain is not offered as open too",
            chainLeft.size() == 1 && ReviewFacts.CANDIDATE.equals(chainLeft.get(0).kind) && chainLeft.get(0).paymentKey.equals(pairs.get(1).paymentKey));
        // The reviewer's finding: the window of a chain starts at its first reminder, and currency is part of what a movement is.
        List<ReviewRules.Item> chain = review(Arrays.asList(bill("BANKA", "me", 8800L, 140L), bill("BANKA", "me", 8800L, 180L), moved("OTHER", "out", 8800L, 145L)));
        Harness.check("a movement between the reminders of a chain, from a source nothing matched, is inside its window: a missed correlation", chain.size() == 1 && chain.get(0).missed);
        Observation usd = Observation.of(Observation.VALUE_MOVED).source("sms.sender", "OTHER", Observation.T0).times(195L * DAY, 195L * DAY).direction("out").object(Observation.MONEY, 50000L, "USD").build();
        Harness.check("the same amount in another currency is not a miss", !review(Arrays.asList(bill("BANKA", "me", 50000L, 190L), usd)).get(0).missed);
        Observation request = Observation.of(Observation.REQUEST_RECEIVED).source("sms.sender", "UPIAPP", Observation.T0).times(190L * DAY, 190L * DAY).bearer("them").object(Observation.MONEY, 3300L, "INR").build();
        List<ReviewRules.Item> asked = review(Arrays.asList(request, moved("UPIAPP", "out", 3300L, 192L)));
        Harness.check("a payment request is always of the person, whatever its bearer says: the question is about paying", asked.size() == 1 && LoopRules.ME.equals(asked.get(0).owner) && "Looks like this was paid".equals(ReviewRules.question(asked.get(0))));
        List<ReviewRules.Item> openLine = review(Arrays.asList(bill("BANKA", "me", 5000L, 190L)));
        Harness.check("an open obligation's line is the bill alone, with no payment in it", ReviewRules.line(openLine.get(0), UTC).contains("BANKA: a bill of \u20b950.00") && !ReviewRules.line(openLine.get(0), UTC).contains("payment"));
        List<ReviewRules.Item> arrived = review(Arrays.asList(bill("SHOP", "them", 120000L, 190L), moved("SHOP", "in", 120000L, 192L)));
        Harness.check("money owed to the person reads as owed to them and as money that came", ReviewRules.line(arrived.get(0), UTC).contains("SHOP: something owed to you, \u20b91,200.00") && ReviewRules.line(arrived.get(0), UTC).contains("money of \u20b91,200.00 on"));
        List<Observation> ties = new ArrayList<>(Arrays.asList(bill("BANKE", "me", 6100L, 150L), moved("BANKE", "out", 6100L, 152L), bill("BANKF", "me", 6200L, 150L), moved("BANKF", "out", 6200L, 152L),
            bill("BANKG", "me", 6300L, 190L), bill("BANKH", "me", 6400L, 190L)));
        String tieWant = keysOf(review(ties));
        boolean tieSame = true;
        for (int seed = 0; seed < 25; seed++) {
            List<Observation> shuffled = new ArrayList<>(ties);
            Collections.shuffle(shuffled, new Random(100 + seed));
            tieSame &= keysOf(review(shuffled)).equals(tieWant);
        }
        Harness.check("payments at the same moment, and bills on the same day, are put in the same order whatever order the facts come in", tieSame);
        Correlator.Result twoClusters = Correlator.run(both);
        Harness.equal("two bills far apart are two obligations of one reminder each", twoClusters.list.size() + "|" + twoClusters.list.get(0).openers.size() + "|" + twoClusters.list.get(1).openers.size(), "2|1|1");

        // Money owed to the person is judged as having arrived, and has no open list.
        List<ReviewRules.Item> owed = review(Arrays.asList(bill("SHOP", "them", 120000L, 190L), moved("SHOP", "in", 120000L, 192L)));
        Harness.equal("money owed to the person is asked about as having arrived", owed.size() + "|" + ReviewRules.question(owed.get(0)) + "|" + ReviewRules.yes(owed.get(0)), "1|Looks like this arrived|Mark arrived");
        Harness.check("and nothing owed to the person is offered Already paid", review(Arrays.asList(bill("SHOP", "them", 120000L, 190L))).isEmpty());

        // Missed correlations.
        List<ReviewRules.Item> m1 = review(Arrays.asList(bill("BANKA", "me", 50000L, 190L), moved("OTHER", "out", 50000L, 195L)));
        Harness.check("a movement of that amount in the window from a source nothing matched is a missed correlation", count(m1, ReviewFacts.OPEN) == 1 && m1.get(0).missed);
        Harness.check("nothing of that amount moved: not missed", !review(Arrays.asList(bill("BANKA", "me", 50000L, 190L))).get(0).missed);
        Harness.check("a movement of another amount, the other way, or outside the window is not a miss",
            !review(Arrays.asList(bill("BANKA", "me", 50000L, 190L), moved("OTHER", "out", 50001L, 195L))).get(0).missed
            && !review(Arrays.asList(bill("BANKA", "me", 50000L, 190L), moved("OTHER", "in", 50000L, 195L))).get(0).missed
            && !review(Arrays.asList(bill("BANKA", "me", 50000L, 190L), moved("OTHER", "out", 50000L, 189L))).get(0).missed
            && !review(Arrays.asList(bill("BANKA", "me", 50000L, 150L), moved("OTHER", "out", 50000L, 196L))).get(0).missed);
        Harness.check("a movement exactly 45 days after the last reminder is inside the window; the 46th day is not",
            review(Arrays.asList(bill("BANKA", "me", 50000L, 150L), moved("OTHER", "out", 50000L, 195L))).size() == 1 && review(Arrays.asList(bill("BANKA", "me", 50000L, 150L), moved("OTHER", "out", 50000L, 195L))).get(0).missed
            && !review(Arrays.asList(bill("BANKA", "me", 50000L, 150L), moved("OTHER", "out", 50000L, 196L))).get(0).missed);
        List<ReviewRules.Item> matched = review(Arrays.asList(bill("SRC1", "me", 100000L, 190L), bill("SRC2", "me", 100000L, 191L), moved("SRC2", "out", 100000L, 193L)));
        ReviewRules.Item src1 = null;
        for (ReviewRules.Item i : matched) if (ReviewFacts.OPEN.equals(i.kind)) src1 = i;
        Harness.check("a movement already matched to another obligation is not a miss for this one", src1 != null && !src1.missed && count(matched, ReviewFacts.CANDIDATE) == 1);
    }

    private static ReviewFacts.Judged otherSettled() {
        ReviewFacts.Judged j = new ReviewFacts.Judged();
        j.settled.add("0123456789abcdef");
        j.refused.add(ReviewFacts.pairKey("0123456789abcdef", "fedcba9876543210"));
        return j;
    }

    private static String keysOf(List<ReviewRules.Item> items) {
        StringBuilder sb = new StringBuilder();
        for (ReviewRules.Item i : items) sb.append(i.kind).append(':').append(i.obligationKey).append(':').append(i.paymentKey).append(':').append(i.missed).append(';');
        return sb.toString();
    }

    private static Journal open(Context[] holder) throws Exception {
        Install.forget();
        Context context = new Context(Files.createTempDirectory("orb-review").toFile());
        holder[0] = context;
        return Journal.open(context, Install.lane(context), Install.id(context));
    }

    private static void answers() throws Exception {
        Harness.suite("review: answers are labels, folded from the journal in any order");
        String ob = "0011223344556677", pay = "8899aabbccddeeff", ob2 = "1111222233334444";
        Map<String, Object> a = ReviewFacts.judged(ob, pay, ReviewFacts.NOT_THIS, ReviewFacts.CANDIDATE, false, "sms.payment.correlation", 1L, 45L);
        Map<String, Object> b = ReviewFacts.judged(ob, "ffeeddccbbaa9988", ReviewFacts.PAID, ReviewFacts.CANDIDATE, false, "sms.payment.correlation", 1L, 45L);
        Map<String, Object> c = ReviewFacts.judged(ob2, "", ReviewFacts.ALREADY_PAID, ReviewFacts.OPEN, true, "", 1L, 45L);
        Context[] h1 = new Context[1], h2 = new Context[1];
        Journal j1 = open(h1);
        j1.append(ReviewFacts.JUDGED, a);
        j1.append(ReviewFacts.JUDGED, b);
        j1.append(ReviewFacts.JUDGED, c);
        Journal j2 = open(h2);
        j2.append(ReviewFacts.JUDGED, c);
        j2.append(ReviewFacts.JUDGED, b);
        j2.append(ReviewFacts.JUDGED, a);
        ReviewFacts.Judged f1 = ReviewFacts.fold(j1.readLines()), f2 = ReviewFacts.fold(j2.readLines());
        Harness.equal("the answers, folded, are the same whatever order they were given in", f1.settled + "|" + f1.refused + "|" + f1.paidPairs + "|" + f1.paid() + f1.notThis() + f1.alreadyPaid() + f1.missed(),
            f2.settled + "|" + f2.refused + "|" + f2.paidPairs + "|" + f2.paid() + f2.notThis() + f2.alreadyPaid() + f2.missed());
        Harness.equal("paid and already paid settle an obligation; paid and not this each answer a pair; missed is counted only on already paid", f1.settled.size() + "|" + f1.refused.size() + "|" + f1.paid() + "|" + f1.notThis() + "|" + f1.alreadyPaid() + "|" + f1.missed(), "2|1|1|1|1|1");
        Harness.equal("an answer is one event and nothing else is written", count(j1, ReviewFacts.JUDGED) + "|" + j1.readLines().size(), "3|" + (3 + countOthers(j1)));
        Harness.check("an event of another type, or a payload with no obligation, is not an answer", ReviewFacts.fold(Arrays.asList()).settled.isEmpty());
        Context[] h3 = new Context[1];
        Journal j3 = open(h3);
        j3.append("orb.something.else", ReviewFacts.judged(ob, pay, ReviewFacts.PAID, ReviewFacts.CANDIDATE, false, "", 1L, 45L));
        Harness.check("a record of another kind that happens to carry the same fields is not an answer", ReviewFacts.fold(j3.readLines()).settled.isEmpty() && ReviewFacts.fold(j3.readLines()).paid() == 0);
        j3.append(ReviewFacts.JUDGED, ReviewFacts.judged(ob2, "", ReviewFacts.ALREADY_PAID, ReviewFacts.OPEN, false, "", 1L, 45L));
        Harness.equal("an already-paid answer that missed nothing counts as already paid and not as missed", ReviewFacts.fold(j3.readLines()).alreadyPaid() + "|" + ReviewFacts.fold(j3.readLines()).missed(), "1|0");
    }

    private static void roundTrip() throws Exception {
        Harness.suite("review: an answer, recorded and read back, changes the review and nothing else");
        List<Observation> facts = Arrays.asList(bill("BANKA", "me", 7000L, 150L), bill("BANKA", "me", 7000L, 200L), moved("BANKA", "out", 7000L, 152L), moved("BANKA", "out", 7000L, 202L),
            bill("BANKB", "me", 9100L, 190L), moved("OTHER", "out", 9100L, 195L));
        Context[] holder = new Context[1];
        Journal journal = open(holder);
        Context context = holder[0];
        Commitments.open(context, journal, null, "Send the GST certificate", "owe", "2026-10-02", null);
        Commitments.open(context, journal, null, "Invoice from Arun", "waiting", "2026-10-20", null);
        List<Commitments.Commitment> before = Commitments.all(context, journal);
        List<String> linesBefore = journal.readLines();
        ReviewFacts.Judged none = ReviewFacts.fold(linesBefore);
        List<ReviewRules.Item> items = review(facts, none);
        ReviewRules.Item candidate = null, open = null;
        for (ReviewRules.Item i : items) { if (candidate == null && i.closer != null) candidate = i; if (i.closer == null) open = i; }
        Harness.check("two candidates and one open obligation to answer", count(items, ReviewFacts.CANDIDATE) == 2 && count(items, ReviewFacts.OPEN) == 1 && open.missed);
        Harness.check("Mark paid is recorded", ReviewFacts.record(journal, candidate, ReviewFacts.PAID));
        List<String> after = journal.readLines();
        Harness.check("it added exactly one event, a judged one, at the end, and altered no earlier line", after.size() == linesBefore.size() + 1 && ReviewFacts.JUDGED.equals(Journal.typeOf(after.get(after.size() - 1)))
            && after.subList(0, linesBefore.size()).equals(linesBefore));
        List<Commitments.Commitment> afterCommitments = Commitments.all(context, journal);
        boolean sameCommitments = afterCommitments.size() == before.size();
        for (int i = 0; sameCommitments && i < before.size(); i++) sameCommitments &= before.get(i).eventId.equals(afterCommitments.get(i).eventId) && Commitments.status(before.get(i), "2026-10-05").equals(Commitments.status(afterCommitments.get(i), "2026-10-05"));
        Harness.check("the person's commitments are exactly as they were: an answer changes nothing on Today", sameCommitments);
        ReviewFacts.Judged folded = ReviewFacts.fold(after);
        List<ReviewRules.Item> rebuilt = review(facts, folded);
        Harness.check("read back from the journal alone, the answered pair is gone and nothing else is", rebuilt.size() == items.size() - 1 && count(rebuilt, ReviewFacts.CANDIDATE) == 1 && folded.paid() == 1);
        for (ReviewRules.Item i : rebuilt) Harness.check("the answered question does not return: " + i.kind, !(i.obligationKey.equals(candidate.obligationKey) && i.paymentKey.equals(candidate.paymentKey)));
        Harness.check("Not this on the other candidate is recorded, and that pair is gone while its bill is asked about as open", ReviewFacts.record(journal, rebuilt.get(0), ReviewFacts.NOT_THIS));
        List<ReviewRules.Item> afterRefusal = review(facts, ReviewFacts.fold(journal.readLines()));
        Harness.check("one open obligation became two, and no candidate is left", count(afterRefusal, ReviewFacts.CANDIDATE) == 0 && count(afterRefusal, ReviewFacts.OPEN) == 2);
        ReviewRules.Item missedOne = null;
        for (ReviewRules.Item i : afterRefusal) if (i.missed) missedOne = i;
        Harness.check("Already paid is recorded with the missed correlation it found", missedOne != null && ReviewFacts.record(journal, missedOne, ReviewFacts.ALREADY_PAID));
        ReviewFacts.Judged end = ReviewFacts.fold(journal.readLines());
        Harness.equal("three answers, one of each, one missed", end.paid() + "|" + end.notThis() + "|" + end.alreadyPaid() + "|" + end.missed(), "1|1|1|1");
        Harness.equal("and still only the three events were added to the journal", journal.readLines().size(), linesBefore.size() + 3);
        Observation named = Observation.of(Observation.VALUE_MOVED).source("sms.sender", "BANKA", Observation.T0).times(152L * DAY, 152L * DAY).direction("out").object(Observation.MONEY, 7000L, "INR")
            .subject("payment", "", LoopRules.INFERRED, "sms.payment.correlation", 3L).build();
        List<ReviewRules.Item> withRule = review(Arrays.asList(bill("BANKA", "me", 7000L, 150L), named));
        Map<String, Object> carried = ReviewFacts.payloadFor(withRule.get(0), ReviewFacts.PAID);
        Harness.equal("the answer names the rule that proposed the pair and its version, and the window it used", carried.get("ruleId") + "|" + carried.get("ruleVersion") + "|" + carried.get("windowDays"), "sms.payment.correlation|3|" + Correlator.WINDOW_DAYS);
        Map<String, Object> openPayload = ReviewFacts.payloadFor(review(Arrays.asList(bill("BANKA", "me", 50000L, 190L), moved("OTHER", "out", 50000L, 195L))).get(0), ReviewFacts.ALREADY_PAID);
        Harness.equal("an open answer carries the missed correlation it found, and no rule", openPayload.get("missed") + "|" + openPayload.get("ruleId"), "true|");
        Harness.check("a journal that is not there takes no answer", !ReviewFacts.record(null, candidate, ReviewFacts.PAID));
        // A duplicated answer (a restored or doubled journal) is the same answer.
        List<String> doubled = new ArrayList<>(journal.readLines());
        doubled.addAll(journal.readLines().subList(linesBefore.size(), journal.readLines().size()));
        ReviewFacts.Judged twice = ReviewFacts.fold(doubled);
        Harness.equal("the same answers read twice count once", twice.paid() + "|" + twice.notThis() + "|" + twice.alreadyPaid() + "|" + twice.missed(), "1|1|1|1");
        // One label per question, the last one in the journal's order; and a line the writer could not have written is not read.
        String paidLine = null;
        for (String l : journal.readLines()) if (ReviewFacts.JUDGED.equals(Journal.typeOf(l)) && l.contains("\"verdict\":\"paid\"")) paidLine = l;
        Harness.check("there is a recorded paid answer to change", paidLine != null);
        String changedLine = paidLine.replace("\"verdict\":\"paid\"", "\"verdict\":\"notThis\"");
        ReviewFacts.Judged changed = ReviewFacts.fold(Arrays.asList(paidLine, changedLine));
        ReviewFacts.Judged changedBack = ReviewFacts.fold(Arrays.asList(changedLine, paidLine));
        Harness.equal("an answer changed later counts once, as the later one (paid then not this)", changed.paid() + "|" + changed.notThis(), "0|1");
        Harness.equal("and the other way round (not this, then paid)", changedBack.paid() + "|" + changedBack.notThis(), "1|0");
        String doubledKey = paidLine.replace("\"verdict\":\"paid\"", "\"verdict\":\"notThis\",\"verdict\":\"paid\"");
        Harness.check("a payload that names a field twice is not an answer the writer could have written, and is not read", !doubledKey.equals(paidLine) && ReviewFacts.fold(Arrays.asList(doubledKey)).paid() == 0);

        // Only what was kept, and only what is not quiet.
        Context[] h2 = new Context[1];
        Journal j2 = open(h2);
        List<Observation> two = Arrays.asList(bill("BANKA", "me", 7000L, 150L), moved("BANKA", "out", 7000L, 152L), bill("BANKB", "me", 8000L, 150L), moved("BANKB", "out", 8000L, 152L));
        ObservationStore.keepAll(h2[0], j2, SenderRules.NONE, two, UTC, "1970-06");
        List<ReviewRules.Item> keptAll = review(ObservationStore.load(h2[0], j2, SenderRules.NONE));
        final java.util.Set<String> quietIds = new java.util.HashSet<>(Arrays.asList("BANKB"));
        List<ReviewRules.Item> keptQuiet = review(ObservationStore.load(h2[0], j2, new SenderRules.Quiet() { @Override public boolean quiet(String id) { return quietIds.contains(id); } }));
        Harness.check("the review is built from the kept facts, and a quiet service's facts are left out of it", keptAll.size() == 2 && keptQuiet.size() == 1 && "BANKA".equals(keptQuiet.get(0).opener.sourceId));
    }

    private static int countOthers(Journal j) throws Exception {
        int n = 0;
        for (String l : j.readLines()) if (!ReviewFacts.JUDGED.equals(Journal.typeOf(l))) n++;
        return n;
    }

    private static int count(Journal j, String type) throws Exception {
        int n = 0;
        for (String l : j.readLines()) if (type.equals(Journal.typeOf(l))) n++;
        return n;
    }

    private static boolean throwsOn(Runnable r) {
        try {
            r.run();
            return false;
        } catch (IllegalArgumentException refused) {
            return true;
        }
    }

    private static void event() {
        Harness.suite("review: what an answer may hold");
        Map<String, Object> e = ReviewFacts.judged("0011223344556677", "8899aabbccddeeff", ReviewFacts.PAID, ReviewFacts.CANDIDATE, false, "sms.payment.correlation", 1L, 45L);
        Harness.equal("the judged event holds only blinded keys, enums and counts", new java.util.TreeSet<>(e.keySet()).toString(), "[missed, obligation, payment, ruleId, ruleVersion, schema, shown, verdict, windowDays]");
        String canon = Json.canonical(e);
        Harness.check("no amount, sender, day or word is in it", !canon.contains("BANK") && !canon.contains("100000") && !canon.contains("INR") && canon.contains("\"verdict\":\"paid\"") && canon.contains(ReviewFacts.SCHEMA));
        Harness.check("a rule is named by a short lower-case dotted name, never by free text",
            throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "8899aabbccddeeff", ReviewFacts.PAID, ReviewFacts.CANDIDATE, false, "HDFC Bank paid \u20b91,000", 1L, 45L); } })
            && throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "8899aabbccddeeff", ReviewFacts.PAID, ReviewFacts.CANDIDATE, false, null, 1L, 45L); } })
            && !throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "8899aabbccddeeff", ReviewFacts.PAID, ReviewFacts.CANDIDATE, false, "", 1L, 45L); } }));
        Harness.check("an open answer carries no payment key at all", !ReviewFacts.judged("0011223344556677", "", ReviewFacts.ALREADY_PAID, ReviewFacts.OPEN, false, "", 1L, 45L).containsKey("payment"));
        Harness.check("a key that is not a blinded key is refused: nothing is recorded by name",
            throwsOn(new Runnable() { public void run() { ReviewFacts.judged("BANKA", "8899aabbccddeeff", ReviewFacts.PAID, ReviewFacts.CANDIDATE, false, "", 1L, 45L); } })
            && throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "100000", ReviewFacts.PAID, ReviewFacts.CANDIDATE, false, "", 1L, 45L); } }));
        Harness.check("a verdict must fit what was shown: paid and not this answer a candidate, already paid answers an open obligation",
            throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "8899aabbccddeeff", ReviewFacts.ALREADY_PAID, ReviewFacts.CANDIDATE, false, "", 1L, 45L); } })
            && throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "", ReviewFacts.PAID, ReviewFacts.OPEN, false, "", 1L, 45L); } })
            && throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "", "closed", ReviewFacts.OPEN, false, "", 1L, 45L); } }));
        Harness.check("only an answer of already paid can have missed a payment; an open obligation has no payment; what was shown is named",
            throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "8899aabbccddeeff", ReviewFacts.PAID, ReviewFacts.CANDIDATE, true, "", 1L, 45L); } })
            && throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "8899aabbccddeeff", ReviewFacts.ALREADY_PAID, ReviewFacts.OPEN, false, "", 1L, 45L); } })
            && throwsOn(new Runnable() { public void run() { ReviewFacts.judged("0011223344556677", "", ReviewFacts.ALREADY_PAID, "elsewhere", false, "", 1L, 45L); } }));
    }

    private static void precision() {
        Harness.suite("review: the precision is reported, never decided on");
        Harness.equal("below 20 answers it says so", ReviewFacts.precisionLine(10, 9), "Precision: insufficient sample (19 of 20 answers).");
        Harness.equal("from 20 it is reported, as a percentage of the answers", ReviewFacts.precisionLine(15, 5), "Precision: 75% of 20 answers (paid \u00f7 paid + not this).");
        Harness.equal("and it rounds to a whole percent", ReviewFacts.precisionLine(12, 9) + "|" + ReviewFacts.precisionLine(13, 8) + "|" + ReviewFacts.precisionLine(1, 19), "Precision: 57% of 21 answers (paid \u00f7 paid + not this).|Precision: 62% of 21 answers (paid \u00f7 paid + not this).|Precision: 5% of 20 answers (paid \u00f7 paid + not this).");
        Harness.equal("no answers at all is an insufficient sample, not a division by zero", ReviewFacts.precisionLine(0, 0), "Precision: insufficient sample (0 of 20 answers).");
        Harness.equal("a missed correlation is counted among the already-paid answers", ReviewFacts.missedLine(4, 1), "Missed correlations: 1 of 4 \u201calready paid\u201d answers.");
    }

    private static String read(String name) throws Exception {
        Path root = Paths.get(System.getProperty("orb.root", "."));
        return new String(Files.readAllBytes(root.resolve("src/" + name + ".java.in")), StandardCharsets.UTF_8);
    }

    private static String code(String source) {
        return source.replaceAll("(?s)/\\*.*?\\*/", " ").replaceAll("(?m)//.*$", "");
    }

    private static int occurrences(String haystack, String needle) {
        int n = 0;
        for (int i = haystack.indexOf(needle); i >= 0; i = haystack.indexOf(needle, i + 1)) n++;
        return n;
    }

    private static void guards() throws Exception {
        Harness.suite("review: what the review may read, write and do \u2014 held by the source");
        String rules = code(read("ReviewRules")), facts = code(read("ReviewFacts")), screen = code(read("ReviewActivity"));
        Harness.check("the review opens, closes and changes nothing: it names no loop, commitment, ledger writer or journal append outside the one answer",
            !rules.contains("append(") && occurrences(facts, "journal.append(JUDGED") == 1 && occurrences(facts, "journal.append(") == 1 && !screen.contains("append(") && !screen.contains("LoopFacts") && !screen.contains("Commitments") && !screen.contains("CommitmentFacts") && !screen.contains("LoopRules.CLOSED") && !rules.contains("Journal"));
        Harness.equal("the screen writes exactly one kind of event, in one place", occurrences(screen, "append(") + "|" + occurrences(screen, "ReviewFacts.record(") + "|" + occurrences(facts, "static boolean record("), "0|1|1");
        Harness.check("the precision is read by the screen and by nothing that decides", occurrences(screen, "ReviewFacts.precisionLine(") == 1);
        int elsewhere = 0;
        Path root = Paths.get(System.getProperty("orb.root", "."));
        try (java.util.stream.Stream<Path> files = Files.list(root.resolve("src"))) {
            for (Path file : (Iterable<Path>) files::iterator) {
                String name = file.getFileName().toString();
                if (!name.endsWith(".java.in") || name.startsWith("ReviewActivity") || name.startsWith("ReviewFacts")) continue;
                String text = code(new String(Files.readAllBytes(file), StandardCharsets.UTF_8));
                elsewhere += occurrences(text, "precisionLine(") + occurrences(text, "ReviewFacts.fold(");
            }
        }
        Harness.equal("nothing else reads the answers or the precision: the review's rules take what was answered as an argument and never look", elsewhere, 0);
        Harness.check("the rules are pure: no storage, clock, Android or pattern", !rules.contains("Context") && !rules.contains("currentTimeMillis") && !rules.contains("import android") && !rules.contains("Pattern"));
        Harness.check("the screen is secure like Recall, reads only the kept facts through the person's marks, and says so when nothing is kept",
            screen.contains("FLAG_SECURE") && screen.contains("ObservationStore.load(") && screen.contains("Senders.quiet(") && !screen.contains("MessagesReader") && screen.contains("Nothing is kept yet"));
        Harness.check("after a tap the screen says it only teaches Orb, only when the answer was recorded; candidates and open bills have their own caps",
            screen.replaceAll("\\s+", " ").contains("noted = ok ? \"Noted. This only teaches Orb") && screen.contains("SHOWN_CANDIDATES = 40") && screen.contains("SHOWN_OPEN = 25") && screen.contains("a bill you said was not matched to a payment comes back here"));
        Harness.check("it is reached from Money moved, and declared not exported", code(read("LedgerActivity")).contains("ReviewActivity.class")
            && new String(Files.readAllBytes(root.resolve("AndroidManifest.xml")), StandardCharsets.UTF_8).replaceAll("(?s)<!--.*?-->", "").matches("(?s).*<activity\\s+android:name=\"\\.ReviewActivity\"\\s+android:exported=\"false\"\\s*/>.*"));
    }
}
