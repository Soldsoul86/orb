package @PKG@;

import android.content.Context;
import java.io.File;
import java.nio.file.Files;
import java.util.Arrays;
import java.util.List;
import java.util.Map;
import java.util.Set;

/** The five checks, the allow-list, and the records — pure logic, no screen. */
final class AssistTest {
    private AssistTest() {}

    private static AssistPolicy.Input good() {
        AssistPolicy.Input in = new AssistPolicy.Input();
        in.structureArrived = true;
        in.packageName = "com.example.chat";
        in.allowed = true;
        in.screenshotArrived = true;
        in.blockedNodes = 0;
        in.uniform = false;
        in.textChars = 120;
        return in;
    }

    static void run() throws Exception {
        Harness.suite("the five checks, in order");
        Harness.equal("everything arrived, allowed, unprotected, with text: keep", AssistPolicy.decide(good()), AssistPolicy.KEEP);

        AssistPolicy.Input in = good(); in.structureArrived = false;
        Harness.equal("1 — no structure (text switch off)", AssistPolicy.decide(in), AssistPolicy.NO_STRUCTURE);

        in = good(); in.allowed = false;
        Harness.equal("2 — not allowed", AssistPolicy.decide(in), AssistPolicy.NOT_ALLOWED);

        in = good(); in.packageName = null;
        Harness.equal("2 — an app that cannot be named is not allowed", AssistPolicy.decide(in), AssistPolicy.NOT_ALLOWED);

        in = good(); in.screenshotArrived = false;
        Harness.equal("3 — no screenshot is *cannot check*, not fine", AssistPolicy.decide(in), AssistPolicy.NO_SCREENSHOT);

        in = good(); in.blockedNodes = 1;
        Harness.equal("4 — structure blocked by the app", AssistPolicy.decide(in), AssistPolicy.PROTECTED_SCREEN);
        in = good(); in.uniform = true;
        Harness.equal("4 — a uniform screenshot (FLAG_SECURE-style)", AssistPolicy.decide(in), AssistPolicy.PROTECTED_SCREEN);

        in = good(); in.textChars = 0;
        Harness.equal("5 — nothing to keep", AssistPolicy.decide(in), AssistPolicy.NO_TEXT);

        Harness.suite("a login screen keeps nothing at all");
        in = good(); in.passwordFields = 1;
        Harness.equal("a password field on the screen: nothing is kept", AssistPolicy.decide(in), AssistPolicy.LOGIN_SCREEN);
        in = good(); in.passwordFields = 1; in.screenshotArrived = false;
        Harness.equal("and without waiting for the screenshot", AssistPolicy.decide(in), AssistPolicy.LOGIN_SCREEN);
        in = good(); in.passwordFields = 1; in.allowed = false;
        Harness.equal("an app that is not allowed is still declined as that first", AssistPolicy.decide(in), AssistPolicy.NOT_ALLOWED);
        in = good(); in.passwordFields = 1; in.structureArrived = false;
        Harness.equal("and structure first of all", AssistPolicy.decide(in), AssistPolicy.NO_STRUCTURE);
        Harness.check("loginScreen is a reason a decline may carry", AssistPolicy.REASONS.contains(AssistPolicy.LOGIN_SCREEN));

        Harness.suite("the order is part of the privacy");
        in = good(); in.structureArrived = false; in.allowed = false;
        Harness.equal("structure is checked first", AssistPolicy.decide(in), AssistPolicy.NO_STRUCTURE);
        in = good(); in.allowed = false; in.screenshotArrived = false; in.blockedNodes = 3; in.textChars = 0;
        Harness.equal("an app that is not allowed is declined as that and nothing about its screen counts",
            AssistPolicy.decide(in), AssistPolicy.NOT_ALLOWED);

        Harness.suite("the payments floor");
        in = good(); in.packageName = "com.google.android.apps.nbu.paisa.user"; in.allowed = true;
        Harness.equal("a payments app is refused even if the list says allowed", AssistPolicy.decide(in), AssistPolicy.NOT_ALLOWED);
        Harness.check("the observed payments app is on the floor", AssistPolicy.isFloor("com.google.android.apps.nbu.paisa.user"));
        Harness.check("so is the observed exchange", AssistPolicy.isFloor("com.coindcx.btc"));
        Harness.check("an ordinary app is not", !AssistPolicy.isFloor("com.whatsapp"));
        Harness.check("null is not", !AssistPolicy.isFloor(null));

        Harness.suite("password fields are recognised by input type");
        Harness.check("text password", AssistPolicy.isPasswordInput(0x81));
        Harness.check("visible password", AssistPolicy.isPasswordInput(0x91));
        Harness.check("web password", AssistPolicy.isPasswordInput(0xe1));
        Harness.check("numeric password", AssistPolicy.isPasswordInput(0x12));
        Harness.check("plain text is not", !AssistPolicy.isPasswordInput(0x01));
        Harness.check("a plain number is not", !AssistPolicy.isPasswordInput(0x02));
        Harness.check("no input type is not", !AssistPolicy.isPasswordInput(0));

        Harness.suite("a password field is recognised by what it says it is, not by its input type alone");
        Harness.check("autofill hint: password", AssistPolicy.isPasswordField(0, new String[] {"password"}, null));
        Harness.check("autofill hint: current-password (what a web page sends)", AssistPolicy.isPasswordField(0, new String[] {"username", "current-password"}, null));
        Harness.check("autofill hint: new-password", AssistPolicy.isPasswordField(0, new String[] {"new-password"}, null));
        Harness.check("html type password", AssistPolicy.isPasswordField(0, null, "password"));
        Harness.check("html type, any case and padding", AssistPolicy.isPasswordField(0, null, "  Password "));
        Harness.check("input type still counts", AssistPolicy.isPasswordField(0x81, null, null));
        Harness.check("a username field is not a password field", !AssistPolicy.isPasswordField(0, new String[] {"username"}, "text"));
        Harness.check("an ordinary field is not", !AssistPolicy.isPasswordField(0x01, null, null));
        Harness.check("nothing known is not", !AssistPolicy.isPasswordField(0, null, null));
        Harness.check("a null hint in the list is tolerated", !AssistPolicy.isPasswordField(0, new String[] {null}, null));

        Harness.suite("the allow-list is what the events add up to");
        File dir = Files.createTempDirectory("orb-allow").toFile();
        Context context = new Context(dir);
        Journal journal = Journal.open(context, Install.lane(context), Install.id(context));
        Harness.equal("a fresh install allows nothing", AllowList.allowed(journal.readLines()).size(), 0);

        journal.append(AllowList.ALLOWED, AssistFacts.grant("com.whatsapp"));
        journal.append(AllowList.ALLOWED, AssistFacts.grant("com.example.chat"));
        Set<String> two = AllowList.allowed(journal.readLines());
        Harness.equal("two allowed", two.size(), 2);
        journal.append(AllowList.DISALLOWED, AssistFacts.revoke("com.whatsapp"));
        Harness.check("latest wins: revoked", !AllowList.isAllowed(journal.readLines(), "com.whatsapp"));
        journal.append(AllowList.ALLOWED, AssistFacts.grant("com.whatsapp"));
        Harness.check("and allowed again", AllowList.isAllowed(journal.readLines(), "com.whatsapp"));

        journal.append(AllowList.ALLOWED, AssistFacts.grant("com.phonepe.app"));
        Harness.check("a payments package written into history is still never allowed",
            !AllowList.isAllowed(journal.readLines(), "com.phonepe.app"));

        Map<String, Object> sneaky = Json.obj();
        sneaky.put("note", "\"package\":\"com.evil.app\"");
        sneaky.put("by", "operator");
        journal.append(AllowList.ALLOWED, sneaky);
        Harness.check("a package spelled inside a string is not a package",
            !AllowList.isAllowed(journal.readLines(), "com.evil.app"));
        journal.append("orb.shared", AssistFacts.grant("com.not.a.grant"));
        Harness.check("only the two assist types count", !AllowList.isAllowed(journal.readLines(), "com.not.a.grant"));
        Harness.check("a malformed name is refused", !AllowList.isPackageName("not a package") && !AllowList.isPackageName("a;b.c"));

        Harness.suite("a decline cannot name the app");
        Map<String, Object> declined = AssistFacts.declined(AssistPolicy.NOT_ALLOWED, 7L);
        Harness.equal("exactly a reason and a build number", declined.keySet().size(), 2);
        Harness.check("no package key", !declined.containsKey("package"));
        Harness.equal("an unknown reason is not echoed", AssistFacts.declined("com.secret.app", 1L).get("reason"), "invalidReason");
        for (String reason : AssistPolicy.REASONS) {
            Harness.equal("reason " + reason + " is accepted as itself", AssistFacts.declined(reason, 1L).get("reason"), reason);
        }

        Harness.suite("what a capture records in the clear");
        String id = "sha256:" + "c".repeat(64);
        Map<String, Object> cap = AssistFacts.captured("com.whatsapp", 40L, 605L, false, id, 700L, "stored", 7L, 2L);
        for (Object value : cap.values()) {
            Harness.check("every value is a number, a boolean or a short word",
                value instanceof Long || value instanceof Boolean || value instanceof String);
        }
        Harness.equal("the sealed identity is carried", cap.get("attachment"), id);
        Harness.equal("an invalid package is not echoed", AssistFacts.captured("not a package", 1L, 1L, false, id, 1L, "stored", 1L, 0L).get("package"), "invalid");
        Harness.equal("an invalid identity is not echoed", AssistFacts.captured("com.whatsapp", 1L, 1L, false, "free text", 1L, "stored", 1L, 0L).get("attachment"), "invalid");
        Harness.equal("an unknown outcome is not echoed", AssistFacts.captured("com.whatsapp", 1L, 1L, false, id, 1L, "my secret", 1L, 0L).get("resolveOutcome"), "other");
        Harness.equal("the count of left-out password fields is recorded", cap.get("passwordFields"), 2L);
        Harness.check("no field is able to carry the text", !cap.containsKey("text") && !cap.containsKey("body") && !cap.containsKey("uri"));
    }
}
