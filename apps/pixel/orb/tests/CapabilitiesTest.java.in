package @PKG@;

import android.content.Context;
import java.io.File;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.TreeMap;

/**
 * Everything Orb may do or read is declared in one place, frozen, shown honestly, and held to by the source
 * (`docs/GATE_READS_PHONE.md`, DR-22): the pinned words, the state read back from history, and a guard that no read exists that
 * a declaration does not name.
 */
final class CapabilitiesTest {
    private CapabilitiesTest() {}

    private static Map<String, Object> pkg(String type, String capability) {
        Map<String, Object> p = Json.obj();
        p.put("capability", capability);
        p.put("by", "operator");
        return p;
    }

    private static String pin(String says) throws Exception {
        return Attachments.identity(says.getBytes(StandardCharsets.UTF_8));
    }

    static void run() throws Exception {
        Harness.suite("thirteen capabilities, each declared once and frozen");
        Harness.equal("the ids, in the order the screen shows them", Capabilities.ids(),
            Arrays.asList("installedPackages.read", "orb.read.screen", "orb.read.grants", "orb.read.contacts", "orb.read.appsecurity", "orb.read.documents", "orb.read.messages", "orb.messages.senders", "orb.observations.keep", "orb.read.calls", "orb.understand", "orb.brief.daily", "orb.remind.local", "orb.handoff.communicate"));
        Set<String> seen = new HashSet<>();
        for (Capabilities.Declaration d : Capabilities.ALL) {
            Harness.check(d.id + " says, authorizes, records and names its withdrawal",
                !d.says.isEmpty() && !d.authorizedBy.isEmpty() && !d.recordsAs.isEmpty() && !d.withdrawnBy.isEmpty() && !d.title.isEmpty() && d.version >= 1L);
            Harness.check(d.id + " has one of the two tiers and is unique", (d.tier.equals(Capabilities.TIER_OBSERVE) || d.tier.equals(Capabilities.TIER_ACT_REVERSIBLE)) && seen.add(d.id));
        }
        Harness.check("the contacts read is Observe and switchable", Capabilities.byId(Capabilities.CONTACTS).tier.equals("Observe") && Capabilities.byId(Capabilities.CONTACTS).switchable);
        Harness.check("the reads are Observe and the reminder is Act (reversible)",
            Capabilities.byId(Capabilities.PACKAGES).tier.equals("Observe") && Capabilities.byId(Capabilities.SCREEN).tier.equals("Observe")
            && Capabilities.byId(Capabilities.GRANTS).tier.equals("Observe") && Capabilities.byId(Reminders.CAPABILITY).tier.equals("Act (reversible)"));
        Harness.check("the grants watch is the one that is not switchable", !Capabilities.byId(Capabilities.GRANTS).switchable
            && Capabilities.byId(Capabilities.PACKAGES).switchable && Capabilities.byId(Capabilities.SCREEN).switchable);
        Harness.equal("the package read's words are pinned: a change is a new capability", pin(Capabilities.PACKAGES_SAYS), "sha256:81e866d255902abc14864b5d10905fbfee8c7f03266582fd08b24fd467bbeb0c");
        Harness.equal("the screen read's words are pinned", pin(Capabilities.SCREEN_SAYS), "sha256:84f03c9fe03e2e86998ed1897d0694873086acc1dd541a499ff54fd7298f9e03");
        Harness.equal("the grants watch's words are pinned", pin(Capabilities.GRANTS_SAYS), "sha256:559ff8b71ce163ff7793114be79012cef725a64909e5cd48ac712d7e3fdeaab2");
        Harness.equal("the contacts read's words are pinned", pin(Capabilities.CONTACTS_SAYS), "sha256:6507721ef30337a1ac574c226ff8cf951e12f2e3f73b0dc7c55cf716aeb9f662");
        Harness.equal("the hand-off's words are pinned", pin(Handoff.DECLARATION), "sha256:71147d7bdb68426103d6e49d251b4e387902dcb46e2578ee2ccaaf49432e13a5");
        Harness.check("the hand-off is Act (reversible), switchable, and says it sends nothing and keeps no number",
            Capabilities.byId(Handoff.CAPABILITY).tier.equals("Act (reversible)") && Capabilities.byId(Handoff.CAPABILITY).switchable
            && Handoff.DECLARATION.contains("Orb sends nothing, calls no one and reads nothing") && Handoff.DECLARATION.contains("never the number or the words") && Handoff.DECLARATION.contains("whether a draft was used"));
        Harness.equal("the safety check's words are pinned", pin(Capabilities.APPSEC_SAYS), "sha256:474082bc372eaab851b44f88a19fe3347c9f1d778dfa3397e071a3a56c73515e");
        Harness.check("the safety check is Observe and switchable, and says only counts are kept and nothing leaves the phone",
            Capabilities.byId(Capabilities.APPSEC).tier.equals("Observe") && Capabilities.byId(Capabilities.APPSEC).switchable
            && Capabilities.APPSEC_SAYS.contains("Only counts are kept; nothing leaves the phone"));
        Harness.equal("the documents source's words are pinned", pin(Capabilities.DOCUMENTS_SAYS), "sha256:407dcd959b9e6ea9716d78c931c756fb349c7b68791ef8443c7eba806a0b0c76");
        Harness.check("the documents source is Observe and switchable, and says it keeps only what you tick and records only counts",
            Capabilities.byId(Capabilities.DOCUMENTS).tier.equals("Observe") && Capabilities.byId(Capabilities.DOCUMENTS).switchable
            && Capabilities.DOCUMENTS_SAYS.contains("only when you tap Look now") && Capabilities.DOCUMENTS_SAYS.contains("Nothing is kept unless you tick it; only counts are recorded"));
        Harness.equal("keeping facts: its words are pinned", pin(Capabilities.OBS_KEEP_SAYS), "sha256:13b02d16b1184beefa61fa2709287459b7fdf2d6e0c0c11220827ed69056d096");
        Harness.equal("the call history's words are pinned", pin(Capabilities.CALLS_SAYS), "sha256:aae241a0f41bc9aee8883b3e20f7df6f5bd51cf6c4cfd6a6b6e78b12b4d193cd");
        Harness.check("the call history is Observe and switchable, says phone and a page being open, and that nothing is kept",
            Capabilities.byId(Capabilities.CALLS).tier.equals("Observe") && Capabilities.byId(Capabilities.CALLS).switchable
            && Capabilities.CALLS_SAYS.contains("only while a person's page is open") && Capabilities.CALLS_SAYS.contains("Nothing is kept; only how many calls were looked at is recorded"));
        Harness.equal("what Orb has noticed: its words are pinned", pin(Capabilities.UNDERSTAND_SAYS), "sha256:45955615d1c0be960c5e8ff85dd16c8db2d7956976278818091328e217d00f02");
        Harness.check("the contacts read says it is only while People is open and never writes", Capabilities.CONTACTS_SAYS.contains("only while the People screen is open")
            && Capabilities.CONTACTS_SAYS.contains("nothing is written to your contacts"));
        Harness.check("the screen read says it is only when you invoke it and never a login screen",
            Capabilities.SCREEN_SAYS.contains("only when you invoke Orb") && Capabilities.SCREEN_SAYS.contains("never a login screen"));
        Harness.check("the package read says nothing leaves the phone", Capabilities.PACKAGES_SAYS.contains("Nothing leaves the phone"));
        Harness.check("the reminder's declaration is the one `Reminders` freezes", Capabilities.byId(Reminders.CAPABILITY).says.equals(Reminders.DECLARATION));

        Harness.suite("state and last use are read from history, and show no content");
        Install.forget();
        Context context = new Context(Files.createTempDirectory("orb-capabilities").toFile());
        Journal journal = Journal.open(context, Install.lane(context), Install.id(context));
        Capabilities.Status none = Capabilities.status(Capabilities.PACKAGES, journal.readLines());
        Harness.check("a package scan never granted: off, never", none.state.startsWith("OFF") && none.lastAtMs < 0 && none.lastDetail.equals("never"));
        journal.append(PackageGrants.GRANTED, pkg(PackageGrants.GRANTED, "installedPackages.read"));
        Harness.check("granted: on", Capabilities.status(Capabilities.PACKAGES, journal.readLines()).state.startsWith("ON"));
        Map<String, Object> scan = Json.obj();
        scan.put("installedPackageHoldingCount", 153L);
        scan.put("installedPackageReadable", true);
        journal.append("grants.packages", scan);
        Capabilities.Status scanned = Capabilities.status(Capabilities.PACKAGES, journal.readLines());
        Harness.check("a scan: when, and how many — a count, never a name", scanned.lastAtMs > 0 && scanned.lastDetail.equals("153 apps"));
        Map<String, Object> refused = Json.obj();
        refused.put("installedPackageReadable", false);
        journal.append("grants.packages", refused);
        Harness.check("a refused scan says so", Capabilities.status(Capabilities.PACKAGES, journal.readLines()).lastDetail.startsWith("could not read"));
        journal.append(PackageGrants.REVOKED, pkg(PackageGrants.REVOKED, "installedPackages.read"));
        Harness.check("revoked: off", Capabilities.status(Capabilities.PACKAGES, journal.readLines()).state.startsWith("OFF"));

        Harness.check("the screen read with no app allowed: off", Capabilities.status(Capabilities.SCREEN, journal.readLines()).state.startsWith("OFF"));
        journal.append(AllowList.ALLOWED, AssistFacts.grant("com.example.chat"));
        Harness.equal("one app allowed", Capabilities.status(Capabilities.SCREEN, journal.readLines()).state, "ON — 1 app allowed");
        journal.append(AllowList.ALLOWED, AssistFacts.grant("com.example.notes"));
        Harness.equal("two", Capabilities.status(Capabilities.SCREEN, journal.readLines()).state, "ON — 2 apps allowed");
        Harness.check("nothing remembered yet", Capabilities.status(Capabilities.SCREEN, journal.readLines()).lastAtMs < 0);
        ScreenText text = new ScreenText();
        text.add("some words that must not appear in the answer");
        Harness.equal("remember something", Capture.remember(context, journal, text, "com.example.chat", 7L, false).outcome, Capture.STORED);
        Capabilities.Status after = Capabilities.status(Capabilities.SCREEN, journal.readLines());
        Harness.check("last use is a time and no content", after.lastAtMs > 0 && !after.lastDetail.contains("words") && !after.state.contains("example"));

        Harness.check("the contacts read never granted: off, never", Capabilities.status(Capabilities.CONTACTS, journal.readLines()).state.startsWith("OFF")
            && Capabilities.status(Capabilities.CONTACTS, journal.readLines()).lastDetail.equals("never"));
        journal.append(PackageGrants.GRANTED, pkg(PackageGrants.GRANTED, "orb.read.contacts"));
        Harness.check("granted: on — and the package scan's own state is not disturbed", Capabilities.status(Capabilities.CONTACTS, journal.readLines()).state.startsWith("ON")
            && Capabilities.status(Capabilities.PACKAGES, journal.readLines()).state.startsWith("OFF"));
        journal.append(ContactsFacts.READ, ContactsFacts.read(412L, 5L, 30L));
        Capabilities.Status contactsUsed = Capabilities.status(Capabilities.CONTACTS, journal.readLines());
        Harness.check("a use: when, and counts only", contactsUsed.lastAtMs > 0 && contactsUsed.lastDetail.equals("412 contacts looked at, 5 people tied by number or email, 30 only by a name"));
        journal.append(ContactsFacts.READ, ContactsFacts.read(1L, 1L, 0L));
        Harness.equal("one person is said in the singular", Capabilities.status(Capabilities.CONTACTS, journal.readLines()).lastDetail, "1 contact looked at, 1 person tied by number or email, 0 only by a name");
        Map<String, Object> old = Json.obj();
        old.put("capability", "orb.read.contacts");
        old.put("contacts", 3L);
        old.put("people", 2L);
        old.put("version", 1L);
        journal.append(ContactsFacts.READ, old);
        Harness.equal("a record from before the split says none by name, not -1", Capabilities.status(Capabilities.CONTACTS, journal.readLines()).lastDetail, "3 contacts looked at, 2 people tied by number or email, 0 only by a name");
        journal.append(PackageGrants.REVOKED, pkg(PackageGrants.REVOKED, "orb.read.contacts"));
        Harness.check("revoked: off", Capabilities.status(Capabilities.CONTACTS, journal.readLines()).state.startsWith("OFF"));

        Capabilities.Status appsecNever = Capabilities.status(Capabilities.APPSEC, journal.readLines());
        Harness.check("the safety check never granted: off, never run", appsecNever.state.startsWith("OFF") && appsecNever.lastAtMs < 0 && appsecNever.lastDetail.equals("never run"));
        journal.append(PackageGrants.GRANTED, pkg(PackageGrants.GRANTED, "orb.read.appsecurity"));
        Harness.check("granted: on, and the other grants are not disturbed", Capabilities.status(Capabilities.APPSEC, journal.readLines()).state.startsWith("ON")
            && Capabilities.status(Capabilities.CONTACTS, journal.readLines()).state.startsWith("OFF") && Capabilities.status(Capabilities.PACKAGES, journal.readLines()).state.startsWith("OFF"));
        journal.append(SafetyFacts.CHECKED, SafetyFacts.checked(210L, 2L, 5L));
        Capabilities.Status appsecUsed = Capabilities.status(Capabilities.APPSEC, journal.readLines());
        Harness.check("a run: when, and counts only — no app", appsecUsed.lastAtMs > 0 && appsecUsed.lastDetail.equals("210 apps looked at, 2 to look at now, 5 worth a look"));
        journal.append(PackageGrants.REVOKED, pkg(PackageGrants.REVOKED, "orb.read.appsecurity"));
        Harness.check("revoked: off", Capabilities.status(Capabilities.APPSEC, journal.readLines()).state.startsWith("OFF"));

        Capabilities.Status docsNever = Capabilities.status(Capabilities.DOCUMENTS, journal.readLines());
        Harness.check("the documents source never granted: off, never looked", docsNever.state.startsWith("OFF") && docsNever.lastAtMs < 0 && docsNever.lastDetail.equals("never looked"));
        journal.append(PackageGrants.GRANTED, pkg(PackageGrants.GRANTED, "orb.read.documents"));
        Harness.check("granted: on, and the others are not disturbed", Capabilities.status(Capabilities.DOCUMENTS, journal.readLines()).state.startsWith("ON")
            && Capabilities.status(Capabilities.CONTACTS, journal.readLines()).state.startsWith("OFF"));
        journal.append(DocumentsFacts.LOOKED, DocumentsFacts.looked(9L, 2L));
        journal.append(DocumentsFacts.KEPT, DocumentsFacts.kept(3L));
        journal.append(DocumentsFacts.KEPT, DocumentsFacts.kept(1L));
        Capabilities.Status docsUsed = Capabilities.status(Capabilities.DOCUMENTS, journal.readLines());
        Harness.check("a look and keeps: when, the count found, and the total kept", docsUsed.lastAtMs > 0 && docsUsed.lastDetail.equals("9 PDFs found at the last look, 4 kept in all"));
        journal.append(PackageGrants.REVOKED, pkg(PackageGrants.REVOKED, "orb.read.documents"));
        Harness.check("revoked: off", Capabilities.status(Capabilities.DOCUMENTS, journal.readLines()).state.startsWith("OFF"));

        Capabilities.Status callsNever = Capabilities.status(Capabilities.CALLS, journal.readLines());
        Harness.check("the call history never granted: off, never looked", callsNever.state.startsWith("OFF") && callsNever.lastAtMs < 0 && callsNever.lastDetail.equals("never looked"));
        journal.append(PackageGrants.GRANTED, pkg(PackageGrants.GRANTED, "orb.read.calls"));
        journal.append(CallsFacts.READ, CallsFacts.read(1510L, 7L));
        Capabilities.Status callsUsed = Capabilities.status(Capabilities.CALLS, journal.readLines());
        Harness.check("granted and used: on, when, and two counts", callsUsed.state.startsWith("ON") && callsUsed.lastAtMs > 0 && callsUsed.lastDetail.equals("1510 calls examined, 7 with that person, at the last look"));
        journal.append(PackageGrants.REVOKED, pkg(PackageGrants.REVOKED, "orb.read.calls"));
        Harness.check("revoked: off", Capabilities.status(Capabilities.CALLS, journal.readLines()).state.startsWith("OFF"));

        Capabilities.Status handoffNever = Capabilities.status(Handoff.CAPABILITY, journal.readLines());
        Harness.check("the hand-off is on, every tap confirmed, and none opened yet", handoffNever.state.startsWith("ON") && handoffNever.lastAtMs < 0 && handoffNever.lastDetail.equals("none opened yet"));
        journal.append(HandoffFacts.RELEASED, HandoffFacts.released("whatsapp", false));
        Capabilities.Status handoffUsed = Capabilities.status(Handoff.CAPABILITY, journal.readLines());
        Harness.check("a use: when, how many, and that Orb sent nothing — no channel, no number", handoffUsed.lastAtMs > 0 && handoffUsed.lastDetail.equals("1 opened — Orb sent nothing"));
        Handoff.turnOff(journal);
        Harness.check("turned off: off, and the reminders are not touched", Capabilities.status(Handoff.CAPABILITY, journal.readLines()).state.startsWith("OFF") && Reminders.enabled(journal.readLines()));
        Handoff.turnOn(journal);
        Harness.check("turned on again", Capabilities.status(Handoff.CAPABILITY, journal.readLines()).state.startsWith("ON"));

        Capabilities.Status watch = Capabilities.status(Capabilities.GRANTS, journal.readLines());
        Harness.check("the grants watch is always on, and has not yet looked", watch.state.equals("ALWAYS ON") && watch.lastAtMs < 0);
        journal.append("grants.observed", Json.obj());
        Harness.check("after it looks, there is a time", Capabilities.status(Capabilities.GRANTS, journal.readLines()).lastAtMs > 0);

        Harness.check("reminders on, none waiting", Capabilities.status(Reminders.CAPABILITY, journal.readLines()).state.equals("ON — 0 reminders waiting"));
        Remind.turnOff(journal, new RemindersTest.Alarms());
        Harness.check("turned off", Capabilities.status(Reminders.CAPABILITY, journal.readLines()).state.startsWith("OFF"));
        Harness.check("an unknown id says so, not a guess", Capabilities.status("orb.read.nothing", journal.readLines()).state.equals("unknown"));

        guard();
    }

    /** Every read in the source is declared; the reads Orb does not have are not there at all. */
    private static void guard() throws Exception {
        Harness.suite("no read exists that a declaration does not name");
        Path root = Paths.get(System.getProperty("orb.root", "."));
        Map<String, String> source = new TreeMap<>();
        try (java.util.stream.Stream<Path> files = Files.list(root.resolve("src"))) {
            for (Path file : (Iterable<Path>) files::iterator) {
                String name = file.getFileName().toString();
                // The registry itself names the APIs as data; it is not a use of them.
                if (name.endsWith(".java.in") && !name.equals("Capabilities.java.in")) source.put(name.replace(".java.in", ""), code(new String(Files.readAllBytes(file), StandardCharsets.UTF_8)));
            }
        }
        Set<String> declaredFiles = new HashSet<>();
        for (Capabilities.Declaration d : Capabilities.ALL) declaredFiles.addAll(d.files);
        for (String f : declaredFiles) Harness.check(f + " (named by a declaration) exists", source.containsKey(f));
        for (String api : Capabilities.READ_APIS) {
            List<String> users = new ArrayList<>();
            for (Map.Entry<String, String> e : source.entrySet()) if (e.getValue().contains(api)) users.add(e.getKey());
            Harness.check("every file using " + api + " is one a declaration names " + users, declaredFiles.containsAll(users));
        }
        for (String api : Capabilities.UNDECLARED_READS) {
            List<String> users = new ArrayList<>();
            for (Map.Entry<String, String> e : source.entrySet()) if (e.getValue().contains(api)) users.add(e.getKey());
            // `SafetyRules` is a table that *names* permissions to judge (`READ_SMS`…) — it reads nothing: no Android class at all.
            if (users.contains("SafetyRules")) {
                Harness.check("SafetyRules only names " + api + " in its table: it imports no Android class", !source.get("SafetyRules").contains("import android."));
                users.remove("SafetyRules");
            }
            Harness.check(api + " is read nowhere — no capability declares it " + users, users.isEmpty());
        }
        String manifest = new String(Files.readAllBytes(root.resolve("AndroidManifest.xml")), StandardCharsets.UTF_8).replaceAll("(?s)<!--.*?-->", "");
        for (String permission : Arrays.asList("READ_CALENDAR", "ACCESS_FINE_LOCATION", "ACCESS_COARSE_LOCATION", "RECORD_AUDIO", "CAMERA",
                "READ_SMS", "READ_CALL_LOG", "PACKAGE_USAGE_STATS", "READ_EXTERNAL_STORAGE", "READ_MEDIA_IMAGES", "INTERNET")) {
            Harness.check("the manifest asks for no " + permission, !manifest.contains("android.permission." + permission));
        }

        Harness.check("the manifest does ask to read contacts — a declared read — and is held to that alone", manifest.contains("android.permission.READ_CONTACTS"));

        Harness.suite("the package scan refuses unless granted, and nothing else reads the list");
        String watch = source.get("Watch");
        int method = watch.indexOf("Map<String, Object> scanPackages(String because)");
        int granted = watch.indexOf("PackageAccess.granted(context)", method);
        int read = watch.indexOf("GrantReader.readPackages(context)", method);
        Harness.check("the grant is checked before the read", method > 0 && granted > method && read > granted);
        List<String> readers = new ArrayList<>();
        for (Map.Entry<String, String> e : source.entrySet()) if (e.getValue().contains("GrantReader.readPackages(")) readers.add(e.getKey());
        Harness.equal("only the scan calls the package read", readers.toString(), "[Watch]");
        Harness.check("a refused scan is recorded as ungranted, not as an empty set",
            watch.substring(method, read).contains("\"installedPackageReadable\", false") && watch.substring(method, read).contains("\"ungranted\""));
    }

    private static String code(String source) {
        StringBuilder out = new StringBuilder();
        for (String line : source.split("\n")) {
            String t = line.trim();
            if (t.startsWith("*") || t.startsWith("//") || t.startsWith("/*")) continue;
            out.append(line).append('\n');
        }
        return out.toString();
    }
}
