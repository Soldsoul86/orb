package @PKG@;

import android.content.Context;
import java.io.File;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.Map;
import java.util.TreeMap;

/**
 * Everything about a person — who the kept words mention, tied by number, email or name, grouped by who shares a number
 * (`docs/PEOPLE_PHONE.md`, DR-24): computed in memory, never recorded, and read only by the one file that may.
 */
final class PeopleTest {
    private PeopleTest() {}

    private static People.Contact contact(String id, String name, String[] phones, String... emails) {
        People.Contact c = new People.Contact(id, name);
        c.phones.addAll(Arrays.asList(phones));
        c.emails.addAll(Arrays.asList(emails));
        return c;
    }

    private static Map<String, Object> keep(Context context, Journal journal, String text) {
        Map<String, Object> payload = Shares.declaredText("android.intent.action.SEND", "text/plain", "android-app://com.example.notes", text.length());
        Attachments.Stored stored = SharedText.seal(context, text, null);
        return SharedText.record(journal, context, payload, stored, null);
    }

    private static String hashOf(Map<String, Object> event) {
        @SuppressWarnings("unchecked")
        Map<String, Object> integrity = (Map<String, Object>) event.get("integrity");
        return (String) integrity.get("hash");
    }

    private static Map<String, Long> listing(File dir, String prefix) {
        Map<String, Long> out = new TreeMap<>();
        File[] children = dir.listFiles();
        if (children == null) return out;
        for (File child : children) {
            if (child.isDirectory()) out.putAll(listing(child, prefix + child.getName() + "/"));
            else out.put(prefix + child.getName(), child.length());
        }
        return out;
    }

    private static People.Person find(People.Result r, String name) {
        for (People.Person p : r.people) if (p.names.contains(name)) return p;
        return null;
    }

    private static People.Person findPossible(People.Result r, String name) {
        for (People.Person p : r.possible) if (p.names.contains(name)) return p;
        return null;
    }

    static void run() throws Exception {
        Harness.suite("a phone number as the kept words would write it");
        Harness.equal("a local number with a leading zero", People.normalPhone("098765 43210"), "+919876543210");
        Harness.equal("with the country code and a hyphen", People.normalPhone("+91 98765-43210"), "+919876543210");
        Harness.equal("another country's", People.normalPhone("+1 415 555 2671"), "+14155552671");
        Harness.check("a short code cannot be matched, so it is not carried", People.normalPhone("12345") == null);
        Harness.check("nor a missing one", People.normalPhone(null) == null && People.normalPhone("") == null);

        Install.forget();
        File dir = Files.createTempDirectory("orb-people").toFile();
        Context context = new Context(dir);
        Journal journal = Journal.open(context, Install.lane(context), Install.id(context));
        List<People.Contact> book = new ArrayList<>();
        book.add(contact("1", "Ravi Kumar", new String[] {"+919876543210", "+919123456789"}, "ravi@kumar.example"));
        book.add(contact("2", "Ravi Menon", new String[] {"+919000000002"}));
        book.add(contact("3", "R. Kumar (work)", new String[] {"+919876543210"}));
        book.add(contact("4", "Priya Shah", new String[] {"+919000000001"}));
        book.add(contact("5", "Anil", new String[] {}));
        book.add(contact("6", "Will Smith", new String[] {}));
        Map<String, Object> a = keep(context, journal, "Call Ravi Kumar tomorrow");
        keep(context, journal, "number 98765 43210 for the loan");
        keep(context, journal, "second number 91234 56789");
        keep(context, journal, "mail ravi@kumar.example");
        keep(context, journal, "Ravi called");
        keep(context, journal, "Tell Priya that Anil will call");
        keep(context, journal, "Is Will coming");
        keep(context, journal, "Priya said hello. Anil is here");
        keep(context, journal, "pay 90000 00001");
        keep(context, journal, "Ravi Kumar at 98765 43210");
        keep(context, journal, "Ravi Kumar owes ₹1,200");

        Harness.suite("who the kept words mention, and how they were found");
        List<String> linesBefore = journal.readLines();
        Map<String, Long> diskBefore = listing(dir, "");
        People.Result r = People.compute(context, journal, book);
        Harness.equal("contacts looked at", r.contacts, 6);
        Harness.equal("one first name is shared (Ravi)", r.sharedFirstNames, 1);
        List<String> shown = new ArrayList<>();
        for (People.Person p : r.people) shown.add(p.names.get(0) + "x" + p.items.size());
        Harness.equal("those tied by a number or an address: Ravi and Priya — Ravi Menon, mentioned only as 'Ravi', is not listed",
            shown, Arrays.asList("Ravi Kumarx6", "Priya Shahx2"));
        List<String> maybe = new ArrayList<>();
        for (People.Person p : r.possible) maybe.add(p.names.get(0) + "x" + p.items.size());
        Harness.equal("those only a name ties are apart, and a name that starts a sentence is not read", maybe, Arrays.asList("Anilx1", "Will Smithx1"));
        Harness.check("a sure person is never also listed as possible", find(r, "Anil") == null && find(r, "Will Smith") == null && findPossible(r, "Ravi Kumar") == null && findPossible(r, "Priya Shah") == null);
        People.Person ravi = find(r, "Ravi Kumar");
        Harness.equal("contacts that share a number are one person", ravi.names, Arrays.asList("Ravi Kumar", "R. Kumar (work)"));
        Harness.equal("so he is shown once, with the other name counted", ravi.display(), "Ravi Kumar (+1)");
        Harness.equal("and his two numbers are one person's", ravi.phones, Arrays.asList("+919876543210", "+919123456789"));
        Harness.equal("how his items were found: the strongest evidence for each", People.evidenceLine(ravi), "3 by number, 1 by email, 2 by name");
        Harness.equal("an item that has both his number and his name is listed once, by number", ravi.items.size(), 6);
        Harness.check("a first name alone, shared by two contacts, matches neither", find(r, "Ravi Menon") == null);
        People.Person priya = find(r, "Priya Shah");
        Harness.equal("a unique first name inside a sentence, and a number: two items", People.evidenceLine(priya), "1 by number, 1 by name");
        boolean wordShown = false;
        for (People.Evidence e : priya.items) if (People.BY_NAME.equals(e.by) && "Priya".equals(e.word)) wordShown = true;
        Harness.check("a name match carries the word it found, to be labelled as a word", wordShown);
        Harness.equal("the verb 'will' is not Will Smith, the capitalised word is", findPossible(r, "Will Smith").items.size(), 1);
        List<String> beside = new ArrayList<>();
        for (Mentions.Handle h : ravi.alsoWith) beside.add(h.kind);
        Harness.check("what appears with him: the amount, never his own numbers or address", beside.contains("amount") && !beside.contains("phone") && !beside.contains("email"));

        Harness.suite("a person's context at a glance: from their own items, computed");
        People.Glance glance = People.context(ravi);
        Harness.equal("how many items", glance.count, 6);
        Harness.check("oldest and newest kept", glance.first > 0 && glance.last >= glance.first);
        Harness.equal("where from, most first", glance.from, Arrays.asList("com.example.notes \u00d76"));
        Harness.equal("and how many were shared", glance.shared, 6);
        People.Person manyApps = new People.Person();
        String[] apps = {"zz", "zz", "zz", "yy", "yy", "aa", "bb", "cc"};
        for (int i = 0; i < apps.length; i++) manyApps.items.add(new People.Evidence(new Recall.Entry("h" + i, "id" + i, "sha256:x", 1000L + i, apps[i], "words"), People.BY_NUMBER, null));
        Harness.equal("where from: most items first, ties by name, at most " + People.CONTEXT_APPS, People.context(manyApps).from, Arrays.asList("zz \u00d73", "yy \u00d72", "aa \u00d71", "bb \u00d71"));
        People.Glance empty = People.context(new People.Person());
        Harness.check("a person nothing mentions has an empty context", empty.count == 0 && empty.first == 0L && empty.last == 0L && empty.from.isEmpty() && empty.shared == 0);

        Harness.suite("a view: nothing written, nothing in the clear");
        Harness.equal("the journal is unchanged", journal.readLines(), linesBefore);
        Harness.equal("and so is every file on disk", listing(dir, ""), diskBefore);
        Harness.check("no name or number from the book is anywhere on disk",
            !contains(dir, "Kumar".getBytes(StandardCharsets.UTF_8)) && !contains(dir, "Priya Shah".getBytes(StandardCharsets.UTF_8)) && !contains(dir, "9876543210".getBytes(StandardCharsets.UTF_8)));

        Harness.suite("erasing the words removes them from the person");
        Harness.equal("erase one of Ravi's items", Erase.execute(context, journal, hashOf(a)).outcome, Erase.DESTROYED);
        Harness.equal("he has one fewer", find(People.compute(context, journal, book), "Ravi Kumar").items.size(), 5);
        Harness.check("an empty book mentions nobody", People.compute(context, journal, new ArrayList<People.Contact>()).people.isEmpty());

        Harness.suite("the record of a read carries counts and nothing else");
        Map<String, Object> read = ContactsFacts.read(412L, 5L, 30L);
        Harness.equal("its fields", new java.util.TreeSet<>(read.keySet()).toString(), "[capability, contacts, people, possible, version]");
        Harness.check("and names no one", !Json.canonical(read).contains("Ravi") && Json.canonical(read).contains("\"contacts\":412"));
        Harness.check("it is the second shape: the count of those only a name ties is there", Json.canonical(read).contains("\"possible\":30") && Json.canonical(read).contains("\"version\":2"));

        second();
        guard();
    }

    /** A second, smaller book: sharing only an address, which word is shown, what comes with a person, and the order of equals. */
    private static void second() throws Exception {
        Harness.suite("people by a shared address, the word shown, what comes with them, and the order");
        Install.forget();
        File dir = Files.createTempDirectory("orb-people2").toFile();
        Context context = new Context(dir);
        Journal journal = Journal.open(context, Install.lane(context), Install.id(context));
        List<People.Contact> book = new ArrayList<>();
        book.add(contact("1", "Zed Zhang", new String[] {}, "shared@x.example"));
        book.add(contact("2", "Amy Adams", new String[] {}, "shared@x.example"));
        book.add(contact("3", "Bob Brown", new String[] {"+919000000011"}));
        book.add(contact("4", "Dan Dale", new String[] {"+919000000012"}));
        book.add(contact("5", "Xena Xu", new String[] {}));
        book.add(contact("6", "Eli Ek", new String[] {}));
        book.add(contact("7", "Quinn Quill", new String[] {}));
        book.add(contact("8", "Dan Dane", new String[] {}));
        book.add(contact("9", "Rita Ann", new String[] {}));
        book.add(contact("10", "Anna Rao", new String[] {}));
        book.add(contact("11", "Amit Rao", new String[] {}));
        book.add(contact("12", "Rao Singh", new String[] {}));
        keep(context, journal, "mail shared@x.example");
        keep(context, journal, "Amy Adams and Zed Zhang met");
        keep(context, journal, "Bob Brown 90000 00011 ₹300");
        keep(context, journal, "Bob Brown ₹1,200");
        keep(context, journal, "Bob Brown ₹1,200 again");
        keep(context, journal, "Dan Dale rang 90000 00012");
        keep(context, journal, "Dan Dale rang again 90000 00012");
        keep(context, journal, "Xena Xu spoke");
        keep(context, journal, "Eli Ek spoke");
        keep(context, journal, "Dan Dale says call on 12/10/2026");
        keep(context, journal, "pay the bill on 15/10/2026");
        People.Result r = People.compute(context, journal, book);
        People.Person zed = find(r, "Zed Zhang");
        Harness.equal("two contacts that share only an email address are one person", zed.names, Arrays.asList("Zed Zhang", "Amy Adams"));
        Harness.equal("found once each: by email, and by name", People.evidenceLine(zed), "1 by email, 1 by name");
        String word = null;
        for (People.Evidence e : zed.items) if (People.BY_NAME.equals(e.by)) word = e.word;
        Harness.equal("when an item names two of a person's contacts, the first in the book is the word shown", word, "Zed Zhang");
        People.Person bob = find(r, "Bob Brown");
        Harness.equal("what appears most often with a person comes first", bob.alsoWith.get(0).value, "INR 1200");
        List<String> order = new ArrayList<>();
        for (People.Person p : r.people) order.add(p.names.get(0));
        Harness.equal("most items first; equals in name order, not the book's", order, Arrays.asList("Bob Brown", "Dan Dale", "Zed Zhang"));
        List<String> apart = new ArrayList<>();
        for (People.Person p : r.possible) apart.add(p.names.get(0));
        Harness.equal("the possible ones are ordered the same way, and apart", apart, Arrays.asList("Eli Ek", "Xena Xu"));

        Harness.suite("a person's dates ahead are the dates in their own items");
        java.util.Calendar noon = java.util.Calendar.getInstance(java.util.TimeZone.getTimeZone("UTC"));
        noon.clear();
        noon.set(2026, 9, 2, 12, 0, 0);
        ComingUp.Result everything = ComingUp.compute(context, journal, noon.getTimeInMillis(), "UTC");
        Harness.equal("everyone's: two dates ahead", everything.days.size(), 2);
        java.util.Set<String> danIds = new java.util.HashSet<>();
        for (People.Evidence e : find(r, "Dan Dale").items) danIds.add(e.entry.id);
        ComingUp.Result danOnly = ComingUp.restrict(everything, danIds);
        Harness.check("Dan's: only the one in an item that mentions him", danOnly.days.size() == 1 && danOnly.days.get(0).date.equals("2026-10-12") && danOnly.days.get(0).items.size() == 1);
        Harness.check("the other date is in no one's items", ComingUp.restrict(everything, new java.util.HashSet<String>()).days.isEmpty());
        Harness.check("restricting changes nothing in the whole", everything.days.size() == 2);

        Harness.suite("you choose the person: a search over every contact, mentioned or not");
        Harness.equal("everyone is there — grouped, and including those nothing mentions", r.all.size(), 11);
        List<String> byZh = new ArrayList<>();
        for (People.Person p : People.find(r.all, "ZH ")) byZh.add(p.display());
        Harness.equal("case and edge blanks do not matter, and a group is found by either name", byZh, Arrays.asList("Zed Zhang (+1)"));
        List<String> byAmy = new ArrayList<>();
        for (People.Person p : People.find(r.all, "amy")) byAmy.add(p.display());
        Harness.equal("by the other contact's name", byAmy, Arrays.asList("Zed Zhang (+1)"));
        List<String> byAn = new ArrayList<>();
        for (People.Person p : People.find(r.all, "an")) byAn.add(p.names.get(0));
        Harness.equal("best first: the name starts with it, a word of it starts with it, then anywhere inside; ties by name",
            byAn, Arrays.asList("Anna Rao", "Rita Ann", "Dan Dale", "Dan Dane", "Zed Zhang"));
        List<String> byRa = new ArrayList<>();
        for (People.Person p : People.find(r.all, "ra")) byRa.add(p.names.get(0));
        Harness.equal("a name that starts with it comes before a word that does, whatever their order by name", byRa, Arrays.asList("Rao Singh", "Amit Rao", "Anna Rao"));
        Harness.check("someone nothing mentions can be chosen, and has no items", People.find(r.all, "quill").size() == 1 && People.find(r.all, "quill").get(0).items.isEmpty());
        Harness.check("one letter is not a search; nothing typed finds no one", People.find(r.all, "a").isEmpty() && People.find(r.all, "").isEmpty() && People.find(r.all, null).isEmpty() && People.find(r.all, "  ").isEmpty());
        Harness.check("a name nobody has finds no one", People.find(r.all, "zzz").isEmpty());
        List<People.Person> many = new ArrayList<>();
        for (int i = 0; i < 40; i++) { People.Person p = new People.Person(); p.names.add(String.format("Test %02d", i)); many.add(p); }
        List<People.Person> capped = People.find(many, "test");
        Harness.check("at most " + People.FIND_LIMIT + " are shown, the first by name", capped.size() == People.FIND_LIMIT && capped.get(0).names.get(0).equals("Test 00") && capped.get(24).names.get(0).equals("Test 24"));
    }

    private static boolean contains(File dir, byte[] needle) throws Exception {
        File[] children = dir.listFiles();
        if (children == null) return false;
        for (File child : children) {
            if (child.isDirectory()) { if (contains(child, needle)) return true; continue; }
            byte[] hay = Files.readAllBytes(child.toPath());
            outer:
            for (int i = 0; i + needle.length <= hay.length; i++) {
                for (int j = 0; j < needle.length; j++) if (hay[i + j] != needle[j]) continue outer;
                return true;
            }
        }
        return false;
    }

    /** One file reads contacts, and nothing that touches them writes, stores or logs. */
    private static void guard() throws Exception {
        Harness.suite("the contacts are read by one file, read-only, and nothing keeps them");
        Path root = Paths.get(System.getProperty("orb.root", "."));
        Map<String, String> source = new TreeMap<>();
        try (java.util.stream.Stream<Path> files = Files.list(root.resolve("src"))) {
            for (Path file : (Iterable<Path>) files::iterator) {
                String name = file.getFileName().toString();
                if (name.endsWith(".java.in") && !name.equals("Capabilities.java.in")) source.put(name.replace(".java.in", ""), code(new String(Files.readAllBytes(file), StandardCharsets.UTF_8)));
            }
        }
        List<String> readers = new ArrayList<>();
        for (Map.Entry<String, String> e : source.entrySet()) if (e.getValue().contains("ContactsContract")) readers.add(e.getKey());
        Harness.equal("only ContactsReader touches the contacts provider", readers.toString(), "[ContactsReader]");
        String reader = source.get("ContactsReader");
        for (String write : Arrays.asList(".insert(", ".update(", ".delete(", "applyBatch", "bulkInsert", "WRITE_CONTACTS")) {
            Harness.check("the reader never uses " + write, !reader.contains(write));
        }
        for (String name : Arrays.asList("People", "PeopleActivity", "ContactsReader", "ContactsFacts")) {
            String t = source.get(name);
            Harness.check(name + " keeps nothing and logs nothing",
                !t.contains("Log.") && !t.contains("System.out") && !t.contains("printStackTrace") && !t.contains("FileOutputStream")
                && !t.contains("RandomAccessFile") && !t.contains("getSharedPreferences") && !t.contains("openFileOutput") && !t.contains("Toast"));
        }
        for (String name : Arrays.asList("People", "PeopleActivity", "ContactsReader")) {
            Harness.check(name + " builds no record of its own", !source.get(name).contains("Json.obj(") && !source.get(name).contains(".put(\""));
        }
        String activity = source.get("PeopleActivity");
        int appends = 0;
        for (int at = activity.indexOf("journal.append("); at >= 0; at = activity.indexOf("journal.append(", at + 1)) appends++;
        Harness.check("the screen's only write is the record of a read (counts only)", appends == 1 && activity.contains("journal.append(ContactsFacts.READ, ContactsFacts.read("));
        Harness.check("the contacts are read only after the grant is checked and Android's permission is there",
            activity.contains("ContactsAccess.granted(this)") && activity.indexOf("ContactsAccess.granted(this)") < activity.indexOf("ContactsReader.read(context)")
            && source.get("ContactsReader").contains("if (!permitted(context)) return null;"));
        Harness.check("the screen keeps the possible people apart: collapsed behind a button, under a heading that says it may be no one",
            activity.contains("result.possible") && activity.contains("Might be") && activity.contains("that only a name matches")
            && activity.indexOf("for (final People.Person person : result.people) mentions.addView(row(person));") < activity.indexOf("Might be")
            && activity.split("addView\\(row\\(person\\)\\);", -1).length == 3);
        Harness.check("the record counts both kinds", activity.contains("ContactsFacts.read(result.contacts, result.people.size(), result.possible.size())"));
        Harness.check("a contact with no number gets greyed hand-off buttons", activity.contains("open.setEnabled(!person.phones.isEmpty());"));
        Harness.check("a person's reminder goes through the existing flow, about no kept item, and People reaches nothing of the gate itself",
            activity.contains("flow.start(null, null, callNote)") && activity.contains(".setNeutralButton(\"Remind me about this person\\u2026\"") && activity.contains("\"Call \" + person.names.get(0)")
            && !activity.contains("Reminders.") && !activity.contains("Remind.") && !activity.contains("ReminderAlarms") && !activity.contains("ReminderNotifier"));
        Harness.check("the note starts as the preset, in the field and in what is kept if untouched, and Android's answer reaches the flow",
            source.get("RemindFlow").contains("if (presetNote != null) note.setText(presetNote);") && source.get("RemindFlow").contains("{presetNote == null ? \"\" : presetNote.trim()}")
            && activity.contains("flow.onPermissionResult(code, results)"));
        Harness.check("the note's window is secure, since it may start as a person's name", source.get("RemindFlow").split("FLAG_SECURE", -1).length - 1 >= 4);
        Harness.check("the screen opens on a search of every contact, typed in a watcher and read by no accessor; what the words mention is collapsed behind a button",
            activity.contains("People.find(result.all, typed)") && activity.contains("addTextChangedListener") && !activity.contains(".getText(")
            && activity.contains("mentions.setVisibility(View.GONE)") && activity.contains("Who my words mention ("));
        Harness.check("Android's permission is asked only for the screen, at the grant", activity.contains("requestPermissions(") && !source.get("ContactsReader").contains("requestPermissions("));
        String access = source.get("ContactsAccess");
        int grantAt = access.indexOf("static void grant("), revokeAt = access.indexOf("static void revoke("), reconcileAt = access.indexOf("static void reconcile(");
        String grant = access.substring(grantAt, revokeAt), revoke = access.substring(revokeAt, reconcileAt);
        Harness.check("a grant is recorded before anything is allowed to read, and is not recorded twice",
            grant.indexOf("if (granted(context)) return;") >= 0 && grant.indexOf("record(journal, PackageGrants.GRANTED") > grant.indexOf("if (granted(context)) return;")
            && grant.indexOf("RandomAccessFile") > grant.indexOf("record(journal, PackageGrants.GRANTED"));
        Harness.check("a revocation stops the reading first, then says so",
            revoke.indexOf(".delete()") >= 0 && revoke.indexOf("record(journal, PackageGrants.REVOKED") > revoke.indexOf(".delete()"));
        Harness.check("after a restore, a grant the phone does not exercise is recorded as withdrawn", access.substring(reconcileAt).contains("lastIsGrant(journal.readLines(), Capabilities.CONTACTS)")
            && access.substring(reconcileAt).contains("granted(context)) return;") && access.contains("payload.put(\"capability\", Capabilities.CONTACTS);"));
        String manifest = new String(Files.readAllBytes(root.resolve("AndroidManifest.xml")), StandardCharsets.UTF_8).replaceAll("(?s)<!--.*?-->", "");
        Harness.check("the manifest asks to read the contacts and not to write them", manifest.contains("android.permission.READ_CONTACTS") && !manifest.contains("WRITE_CONTACTS"));
    }

    private static String code(String source) {
        StringBuilder out = new StringBuilder();
        for (String line : source.split("\n")) {
            String t = line.trim();
            if (t.startsWith("*") || t.startsWith("//") || t.startsWith("/*")) continue;
            out.append(line).append('\n');
        }
        return out.toString();
    }
}
