package @PKG@;

import java.io.IOException;
import java.nio.charset.StandardCharsets;
import java.nio.file.Files;
import java.nio.file.Path;
import java.nio.file.Paths;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.List;
import java.util.regex.Pattern;

/**
 * The assistant may **receive** a screen and may **keep its text only if the person taps
 * Remember** — and the code that does either is confined, by file, so the rules can be
 * checked by reading six files rather than trusted across sixty.
 *
 * | File | May | May not |
 * | --- | --- | --- |
 * | `ScreenReader` | read `getText` and the page address | read anything else off a screen; keep, log or write anything |
 * | `ScreenText` | hold the text in memory | import Android; write or log anything |
 * | `Capture` | seal the text (`Attachments`) | read a screen; log |
 * | `Recall` | open sealed text (`Attachments.open`), in memory | write anything; log; read a screen |
 * | `RecallActivity` | draw it, behind `FLAG_SECURE` | touch the sealed store |
 * | `AssistFacts` | build every record | — |
 * | everything else in the assistant | decide and draw | read screen content; touch `Attachments`; build a record; log |
 *
 * Crude on purpose: a rule that has to be argued about gets argued away, and a failing test
 * that prints the line does not.
 */
final class AssistGuardTest {
    /** Every assistant file that is not the one place records are built. */
    private static final List<String> ALL = Arrays.asList(
        "AssistSession", "AssistService", "SessionService", "RecognitionStub", "AllowActivity",
        "AssistPolicy", "AllowList", "ScreenText", "ScreenReader", "Capture", "Recall", "RecallActivity", "UpiApps");
    /** The assistant files that may not read what a screen says. */
    private static final List<String> NO_CONTENT = Arrays.asList(
        "AssistSession", "AssistService", "SessionService", "RecognitionStub", "AllowActivity",
        "AssistPolicy", "AllowList", "ScreenText", "Capture", "Recall", "RecallActivity", "UpiApps");
    /** The assistant files that may not touch the sealed store. */
    private static final List<String> NO_STORE = Arrays.asList(
        "AssistSession", "AssistService", "SessionService", "RecognitionStub", "AllowActivity",
        "AssistPolicy", "AllowList", "ScreenText", "ScreenReader", "RecallActivity", "UpiApps");

    private static final Pattern CONTENT_ACCESSOR = Pattern.compile(
        "\\.(getText|getContentDescription|getHint|getHintIdEntry|getIdEntry|getWebDomain|getTitle"
            + "|getWebUri|getStructuredData|getClipData|getIntent)\\(\\)");

    static void run() throws IOException {
        Path root = Paths.get(System.getProperty("orb.root", "."));
        java.util.Map<String, String> source = new java.util.LinkedHashMap<>();
        for (String name : ALL) {
            source.put(name, new String(Files.readAllBytes(root.resolve("src/" + name + ".java.in")), StandardCharsets.UTF_8));
        }
        String manifest = new String(Files.readAllBytes(root.resolve("AndroidManifest.xml")), StandardCharsets.UTF_8)
            .replaceAll("(?s)<!--.*?-->", "");
        Harness.suite("the assistant's source is what is scanned");
        Harness.equal("found all the files", source.size(), ALL.size());

        Harness.suite("records are built by AssistFacts and nowhere else");
        forbid(source, ALL, "builds a record outside AssistFacts", Pattern.compile("Json\\.obj\\(|\\.put\\(\""));

        Harness.suite("nothing is logged");
        forbid(source, ALL, "writes somewhere a screen's content could leak",
            Pattern.compile("\\bLog\\.|System\\.(out|err)|printStackTrace|Toast"));

        Harness.suite("only ScreenReader reads what a screen says");
        int uses = 0;
        List<String> offenders = new ArrayList<>();
        for (String name : NO_CONTENT) {
            String[] lines = source.get(name).split("\n");
            for (int i = 0; i < lines.length; i++) {
                if (isComment(lines[i])) continue;
                java.util.regex.Matcher m = CONTENT_ACCESSOR.matcher(lines[i]);
                while (m.find()) {
                    uses++;
                    String after = lines[i].substring(m.end());
                    String next = after.trim();
                    // Outside the reader a length or a null test is the most that is allowed.
                    if (!(after.startsWith(".length()") || next.startsWith("!= null") || next.startsWith("== null"))) {
                        offenders.add(name + ":" + (i + 1) + "  " + lines[i].trim());
                    }
                }
            }
        }
        Harness.check("outside it, a content accessor is only ever a length or a null test (" + uses + " uses)", offenders.isEmpty());
        for (String o : offenders) System.out.println("           " + o);

        String reader = source.get("ScreenReader");
        Harness.check("the reader reads text and the page address",
            reader.contains(".getText()") && reader.contains(".getWebUri()"));
        forbidIn(source, Arrays.asList("ScreenReader"), "reads more than text and the address",
            Pattern.compile("\\.(getContentDescription|getHint|getHintIdEntry|getIdEntry|getWebDomain|getTitle"
                + "|getStructuredData|getClipData|getIntent|getText)\\(\\)\\s*[^;]*;?\\s*$"), true);
        Harness.check("and refuses a password field by what it says it is, never reading its text",
            reader.contains("isPasswordField(") && reader.contains("notePassword()"));

        Harness.suite("the buffer is plain Java");
        Harness.check("ScreenText imports nothing from Android", !source.get("ScreenText").contains("import android"));

        Harness.suite("only Capture touches the sealed store");
        forbid(source, NO_STORE, "refers to Attachments", Pattern.compile("\\bAttachments\\b"));
        Harness.check("Capture seals", source.get("Capture").contains("Attachments.store("));
        Harness.check("Recall opens", source.get("Recall").contains("Attachments.open("));
        Harness.check("and nothing but Recall opens it", !source.get("Capture").contains("Attachments.open(")
            && !source.get("RecallActivity").contains("Attachments"));

        Harness.suite("the screen that shows remembered words hides itself");
        String ra = source.get("RecallActivity");
        Harness.check("RecallActivity's own window is secure: no screenshot, recording or recents thumbnail",
            ra.contains("getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE"));
        Harness.check("and so is the dialog that shows the full text",
            ra.contains("dialog.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE"));

        Harness.suite("the package visibility is one narrow query, not a list of installed apps");
        String queries = manifest.substring(manifest.indexOf("<queries>"), manifest.indexOf("</queries>"));
        Harness.check("Orb asks to see who handles the UPI link", queries.contains("android:scheme=\"upi\"") && queries.contains("android:host=\"pay\""));
        Harness.check("no <package> entries (it names no app it wants to see)", !queries.contains("<package"));
        Harness.check("and does not declare the broad permission in the template", !manifest.contains("android.permission.QUERY_ALL_PACKAGES\""));
        Harness.check("the UPI link is only resolved: UpiApps never starts an activity",
            !source.get("UpiApps").contains("startActivity"));

        Harness.suite("allowing an app takes two taps, and names the app");
        String session = source.get("AssistSession");
        Harness.check("the first tap asks again and names the app", session.contains("confirmingAllow") && session.contains("\"Yes, allow \" + packageName"));
        Harness.check("the button names the app before the first tap", session.contains("\"Allow \" + packageName"));
        Harness.check("a payments app is re-checked at the tap, not only when the card opened",
            session.contains("UpiApps.isPayments(getContext(), packageName, exceptions())") && session.split("UpiApps.isPayments", -1).length - 1 >= 3);

        Harness.suite("a payments exception is named, warned about, and nowhere else");
        Harness.check("only the session writes an exception, and only through the fact builder",
            session.contains("AssistFacts.grantException(packageName)")
            && !source.get("AllowActivity").contains("grantException") && !source.get("Capture").contains("grantException"));
        Harness.check("the exception is offered only to an app that handles UPI and is not on the floor",
            session.contains("UpiApps.canExcept(getContext(), packageName)") && source.get("UpiApps").contains("!AssistPolicy.isFloor(packageName)"));
        Harness.check("the warning says the app can send money, before the second tap",
            session.contains("can also send money. If you allow it, payment screens inside it can be kept too"));

        Harness.suite("the brain is reached through one file, which cannot touch what is sealed");
        String observe = new String(Files.readAllBytes(root.resolve("src/Observe.java.in")), StandardCharsets.UTF_8);
        List<String> brainUsers = new ArrayList<>();
        try (java.util.stream.Stream<Path> all = Files.list(root.resolve("src"))) {
            for (Path file : (Iterable<Path>) all::iterator) {
                String text = new String(Files.readAllBytes(file), StandardCharsets.UTF_8);
                if (text.contains("dev.orb.brain")) brainUsers.add(file.getFileName().toString());
            }
        }
        Harness.equal("only Observe calls the brain", brainUsers, java.util.Arrays.asList("Observe.java.in"));
        Harness.check("Observe never refers to Attachments", !observe.contains("Attachments"));
        Harness.check("nor to Android", !observe.contains("android."));
        Harness.check("nor logs", !Pattern.compile("\\bLog\\.|System\\.(out|err)|printStackTrace|Toast").matcher(observe).find());
        Harness.check("and the brain it calls is the Observer, which writes nothing",
            observe.contains("dev.orb.brain.Observer.plan(") && !observe.contains("Observer.write"));

        Harness.suite("one process, one writer; nothing extra requested");
        Harness.check("no component runs in its own process", !manifest.contains("android:process"));
        Harness.check("platform backup is off", manifest.contains("android:allowBackup=\"false\""));
        List<String> permissions = new ArrayList<>();
        java.util.regex.Matcher pm = Pattern.compile("<uses-permission[^>]*android:name=\"([^\"]+)\"").matcher(manifest);
        while (pm.find()) permissions.add(pm.group(1));
        Harness.check("the only permission is the boot receiver's " + permissions,
            permissions.size() == 1 && permissions.get(0).equals("android.permission.RECEIVE_BOOT_COMPLETED"));
        Harness.check("the assistant service is bound by the platform's own permission",
            manifest.contains("android.permission.BIND_VOICE_INTERACTION"));
    }

    private static boolean isComment(String line) {
        String t = line.trim();
        return t.startsWith("*") || t.startsWith("//") || t.startsWith("/*");
    }

    /** Fails if any named file has a non-comment line matching `bad`. */
    private static void forbid(java.util.Map<String, String> source, List<String> files, String what, Pattern bad) {
        forbidIn(source, files, what, bad, false);
    }

    private static void forbidIn(java.util.Map<String, String> source, List<String> files, String what, Pattern bad, boolean skipPermittedReader) {
        List<String> hits = new ArrayList<>();
        for (String name : files) {
            String[] lines = source.get(name).split("\n");
            for (int i = 0; i < lines.length; i++) {
                if (isComment(lines[i])) continue;
                if (skipPermittedReader) {
                    // In the reader: only `getText()` and `getWebUri()` may be called.
                    java.util.regex.Matcher m = CONTENT_ACCESSOR.matcher(lines[i]);
                    while (m.find()) {
                        String accessor = m.group(1);
                        if (!accessor.equals("getText") && !accessor.equals("getWebUri")) hits.add(name + ":" + (i + 1) + "  " + lines[i].trim());
                    }
                } else if (bad.matcher(lines[i]).find()) {
                    hits.add(name + ":" + (i + 1) + "  " + lines[i].trim());
                }
            }
        }
        Harness.check(what + "? none in " + files.size() + " files", hits.isEmpty());
        for (String h : hits) System.out.println("           " + h);
    }
}
