<?xml version="1.0" encoding="utf-8"?>
<!--
  Orb — the consolidated runtime.

  **Two permissions, and the second one is AD-7.**

  The share sensor needs none at all: receiving a share is not a Capability,
  because Orb reaches for nothing — the world reaches in (`SENSOR_SHARE.md` §1).

  `RECEIVE_BOOT_COMPLETED` wakes the app after a restart and reads nothing.

  `QUERY_ALL_PACKAGES` **does** read: the whole installed set, 484 entries
  describing a person's life. It is the permission a surveillance app would want,
  held by an app whose purpose is to notice one. `Capability.md` §8 puts it at
  tier `Observe` and AD-7 records that pass 2 took it with no declaration and no
  authorization.

  **So it is declared here and gated at runtime.** The manifest permission only
  makes the read *possible*; `PackageAccess` decides whether it *happens*, and
  the grant, the refusal and the revocation are all events.

  **And it is now a build flag** — `ORB_PACKAGE_SCAN=0` omits the permission
  entirely. Two reasons, and the second was not anticipated:

  1. `DEVICE_LOOP.md` §7b38: Play Protect blocked the build that first carried
     this permission, having passed four previous builds of the same package
     under the same key that carried none. Omitting it is the one-change
     experiment that separates the permission from the receiver and the size.
  2. The **honest degradation** this comment has always claimed —
     `GrantReader.packageScope` records `visible`, and `Grants.previous` refuses
     to diff across a scope change and re-baselines once instead of reporting two
     hundred uninstalls that never happened — has **never actually been run**. A
     claim that has only ever been argued is not a claim that has been tested.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="@PKG@"
    android:versionCode="@VERSION_CODE@"
    android:versionName="0.1-orb">

    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Reminders (docs/GATE_PHONE.md): to show the notification the person asked for, and nothing else.
         Asked at the first confirmation, with a sentence saying why. No exact-alarm permission: a reminder
         may be a few minutes late while the phone dozes, and the confirmation card says so. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- People (docs/PEOPLE_PHONE.md): to read the contacts, only while the People screen is open, only after the person has
         granted it in Orb and again in Android's own question. Read-only: there is no write permission. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
@QUERY_ALL_PACKAGES@
<!-- Calls (docs/CALLS_PHONE.md): the call-history permission is declared here only in the calls build (ORB_CALL_LOG=1), by build.sh,
         the one place it is spelled out. The default build declares none. -->
@CALL_LOG@

    <!--
      Without this, `queryBroadcastReceivers` for admin receivers sees some
      packages and not others — and the ones it would miss are third-party,
      which is exactly the case this signal exists for.
    -->
    <queries>
        <intent>
            <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
        </intent>
        <!--
          Launcher apps. With the UPI and device-admin queries this is the whole set the package scan
          compares (docs/SENSOR_GRANTS.md §9): apps that match a declared query are always visible,
          so the set does not move with what Orb happened to be doing — an app that merely handed Orb
          a share used to appear in it, and vanish at the next scan, as if it had been installed and
          removed. This is not QUERY_ALL_PACKAGES, and lists no package by name.
        -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!--
          The Safety check (docs/SAFETY_CHECK_PHONE.md): the apps that provide the powerful services it looks for. These
          name *kinds of service*, never an app, and are not QUERY_ALL_PACKAGES (which Play Protect blocked on this phone,
          DEVICE_LOOP.md section 7b38). With the launcher query above they are the whole set the check can see.
        -->
        <intent>
            <action android:name="android.accessibilityservice.AccessibilityService" />
        </intent>
        <intent>
            <action android:name="android.service.notification.NotificationListenerService" />
        </intent>
        <intent>
            <action android:name="android.view.InputMethod" />
        </intent>
        <!--
          Which apps on this phone handle a UPI payment link. Not a list of installed apps: only
          those that answer upi://pay become visible, and Orb uses them for one thing, to refuse
          to remember from a payments app whatever it is called (DR-14 ruling 1). Every UPI app,
          banks' included, has to handle this link, so it finds apps no list of names would.
        -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" android:host="pay" />
        </intent>
    </queries>

    <!--
      allowBackup is off (AD-11). Its default is on, and this app keeps the journal,
      the sealed attachments *and their keys* in private storage: a platform backup
      would carry key and ciphertext off the phone together. Losing the phone then
      loses the journal, and the export in Downloads is the copy that survives.
    -->
    <application
        android:name=".Orb"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:label="@LABEL@"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".RecallActivity"
            android:exported="false" />

        <activity
            android:name=".BackupActivity"
            android:exported="false" />

        <activity
            android:name=".MayDoActivity"
            android:exported="false" />

        <activity
            android:name=".ComingUpActivity"
            android:exported="false" />

        <activity
            android:name=".PeopleActivity"
            android:exported="false" />

        <!-- The Safety check: what other apps on the phone may do. Not exported; secure like Recall. -->
        <activity
            android:name=".SafetyActivity"
            android:exported="false" />

        <!-- Sources: PDF files Orb may read when you ask (docs/SOURCES_PHONE.md). Not exported; secure like Recall. -->
        <activity
            android:name=".SourcesActivity"
            android:exported="false" />

        <!-- Senders: which services are not about your obligations (docs/SENDER_MARKS_PHONE.md). Not exported; secure like Recall. -->
        <activity
            android:name=".SendersActivity"
            android:exported="false" />

        <!-- Today: what matters now. Not exported; secure like Recall. -->
        <activity
            android:name=".TodayActivity"
            android:exported="false" />

        <!-- An alarm Orb set for a reminder the person confirmed. Not exported: only Orb's own alarm reaches it. -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- The morning brief's alarm (docs/MORNING_BRIEF_PHONE.md). Not exported: only Orb's own alarm reaches it. -->
        <receiver
            android:name=".BriefReceiver"
            android:exported="false" />

        <activity
            android:name=".AllowActivity"
            android:exported="false" />

        <!--
          Orb as the device's assistant (step 7). Bound only when the person chooses Orb in
          Default digital assistant app. No permission is requested: the BIND permission is
          what the *platform* must hold to bind these, not something Orb asks for.
        -->
        <service
            android:name=".AssistService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".SessionService"
            android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:exported="true" />

        <!-- Required for the system to offer Orb as an assistant (P30); recognises nothing. -->
        <service
            android:name=".RecognitionStub"
            android:exported="true">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
            <meta-data
                android:name="android.speech"
                android:resource="@xml/recognition_service" />
        </service>

        <activity
            android:name=".ItemsActivity"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          The share target.

          `exported` because the whole point is that other apps can reach it —
          and it is safe to export precisely because it *takes* nothing: it
          records what it was handed and finishes. It opens no stream, reads no
          file and fetches no URL, so an app that shares something to Orb has
          disclosed exactly what it chose to.

          `excludeFromRecents` and the translucent theme keep it out of the way:
          a share target that left a screen behind would make the user dismiss
          something after every share, and a sensor that is annoying to feed
          stops being fed.

          The `mimeType` wildcard accepts anything. The declaration is what the
          sender said it was (`ShareActivity.record`), never verified here.
        -->
        <activity
            android:name=".ShareActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|density|uiMode|layoutDirection|locale"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
        <!-- P6 held and strengthened: these arrive with no foreground service (§7b19). -->
        <receiver
            android:name=".WakeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.PACKAGE_ADDED" />
                <action android:name="android.intent.action.PACKAGE_REMOVED" />
                <action android:name="android.intent.action.PACKAGE_REPLACED" />
                <data android:scheme="package" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
