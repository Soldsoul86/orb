package @PKG@;

import android.content.Context;
import java.io.File;
import java.io.IOException;
import java.io.RandomAccessFile;
import java.util.Map;

/**
 * Whether Orb may **keep the facts it reads** \u2014 the normalized observations (amounts, days, who; never message text), sealed on this phone by source and month
 * (`docs/MONEY_PHONE.md` \u00a77, DR-44) \u2014 a recorded decision of the person's, the same shape as `SendersAccess`. There is no Android permission to ask: keeping reads
 * nothing new. The grant is an event written when the person says yes to keeping, the flag follows it, a revocation removes the flag and then says so, and
 * the history is made to agree after a restore. **Switching it off stops keeping; it erases nothing** \u2014 erasing what was kept is its own, explicit act.
 */
final class KeepAccess {
    private KeepAccess() {}

    private static final String FILE = "observations-keep.granted";

    static boolean granted(Context context) {
        return new File(context.getFilesDir(), FILE).exists();
    }

    /**
     * Whether the person switched keeping off (the last record is a revocation). **Then nothing is kept until they turn it on again** — the Keep button on the
     * Sources screen refuses, and says where to turn it on. Never decided is not switched off: the first Keep is the person's first yes. If the history cannot
     * be read the answer is *switched off*: a doubt fails toward not keeping.
     */
    static boolean switchedOff(java.util.List<String> lines) {
        try {
            return PackageGrants.lastIsRevocation(lines, Capabilities.OBS_KEEP);
        } catch (IOException unreadable) {
            return true;
        }
    }

    /** Event first, then the flag: a crash in between leaves a grant on record that the device does not yet exercise \u2014 the harmless direction. */
    static void grant(Context context, Journal journal) throws IOException {
        if (granted(context)) return;
        record(journal, PackageGrants.GRANTED, "operator");
        try (RandomAccessFile out = new RandomAccessFile(new File(context.getFilesDir(), FILE), "rws")) {
            out.write(new byte[] {1});
            out.getFD().sync();
        }
    }

    /** Flag first, then the event: stop keeping, then say so. */
    static void revoke(Context context, Journal journal) {
        new File(context.getFilesDir(), FILE).delete();
        record(journal, PackageGrants.REVOKED, "operator");
    }

    /** A restore brings the journal back and grants nothing: if it says *granted* and the flag is absent, record the revocation. */
    static void reconcile(Context context, Journal journal) {
        if (journal == null || granted(context)) return;
        try {
            if (PackageGrants.lastIsGrant(journal.readLines(), Capabilities.OBS_KEEP)) record(journal, PackageGrants.REVOKED, "reconcile");
        } catch (IOException unreadable) {
            // Cannot read the history, so cannot say what it claims. Write nothing.
        }
    }

    private static void record(Journal journal, String type, String by) {
        if (journal == null) return;
        Map<String, Object> payload = Json.obj();
        payload.put("capability", Capabilities.OBS_KEEP);
        payload.put("tier", Capabilities.TIER_OBSERVE);
        payload.put("scope", "keeping, sealed on this phone by source and month for 24 months, the facts Orb reads from sources you choose");
        payload.put("by", by);
        journal.append(type, payload);
    }
}
