package @PKG@;

import android.app.Activity;
import android.content.ClipDescription;
import android.content.Intent;
import android.net.Uri;
import android.os.Bundle;
import android.os.SystemClock;
import android.widget.Toast;
import java.io.InputStream;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * Share to Orb — the first sensor that is handed its mandate rather than taking
 * it.
 *
 * `docs/SENSOR_SHARE.md`, written as a declaration before this file existed,
 * because that is the test `AD-7` failed by being decided in a manifest at build
 * time. Two results from writing it first, both load-bearing here:
 *
 * **Receiving a share is not a `Capability`.** `Capability.md` §8's *reads are
 * capabilities too* is about Orb reaching out and taking. A share is the world
 * reaching in: no permission, nothing enumerated, nothing requested. This class
 * declares no permission and asks for none.
 *
 * **A share hands over a reference, not content**, and resolving that reference
 * is a `Capability` at tier `Observe`. §3 put the resolution *later*, under a
 * separate authorization — and **§7b33 measured that later is not available**:
 * the URI grant is scoped to this activity's lifetime, and a read 9.5 s after the
 * share is refused outright. The separation was a good idea the platform does not
 * permit.
 *
 * **Ruled 2026-09-28: resolve during the share.** The Capability is declared where
 * it must happen rather than where it would be tidiest, and **the share is itself
 * the authorization event** — a person deliberately handing something over is
 * stronger consent than a prompt Orb could invent afterwards. The act is recorded
 * every time, including when it fails.
 *
 * **A URL is still not fetched.** Only a `content://` reference the sender granted
 * is opened. Fetching a shared link would make Orb initiate a connection to an
 * arbitrary third party on the strength of a tap — egress at tier
 * *Act (irreversible)* under DR-9, and a different act from reading what was
 * handed over. **Sharing a link is not authorization to visit it.**
 */
public final class ShareActivity extends Activity {

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);

        Orb app = Orb.get();
        Journal journal = app == null ? null : app.journal();
        if (journal == null) {
            Toast.makeText(this, "Orb: journal unavailable, nothing recorded", Toast.LENGTH_SHORT).show();
            finish();
            return;
        }

        Intent intent = getIntent();
        Map<String, Object> payload = record(intent);
        // While the grant is live, and only here. By the time this activity
        // finishes it is gone (§7b33).
        resolve(intent, payload);
        payload.put("elapsedRealtimeMs", SystemClock.elapsedRealtime());
        journal.append(Orb.SHARED, payload);

        Toast.makeText(this, "Orb recorded the share", Toast.LENGTH_SHORT).show();
        finish();
    }

    /**
     * What the hand-off was, as the sender declared it — built by `Shares`, which
     * touches no Android, so the same code can be run off the phone to produce the
     * fixture the desktop importer is tested against.
     */
    private Map<String, Object> record(Intent intent) {
        if (intent == null) return Shares.unreadable();
        Uri referrer = getReferrer();
        return Shares.declared(
            String.valueOf(intent.getAction()),
            intent.getType(),
            referrer == null ? null : referrer.toString(),
            references(intent));
    }

    /**
     * Reads the shared content into an `Attachment`, while the grant still holds.
     *
     * **Only `content://`.** A `file://` reference would be a path this app has
     * no business reading, and an `http(s)` one is a fetch — a different
     * Capability at a higher tier (DR-9), not this one.
     *
     * **Only the first item.** A multi-item share is recorded in full as
     * references; resolving all of them is more content than one tap authorizes
     * comfortably, and the count is on the record for a reader to notice.
     *
     * Every outcome is written down. `resolved: false` with a reason is a
     * finding; silently leaving the field as it was would make *not attempted*
     * and *attempted and refused* the same record.
     */
    private void resolve(Intent intent, Map<String, Object> payload) {
        String reference = Shares.firstReference(payload);
        String unresolvable = Shares.unresolvableOutcome(reference);
        if (unresolvable != null) {
            Shares.outcome(payload, unresolvable, null, null, 0L);
            return;
        }

        try (InputStream in = getContentResolver().openInputStream(Uri.parse(reference))) {
            if (in == null) {
                Shares.outcome(payload, "openedNull", null, null, 0L);
                return;
            }
            Attachments.Stored stored = Attachments.store(this, in);
            Shares.outcome(payload, stored.outcome, stored.detail, stored.identity, stored.bytes);
        } catch (SecurityException refused) {
            Shares.refused(payload, refused.getMessage());
        } catch (Exception error) {
            Shares.failed(payload, error);
        }
    }

    /**
     * The references a share carries, in the order the sender gave them.
     *
     * Plain text is *itself* the content and is recorded as the reference; a
     * `content://` URI and a URL are pointers. The distinction matters for what
     * resolution would later have to do, and not for what is recorded now.
     */
    private List<String> references(Intent intent) {
        List<String> out = new ArrayList<>();
        String action = intent.getAction();

        if (Intent.ACTION_SEND_MULTIPLE.equals(action)) {
            ArrayList<Uri> uris = intent.getParcelableArrayListExtra(Intent.EXTRA_STREAM, Uri.class);
            if (uris != null) {
                for (Uri uri : uris) {
                    if (uri != null) out.add(uri.toString());
                }
            }
            return out;
        }

        Uri stream = intent.getParcelableExtra(Intent.EXTRA_STREAM, Uri.class);
        if (stream != null) {
            out.add(stream.toString());
            return out;
        }

        CharSequence text = intent.getCharSequenceExtra(Intent.EXTRA_TEXT);
        if (text != null) {
            out.add(text.toString());
            return out;
        }

        // A share that named neither a stream nor text. Recorded as an empty
        // list, which with `itemCount: 0` says *this arrived and carried
        // nothing we could name* — a fact, and different from a failed read.
        return out;
    }

    /** The MIME types this activity accepts, for the manifest to mirror. */
    static boolean accepts(ClipDescription description) {
        return description != null && description.getMimeTypeCount() > 0;
    }
}
