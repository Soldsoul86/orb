package @PKG@;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.Intent;
import android.database.Cursor;
import android.graphics.Typeface;
import android.net.Uri;
import android.os.Bundle;
import android.os.SystemClock;
import android.provider.OpenableColumns;
import android.view.View;
import android.view.WindowManager;
import android.widget.Button;
import android.widget.CheckBox;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import java.io.IOException;
import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;
import java.util.Locale;

/**
 * Sources (`docs/SOURCES_PHONE.md`): the places Orb may reach for what you did not hand it — today, one: PDF files. **It reads only when the
 * person taps *Look now* (or has just picked files), shows what it found with the first words of each, and keeps only what is ticked.**
 * Unticked files are forgotten when the screen closes: nothing copied, nothing recorded about them. Kept words are sealed like a share
 * (`DocumentsFlow`). Only counts are recorded (`DocumentsFacts`). Secure like Recall, because documents describe a life.
 *
 * Two ways to name files, neither needing an Android permission: **a folder** (Android's folder picker — it refuses the Downloads folder
 * itself since Android 11, so a folder inside it, or Documents) and **the files themselves** (Android's file picker, which does open
 * Downloads). The screen starts the pickers and nothing else.
 */
public final class SourcesActivity extends Activity {
    private static final int PICK_FOLDER = 1;
    private static final int PICK_FILES = 2;
    private static final int PICK_MESSAGES = 3;

    private LinearLayout list;
    /** The files of the current look, with the controls that show them; memory only. */
    private final List<RowView> shown = new ArrayList<>();
    /** The files the person picked by hand (no folder): addresses Android granted this screen. */
    private final List<DocumentsRules.Doc> picked = new ArrayList<>();
    private LinearLayout results;
    private TextView summary;
    private boolean looking;
    /** Set by the file picker's answer and used once by the next drawing: files were just named, so look at them. */
    private boolean lookPicked;

    private static final class RowView {
        final DocumentsRules.Doc doc;
        final CheckBox box;
        final TextView status;

        RowView(DocumentsRules.Doc doc, CheckBox box, TextView status) {
            this.doc = doc;
            this.box = box;
            this.status = status;
        }
    }

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);
        getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        ScrollView scroll = new ScrollView(this);
        list = new LinearLayout(this);
        list.setOrientation(LinearLayout.VERTICAL);
        list.setPadding(40, 120, 40, 40);
        scroll.addView(list);
        setContentView(scroll);
    }

    @Override
    protected void onResume() {
        super.onResume();
        if (looking) return;
        // Coming back from the Senders screen (or anywhere): draw the screen again, and then the last Look again, with the ticks the person had, so that
        // their sender marks are reflected at once and nothing they were doing is lost.
        java.util.Set<String> ticks = new java.util.HashSet<>();
        for (int i = 0; i < messageBoxes.size() && i < messageRows.size(); i++) if (messageBoxes.get(i).isChecked()) ticks.add(messageRows.get(i).number);
        render();
        if (!looking && messagesLook != null && messageResults != null) {
            messageBoxes.clear();
            messageRows.clear();
            showMessagesLook(messagesLook, null);
            for (int i = 0; i < messageBoxes.size(); i++) if (ticks.contains(messageRows.get(i).number)) messageBoxes.get(i).setChecked(true);
        }
    }

    @Override
    protected void onDestroy() {
        super.onDestroy();
        if (isFinishing()) SenderSession.clear();
    }

    private TextView text(String s, int size, boolean bold) {
        TextView t = new TextView(this);
        t.setTextSize(size);
        t.setPadding(0, 8, 0, 8);
        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
        t.setText(s);
        return t;
    }

    private Button button(String label, View.OnClickListener onClick) {
        Button b = new Button(this);
        b.setText(label);
        b.setOnClickListener(onClick);
        return b;
    }

    private Journal journal() {
        Orb orb = Orb.get();
        return orb == null ? null : orb.journal();
    }

    private void message(String s) {
        new AlertDialog.Builder(this).setMessage(s).setPositiveButton("OK", null).show();
    }

    private void render() {
        list.removeAllViews();
        shown.clear();
        results = null;
        summary = null;
        list.addView(text("Sources", 17, true));
        final Journal journal = journal();
        if (journal == null) {
            list.addView(text("journal unavailable", 13, false));
            return;
        }
        documents(journal);
        messages(journal);
    }

    /** The PDF source's section (`SOURCES_PHONE.md`). */
    private void documents(final Journal journal) {
        list.addView(text("PDF files", 15, true));
        if (!DocumentsAccess.granted(this)) {
            list.addView(text("Orb can read the PDFs you point it at \u2014 invoices, tickets, letters \u2014 so that what is in them can be found, "
                + "mentioned with the right person and turned into dates and commitments. It reads only when you tap, shows you the first words of "
                + "each file, and keeps only the ones you tick. It keeps the words, not the file. Nothing is kept about the ones you do not tick.", 13, false));
            list.addView(text("This needs no Android permission: you name the folder or the files, and Android gives Orb only those.", 12, false));
            list.addView(button("Turn on PDF files", new View.OnClickListener() {
                @Override public void onClick(View view) {
                    try {
                        DocumentsAccess.grant(SourcesActivity.this, journal);
                    } catch (IOException notRecorded) {
                        message("Orb could not record this, so it turned nothing on.");
                        return;
                    }
                    render();
                }
            }));
            return;
        }
        final String folder = DocumentsAccess.folder(this);
        list.addView(text(folder == null ? "On. Choose a folder, or pick files." : "On. A folder is chosen.", 13, false));
        if (folder != null) {
            list.addView(button("Look now", new View.OnClickListener() {
                @Override public void onClick(View view) { lookInFolder(Uri.parse(folder)); }
            }));
        }
        list.addView(button(folder == null ? "Choose a folder" : "Choose another folder", new View.OnClickListener() {
            @Override public void onClick(View view) {
                Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT_TREE);
                pick.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION | Intent.FLAG_GRANT_PERSISTABLE_URI_PERMISSION);
                startActivityForResult(pick, PICK_FOLDER);
            }
        }));
        list.addView(text("Android does not let an app be given the Downloads folder itself. Pick a folder inside it, or use Pick files, which does open Downloads.", 11, false));
        list.addView(button("Pick files", new View.OnClickListener() {
            @Override public void onClick(View view) {
                Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT);
                pick.addCategory(Intent.CATEGORY_OPENABLE);
                pick.setType("application/pdf");
                pick.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true);
                startActivityForResult(pick, PICK_FILES);
            }
        }));
        list.addView(button("Switch off PDF files", new View.OnClickListener() {
            @Override public void onClick(View view) {
                DocumentsAccess.revoke(SourcesActivity.this, journal);
                picked.clear();
                render();
            }
        }));
        results = new LinearLayout(this);
        results.setOrientation(LinearLayout.VERTICAL);
        list.addView(results);
        if (lookPicked && !picked.isEmpty()) {
            lookPicked = false;
            lookAt(new ArrayList<>(picked), 0);
        }
    }

    @Override
    protected void onActivityResult(int requestCode, int resultCode, Intent data) {
        super.onActivityResult(requestCode, resultCode, data);
        if (requestCode == PICK_MESSAGES) {
            if (resultCode == RESULT_OK && data != null && data.getData() != null && journal() != null && MessagesAccess.granted(this)) {
                messagesFile = data.getData();
                lookMessages = true;
            }
            return;
        }
        if (resultCode != RESULT_OK || data == null) return;
        Journal journal = journal();
        if (journal == null || !DocumentsAccess.granted(this)) return;
        if (requestCode == PICK_FOLDER && data.getData() != null) {
            try {
                DocumentsAccess.choose(this, journal, data.getData());
            } catch (IOException | RuntimeException notChosen) {
                message("Orb could not keep that folder.");
                return;
            }
            picked.clear();
        } else if (requestCode == PICK_FILES) {
            picked.clear();
            List<Uri> uris = new ArrayList<>();
            if (data.getClipData() != null) {
                for (int i = 0; i < data.getClipData().getItemCount(); i++) uris.add(data.getClipData().getItemAt(i).getUri());
            } else if (data.getData() != null) {
                uris.add(data.getData());
            }
            for (Uri uri : uris) picked.add(describe(uri));
            lookPicked = true;
        }
    }

    /** A picked file as the picker describes it: name, size, date. Android grants this screen those files and no others. */
    private DocumentsRules.Doc describe(Uri uri) {
        String name = "";
        long size = -1L;
        long modified = 0L;
        try (Cursor c = getContentResolver().query(uri, new String[] {OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE, "last_modified"}, null, null, null)) {
            if (c != null && c.moveToFirst()) {
                name = c.getString(0) == null ? "" : c.getString(0);
                size = c.isNull(1) ? -1L : c.getLong(1);
                modified = c.getColumnCount() > 2 && !c.isNull(2) ? c.getLong(2) : 0L;
            }
        } catch (RuntimeException unreadable) {
            // The picker gave an address and nothing more; the file is still listed, by what it is.
        }
        return new DocumentsRules.Doc(uri.toString(), name, "application/pdf", size, modified);
    }

    private void lookInFolder(Uri folder) {
        if (results == null) return;
        results.removeAllViews();
        results.addView(text("Looking in the folder\u2026", 13, false));
        final Uri tree = folder;
        looking = true;
        new Thread(new Runnable() {
            @Override public void run() {
                final List<DocumentsRules.Doc> all = DocumentsReader.list(SourcesActivity.this, tree);
                final List<DocumentsRules.Doc> listed = DocumentsRules.listed(all);
                final int leftOut = DocumentsRules.leftOut(all);
                runOnUiThread(new Runnable() {
                    @Override public void run() { lookAt(listed, leftOut); }
                });
            }
        }).start();
    }

    /** Shows the files and, one by one as each is read, what is in them. Records the look once when every file has been looked at. */
    private void lookAt(final List<DocumentsRules.Doc> docs, final int leftOut) {
        looking = true;
        results.removeAllViews();
        shown.clear();
        summary = text("Looking at " + docs.size() + (docs.size() == 1 ? " file\u2026" : " files\u2026"), 13, true);
        results.addView(summary);
        if (docs.isEmpty()) {
            summary.setText("No PDF files found here.");
            recordLook(0, 0);
            looking = false;
            return;
        }
        for (DocumentsRules.Doc doc : docs) {
            CheckBox box = new CheckBox(this);
            box.setText(label(doc));
            box.setEnabled(false);
            TextView status = text("Reading\u2026", 12, false);
            results.addView(box);
            results.addView(status);
            shown.add(new RowView(doc, box, status));
        }
        final DocumentsReader reader = new DocumentsReader(this);
        new Thread(new Runnable() {
            @Override public void run() {
                int keepable = 0;
                int unreadable = 0;
                for (int i = 0; i < docs.size(); i++) {
                    final RowView view = shown.get(i);
                    final DocumentsRules.Row row = DocumentsFlow.inspect(SourcesActivity.this, view.doc, reader);
                    if (row.keepable()) keepable++;
                    if (DocumentsRules.UNREADABLE.equals(row.state)) unreadable++;
                    runOnUiThread(new Runnable() {
                        @Override public void run() { show(view, row); }
                    });
                }
                final int canKeep = keepable;
                final int cannot = unreadable;
                runOnUiThread(new Runnable() {
                    @Override public void run() { finished(docs.size(), leftOut, canKeep, cannot); }
                });
            }
        }).start();
    }

    private void show(RowView view, DocumentsRules.Row row) {
        view.status.setText(DocumentsRules.statusLine(row));
        view.box.setEnabled(row.keepable());
    }

    private void finished(int count, int leftOut, int keepable, int unreadable) {
        looking = false;
        if (summary == null || results == null) return;
        summary.setText(DocumentsRules.summary(count, leftOut, keepable));
        recordLook(count, unreadable);
        if (keepable > 0) {
            results.addView(button("Keep the ticked ones", new View.OnClickListener() {
                @Override public void onClick(View view) { keepTicked(); }
            }));
        }
        results.addView(text("Only the words are kept, sealed on this phone; the PDF is not copied. Nothing is kept about files you do not tick.", 11, false));
    }

    private void recordLook(int found, int unreadable) {
        Journal journal = journal();
        if (journal != null) journal.append(DocumentsFacts.LOOKED, DocumentsFacts.looked(found, unreadable));
    }

    private String label(DocumentsRules.Doc doc) {
        String when = doc.modified > 0 ? new SimpleDateFormat("d MMM yyyy", Locale.getDefault()).format(new Date(doc.modified)) : "date unknown";
        return (doc.name.isEmpty() ? "(unnamed PDF)" : doc.name) + "\n" + when + " \u00b7 " + Recall.sizeLabel(doc.size);
    }

    private void keepTicked() {
        final List<DocumentsRules.Doc> ticked = new ArrayList<>();
        final List<RowView> tickedViews = new ArrayList<>();
        for (RowView v : shown) {
            if (v.box.isEnabled() && v.box.isChecked()) {
                ticked.add(v.doc);
                tickedViews.add(v);
            }
        }
        if (ticked.isEmpty()) {
            message("Nothing is ticked, so nothing was kept.");
            return;
        }
        final Journal journal = journal();
        if (journal == null) return;
        looking = true;
        final DocumentsReader reader = new DocumentsReader(this);
        new Thread(new Runnable() {
            @Override public void run() {
                final int kept = DocumentsFlow.keep(SourcesActivity.this, journal, ticked, reader, SystemClock.elapsedRealtime());
                journal.append(DocumentsFacts.KEPT, DocumentsFacts.kept(kept));
                final List<DocumentsRules.Row> after = new ArrayList<>();
                for (DocumentsRules.Doc doc : ticked) after.add(DocumentsFlow.inspect(SourcesActivity.this, doc, reader));
                runOnUiThread(new Runnable() {
                    @Override public void run() {
                        looking = false;
                        for (int i = 0; i < tickedViews.size(); i++) {
                            tickedViews.get(i).box.setChecked(false);
                            show(tickedViews.get(i), after.get(i));
                        }
                        if (summary != null) summary.setText("Kept " + kept + " of " + ticked.size() + ". Find the words in Recall.");
                    }
                });
            }
        }).start();
    }

    // ---- text messages, from a backup file the person makes and picks (`docs/MESSAGES_PHONE.md`)

    /** The file just picked; memory only, and Android's grant for it lasts only as long as this screen. */
    private Uri messagesFile;
    private boolean lookMessages;
    private LinearLayout messageResults;
    private MessagesFlow.Look messagesLook;
    /** Recomputes the fit paragraph from the tallies with the person's marks as they are now. */
    private void showFit() {
        if (messagesLook == null || fitText == null) return;
        currentFit = messagesLook.tally.report(Senders.quiet(this, journal()));
        fitText.setText(currentFit.say());
        if (recordFit != null) {
            recordFit.setText("Record this fit report (counts only)");
            recordFit.setEnabled(true);
        }
    }

    /** The fit paragraph and its record button; recomputed from the tallies whenever the person's sender marks may have changed. */
    private TextView fitText;
    private Button recordFit;
    private LoopFit.Report currentFit;
    private final List<CheckBox> messageBoxes = new ArrayList<>();
    private final List<MessagesRules.Conversation> messageRows = new ArrayList<>();
    private TextView tally;

    private void messages(final Journal journal) {
        list.addView(text("Text messages", 15, true));
        if (!MessagesAccess.granted(this)) {
            list.addView(text("Android and Google do not let an app installed like Orb read your texts directly, and Orb will not ask. But a free backup app "
                + "from the Play Store can write your messages to a file, and Orb can read that file the way it reads a PDF: you pick it, you see the "
                + "conversations, and only the ones you tick are kept \u2014 as words, sealed, tied to the right person by their number.", 13, false));
            list.addView(text("Bank and one-time-code messages are left out and only counted. Only finished months are kept. The backup file holds every message "
                + "in the clear, so delete it when you are done: Orb never makes or deletes it.", 12, false));
            list.addView(button("Turn on text messages", new View.OnClickListener() {
                @Override public void onClick(View view) {
                    try {
                        MessagesAccess.grant(SourcesActivity.this, journal);
                    } catch (IOException notRecorded) {
                        message("Orb could not record this, so it turned nothing on.");
                        return;
                    }
                    render();
                }
            }));
            return;
        }
        list.addView(text("On. Pick the backup file (XML or JSON) your backup app made.", 13, false));
        list.addView(button("Pick the backup file", new View.OnClickListener() {
            @Override public void onClick(View view) {
                Intent pick = new Intent(Intent.ACTION_OPEN_DOCUMENT);
                pick.addCategory(Intent.CATEGORY_OPENABLE);
                pick.setType("*/*");
                startActivityForResult(pick, PICK_MESSAGES);
            }
        }));
        list.addView(button("Switch off text messages", new View.OnClickListener() {
            @Override public void onClick(View view) {
                MessagesAccess.revoke(SourcesActivity.this, journal);
                messagesFile = null;
                messagesLook = null;
                SenderSession.clear();
                render();
            }
        }));
        messageResults = new LinearLayout(this);
        messageResults.setOrientation(LinearLayout.VERTICAL);
        list.addView(messageResults);
        if (lookMessages && messagesFile != null) {
            lookMessages = false;
            startMessagesLook(messagesFile);
        }
    }

    private boolean lookRecorded;

    private void startMessagesLook(final Uri file) {
        lookRecorded = false;
        messageResults.removeAllViews();
        messageBoxes.clear();
        messageRows.clear();
        messageResults.addView(text("Reading the file\u2026 this can take a little while for a big one.", 13, false));
        looking = true;
        new Thread(new Runnable() {
            @Override public void run() {
                long size = MessagesReader.sizeOf(SourcesActivity.this, file);
                MessagesFlow.Look result = null;
                String failure = null;
                if (size > MessagesRules.MAX_BYTES) {
                    failure = "That file is over 200 MB, which Orb will not read.";
                } else {
                    try {
                        result = MessagesFlow.look(new MessagesReader(SourcesActivity.this, file), System.currentTimeMillis(), java.util.TimeZone.getDefault());
                    } catch (Exception unreadable) {
                        failure = "Orb could not read that file (" + unreadable.getClass().getSimpleName() + "). It looks like "
                            + new MessagesReader(SourcesActivity.this, file).kind() + "; Orb reads message backups written as XML or JSON.";
                    }
                }
                final MessagesFlow.Look found = result;
                final String why = failure;
                runOnUiThread(new Runnable() {
                    @Override public void run() { showMessagesLook(found, why); }
                });
            }
        }).start();
    }

    private void showMessagesLook(MessagesFlow.Look found, String failure) {
        looking = false;
        if (messageResults == null) return;
        messageResults.removeAllViews();
        Journal journal = journal();
        if (found == null) {
            messageResults.addView(text(failure, 13, true));
            return;
        }
        MessagesRules.Survey survey = found.survey;
        if (journal != null && !lookRecorded) {
            journal.append(MessagesFacts.LOOKED_TYPE, MessagesFacts.looked(survey.by.size(), survey.total, found.leftOut()));
            lookRecorded = true;   // drawing the same Look again (after the Senders screen) is not a second look
        }
        if (!found.recognition.recognised()) {
            messageResults.addView(text(found.recognition.describe(), 13, true));
            return;
        }
        messagesLook = found;
        // People you said you are in regular touch with (What Orb has noticed, if it is on) are marked and listed first. Nothing is ticked for you.
        java.util.Set<String> close = new java.util.HashSet<>();
        if (UnderstandingAccess.granted(this)) {
            try {
                close = Understanding.closeNumbers(survey.by.keySet(), UnderstandingFacts.verdicts(journal.readLines()), UnderstandingFacts.keyer(this));
            } catch (Exception cannotTell) {
                close = new java.util.HashSet<>();   // cannot tell who: nothing is marked rather than a guess
            }
        }
        final java.util.Set<String> closeHere = close;
        List<MessagesRules.Conversation> rows = survey.listed(close);
        messageResults.addView(text(survey.by.size() + (survey.by.size() == 1 ? " conversation" : " conversations") + " can be kept"
            + (survey.leftOutConversations() > 0 ? " (the " + MessagesRules.MAX_LISTED + " most recent are listed" + (close.isEmpty() ? "" : ", with the people you are in regular touch with first") + ")" : "") + ".", 13, true));
        messageResults.addView(text("Left out, and only counted: " + survey.service + " from names or short codes (banks, offers, codes) \u00b7 " + survey.codes
            + " that look like codes \u00b7 " + survey.outside + " from this month or older than a year \u00b7 " + survey.other + " drafts or other kinds."
            + (found.recognition.cut ? " The file is longer than " + MessagesRules.MAX_MESSAGES + " messages; Orb read the first " + MessagesRules.MAX_MESSAGES + "." : ""), 11, false));
        SenderSession.hold(found.tally);
        fitText = text("", 11, false);
        messageResults.addView(fitText);
        recordFit = button("Record this fit report (counts only)", null);
        recordFit.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) {
                Journal now = journal();
                boolean written = now != null && currentFit != null && now.append(LoopFacts.FIT_REPORTED, LoopFacts.fitReported(currentFit)) != null;
                recordFit.setText(written ? "Recorded \u2014 counts and sender codes only" : "Could not record it");
                recordFit.setEnabled(!written);
            }
        });
        messageResults.addView(recordFit);
        messageResults.addView(button("Senders\u2026 (mark those that are not about your obligations)", new View.OnClickListener() {
            @Override public void onClick(View view) { startActivity(new android.content.Intent(SourcesActivity.this, SendersActivity.class)); }
        }));
        showFit();
        final java.util.TimeZone zone = java.util.TimeZone.getDefault();
        for (MessagesRules.Conversation c : rows) {
            CheckBox box = new CheckBox(this);
            box.setText(MessagesRules.rowLabel(c, zone, closeHere.contains(c.number)));
            box.setOnCheckedChangeListener(new android.widget.CompoundButton.OnCheckedChangeListener() {
                @Override public void onCheckedChanged(android.widget.CompoundButton b, boolean checked) { updateTally(); }
            });
            messageResults.addView(box);
            messageResults.addView(text("Last: " + c.snippet, 12, false));
            messageBoxes.add(box);
            messageRows.add(c);
        }
        if (!closeHere.isEmpty()) {
            int shown = 0;
            for (MessagesRules.Conversation c : rows) if (closeHere.contains(c.number)) shown++;
            messageResults.addView(text(shown + (shown == 1 ? " listed conversation is" : " listed conversations are") + " with people you said you are in regular touch with.", 12, false));
            messageResults.addView(button("Tick those " + shown, new View.OnClickListener() {
                @Override public void onClick(View view) {
                    for (int i = 0; i < messageBoxes.size(); i++) if (closeHere.contains(messageRows.get(i).number)) messageBoxes.get(i).setChecked(true);
                }
            }));
        }
        tally = text("", 12, true);
        messageResults.addView(tally);
        updateTally();
        if (!rows.isEmpty()) {
            messageResults.addView(button("Keep the ticked ones", new View.OnClickListener() {
                @Override public void onClick(View view) { keepMessages(); }
            }));
        }
        messageResults.addView(text("Only the words are kept, sealed on this phone, one item per finished month. Delete the backup file when you are done.", 11, false));
    }

    /** *3 conversations ticked \u2014 up to 14 items (at most 60 per Keep). Orb holds 312 kept items; its screens read the newest 500.* */
    private void updateTally() {
        if (tally == null) return;
        int ticked = 0;
        int items = 0;
        for (int i = 0; i < messageBoxes.size(); i++) {
            if (messageBoxes.get(i).isChecked()) {
                ticked++;
                items += messageRows.get(i).months.size();
            }
        }
        Journal journal = journal();
        int held = 0;
        try {
            if (journal != null) held = MessagesFlow.heldItems(journal.readLines());
        } catch (IOException unreadable) {
            held = -1;
        }
        String hold = held < 0 ? "" : " Orb holds " + held + " kept items" + (held + Math.min(items, MessagesRules.MAX_ITEMS_PER_KEEP) > Recall.SCAN_LIMIT - 100
            ? " and its screens read only the newest " + Recall.SCAN_LIMIT + " \u2014 this may push older ones out of view." : "; its screens read the newest " + Recall.SCAN_LIMIT + ".");
        tally.setText(ticked + (ticked == 1 ? " conversation ticked" : " conversations ticked") + " \u2014 up to " + items + (items == 1 ? " item" : " items")
            + " (at most " + MessagesRules.MAX_ITEMS_PER_KEEP + " per Keep)." + hold);
    }

    private void keepMessages() {
        final java.util.Set<String> numbers = new java.util.HashSet<>();
        for (int i = 0; i < messageBoxes.size(); i++) if (messageBoxes.get(i).isChecked()) numbers.add(messageRows.get(i).number);
        if (numbers.isEmpty()) {
            message("Nothing is ticked, so nothing was kept.");
            return;
        }
        final Journal journal = journal();
        final Uri file = messagesFile;
        if (journal == null || file == null) return;
        looking = true;
        new Thread(new Runnable() {
            @Override public void run() {
                MessagesFlow.Kept kept = null;
                String failure = null;
                try {
                    kept = MessagesFlow.keep(SourcesActivity.this, journal, new MessagesReader(SourcesActivity.this, file), numbers, System.currentTimeMillis(),
                        java.util.TimeZone.getDefault(), SystemClock.elapsedRealtime());
                } catch (Exception unreadable) {
                    failure = "Orb could not keep these (" + unreadable.getClass().getSimpleName() + ").";
                }
                final MessagesFlow.Kept done = kept;
                final String why = failure;
                runOnUiThread(new Runnable() {
                    @Override public void run() {
                        looking = false;
                        if (done != null) journal.append(MessagesFacts.KEPT_TYPE, MessagesFacts.kept(done.kept));
                        if (messageResults == null) return;
                        String said = done == null ? why : "Kept " + done.kept + (done.kept == 1 ? " month" : " months") + ". Already in Orb: " + done.held
                            + " \u00b7 an earlier version of the month is already in Orb: " + done.earlier + " \u00b7 erased before, not kept again: " + done.erased
                            + (done.capped > 0 ? " \u00b7 not kept, over the " + MessagesRules.MAX_ITEMS_PER_KEEP + " per Keep: " + done.capped : "")
                            + ". Find them in Recall. Delete the backup file now.";
                        messageResults.addView(text(said, 13, true));
                    }
                });
            }
        }).start();
    }
}
