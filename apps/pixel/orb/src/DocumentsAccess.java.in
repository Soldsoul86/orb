package @PKG@;

import android.content.Context;
import android.content.Intent;
import android.net.Uri;
import android.os.SystemClock;
import java.io.File;
import java.io.IOException;
import java.io.RandomAccessFile;
import java.nio.charset.StandardCharsets;
import java.util.Map;

/**
 * Whether Orb may read the Documents folder, and which folder — a **recorded decision of the person's** (`docs/SOURCES_PHONE.md`, the
 * same shape as `SafetyAccess`): the grant is an event, the flag follows it, a revocation removes the flag, releases the folder
 * Android was holding open for Orb, and then says so; after a restore the history is made to agree with the phone.
 *
 * The folder is held as Android's own persisted grant to **that one folder**, with its address kept in a small file beside the
 * flag. The address is not a record of anything read and is not in the journal.
 *
 * **Nothing here reads a document.** `DocumentsReader` does, only after this says yes.
 */
final class DocumentsAccess {
    private DocumentsAccess() {}

    private static final String FLAG = "documents-access.granted";
    private static final String FOLDER = "documents-access.folder";

    static boolean granted(Context context) {
        return new File(context.getFilesDir(), FLAG).exists();
    }

    /** The chosen folder's address, or null when none is chosen. */
    static String folder(Context context) {
        File file = new File(context.getFilesDir(), FOLDER);
        if (!file.exists()) return null;
        try (java.io.FileInputStream in = new java.io.FileInputStream(file)) {
            byte[] bytes = new byte[(int) Math.min(file.length(), 4096)];
            int n = in.read(bytes);
            String uri = new String(bytes, 0, Math.max(0, n), StandardCharsets.UTF_8).trim();
            return uri.isEmpty() ? null : uri;
        } catch (IOException unreadable) {
            return null;
        }
    }

    /** Event first, then the flag: a crash in between leaves a grant on record that the device does not yet exercise — the harmless direction. */
    static void grant(Context context, Journal journal) throws IOException {
        if (granted(context)) return;
        record(journal, PackageGrants.GRANTED, "operator");
        try (RandomAccessFile out = new RandomAccessFile(new File(context.getFilesDir(), FLAG), "rws")) {
            out.write(new byte[] {1});
            out.getFD().sync();
        }
    }

    /** Remembers the folder the person chose, takes Android's persisted read access to it, and says so — counts only. */
    static void choose(Context context, Journal journal, Uri tree) throws IOException {
        context.getContentResolver().takePersistableUriPermission(tree, Intent.FLAG_GRANT_READ_URI_PERMISSION);
        String previous = folder(context);
        try (java.io.FileOutputStream out = new java.io.FileOutputStream(new File(context.getFilesDir(), FOLDER))) {
            out.write(tree.toString().getBytes(StandardCharsets.UTF_8));
            out.getFD().sync();
        }
        if (previous != null && !previous.equals(tree.toString())) release(context, previous);
        if (journal != null) journal.append(DocumentsFacts.CHOSEN, DocumentsFacts.chosen());
    }

    /** Flag first, then the event: stop reading, then say so. The folder access Android held is let go. */
    static void revoke(Context context, Journal journal) {
        new File(context.getFilesDir(), FLAG).delete();
        String folder = folder(context);
        new File(context.getFilesDir(), FOLDER).delete();
        if (folder != null) release(context, folder);
        record(journal, PackageGrants.REVOKED, "operator");
    }

    /** A restore brings the journal back and grants nothing: if it says *granted* and the flag is absent, record the revocation. */
    static void reconcile(Context context, Journal journal) {
        if (journal == null || granted(context)) return;
        try {
            if (PackageGrants.lastIsGrant(journal.readLines(), Capabilities.DOCUMENTS)) record(journal, PackageGrants.REVOKED, "reconcile");
        } catch (IOException unreadable) {
            // Cannot read the history, so cannot say what it claims. Write nothing.
        }
    }

    private static void release(Context context, String uri) {
        try {
            context.getContentResolver().releasePersistableUriPermission(Uri.parse(uri), Intent.FLAG_GRANT_READ_URI_PERMISSION);
        } catch (RuntimeException alreadyGone) {
            // Android no longer held it; nothing to let go.
        }
    }

    private static void record(Journal journal, String type, String by) {
        if (journal == null) return;
        Map<String, Object> payload = Json.obj();
        payload.put("capability", Capabilities.DOCUMENTS);
        payload.put("tier", Capabilities.TIER_OBSERVE);
        payload.put("scope", "the PDF files you point Orb at, read only when you tap Look now");
        payload.put("by", by);
        payload.put("elapsedRealtimeMs", SystemClock.elapsedRealtime());
        journal.append(type, payload);
    }
}
