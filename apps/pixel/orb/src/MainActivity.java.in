package @PKG@;

import android.app.Activity;
import android.content.ContentResolver;
import android.content.ContentValues;
import android.content.Intent;
import android.graphics.Typeface;
import android.net.Uri;
import android.os.Bundle;
import android.os.Environment;
import android.provider.MediaStore;
import android.view.View;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import java.io.IOException;
import java.io.OutputStream;
import java.nio.charset.StandardCharsets;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;
import java.util.Locale;
import java.util.Map;

/**
 * Enough of a screen to see the identity, hand things to Orb, and get the
 * journal off the phone. Not a product surface — the output is the journal.
 */
public final class MainActivity extends Activity {
    private TextView status;
    private TextView backupLine;

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(40, 120, 40, 40);

        TextView title = new TextView(this);
        title.setText("Orb");
        title.setTextSize(17);
        title.setTypeface(Typeface.DEFAULT_BOLD);
        root.addView(title);

        Button export = new Button(this);
        export.setText("Export and share journal");
        export.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { export(); }
        });
        root.addView(export);

        // Durability (docs/DURABILITY.md): the line that says whether losing this phone loses everything.
        backupLine = new TextView(this);
        backupLine.setTextSize(12);
        backupLine.setPadding(0, 8, 0, 8);
        root.addView(backupLine);

        Button backupButton = new Button(this);
        backupButton.setText("Back up and restore");
        backupButton.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { startActivity(new Intent(MainActivity.this, BackupActivity.class)); }
        });
        root.addView(backupButton);

        // Step 7 / A8: read back, search, and erase what Orb remembered.
        Button recall = new Button(this);
        recall.setText("What Orb remembered");
        recall.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { startActivity(new Intent(MainActivity.this, RecallActivity.class)); }
        });
        root.addView(recall);

        // Step 7: Orb as the assistant, and the apps it may remember from.
        Button choose = new Button(this);
        choose.setText("Use Orb as the assistant");
        choose.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { openAssistantSettings(); }
        });
        root.addView(choose);

        Button apps = new Button(this);
        apps.setText("Apps Orb may remember from");
        apps.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { startActivity(new Intent(MainActivity.this, AllowActivity.class)); }
        });
        root.addView(apps);

        // What Orb keeps under a key it can destroy, and the way to destroy one (step 6).
        Button items = new Button(this);
        items.setText("Kept by Orb: erase");
        items.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { startActivity(new Intent(MainActivity.this, ItemsActivity.class)); }
        });
        root.addView(items);

        // The §7b32 probe, behind an explicit tap. It *is* the Capability act
        // it is testing for (`Resolve`), so it never runs on its own.
        Button resolve = new Button(this);
        resolve.setText("Test: can the last share still be read?");
        resolve.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { resolveProbe(); }
        });
        root.addView(resolve);

        // AD-7, half paid: the package scan does not run until this is tapped,
        // and the grant, the refusal and the revocation are all events.
        Button access = new Button(this);
        access.setText("Package scanning: grant / revoke");
        access.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { togglePackageAccess(); }
        });
        root.addView(access);

        Button scan = new Button(this);
        scan.setText("Scan installed packages now");
        scan.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { scanNow(); }
        });
        root.addView(scan);

        status = new TextView(this);
        status.setTextSize(12);
        status.setTypeface(Typeface.MONOSPACE);
        status.setTextIsSelectable(true);
        root.addView(status);

        ScrollView scroll = new ScrollView(this);
        scroll.addView(root);
        setContentView(scroll);
    }

    /**
     * Shows the identity and what has been recorded under it.
     *
     * **The identity is on screen deliberately.** AD-8 came from two installs
     * being indistinguishable, and the cheapest guard against a repeat is that a
     * person can read which install they are looking at without exporting
     * anything.
     */
    @Override
    protected void onResume() {
        super.onResume();
        Orb app = Orb.get();
        Journal journal = app == null ? null : app.journal();
        // The line that says whether losing this phone loses everything is first, and always refreshed.
        backupLine.setText(BackupActivity.lastLine(journal));
        if (journal == null) {
            status.setText("\njournal unavailable");
            return;
        }
        try {
            List<String> lines = journal.readLines();
            StringBuilder out = new StringBuilder("\ninstall  ");
            out.append(app.install()).append('\n');
            out.append("lane     ").append(app.install()).append('\n');
            out.append("package  ").append(getPackageName()).append('\n');
            out.append("events   ").append(lines.size()).append('\n');
            out.append("scanning ").append(PackageAccess.granted(this) ? "granted" : "not granted").append('\n');
            out.append("\nShare anything to Orb to record it.\n");
            status.setText(out.toString());
        } catch (IOException error) {
            status.setText("\nread failed: " + error);
        }
    }

    /** Grants or revokes the one read in this app that needs authorizing. */
    private void togglePackageAccess() {
        Orb app = Orb.get();
        Journal journal = app == null ? null : app.journal();
        if (journal == null) {
            status.setText("\njournal unavailable");
            return;
        }
        try {
            if (PackageAccess.granted(this)) {
                PackageAccess.revoke(this, journal);
                status.setText("\npackage scanning REVOKED\nrecorded as " + PackageAccess.REVOKED + "\n");
            } else {
                PackageAccess.grant(this, journal);
                status.setText("\npackage scanning GRANTED (tier Observe)\nrecorded as "
                    + PackageAccess.GRANTED + "\n");
            }
        } catch (IOException error) {
            status.setText("\ncould not record the change: " + error);
        }
    }

    /**
     * An operator-requested scan.
     *
     * The count is read back out of the event that was just written rather than
     * out of the variable that produced it — the journal is the record, and a
     * screen showing a number the journal does not hold would be a second source
     * of truth the size of one line.
     */
    private void scanNow() {
        Orb app = Orb.get();
        Map<String, Object> report = app == null || app.watch() == null
            ? null : app.watch().scanPackages("operator.scan");
        if (report == null) {
            status.setText("\nscan failed: journal unavailable");
            return;
        }
        if (Boolean.FALSE.equals(report.get("installedPackageReadable"))) {
            status.setText("\nscan REFUSED — not granted\nthe refusal is on the record, "
                + "because \"nobody authorized it\" and \"nothing was found\" are opposite facts\n");
            return;
        }
        StringBuilder out = new StringBuilder("\nscanned installed packages\n");
        out.append("count  ").append(report.get("installedPackageHoldingCount")).append('\n');
        out.append("scope  ").append(report.get("installedPackageScope")).append('\n');
        out.append(Boolean.TRUE.equals(report.get("changed"))
            ? "something changed since the last scan\n"
            : "nothing changed since the last scan\n");
        status.setText(out.toString());
    }

    /**
     * Attempts the last share's reference, and records what happened.
     *
     * The answer §7b32 needs: whether a URI granted to `ShareActivity` outlives
     * the activity it was granted to. Expected from the platform's model is not
     * the same as measured on the device, and this is the measurement.
     */
    private void resolveProbe() {
        Orb app = Orb.get();
        Journal journal = app == null ? null : app.journal();
        if (journal == null) {
            status.setText("\njournal unavailable");
            return;
        }
        Map<String, Object> report = Resolve.attempt(this, journal);
        journal.append("orb.resolve.attempt", report);

        StringBuilder out = new StringBuilder("\nprobe: can the last share still be read?\n");
        out.append("outcome  ").append(report.get("outcome")).append('\n');
        Object since = report.get("sinceShareMs");
        if (since instanceof Long) {
            out.append("age      ").append(((Long) since) / 1000L).append(" s since the share\n");
        }
        Object threw = report.get("threw");
        if (threw != null) out.append("threw    ").append(threw).append('\n');
        Object bytes = report.get("bytesRead");
        if (bytes != null) out.append("bytes    ").append(bytes).append(" (read and discarded)\n");
        out.append("\nrecorded as orb.resolve.attempt\n");
        status.setText(out.toString());
    }

    /**
     * The system screen where the default assistant is chosen. Nothing here can make Orb
     * the assistant; only the person can, there. Falls back to the broader default-apps
     * screen if the first is not offered.
     */
    private void openAssistantSettings() {
        try {
            startActivity(new Intent(android.provider.Settings.ACTION_VOICE_INPUT_SETTINGS));
        } catch (RuntimeException first) {
            try {
                startActivity(new Intent(android.provider.Settings.ACTION_MANAGE_DEFAULT_APPS_SETTINGS));
            } catch (RuntimeException second) {
                status.setText("\ncould not open settings\nSettings > Apps > Default apps > Digital assistant app");
            }
        }
    }

    /**
     * Writes the journal to Downloads, recording the disclosure first.
     *
     * **The export names its own source**, which the pass-1 and pass-2 exports
     * never did — AD-8's third requirement. Four packages writing lane `pixel`
     * produced four files that nothing in the data could tell apart, and the
     * precedent for the fix was already in this repository: `dev.orb.probeg`'s
     * capability report opens by naming its package (`DEVICE_LOOP.md` §7b30).
     * This follows it.
     *
     * The install identity is on every envelope as `device`, so it is not
     * repeated here — that would be a second source of truth for one fact
     * (Art. IX §33). The **package** is not derivable from any envelope, so it is.
     */
    private void export() {
        Orb app = Orb.get();
        Journal journal = app == null ? null : app.journal();
        if (journal == null) {
            status.setText("\njournal unavailable");
            return;
        }

        try {
            List<String> lines = journal.readLines();
            String name = "orb-" + new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(new Date()) + ".txt";

            Map<String, Object> record = Json.obj();
            record.put("destination", "Downloads/" + name);
            record.put("eventsBeforeThis", (long) lines.size());
            record.put("reason", "operator export");
            // The two things a reader of the file alone cannot otherwise recover.
            record.put("package", getPackageName());
            record.put("exportScope", "whole-lane");
            // The state of the store, not only its declarations: keys held, identities
            // destroyed. Numbers, never content (step 6).
            long[] keys = Attachments.counts(this);
            record.put("attachmentKeysHeld", keys[0]);
            record.put("attachmentsDestroyed", keys[1]);
            journal.append("orb.export", record);

            // Re-read, so the file contains the record of its own export. A
            // disclosure missing from the copy it produced would be a gap in the
            // history the copy exists to carry.
            lines = journal.readLines();

            ContentValues values = new ContentValues();
            values.put(MediaStore.Downloads.DISPLAY_NAME, name);
            values.put(MediaStore.Downloads.MIME_TYPE, "text/plain");
            values.put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);

            ContentResolver resolver = getContentResolver();
            Uri target = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
            if (target == null) {
                status.setText("\nexport failed: no destination");
                return;
            }
            try (OutputStream out = resolver.openOutputStream(target)) {
                if (out == null) {
                    status.setText("\nexport failed: destination not writable");
                    return;
                }
                for (String line : lines) {
                    out.write(line.getBytes(StandardCharsets.UTF_8));
                    out.write('\n');
                }
            }
            status.setText("\nexported " + lines.size() + " events\nDownloads/" + name);
        } catch (IOException error) {
            status.setText("\nexport failed: " + error);
        }
    }
}
