package @PKG@;

import java.util.ArrayList;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * Everything Orb may do or read, declared in one place (`docs/GATE_READS_PHONE.md`, DR-22) — the registry `AD-7` asked for.
 *
 * `Capability.md` §1: *reads are capabilities too* — they cost privacy even when nothing leaves the device. Four are declared
 * here, each frozen with its text pinned by a test (a wider read is a **new** capability, never an edit): the package scan, the
 * assistant's screen read, the grants watch, and the reminder (declared in `Reminders`).
 *
 * **Nothing about how they behave is defined here.** The scan, the assistant and the watch run as they always have; their
 * records are the events they already write, and this registry names them (`recordsAs`) and reads them back. A second record
 * beside the first would be two sources of truth for one fact. `state` and `lastUse` are projections over the journal.
 *
 * **Held by tests:** the declarations are pinned; every platform read in the source sits in a file a declaration names; and the
 * reads Orb does not have — contacts, calendar, location, the clipboard, the microphone, the camera — appear **nowhere** until a
 * capability declares them (`CapabilitiesTest`). A fifth read added without a declaration fails the build.
 */
final class Capabilities {
    private Capabilities() {}

    static final String TIER_OBSERVE = "Observe";
    static final String TIER_ACT_REVERSIBLE = "Act (reversible)";

    /** One declared capability. */
    static final class Declaration {
        final String id;
        final long version;
        final String title;
        /** What it does, in the words a person reads. Frozen with the version. */
        final String says;
        final String tier;
        final String authorizedBy;
        /** The event types that are the record of its use — already written, never duplicated. */
        final List<String> recordsAs;
        final String withdrawnBy;
        /** Whether the person can switch it off. */
        final boolean switchable;
        /** The source files that perform its platform reads (what the guard holds each read to). */
        final List<String> files;

        Declaration(String id, long version, String title, String says, String tier, String authorizedBy,
                    List<String> recordsAs, String withdrawnBy, boolean switchable, List<String> files) {
            this.id = id;
            this.version = version;
            this.title = title;
            this.says = says;
            this.tier = tier;
            this.authorizedBy = authorizedBy;
            this.recordsAs = Collections.unmodifiableList(recordsAs);
            this.withdrawnBy = withdrawnBy;
            this.switchable = switchable;
            this.files = Collections.unmodifiableList(files);
        }
    }

    static final String PACKAGES = "installedPackages.read";
    static final String SCREEN = "orb.read.screen";
    static final String GRANTS = "orb.read.grants";
    static final String CONTACTS = "orb.read.contacts";
    static final String APPSEC = "orb.read.appsecurity";
    static final long APPSEC_VERSION = 1L;
    static final String MESSAGES = "orb.read.messages";
    static final long MESSAGES_VERSION = 1L;
    static final String CALLS = "orb.read.calls";
    static final long CALLS_VERSION = 1L;
    static final String BRIEF = "orb.brief.daily";
    static final long BRIEF_VERSION = 1L;
    static final String SENDERS = "orb.messages.senders";
    static final long SENDERS_VERSION = 1L;
    static final String OBS_KEEP = "orb.observations.keep";
    static final long OBS_KEEP_VERSION = 1L;
    static final String UNDERSTAND = "orb.understand";
    static final long UNDERSTAND_VERSION = 1L;
    static final String DOCUMENTS = "orb.read.documents";
    static final long DOCUMENTS_VERSION = 1L;

    static final String PACKAGES_SAYS =
