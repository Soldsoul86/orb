package @PKG@;

import android.app.admin.DevicePolicyManager;
import android.content.ComponentName;
import android.content.Context;
import android.content.Intent;
import android.content.pm.PackageInfo;
import android.content.pm.PackageManager;
import android.content.pm.ResolveInfo;
import android.provider.Settings;
import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * The platform reads, and nothing else.
 *
 * The three grant reads cost **no permission of any kind** — confirmed on this
 * device on 2026-09-26 by `apps/pixel/probe-grants` (`DEVICE_LOOP.md` §7,
 * P12–P14, all three answered). None of it was assumed.
 *
 * The fourth read, the installed-package set, is the one exception and it is
 * declared as such: it wants `QUERY_ALL_PACKAGES` to be complete, and it records
 * which completeness it got instead of hoping. See `packages`.
 *
 * The contract with `Grants` is one value: a `null` list means *we could not
 * find out*, and an empty list means *we found out, and it is none*. Nothing
 * here may return the second when it means the first.
 */
final class GrantReader {

    private GrantReader() {}

    /** Reads the three grants once. `null` for a kind means the read did not settle it. */
    static Map<String, List<String>> read(Context context) {
        Map<String, List<String>> out = new HashMap<>();
        out.put("accessibility",
            secure(context, Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES));
        // The constant is `@hide`, so the key is spelled out. Naming a setting is
        // exactly what a third-party app may do, which is the whole basis of this.
        out.put("notificationListener", secure(context, "enabled_notification_listeners"));
        out.put("deviceAdmin", admins(context));
        return out;
    }

    /**
     * The package set, read only when a scan asks for it.
     *
     * Separate from `read` because it is separately expensive and separately
     * timed — `Grants.PACKAGE_KINDS` says why. The map has the same shape as
     * `read`'s so `Grants.report` needs no special case for it.
     */
    static Map<String, List<String>> readPackages(Context context) {
        Map<String, List<String>> out = new HashMap<>();
        out.put("installedPackage", packages(context));
        return out;
    }

    /**
     * The scope of each set that has one, for `Grants.report`.
     *
     * Only the package set: the three grant lists are whole or unreadable, with
     * no middle. Read in the same breath as the set itself so the two cannot
     * disagree.
     */
    static Map<String, String> scopes(Context context) {
        Map<String, String> out = new HashMap<>();
        out.put("installedPackage", packageScope(context));
        return out;
    }

    /**
     * Every installed package, and why this one read is not like the others.
     *
     * `getInstalledPackages` is **filtered** on API 30 and up: without
     * `QUERY_ALL_PACKAGES` an app sees only what it has declared a `<queries>`
     * interest in, plus a handful the platform always shows. A filtered list is
     * not a wrong answer — it is an answer to a different question, and the
     * damage is done by treating the two as one. So the list is read, and
     * `packageScope` records which question was answered.
     *
     * `null` on a throw, never an empty list: on a device that returned nothing,
     * *every app has been uninstalled* is the reading that would follow, and it
     * would be the loudest false alarm this app is capable of.
     */
    private static List<String> packages(Context context) {
        // Without the broad permission the platform's list moves with what Orb was doing (an app that just
        // handed it a share appears, then vanishes). The set is then exactly the apps matching the queries the
        // manifest declares, which does not (`docs/SENSOR_GRANTS.md` §9).
        if (!queriesAllPackages(context)) return PackageQueries.read(context);
        try {
            PackageManager manager = context.getPackageManager();
            if (manager == null) return null;
            List<PackageInfo> installed = manager.getInstalledPackages(0);
            if (installed == null) return null;
            List<String> names = new ArrayList<>();
            for (PackageInfo info : installed) {
                if (info != null && info.packageName != null) names.add(info.packageName);
            }
            return names;
        } catch (Throwable error) {
            return null;
        }
    }

    /**
     * Which look the package list was: `all`, or `declared` (the apps matching the queries the manifest declares).
     *
     * `QUERY_ALL_PACKAGES` is a normal, install-time permission, so on a build
     * that declares it this is granted without anyone being asked — and on a
     * build that drops it, this returns `visible` and the comparison re-baselines
     * once rather than reporting the difference as two hundred uninstalls
     * (`Grants.previous`). That is why the field exists: so the permission is a
     * decision someone can reverse in one line of manifest without this signal
     * lying on either side of the change.
     *
     * `unknown` is kept distinct from both. A check that threw is not a filtered
     * look, and recording it as one would compare two sets that may not be
     * comparable.
     */
    private static String packageScope(Context context) {
        try {
            // `declared`: the apps matching the queries the manifest declares (launchers, UPI handlers,
            // device admins) — a *different set* from the `visible` and `visible+upi` earlier builds
            // recorded, so the scope changes and the comparison re-baselines once, rather than reporting
            // the difference as installs and uninstalls.
            return queriesAllPackages(context) ? "all" : DeclaredPackages.SCOPE;
        } catch (Throwable error) {
            return "unknown";
        }
    }

    private static boolean queriesAllPackages(Context context) {
        try {
            return context.checkSelfPermission("android.permission.QUERY_ALL_PACKAGES") == PackageManager.PERMISSION_GRANTED;
        } catch (Throwable error) {
            return false;
        }
    }

    /** One `Settings.Secure` list. A throw is unknown; a null setting is none. */
    private static List<String> secure(Context context, String key) {
        try {
            String raw = Settings.Secure.getString(context.getContentResolver(), key);
            // A null setting here genuinely means the row was never written, i.e.
            // nothing is enabled. Both lists on this platform are created the
            // first time something is granted, and both came back non-null with
            // a value once something was.
            return Grants.split(raw);
        } catch (Throwable error) {
            return null;
        }
    }

    /**
     * Active device admins — and the reason this is not one line.
     *
     * `getActiveAdmins()` returns **`null` when none is active**, measured on
     * this device: four readings with nothing enabled all returned `null`, and
     * the reading with Find Hub's admin on returned a one-element list. So a
     * bare `null` cannot be handed to `Grants` as *unknown* — this kind would
     * then be unreadable on every ordinary phone forever, re-baselining at every
     * process start and never able to report a change.
     *
     * Nor can `null` simply be read as *none*: a platform that withheld the list
     * would produce the identical value, and then a real stalkerware admin would
     * be recorded as an empty set. **Both readings are wrong on their own.**
     *
     * `isAdminActive` settles it. It is public, takes any component, needs no
     * permission and does not require being that admin, so asking it once per
     * installed admin receiver is a second route to the same fact. If it says
     * nothing is active, a `null` enumeration is *none*; if it says something is
     * active while the enumeration is empty, the list is being withheld and this
     * returns `null` — unknown, honestly.
     */
    private static List<String> admins(Context context) {
        try {
            DevicePolicyManager policy =
                (DevicePolicyManager) context.getSystemService(Context.DEVICE_POLICY_SERVICE);
            if (policy == null) return null;

            List<ComponentName> enumerated = policy.getActiveAdmins();
            if (enumerated != null && !enumerated.isEmpty()) {
                List<String> names = new ArrayList<>();
                for (ComponentName admin : enumerated) names.add(admin.flattenToShortString());
                return names;
            }

            // Nothing enumerated. Find out whether that is true before recording it.
            List<String> active = activeByComponent(context, policy);
            if (active == null) return null;      // could not corroborate: unknown
            if (active.isEmpty()) return active;  // corroborated: genuinely none
            // Corroborated the other way: something is active and the bulk call
            // did not say so. The active set is withheld, and saying "none" here
            // would be the one failure this signal exists to avoid.
            return null;
        } catch (Throwable error) {
            return null;
        }
    }

    /** Which installed admin receivers are active, asked one at a time. */
    private static List<String> activeByComponent(Context context, DevicePolicyManager policy) {
        try {
            Intent intent = new Intent("android.app.action.DEVICE_ADMIN_ENABLED");
            List<ResolveInfo> installed = context.getPackageManager()
                .queryBroadcastReceivers(intent, PackageManager.MATCH_ALL);
            if (installed == null) return null;
            List<String> active = new ArrayList<>();
            for (ResolveInfo info : installed) {
                ComponentName component =
                    new ComponentName(info.activityInfo.packageName, info.activityInfo.name);
                if (policy.isAdminActive(component)) {
                    active.add(component.flattenToShortString());
                }
            }
            return active;
        } catch (Throwable error) {
            return null;
        }
    }
}
