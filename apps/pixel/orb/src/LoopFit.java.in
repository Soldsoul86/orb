package @PKG@;

import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.Collections;
import java.util.Comparator;
import java.util.HashMap;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;
import java.util.TreeMap;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * The fit test (`docs/LOOP_PROTOCOL.md` §13, DR-41): a **draft** reading of service messages — banks, bills, deliveries, bookings — held against the Loop
 * protocol to see how much of a real inbox it covers, **not** a Money feature. Each service message lands in exactly one role: `opens`, `advances`,
 * `closes`, `evidence`, `noise` or `unmapped`. Conversations (from a number) are counted and **not read**: they need language, which is out of v0.1.
 *
 * **Pure; keeps nothing but counts.** The body is read once, in memory, to choose a role; what is kept is the role, the kind, the amount and the brand of
 * the sender (`HDFCBK`) — and only to count how many closings match an opening of the same amount. The report is counts; the only names in it are service
 * brand codes of the largest unmapped groups, so that what the protocol misses can be seen.
 *
 * Rules are first-match, in the order below, and every one is a documented guess (`rules()`): the point is the *residue*, not the score.
 */
final class LoopFit implements MessagesXml.Sink {
    static final String VERSION = "fit/1";
    static final int TOP_UNMAPPED = 10;
    static final int TOP_AMBIGUOUS = 5;
    /** Messages with an amount kept (as numbers) to match closings to openings. */
    static final int MAX_KEPT = 50_000;
    /** An opening and a closing of the same amount from the same sender, this near, are one loop. */
    static final int MATCH_DAYS = 45;

    static final String OPENS = "opens";
    static final String ADVANCES = "advances";
    static final String CLOSES = "closes";
    static final String EVIDENCE = "evidence";
    static final String NOISE = "noise";
    /** Two or more rules read it as different loops (or as opening and closing). Counted apart, never forced into a kind. */
    static final String AMBIGUOUS = "ambiguous";
    static final String UNMAPPED = "unmapped";
    static final List<String> ROLES = Collections.unmodifiableList(java.util.Arrays.asList(OPENS, ADVANCES, CLOSES, EVIDENCE, NOISE, AMBIGUOUS, UNMAPPED));

    /** What one message was read as. `kind` and `owner` are a protocol kind and next mover for opens/advances/closes, else null; `tag` names why for noise. */
    static final class Reading {
        final String role;
        final String kind;
        final String owner;
        /** Integer minor units of the first amount, or 0. */
        final long minor;
        final String tag;
        /** The first rule that matched (for an ambiguous message, the first two joined with `+`). */
        final String rule;

        Reading(String role, String kind, String owner, long minor, String tag, String rule) {
            this.role = role;
            this.kind = kind;
            this.owner = owner;
            this.minor = minor;
            this.tag = tag;
            this.rule = rule;
        }

        boolean forms() {
            return OPENS.equals(role) || ADVANCES.equals(role) || CLOSES.equals(role);
        }

        String signature() {
            return role + "." + kind + "." + owner;
        }
    }

    /** The first amount in the words, in minor units, or 0. */
    static long minorOf(String body) {
        return SmsNormalizer.minorOf(body);
    }

    /** Every rule that matches a message, as the readings the fit report has always given them (the normalizer's rules, judged each on its own). */
    static List<Reading> readAll(String body) {
        return SmsNormalizer.readings(body);
    }

    /** What one service message is read as, in the fit report's own roles: the normalizer's outcome, seen through the legacy reading class. */
    static Reading read(String body) {
        return SmsNormalizer.normalize("", body, 0L, 0L).legacy;
    }

    /** The rule names in the order they are tried. */
    static List<String> rules() {
        return SmsNormalizer.rules();
    }

    /** The sender's brand for counting: `VM-HDFCBK` and `HDFCBK-S` are `HDFCBK`. A numeric short code is `SHORTCODE`; anything else `OTHER`. */
    static String brandOf(String address) {
        return brandOfSender(SenderRules.senderId(address));
    }

    static String brandOfSender(String senderId) {
        if (senderId == null || senderId.isEmpty()) return "OTHER";
        return senderId.matches("[0-9]+") ? "SHORTCODE" : senderId;
    }

    // ---- the tally

    /** Everything kept for one sender, so that a mark can be applied (or taken back) without reading the file again. Counts, and the normalized facts. */
    private static final class Tally {
        long messages;
        /** Messages the unmarked reading called a loop: it opens, moves on or closes one. */
        long formed;
        long unmapped;
        final Map<String, Long> counts = new TreeMap<>();
        final Map<String, Long> noiseTags = new TreeMap<>();
        final Map<String, Long> ambiguousPairs = new HashMap<>();
        /** The normalized observations of this sender (no raw text), as far as `MAX_KEPT` allows. */
        final List<Observation> observations = new ArrayList<>();
    }

    private final Map<String, Tally> senders = new HashMap<>();
    private long messages;
    private long service;
    private long conversational;
    private long other;
    private long cutKept;
    private long keptCount;

    @Override public void message(MessagesRules.Message m) {
        messages++;
        if (m.type != MessagesRules.RECEIVED && m.type != MessagesRules.SENT) { other++; return; }
        if (m.number != null) { conversational++; return; }   // from a number: counted, not read
        service++;
        String id = SenderRules.senderId(m.address);
        if (id == null) id = "";
        Tally t = senders.get(id);
        if (t == null) {
            if (senders.size() >= SenderRules.MAX_SENDERS) { id = ""; t = senders.get(id); }
            if (t == null) { t = new Tally(); senders.put(id, t); }
        }
        // The seam: the words are normalized into facts and dropped. What follows reads facts, not words.
        SmsNormalizer.Result n = SmsNormalizer.normalize(id, m.body, m.dateMs, m.dateMs);
        Reading r = n.legacy;
        t.messages++;
        bump(t.counts, r.role);
        if (r.forms()) {
            t.formed++;
            bump(t.counts, r.role + "." + r.kind + "." + r.owner);
            bump(t.counts, "kind." + r.kind);
            if (LoopRules.GIVE.equals(r.kind)) bump(t.counts, "kind." + r.kind + "." + r.owner);
        }
        if (r.tag != null) bump(t.noiseTags, r.tag);
        if (UNMAPPED.equals(r.role)) t.unmapped++;
        if (AMBIGUOUS.equals(r.role)) bumpCapped(t.ambiguousPairs, r.rule, 40, "other");
        if (n.discarded != null) bump(t.counts, "discard." + n.discarded);
        for (Observation o : n.observations) {
            bump(t.counts, "obs." + o.type);
            if (keptCount >= MAX_KEPT) { cutKept++; continue; }
            keptCount++;
            t.observations.add(o);
        }
    }

    private static void bump(Map<String, Long> map, String key) {
        add(map, key, 1L);
    }

    private static void add(Map<String, Long> map, String key, long n) {
        Long old = map.get(key);
        map.put(key, old == null ? n : old + n);
    }

    private static void bumpCapped(Map<String, Long> map, String key, int cap, String rest) {
        if (map.size() < cap || map.containsKey(key)) bump(map, key);
        else bump(map, rest);
    }

    /** The result: counts only. */
    static final class Report {
        final long messages, service, conversational, other;
        private final Map<String, Long> counts;
        private final Map<String, Long> unmappedBrands;
        private final Map<String, Long> ambiguousPairs;

        Report(long messages, long service, long conversational, long other, Map<String, Long> counts, Map<String, Long> unmappedBrands, Map<String, Long> ambiguousPairs) {
            this.messages = messages;
            this.service = service;
            this.conversational = conversational;
            this.other = other;
            this.counts = counts;
            this.unmappedBrands = unmappedBrands;
            this.ambiguousPairs = ambiguousPairs;
        }

        long get(String name) {
            Long n = counts.get(name);
            return n == null ? 0L : n;
        }

        /**
         * Every count by name: the legacy roles (`opens`, `closes` … and `role.KIND.owner`, `kind.KIND`), the seam's own (`obs.TYPE`, `effect.EFFECT`,
         * `discard.WHY`, `ledger.*`, `closure.candidates`), the matching figures and what quiet senders hid.
         */
        Map<String, Long> counts() {
            return counts;
        }

        private static Map<String, Long> top(Map<String, Long> all, int n) {
            List<Map.Entry<String, Long>> sorted = new ArrayList<>(all.entrySet());
            Collections.sort(sorted, new Comparator<Map.Entry<String, Long>>() {
                @Override public int compare(Map.Entry<String, Long> a, Map.Entry<String, Long> b) {
                    int c = Long.compare(b.getValue(), a.getValue());
                    return c != 0 ? c : a.getKey().compareTo(b.getKey());
                }
            });
            Map<String, Long> out = new LinkedHashMap<>();
            for (int i = 0; i < Math.min(n, sorted.size()); i++) out.put(sorted.get(i).getKey(), sorted.get(i).getValue());
            return out;
        }

        /** The sender brands with most unmapped messages (ties by name), at most `n`. */
        Map<String, Long> topUnmapped(int n) {
            return top(unmappedBrands, n);
        }

        /** The rule pairs that most often disagree (ties by name), at most `n`: names of rules, never words. */
        Map<String, Long> topAmbiguous(int n) {
            return top(ambiguousPairs, n);
        }

        /** Not a loop: information that opens nothing, and noise (including what quiet senders sent). */
        long notALoop() {
            return get(EVIDENCE) + get(NOISE);
        }

        /** Service messages that are about the person's obligations: everything except noise. */
        long nonNoise() {
            return service - get(NOISE);
        }

        /** Whole percent of the non-noise service messages that no rule read; 0 when there are none. */
        long unmappedPercent() {
            long n = nonNoise();
            return n == 0 ? 0L : Math.round(100.0 * get(UNMAPPED) / n);
        }

        /** The counts for the Messages screen, in the protocol's own words. Counts only. */
        String say() {
            String cost = SenderRules.costLine(get("quiet.senders"), get("quiet.hid"));
            return "Protocol fit (a draft reading of " + service + " messages from names and short codes; " + conversational + " from numbers are not read). "
                + "Each can open, move on or close a loop: DO " + get("kind.DO") + " \u00b7 GIVE " + get("kind.GIVE") + " (" + get("kind.GIVE.me") + " owed by you, " + get("kind.GIVE.them")
                + " owed to you) \u00b7 ATTEND " + get("kind.ATTEND") + " \u00b7 RESPOND " + get("kind.RESPOND") + " \u00b7 DECIDE " + get("kind.DECIDE")
                + ". Not a loop: " + notALoop() + " (" + get(NOISE) + " noise, " + get(EVIDENCE) + " only information). Could not be read: " + get(UNMAPPED) + " (" + unmappedPercent()
                + "% of the rest). Ambiguous: " + get(AMBIGUOUS) + ". "
                + "Money moved: " + get("ledger.out") + " out, " + get("ledger.in") + " in; " + get("closure.candidates") + " of those look like the end of something open (suggestions only), "
                + get("ledger.only") + " are the ledger only. "
                + "Of " + get("loops.opens") + " obligations with an amount (reminders counted once), " + get("loops.closed") + " were closed by a payment of the same amount from the same sender."
                + (cost.isEmpty() ? "" : " " + cost);
        }
    }

    /** The senders, as the Senders screen lists them: ordered, with the person's marks applied. Counts and sender codes, held in memory only. */
    List<SenderRules.Row> senders(SenderRules.Quiet quiet) {
        List<SenderRules.Row> rows = new ArrayList<>();
        for (Map.Entry<String, Tally> e : senders.entrySet()) {
            if (e.getKey().isEmpty()) continue;   // the unmarkable remainder
            rows.add(new SenderRules.Row(e.getKey(), e.getValue().messages, e.getValue().unmapped, e.getValue().formed, quiet.quiet(e.getKey())));
        }
        return SenderRules.order(rows);
    }

    /** The reading with nobody quiet. For tests and diagnostics: a reader of the person's messages calls `report(Quiet)` with their marks. */
    Report report() {
        return report(SenderRules.NONE);
    }

    /**
     * The reading with the person's marks: **every message from a quiet sender is not a loop** (noise, tagged `sender`), whatever its words say; what that cost
     * is counted (`quiet.hid`: messages the unmarked reading called a loop). Marks change only this reading; no loop or commitment is touched.
     */
    Report report(SenderRules.Quiet quiet) {
        Map<String, Long> out = new TreeMap<>();
        Map<String, Long> tags = new TreeMap<>();
        Map<String, Long> brands = new HashMap<>();
        Map<String, Long> pairs = new HashMap<>();
        List<Observation> facts = new ArrayList<>();
        long hid = 0, quietMessages = 0, quietSenders = 0;
        for (Map.Entry<String, Tally> e : senders.entrySet()) {
            Tally t = e.getValue();
            if (!e.getKey().isEmpty() && quiet.quiet(e.getKey())) {
                quietSenders++;
                quietMessages += t.messages;
                hid += t.formed;
                add(out, NOISE, t.messages);
                add(tags, "sender", t.messages);
                add(out, "discard.quiet", t.messages);
                continue;
            }
            for (Map.Entry<String, Long> c : t.counts.entrySet()) add(out, c.getKey(), c.getValue());
            for (Map.Entry<String, Long> c : t.noiseTags.entrySet()) add(tags, c.getKey(), c.getValue());
            for (Map.Entry<String, Long> c : t.ambiguousPairs.entrySet()) add(pairs, c.getKey(), c.getValue());
            if (t.unmapped > 0) add(brands, brandOfSender(e.getKey()), t.unmapped);
            facts.addAll(t.observations);
        }
        // Correlate, then interpret: which payments look like the end of something open, and what each observation does to loops. Order does not matter.
        Correlator.Result matched = Correlator.run(facts);
        long ledgerOnly = 0;
        for (Observation o : facts) {
            boolean closing = matched.matched.contains(o.id);
            Interpreter.Effect effect = Interpreter.effectOf(o, closing);
            if (Observation.VALUE_MOVED.equals(o.type)) {
                add(out, Observation.OUT.equals(o.direction) ? "ledger.out" : "ledger.in", 1L);
                if (!matched.closing.contains(o.id)) ledgerOnly++;
            }
            add(out, "effect." + effect.type, 1L);
        }
        for (String role : ROLES) if (!out.containsKey(role)) out.put(role, 0L);
        for (Map.Entry<String, Long> c : tags.entrySet()) out.put("noise." + c.getKey(), c.getValue());
        out.put("match.opens", matched.openers);
        out.put("match.opensMatched", matched.candidates);
        out.put("match.closes", matched.closers);
        out.put("match.closesMatched", matched.candidates);
        out.put("match.cut", cutKept);
        out.put("loops.opens", matched.obligations);
        out.put("loops.closed", matched.obligationsClosed);
        out.put("closure.candidates", matched.candidates);
        out.put("ledger.only", ledgerOnly);
        out.put("quiet.senders", quietSenders);
        out.put("quiet.messages", quietMessages);
        out.put("quiet.hid", hid);
        return new Report(messages, service, conversational, other, out, brands, pairs);
    }
}
