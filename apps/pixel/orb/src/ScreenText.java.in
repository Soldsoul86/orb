package @PKG@;

import java.nio.charset.StandardCharsets;

/**
 * The text of one screen, held in memory between *looking* and *tapping Remember* — and
 * nowhere else. No Android in it.
 *
 * **This is the only object that holds what the screen said**, and it lives exactly as long
 * as the card does. `discard()` empties it: a declined screen, a dismissed card, a finished
 * remember. Nothing writes it to disk except `Capture`, which seals it, and nothing logs it
 * (`AssistGuardTest` fails the build if either changes).
 *
 * **Text only** (DR-14 ruling 5). It takes node text and one page address; there is no way to
 * add a description, a hint, an id or a picture, so they cannot be kept by accident. Passwords
 * are never added: the reader refuses them by input type before they reach here.
 */
final class ScreenText {
    static final String HEADER = "orb.screen.text.v1";

    private final StringBuilder body = new StringBuilder();
    private String webUri;
    int textNodes;
    long textChars;
    int blocked;
    /** Password fields left out — a count, so a screen's login-ness is visible without its contents. */
    int passwordFields;

    /**
     * Whether this text is a masked secret — only bullets or asterisks, at least three of them.
     *
     * **Found on a real phone, 2026-10-01.** A web login page delivered its password field as a
     * node Orb recognised and skipped — *and* as a second node whose text was the masked
     * display, `••••••••`. The real characters were never there; the dots were, and **a row of
     * dots is the length of the password and the fact that there is one.** So a run of mask
     * characters is treated as a password field whatever node it arrives on. A single bullet
     * (a separator in a chat list) is ordinary text and is kept.
     */
    static boolean looksMasked(String text) {
        int marks = 0;
        for (int i = 0; i < text.length(); i++) {
            char c = text.charAt(i);
            if (c == ' ' || c == '\u00a0') continue;
            if (c == '\u2022' || c == '\u25cf' || c == '\u2219' || c == '\u00b7' || c == '*' || c == '\u2217'
                || c == '\u25cb' || c == '\u25e6' || c == '\u26ab' || c == '\u2024') {
                marks++;
                continue;
            }
            return false;
        }
        return marks >= 3;
    }

    /** One element's text, trimmed; blank text is nothing, and a masked secret is a password field. */
    void add(CharSequence text) {
        if (text == null) return;
        String trimmed = text.toString().trim();
        if (trimmed.isEmpty()) return;
        if (looksMasked(trimmed)) {
            passwordFields++;
            return;
        }
        if (body.length() > 0) body.append('\n');
        body.append(trimmed);
        textNodes++;
        textChars += trimmed.length();
    }

    /** A password field was on the screen. Counted; nothing about it is read. */
    void notePassword() {
        passwordFields++;
    }

    /** A node the app marked as not for assistants. Counted; its text is never added. */
    void noteBlocked() {
        blocked++;
    }

    /** The page address the app supplied. It is content, so it is sealed with the text. */
    void setWebUri(String uri) {
        this.webUri = (uri == null || uri.isEmpty()) ? null : uri.replace('\n', ' ');
    }

    boolean hasWebUri() {
        return webUri != null;
    }

    /** The start of the text, for the person to see before deciding. Never splits a character. */
    String preview(int maxChars) {
        String all = body.toString();
        if (all.length() <= maxChars) return all;
        int end = maxChars;
        if (end > 0 && Character.isHighSurrogate(all.charAt(end - 1))) end--;
        return all.substring(0, end) + "…";
    }

    /** How much of the text a preview of this length leaves out. */
    long hiddenBy(int maxChars) {
        long rest = body.length() - maxChars;
        return rest > 0 ? rest : 0L;
    }

    /**
     * What gets sealed: a versioned header, the address if there was one, then the text.
     *
     * Identical screens produce identical bytes and therefore one Attachment under one key
     * (inv. 2) — and an erased one is not kept again (inv. 8). Nothing else is in it: no
     * time, no app, no counts, so nothing about *when* or *where* sits next to the text.
     */
    byte[] document() {
        String doc = HEADER + "\nuri:" + (webUri == null ? "" : webUri) + "\n---\n" + body;
        return doc.getBytes(StandardCharsets.UTF_8);
    }

    /** Forgets everything. Called whenever the card ends, whatever happened. */
    void discard() {
        body.setLength(0);
        body.trimToSize();
        webUri = null;
        textNodes = 0;
        textChars = 0;
        blocked = 0;
        passwordFields = 0;
    }
}
