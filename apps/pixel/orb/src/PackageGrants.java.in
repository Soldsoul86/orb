package @PKG@;

import java.io.IOException;
import java.util.List;

/**
 * What the journal says about the package-scan grant — pure, so the rule can be tested without a device.
 */
final class PackageGrants {
    private PackageGrants() {}

    static final String GRANTED = "grants.capability.granted";
    static final String REVOKED = "grants.capability.revoked";

    /**
     * Whether the most recent grant or revocation of `installedPackages.read` was a grant. Anything else — no such
     * event, a revocation last — is false. Scans from the end. A line whose type cannot be read is refused, not
     * skipped: skipping could return an older answer as though that line did not exist.
     */
    static boolean lastIsGrant(List<String> lines) throws IOException {
        return lastIsGrant(lines, "installedPackages.read");
    }

    /** The same, for any capability whose grants are recorded as `grants.capability.granted` / `revoked` (`ContactsAccess` too). */
    static boolean lastIsGrant(List<String> lines, String capability) throws IOException {
        for (int i = lines.size() - 1; i >= 0; i--) {
            String line = lines.get(i);
            String type = Journal.typeOf(line);
            if (type == null) throw new IOException("cannot tell the type of event " + (i + 1) + "; refusing to skip it");
            boolean granted = GRANTED.equals(type);
            if (!granted && !REVOKED.equals(type)) continue;
            int payload = line.indexOf("\"payload\":");
            if (payload < 0 || line.indexOf("\"capability\":\"" + capability + "\"", payload) < 0) continue;
            return granted;
        }
        return false;
    }

    /**
     * Whether the person **switched a capability off**: the last record about it is a revocation. Never decided (no record) is false, and so is granted. A line whose
     * type cannot be read is refused, as in `lastIsGrant`.
     */
    static boolean lastIsRevocation(List<String> lines, String capability) throws IOException {
        for (int i = lines.size() - 1; i >= 0; i--) {
            String line = lines.get(i);
            String type = Journal.typeOf(line);
            if (type == null) throw new IOException("cannot tell the type of event " + (i + 1) + "; refusing to skip it");
            boolean granted = GRANTED.equals(type);
            if (!granted && !REVOKED.equals(type)) continue;
            int payload = line.indexOf("\"payload\":");
            if (payload < 0 || line.indexOf("\"capability\":\"" + capability + "\"", payload) < 0) continue;
            return !granted;
        }
        return false;
    }
}
