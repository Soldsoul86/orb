package @PKG@;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.DialogInterface;
import android.content.pm.PackageManager;
import android.graphics.Typeface;
import android.os.Bundle;
import android.text.Editable;
import android.text.TextWatcher;
import android.view.View;
import android.view.WindowManager;
import android.widget.Button;
import android.widget.EditText;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import java.io.IOException;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;
import java.util.Locale;

/**
 * People — the contacts your kept words mention, and everything about each (`docs/PEOPLE_PHONE.md`, DR-24).
 *
 * **This screen is the only place the contacts are read, and it reads them only while it is open.** Nothing is kept: the contacts
 * and the words are held in memory for the screen and let go, no person is ever recorded, and the one thing written is a record
 * that the read happened — **counts only** (`ContactsFacts`), so the read is never silent and never carries what it read. It asks
 * Android's permission only at the first grant, after saying why; it is secure like Recall, because a person's contacts and what
 * you wrote about them are as private as the words.
 */
public final class PeopleActivity extends Activity {
    private static final int REQUEST_CONTACTS = 72;
    /** The intent extra Recall passes to open this screen in *choose* mode: the kept item to link (`PERSON_LINK_PHONE.md`). */
    static final String LINK_ITEM = "linkItem";
    /** At most this many dates ahead are shown in a person's window. */
    private static final int MAX_DAYS = 8;

    /**
     * Opens this screen to choose who a kept item is about. Only the item's event id travels, to this app's own screen — Recall never
     * starts an activity itself, and nothing is handed to another app.
     */
    static void chooseFor(Activity from, String itemEventId) {
        from.startActivity(new android.content.Intent(from, PeopleActivity.class).putExtra(LINK_ITEM, itemEventId));
    }

    private LinearLayout list;
    /** The read is recorded once per opening, not per redraw. */
    private boolean recorded;
    /** The closing explanation: the section of possible people is placed above it. */
    private View note;
    private RemindFlow flow;
    private HandoffFlow handoff;
    private CommitmentFlow commitmentFlow;
    /** Every live commitment, read with the people; a person's are the ones that name them. */
    private List<Commitments.Commitment> commitments;
    /** The dates ahead in all kept items, computed once with the people; a person's are the ones in their own items. */
    private ComingUp.Result ahead;
    /** Choose mode: the item whose person is being chosen; null when this screen is just People. */
    private String linkItem;
    /** The person's window that is open, and the person to open again after a link or an unlink changes the screen. */
    private AlertDialog shown;
    private String reopenName;

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);
        linkItem = getIntent() == null ? null : getIntent().getStringExtra(LINK_ITEM);
        getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        ScrollView scroll = new ScrollView(this);
        list = new LinearLayout(this);
        list.setOrientation(LinearLayout.VERTICAL);
        list.setPadding(40, 120, 40, 40);
        scroll.addView(list);
        setContentView(scroll);
    }

    @Override
    protected void onResume() {
        super.onResume();
        recorded = false;
        render();
    }

    private TextView text(String s, int size, boolean bold) {
        TextView t = new TextView(this);
        t.setTextSize(size);
        t.setPadding(0, 8, 0, 8);
        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
        t.setText(s);
        return t;
    }

    private Journal journal() {
        Orb orb = Orb.get();
        return orb == null ? null : orb.journal();
    }

    private void render() {
        list.removeAllViews();
        list.addView(text("People", 17, true));
        final Journal journal = journal();
        if (journal == null) {
            list.addView(text("journal unavailable", 13, false));
            return;
        }
        if (!ContactsAccess.granted(this)) {
            askToGrant(journal);
            return;
        }
        if (!ContactsReader.permitted(this)) {
            list.addView(text("You granted Orb access to your contacts, but Android's permission is off. Nothing was read.", 13, false));
            Button again = new Button(this);
            again.setText("Ask Android again");
            again.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) { requestPermissions(new String[] {ContactsReader.PERMISSION}, REQUEST_CONTACTS); }
            });
            list.addView(again);
            return;
        }
        list.addView(text("Looking through your contacts and what you kept…", 13, false));
        final android.content.Context context = this;
        new Thread(new Runnable() {
            @Override public void run() {
                final List<People.Contact> book = ContactsReader.read(context);
                People.Result computed = null;
                ComingUp.Result dates = null;
                List<Commitments.Commitment> owed = null;
                if (book != null) {
                    try {
                        owed = Commitments.all(context, journal);
                        computed = People.compute(context, journal, book);
                        dates = ComingUp.compute(context, journal, System.currentTimeMillis(), java.util.TimeZone.getDefault().getID());
                    } catch (IOException unreadable) {
                        computed = null;
                    }
                }
                ahead = dates;
                commitments = owed;
                final People.Result result = computed;
                final boolean readable = book != null;
                runOnUiThread(new Runnable() {
                    @Override public void run() { show(journal, readable, result); }
                });
            }
        }).start();
    }

    private void askToGrant(final Journal journal) {
        list.addView(text(Capabilities.CONTACTS_SAYS, 13, false));
        list.addView(text("Orb reads your contacts only while this screen is open, to tell you which people your kept words mention and "
            + "to put everything about one person together — their several numbers become one. You can revoke this any time on What Orb may do.", 13, false));
        Button grant = new Button(this);
        grant.setText("Allow Orb to read my contacts");
        grant.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) {
                if (ContactsReader.permitted(PeopleActivity.this)) finishGrant(journal);
                else requestPermissions(new String[] {ContactsReader.PERMISSION}, REQUEST_CONTACTS);
            }
        });
        list.addView(grant);
    }

    /** Android said yes: now the person's own decision is recorded, and only then does anything read. */
    private void finishGrant(Journal journal) {
        try {
            ContactsAccess.grant(this, journal);
        } catch (IOException notRecorded) {
            new AlertDialog.Builder(this).setMessage("Orb could not record this, so it did not grant anything.").setPositiveButton("OK", null).show();
            return;
        }
        render();
    }

    @Override
    public void onRequestPermissionsResult(int code, String[] permissions, int[] results) {
        super.onRequestPermissionsResult(code, permissions, results);
        if (flow != null) flow.onPermissionResult(code, results);
        if (commitmentFlow != null) commitmentFlow.onPermissionResult(code, results);
        if (code != REQUEST_CONTACTS) return;
        boolean ok = results.length > 0 && results[0] == PackageManager.PERMISSION_GRANTED;
        Journal journal = journal();
        if (ok && journal != null) {
            if (!ContactsAccess.granted(this)) finishGrant(journal);
            else render();
        } else {
            new AlertDialog.Builder(this).setMessage("Android did not allow it, so nothing changed and Orb read nothing.").setPositiveButton("OK", null).show();
        }
    }

    private void show(Journal journal, boolean readable, final People.Result result) {
        list.removeAllViews();
        list.addView(text("People", 17, true));
        if (!readable || result == null) {
            list.addView(text("Orb could not read your contacts or its history, so it shows nothing rather than guess.", 13, false));
            return;
        }
        if (!recorded) {
            recorded = true;
            // The read happened: said, with counts only — never a name, a number or an address.
            journal.append(ContactsFacts.READ, ContactsFacts.read(result.contacts, result.people.size(), result.possible.size()));
        }
        // You choose the person: type a few letters of a contact's name. Nothing is listed until you do.
        list.addView(text(linkItem != null ? "Choose who this is about. Orb will list it on their page." : "Find a person in your contacts, then set a reminder about them.", 13, false));
        final EditText search = new EditText(this);
        search.setHint("A name, two letters or more");
        search.setSingleLine(true);
        list.addView(search);
        final LinearLayout found = new LinearLayout(this);
        found.setOrientation(LinearLayout.VERTICAL);
        list.addView(found);
        search.addTextChangedListener(new TextWatcher() {
            @Override public void beforeTextChanged(CharSequence s, int a, int b, int c) {}
            @Override public void onTextChanged(CharSequence s, int a, int b, int c) {}
            @Override public void afterTextChanged(Editable s) {
                // Kept in memory for the screen and let go with it; never stored or logged.
                found.removeAllViews();
                String typed = s.toString();
                List<People.Person> hits = People.find(result.all, typed);
                for (People.Person person : hits) found.addView(row(person));
                if (hits.isEmpty() && typed.trim().length() >= People.FIND_MIN) found.addView(text("No contact has that in its name.", 13, false));
            }
        });
        if (linkItem != null) return;   // Choose mode: the search is all there is.
        // What the words mention is a guess, so it sits behind a button, not in front of you.
        final LinearLayout mentions = new LinearLayout(this);
        mentions.setOrientation(LinearLayout.VERTICAL);
        mentions.setVisibility(View.GONE);
        final Button toggle = new Button(this);
        toggle.setText("Who my words mention (" + result.people.size() + " sure, " + result.possible.size() + " might be)");
        toggle.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) {
                mentions.setVisibility(mentions.getVisibility() == View.GONE ? View.VISIBLE : View.GONE);
            }
        });
        list.addView(toggle);
        list.addView(mentions);
        StringBuilder said = new StringBuilder();
        said.append(result.people.size()).append(result.people.size() == 1 ? " person" : " people").append(" tied by number or email · ")
            .append(result.possible.size()).append(" only by a name · ").append(result.contacts).append(" contacts looked at");
        if (result.looked.unreadable > 0) said.append(" · ").append(result.looked.unreadable).append(" items could not be read");
        if (result.looked.skipped > 0) said.append(" · looked at the newest ").append(Recall.SCAN_LIMIT).append(", ").append(result.looked.skipped).append(" not looked at");
        mentions.addView(text(said.toString(), 12, false));
        if (result.people.isEmpty()) {
            mentions.addView(text("None of your contacts' numbers or email addresses is in what you kept.", 14, false));
        }
        for (final People.Person person : result.people) mentions.addView(row(person));
        if (!result.possible.isEmpty()) {
            final Button more = new Button(this);
            more.setText("Show " + result.possible.size() + " that only a name matches");
            more.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    mentions.removeView(more);
                    mentions.addView(text("Might be — only a word matches a contact's name. It can be a different person, or no person.", 13, true), mentions.indexOfChild(note));
                    int at = mentions.indexOfChild(note);
                    for (People.Person person : result.possible) mentions.addView(row(person), at++);
                }
            });
            mentions.addView(more);
        }
        if (result.sharedFirstNames > 0) {
            mentions.addView(text(result.sharedFirstNames + (result.sharedFirstNames == 1 ? " first name is" : " first names are")
                + " shared by several contacts, so those are matched by full name or number only.", 12, false));
        }
        note = text("Matching by name finds a word that happens to be a name — it can be a different person or no person. "
            + "Matching by number or email is much surer. A name at the start of a sentence is not read: a capital there says nothing.", 12, false);
        mentions.addView(note);
        // After a link or an unlink the screen was recomputed: open the same person again.
        if (reopenName != null) {
            String name = reopenName;
            reopenName = null;
            for (People.Person p : result.all) if (p.names.contains(name)) { showPerson(p); break; }
        }
    }

    private View row(final People.Person person) {
        LinearLayout row = new LinearLayout(this);
        row.setOrientation(LinearLayout.VERTICAL);
        row.setPadding(0, 16, 0, 16);
        row.addView(text(person.display(), 15, true));
        row.addView(text(person.items.isEmpty() ? "nothing you kept mentions them" : person.items.size() + (person.items.size() == 1 ? " kept item" : " kept items") + " · " + People.evidenceLine(person), 12, false));
        row.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) {
                if (linkItem != null) confirmLink(person, linkItem, null);
                else showPerson(person);
            }
        });
        return row;
    }

    private void say(String message, DialogInterface.OnDismissListener then) {
        AlertDialog box = new AlertDialog.Builder(this).setMessage(message).setPositiveButton("OK", null).create();
        if (then != null) box.setOnDismissListener(then);
        box.show();
    }

    /** The card before a link: who, and what — Cancel is the default. Nothing is written until *Link*. */
    private void confirmLink(final People.Person person, final String itemId, String preview) {
        AlertDialog card = new AlertDialog.Builder(this)
            .setTitle("Link this to " + person.display() + "?")
            .setMessage((preview == null ? "The item you chose in Recall" : preview)
                + "\n\nOrb will list it on their page and say you linked it. Nothing leaves the phone. You can unlink it any time.")
            .setNegativeButton("Cancel", null)
            .setPositiveButton("Link", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) { link(person, itemId); }
            })
            .create();
        card.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        card.show();
        card.getButton(AlertDialog.BUTTON_NEGATIVE).requestFocus();
    }

    private void link(People.Person person, String itemId) {
        Journal journal = journal();
        if (journal == null) return;
        String outcome;
        try {
            outcome = PersonLink.link(this, journal, itemId, person);
        } catch (IOException unreadable) {
            say("Orb could not read its history, so it did not link anything.", null);
            return;
        }
        if (PersonLink.ALREADY.equals(outcome)) {
            say("Already linked.", null);
        } else if (!PersonLink.LINKED.equals(outcome)) {
            say("Orb could not record this, so it did not link anything.", null);
        } else if (linkItem != null) {
            say("Linked. It is on their page now.", new DialogInterface.OnDismissListener() {
                @Override public void onDismiss(DialogInterface d) { finish(); }
            });
        } else {
            reopenName = person.names.get(0);
            if (shown != null) shown.dismiss();
            render();
        }
    }

    /** *Add something I kept…* — the newest kept items, to pick one to link to this person. */
    private void chooseItem(final People.Person person) {
        final Journal journal = journal();
        if (journal == null) return;
        final android.content.Context context = this;
        new Thread(new Runnable() {
            @Override public void run() {
                Recall.Results found = null;
                try {
                    found = Recall.search(context, journal, "", null);
                } catch (IOException unreadable) {
                    found = null;
                }
                final Recall.Results results = found;
                runOnUiThread(new Runnable() {
                    @Override public void run() { pickItem(person, results); }
                });
            }
        }).start();
    }

    private static final int PICK_ITEMS = 30;

    private void pickItem(final People.Person person, Recall.Results found) {
        if (found == null) {
            say("Orb could not read what you kept.", null);
            return;
        }
        java.util.Set<String> already = new java.util.HashSet<>();
        for (People.Evidence e : person.items) if (People.BY_LINK.equals(e.by) && e.entry.id != null) already.add(e.entry.id);
        final List<Recall.Entry> choices = new java.util.ArrayList<>();
        for (Recall.Entry e : found.entries) {
            if (e.id != null && !already.contains(e.id) && choices.size() < PICK_ITEMS) choices.add(e);
        }
        if (choices.isEmpty()) {
            say("Nothing else you kept to add.", null);
            return;
        }
        SimpleDateFormat day = new SimpleDateFormat("d MMM", Locale.getDefault());
        String[] labels = new String[choices.size()];
        for (int i = 0; i < labels.length; i++) {
            Recall.Entry e = choices.get(i);
            String flat = e.snippet.replace('\n', ' ');
            labels[i] = day.format(new Date(e.wallClock)) + " \u00b7 " + (e.packageName == null ? "" : e.packageName + " \u00b7 ") + (flat.length() > 80 ? flat.substring(0, 80) + "\u2026" : flat);
        }
        AlertDialog which = new AlertDialog.Builder(this)
            .setTitle("Add which to " + person.display() + "?")
            .setItems(labels, new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int index) {
                    Recall.Entry e = choices.get(index);
                    confirmLink(person, e.id, "\u201c" + e.snippet + "\u201d");
                }
            })
            .setNegativeButton("Cancel", null)
            .create();
        which.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        which.show();
    }

    /** Unlinking removes only the link: the item stays kept. */
    private void confirmUnlink(final People.Person person, final People.Evidence item) {
        AlertDialog sure = new AlertDialog.Builder(this)
            .setTitle("Unlink this?")
            .setMessage("It stays kept. Only the link to " + person.display() + " is removed, for good.")
            .setNegativeButton("Keep the link", null)
            .setPositiveButton("Unlink", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) {
                    Journal journal = journal();
                    if (journal == null) return;
                    try {
                        PersonLink.unlink(PeopleActivity.this, journal, item.linkHash);
                    } catch (IOException unreadable) {
                        say("Orb could not read its history, so it did not unlink anything.", null);
                        return;
                    }
                    reopenName = person.names.get(0);
                    if (shown != null) shown.dismiss();
                    render();
                }
            })
            .create();
        // The card names a person: no screenshots of it.
        sure.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        sure.show();
        sure.getButton(AlertDialog.BUTTON_NEGATIVE).requestFocus();
    }

    /** After a commitment is kept or changed, the screen is recomputed and the same person's page opens again. */
    private Runnable reopenAfter(final People.Person person) {
        return new Runnable() {
            @Override public void run() {
                reopenName = person.names.get(0);
                if (shown != null) shown.dismiss();
                render();
            }
        };
    }

    /** What is open with this person: commitments that name them, each with Done, Move, Drop, Remind me and Delete. */
    private void addOpenWithThem(LinearLayout column, People.Person person) {
        if (commitments == null || commitmentFlow == null) return;
        List<Commitments.Commitment> mine = Commitments.forPerson(commitments, person);
        if (mine.isEmpty()) return;
        column.addView(text("Open with them (" + mine.size() + ")", 13, true));
        String today = CommitmentFlow.today();
        for (Commitments.Commitment c : mine) column.addView(commitmentFlow.row(c, today, reopenAfter(person)));
    }

    /** The dates ahead in this person's own items — the Coming up reader, restricted; a guess is marked as one. */
    private void addDatesAhead(LinearLayout column, People.Person person) {
        if (ahead == null || person.items.isEmpty()) return;
        java.util.Set<String> ids = new java.util.HashSet<>();
        for (People.Evidence e : person.items) if (e.entry.id != null) ids.add(e.entry.id);
        ComingUp.Result mine = ComingUp.restrict(ahead, ids);
        if (mine.days.isEmpty()) return;
        column.addView(text("Dates ahead in these items", 13, true));
        SimpleDateFormat nice = new SimpleDateFormat("EEE d MMM yyyy", Locale.getDefault());
        int shown = 0;
        for (ComingUp.Day day : mine.days) {
            if (shown++ >= MAX_DAYS) break;
            final String[] ymd = day.date.split("-");
            java.util.Calendar c = java.util.Calendar.getInstance();
            c.clear();
            c.set(Integer.parseInt(ymd[0]), Integer.parseInt(ymd[1]) - 1, Integer.parseInt(ymd[2]));
            for (final ComingUp.Item item : day.items) {
                LinearLayout row = new LinearLayout(this);
                row.setOrientation(LinearLayout.VERTICAL);
                row.setPadding(0, 8, 0, 8);
                row.addView(text(nice.format(c.getTime()) + (item.guess ? "  \u00b7  a guess: \u201c" + item.phrase + "\u201d" : ""), 13, !item.guess));
                row.addView(text(item.shown(), 12, false));
                if (item.reminded) {
                    row.addView(text("A reminder is set.", 12, true));
                } else {
                    Button remind = new Button(this);
                    remind.setText("Remind me on " + new SimpleDateFormat("d MMM", Locale.getDefault()).format(c.getTime()));
                    final int[] picked = {Integer.parseInt(ymd[0]), Integer.parseInt(ymd[1]), Integer.parseInt(ymd[2])};
                    remind.setOnClickListener(new View.OnClickListener() {
                        @Override public void onClick(View view) {
                            if (flow == null) flow = new RemindFlow(PeopleActivity.this);
                            flow.start(item.entry.id, picked);
                        }
                    });
                    row.addView(remind);
                }
                column.addView(row);
            }
        }
        column.addView(text("Orb knows only what you shared or let it remember. A guess is read from when you kept the item.", 11, false));
    }

    private void showPerson(final People.Person person) {
        ScrollView scroll = new ScrollView(this);
        LinearLayout column = new LinearLayout(this);
        column.setOrientation(LinearLayout.VERTICAL);
        column.setPadding(48, 24, 48, 24);
        StringBuilder who = new StringBuilder();
        for (String n : person.names) who.append(who.length() > 0 ? ", " : "").append(n);
        column.addView(text(who.toString(), 14, true));
        for (String p : person.phones) column.addView(text("Phone  " + Mentions.show(new Mentions.Handle("phone", p)), 13, false));
        for (String e : person.emails) column.addView(text("Email  " + e, 13, false));
        // Reach them from here: each opens another app after a confirmation; Orb sends nothing and calls no one (`Handoff`).
        LinearLayout reach = new LinearLayout(this);
        reach.setOrientation(LinearLayout.HORIZONTAL);
        for (final String[] channel : new String[][] {{HandoffFacts.WHATSAPP, "WhatsApp"}, {HandoffFacts.SMS, "Message"}, {HandoffFacts.DIAL, "Call"}}) {
            Button open = new Button(this);
            open.setText(channel[1]);
            open.setEnabled(!person.phones.isEmpty());
            open.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (handoff == null) handoff = new HandoffFlow(PeopleActivity.this);
                    handoff.start(channel[0], person);
                }
            });
            reach.addView(open);
        }
        column.addView(reach);
        Button add = new Button(this);
        add.setText("Add something I kept\u2026");
        add.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) {
                if (shown != null) shown.dismiss();
                chooseItem(person);
            }
        });
        column.addView(add);
        // Commitments with them: what you owe, what you are waiting for — your confirmation, their sealed words (`COMMITMENTS_PHONE.md`).
        if (commitmentFlow == null) commitmentFlow = new CommitmentFlow(this);
        Button track = new Button(this);
        track.setText("Add a commitment\u2026");
        track.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) {
                if (shown != null) shown.dismiss();
                commitmentFlow.start(null, "", null, person, reopenAfter(person));
            }
        });
        column.addView(track);
        People.Glance context = People.context(person);
        if (context.count > 0) {
            SimpleDateFormat day = new SimpleDateFormat("d MMM yyyy", Locale.getDefault());
            StringBuilder glance = new StringBuilder("Last mentioned ").append(day.format(new Date(context.last)));
            if (context.first != context.last) glance.append(" \u00b7 first ").append(day.format(new Date(context.first)));
            glance.append(" \u00b7 ").append(context.count).append(context.count == 1 ? " kept item" : " kept items");
            column.addView(text(glance.toString(), 13, true));
            StringBuilder from = new StringBuilder();
            for (String f : context.from) from.append(from.length() > 0 ? " \u00b7 " : "").append(f);
            if (context.shared > 0) from.append(from.length() > 0 ? " \u00b7 " : "").append("shared \u00d7").append(context.shared);
            if (from.length() > 0) column.addView(text("From: " + from, 12, false));
        }
        if (!person.alsoWith.isEmpty()) {
            StringBuilder with = new StringBuilder("Often with:");
            for (Mentions.Handle h : person.alsoWith) with.append("\n  ").append(Mentions.line(h));
            column.addView(text(with.toString(), 13, false));
        }
        addOpenWithThem(column, person);
        addDatesAhead(column, person);
        SimpleDateFormat when = new SimpleDateFormat("d MMM yyyy HH:mm", Locale.getDefault());
        if (person.items.isEmpty()) column.addView(text("Nothing you kept mentions them yet.", 13, false));
        for (final People.Evidence item : person.items) {
            LinearLayout row = new LinearLayout(this);
            row.setOrientation(LinearLayout.VERTICAL);
            row.setPadding(0, 16, 0, 16);
            String how = People.BY_LINK.equals(item.by) ? "you linked it"
                : People.BY_NAME.equals(item.by) ? "mentions the word “" + item.word + "”"
                : People.BY_EMAIL.equals(item.by) ? "has their email" : "has their number";
            row.addView(text(when.format(new Date(item.entry.wallClock)) + "  ·  " + (item.entry.packageName == null ? "" : item.entry.packageName)
                + (Provenance.SHARED_TEXT.equals(item.entry.type) ? "  ·  shared" : "") + "  ·  " + how, 11, true));
            row.addView(text(item.entry.snippet, 14, false));
            if (People.BY_LINK.equals(item.by) && item.linkHash != null) {
                Button unlink = new Button(this);
                unlink.setText("Unlink");
                unlink.setOnClickListener(new View.OnClickListener() {
                    @Override public void onClick(View view) { confirmUnlink(person, item); }
                });
                row.addView(unlink);
            }
            column.addView(row);
        }
        scroll.addView(column);
        final String callNote = "Call " + person.names.get(0);
        AlertDialog dialog = new AlertDialog.Builder(this)
            .setTitle(person.display())
            .setView(scroll)
            .setPositiveButton("Close", null)
            // A reminder you set, about no kept item: the name only ever sits in its sealed note (`PERSON_ACTION_PHONE.md`).
            .setNeutralButton("Remind me about this person\u2026", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) {
                    if (flow == null) flow = new RemindFlow(PeopleActivity.this);
                    flow.start(null, null, callNote);
                }
            })
            .create();
        // A person's contact details and what you wrote about them are as private as the words.
        dialog.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        shown = dialog;
        dialog.show();
    }
}
