package @PKG@;

import android.content.Intent;
import android.os.RemoteException;
import android.speech.RecognitionService;
import android.speech.SpeechRecognizer;

/**
 * A speech recogniser that never recognises anything.
 *
 * The Android documentation for voice-interaction services lists a recognition
 * service among what one must provide, and the metadata names one. **Whether a
 * phone assistant can omit it is unconfirmed** (`DEVICE_LOOP.md` §7b41), so this
 * probe includes the smallest one that satisfies the declaration: it answers every
 * request with an error and listens to nothing. It is not a microphone user — the
 * probe requests no permission at all.
 *
 * Side effect, stated: it may appear in the system's list of speech-recognition
 * engines. Do not pick it there.
 */
public final class RecognitionStub extends RecognitionService {
    @Override
    protected void onStartListening(Intent recognizerIntent, Callback listener) {
        try {
            listener.error(SpeechRecognizer.ERROR_RECOGNIZER_BUSY);
        } catch (RemoteException ignored) {
            // The caller went away; there is nothing to tell.
        }
    }

    @Override
    protected void onCancel(Callback listener) {}

    @Override
    protected void onStopListening(Callback listener) {}
}
