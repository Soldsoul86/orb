package @PKG@;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.DialogInterface;
import android.content.pm.PackageManager;
import android.graphics.Typeface;
import android.os.Bundle;
import android.view.View;
import android.view.WindowManager;
import android.widget.Button;
import android.widget.CheckBox;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import android.widget.TimePicker;
import java.io.IOException;
import java.text.SimpleDateFormat;
import java.util.Calendar;
import java.util.List;
import java.util.Locale;
import java.util.TimeZone;

/**
 * Today — *what matters now* (`docs/COMMITMENTS_PHONE.md`, DR-30): what is overdue, what is due today and this week, what you are waiting for,
 * and what has no date — your commitments, and the written dates ahead in what you kept that are not one yet. **Computed each time it
 * opens; nothing is stored here.** Orb never marks anything done: *overdue* says *still open*. Secure like Recall, because it shows your words.
 */
public final class TodayActivity extends Activity {
    private LinearLayout list;
    private CommitmentFlow commitments;

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);
        getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        ScrollView scroll = new ScrollView(this);
        list = new LinearLayout(this);
        list.setOrientation(LinearLayout.VERTICAL);
        list.setPadding(40, 120, 40, 40);
        scroll.addView(list);
        setContentView(scroll);
        commitments = new CommitmentFlow(this);
    }

    @Override
    protected void onResume() {
        super.onResume();
        render();
    }

    @Override
    public void onRequestPermissionsResult(int code, String[] permissions, int[] results) {
        super.onRequestPermissionsResult(code, permissions, results);
        commitments.onPermissionResult(code, results);
        if (code == REQUEST_BRIEF) {
            if (results.length > 0 && results[0] == PackageManager.PERMISSION_GRANTED) finishTurnOn(pendingMinute, pendingWords);
            else say("Android did not allow notifications, so the brief could not appear and nothing was turned on.");
        }
    }

    private TextView text(String s, int size, boolean bold) {
        TextView t = new TextView(this);
        t.setTextSize(size);
        t.setPadding(0, 8, 0, 8);
        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
        t.setText(s);
        return t;
    }

    private Journal journal() {
        Orb orb = Orb.get();
        return orb == null ? null : orb.journal();
    }

    private void render() {
        final Journal journal = journal();
        list.removeAllViews();
        list.addView(text("Today", 17, true));
        if (journal == null) {
            list.addView(text("journal unavailable", 13, false));
            return;
        }
        list.addView(text("Looking at what you owe and what you kept…", 13, false));
        final android.content.Context context = this;
        new Thread(new Runnable() {
            @Override public void run() {
                List<Commitments.Commitment> all = null;
                ComingUp.Result dates = null;
                try {
                    all = Commitments.all(context, journal);
                    dates = ComingUp.compute(context, journal, System.currentTimeMillis(), TimeZone.getDefault().getID());
                } catch (IOException unreadable) {
                    all = null;
                }
                final List<Commitments.Commitment> found = all;
                final ComingUp.Result ahead = dates;
                runOnUiThread(new Runnable() {
                    @Override public void run() { show(found, ahead); }
                });
            }
        }).start();
    }

    // ---- The morning brief (docs/MORNING_BRIEF_PHONE.md, DR-40): off until turned on; counts only unless asked; the gate decides at each showing.

    private static final int REQUEST_BRIEF = 77;
    private int pendingMinute;
    private boolean pendingWords;

    private void say(String message) {
        new AlertDialog.Builder(this).setMessage(message).setPositiveButton("OK", null).show();
    }

    private void addBriefCard(final List<Commitments.Commitment> all, final ComingUp.Result ahead) {
        final Journal journal = journal();
        if (journal == null) return;
        List<String> lines;
        boolean on;
        try {
            lines = journal.readLines();
            on = BriefConfig.enabled(lines);
        } catch (IOException unreadable) {
            return;   // The history cannot say whether it is on, so no card rather than a guess.
        }
        list.addView(text("Morning brief", 15, true));
        if (!on) {
            list.addView(text("Off. Orb can show one notification each morning saying how many things are overdue, due today and ahead. "
                + "Counts only; nothing leaves your phone.", 12, false));
            Button turnOn = new Button(this);
            turnOn.setText("Turn on the morning brief\u2026");
            turnOn.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) { askBrief(false, BriefRules.DEFAULT_MINUTE, false); }
            });
            list.addView(turnOn);
        } else {
            final int minute = BriefConfig.minute(lines);
            final boolean words = BriefConfig.words(lines);
            list.addView(text("On \u2014 each morning at " + BriefRules.clock(minute) + (words ? " \u00b7 with the first words" : " \u00b7 counts only"), 12, false));
            LinearLayout buttons = new LinearLayout(this);
            buttons.setOrientation(LinearLayout.HORIZONTAL);
            Button preview = new Button(this);
            preview.setText("Show me today's brief");
            preview.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    Commitments.Today t = Commitments.today(all, ahead, CommitmentFlow.today(), System.currentTimeMillis());
                    String said = BriefRules.text(BriefRules.counts(t, CommitmentFlow.today(), System.currentTimeMillis()));
                    say(said.isEmpty() ? "Nothing to say today, so no notification would be shown." : said);
                }
            });
            buttons.addView(preview);
            Button change = new Button(this);
            change.setText("Change\u2026");
            change.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) { askBrief(true, minute, words); }
            });
            buttons.addView(change);
            Button off = new Button(this);
            off.setText("Turn off");
            off.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    Brief.turnOff(journal, new BriefAlarms(TodayActivity.this));
                    render();
                }
            });
            buttons.addView(off);
            list.addView(buttons);
        }
    }

    /** The card: what is shown and when, with the time to choose and the words option off. **Cancel is the default.** */
    private void askBrief(final boolean changing, int minute, boolean words) {
        LinearLayout form = new LinearLayout(this);
        form.setOrientation(LinearLayout.VERTICAL);
        form.setPadding(48, 16, 48, 0);
        form.addView(text("Once each morning Orb shows one notification with counts \u2014 for example \u201c3 overdue \u00b7 1 due today \u00b7 2 dates this week\u201d. "
            + "No names or words by default. Tap it to see the details here. If it is already past the time today, it is shown at once if that is within "
            + "3 hours, and skipped otherwise. You can turn it off any time.", 12, false));
        final TimePicker picker = new TimePicker(this);
        picker.setHour(minute / 60);
        picker.setMinute(minute % 60);
        form.addView(picker);
        final CheckBox withWords = new CheckBox(this);
        withWords.setText("Also show the first words (they would sit on the lock-screen history)");
        withWords.setChecked(words);
        form.addView(withWords);
        AlertDialog card = new AlertDialog.Builder(this)
            .setTitle(changing ? "Change the morning brief" : "Turn on the morning brief?")
            .setView(form)
            .setNegativeButton("Cancel", null)
            .setPositiveButton(changing ? "Save" : "Turn on", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) {
                    int chosen = picker.getHour() * 60 + picker.getMinute();
                    boolean chosenWords = withWords.isChecked();
                    Journal journal = journal();
                    if (journal == null) return;
                    if (changing) {
                        if (!Brief.configure(journal, chosen, chosenWords)) { say("Orb could not record this, so nothing changed."); return; }
                        rearm(journal);
                        render();
                    } else if (!ReminderNotifier.permitted(TodayActivity.this)) {
                        pendingMinute = chosen;
                        pendingWords = chosenWords;
                        requestPermissions(new String[] {"android.permission.POST_NOTIFICATIONS"}, REQUEST_BRIEF);
                    } else {
                        finishTurnOn(chosen, chosenWords);
                    }
                }
            })
            .create();
        card.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        card.show();
        card.getButton(AlertDialog.BUTTON_NEGATIVE).requestFocus();
    }

    /** Android allows notifications: now the person's decision is recorded, the alarm is set, and nothing else. */
    private void finishTurnOn(int minute, boolean words) {
        Journal journal = journal();
        if (journal == null) return;
        if (!Brief.turnOn(journal, minute, words)) {
            say("Orb could not record this, so it turned nothing on.");
            return;
        }
        rearm(journal);
        render();
    }

    private void rearm(Journal journal) {
        try {
            Brief.rearm(this, journal, System.currentTimeMillis(), TimeZone.getDefault(), BriefNotifier.permitted(this), new BriefNotifier(this), new BriefAlarms(this));
        } catch (IOException unreadable) {
            // History that cannot be read shows nothing; the next start tries again.
        }
    }

    private void section(String title, List<Commitments.Commitment> items, String today, Runnable refresh) {
        if (items.isEmpty()) return;
        list.addView(text(title + " (" + items.size() + ")", 15, true));
        for (Commitments.Commitment c : items) list.addView(commitments.row(c, today, refresh));
    }

    private void show(List<Commitments.Commitment> all, ComingUp.Result ahead) {
        list.removeAllViews();
        list.addView(text("Today", 17, true));
        if (all == null) {
            list.addView(text("Orb could not read its history, so it shows nothing rather than guess.", 13, false));
            return;
        }
        final Runnable refresh = new Runnable() {
            @Override public void run() { render(); }
        };
        final String today = CommitmentFlow.today();
        String[] ymd = today.split("-");
        Calendar c = Calendar.getInstance();
        c.clear();
        c.set(Integer.parseInt(ymd[0]), Integer.parseInt(ymd[1]) - 1, Integer.parseInt(ymd[2]));
        list.addView(text(new SimpleDateFormat("EEEE d MMMM yyyy", Locale.getDefault()).format(c.getTime()), 13, false));
        addBriefCard(all, ahead);
        Button add = new Button(this);
        add.setText("Add a commitment…");
        add.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { commitments.start(null, "", null, null, refresh); }
        });
        list.addView(add);
        Commitments.Today t = Commitments.today(all, ahead, today, System.currentTimeMillis());
        boolean any = !(t.overdue.isEmpty() && t.today.isEmpty() && t.week.isEmpty() && t.waiting.isEmpty() && t.undated.isEmpty() && t.dates.isEmpty() && t.closed.isEmpty() && t.later == 0);
        if (!any) {
            list.addView(text("Nothing is open. Track something from a person's page, a kept item, or a date in Coming up — or add one here.", 14, false));
            return;
        }
        section("Overdue — still open", t.overdue, today, refresh);
        section("Today", t.today, today, refresh);
        section("This week", t.week, today, refresh);
        addDates(t, refresh);
        section("Waiting for", t.waiting, today, refresh);
        section("No date", t.undated, today, refresh);
        section("Closed in the last " + Commitments.CLOSED_DAYS + " days \u2014 you can reopen", t.closed, today, refresh);
        if (t.later > 0) list.addView(text(t.later + " more, dated further ahead", 12, false));
        list.addView(text("Orb never marks anything done — only you. “Still open” means the date passed and you have not closed it.", 11, false));
    }

    /** The written dates ahead in what you kept, this week, that are not yet a commitment — each can become one. */
    private void addDates(Commitments.Today t, final Runnable refresh) {
        if (t.dates.isEmpty()) return;
        list.addView(text("Dates in what you kept, this week", 14, true));
        SimpleDateFormat nice = new SimpleDateFormat("EEE d MMM", Locale.getDefault());
        for (ComingUp.Day day : t.dates) {
            final String[] ymd = day.date.split("-");
            Calendar c = Calendar.getInstance();
            c.clear();
            c.set(Integer.parseInt(ymd[0]), Integer.parseInt(ymd[1]) - 1, Integer.parseInt(ymd[2]));
            for (final ComingUp.Item item : day.items) {
                LinearLayout row = new LinearLayout(this);
                row.setOrientation(LinearLayout.VERTICAL);
                row.setPadding(0, 8, 0, 8);
                row.addView(text(nice.format(c.getTime()) + (item.guess ? "  ·  a guess: “" + item.phrase + "”" : ""), 13, !item.guess));
                row.addView(text(item.shown(), 12, false));
                Button track = new Button(this);
                track.setText("Track this…");
                final int[] picked = {Integer.parseInt(ymd[0]), Integer.parseInt(ymd[1]), Integer.parseInt(ymd[2])};
                final String preset = item.line != null ? item.line : firstWords(item.entry.snippet);
                track.setOnClickListener(new View.OnClickListener() {
                    @Override public void onClick(View view) { commitments.start(item.entry.id, preset, picked, null, refresh); }
                });
                row.addView(track);
                list.addView(row);
            }
        }
    }

    /** The first words of an item, to start a commitment from — the person edits them. */
    static String firstWords(String snippet) {
        String flat = snippet == null ? "" : snippet.replace('\n', ' ').trim();
        return flat.length() > 80 ? flat.substring(0, 80) : flat;
    }
}
