package @PKG@;

import java.io.IOException;
import java.util.Arrays;
import java.util.Collections;
import java.util.List;
import java.util.Map;
import java.util.regex.Pattern;

/**
 * *Reach them from there* — the gate and the chain for handing one person's number to another app (`docs/PERSON_CONTEXT_PHONE.md`,
 * DR-28). **Orb sends nothing and calls no one**: it opens WhatsApp, the messaging app or the dialer with the number filled in, and
 * the person presses send or call there. The part that decides and records; it touches no Android — the app is opened through the
 * `Launcher`, which the app wires to Android and a test wires to a recorder.
 *
 * **Declared once, then frozen:** `orb.handoff.communicate` v1, Act (reversible), switchable, **every tap confirmed** — no standing
 * authorization, because nothing here needs to happen when the person is not looking.
 *
 * **Recorded first, then done** (as `Remind`): the release is written before the other app is opened, so Orb never acts without
 * history holding it; if no app handles it, a refusal follows. **Channel only is recorded — never the number or any text.** WhatsApp
 * is reached by its own link scheme, never a web link, so there is no browser fallback that would send the number to a website.
 */
final class Handoff {
    private Handoff() {}

    static final String CAPABILITY = "orb.handoff.communicate";
    static final long VERSION = 1L;

    /** The words that freeze the capability: a change to what it may do is a new capability, not an edit of this one. */
    static final String DECLARATION =
        "Opens WhatsApp, your messaging app or your dialer with one person's number filled in, when you tap and confirm. "
        + "Orb sends nothing, calls no one and reads nothing; you press send or call there. Only which kind of app was opened is "
        + "kept, never the number.";

    /** Opens another app. The only way anything reaches one. Returns false if no app handles it. */
    interface Launcher {
        boolean open(String channel, String uri);
    }

    /** A number in the form the contacts reader carries: `+` and 8–15 digits. Anything else is refused before an app is named. */
    private static final Pattern NUMBER = Pattern.compile("^\\+[0-9]{8,15}$");

    /**
     * The link that opens the channel, or null if it cannot be built safely. `tel:`, `smsto:`, and WhatsApp's own scheme — **no `http`**.
     */
    static String uri(String channel, String number) {
        if (number == null || !NUMBER.matcher(number).matches()) return null;
        if (HandoffFacts.DIAL.equals(channel)) return "tel:" + number;
        if (HandoffFacts.SMS.equals(channel)) return "smsto:" + number;
        if (HandoffFacts.WHATSAPP.equals(channel)) return "whatsapp://send?phone=" + number.substring(1);
        return null;
    }

    /** Whether the capability is on: the last of *allowed* and *revoked* wins; on until the person says otherwise. */
    static boolean enabled(List<String> lines) {
        boolean on = true;
        for (String line : lines) {
            String type = Journal.typeOf(line);
            if (HandoffFacts.ALLOWED.equals(type)) on = true;
            else if (HandoffFacts.REVOKED.equals(type)) on = false;
        }
        return on;
    }

    static void turnOff(Journal journal) {
        journal.append(HandoffFacts.REVOKED, HandoffFacts.revoked());
    }

    static void turnOn(Journal journal) {
        journal.append(HandoffFacts.ALLOWED, HandoffFacts.allowed());
    }

    private static String idOf(Map<String, Object> event) {
        return event == null ? null : (String) event.get("id");
    }

    /** The person tapped a channel and is about to be shown the review card. Returns the intent's event id, or null if it could not be written. */
    static String intend(Journal journal, String channel, long versionCode) {
        return idOf(journal.append(HandoffFacts.INTENT, HandoffFacts.intent(channel, versionCode)));
    }

    /** The person did not confirm. Recorded exactly as a confirmation is. */
    static void cancel(Journal journal, String intentId, String reason) {
        journal.append(HandoffFacts.CANCELLED, HandoffFacts.cancelled(reason), Arrays.asList(intentId));
    }

    /** The person confirmed this exact hand-off. Returns the confirmation's event id, or null if it could not be written. */
    static String confirm(Journal journal, String intentId, String channel) {
        return idOf(journal.append(HandoffFacts.CONFIRMED, HandoffFacts.confirmed(channel), Arrays.asList(intentId)));
    }

    /** What `release` answers. */
    static final String RELEASED = "released";

    private static boolean releasedAlready(List<String> lines, String confirmedId) {
        for (String line : lines) {
            if (HandoffFacts.RELEASED.equals(Journal.typeOf(line)) && Reminders.causesOf(line).contains(confirmedId)) return true;
        }
        return false;
    }

    private static String refuse(Journal journal, String confirmedId, String reason) {
        journal.append(HandoffFacts.REFUSED, HandoffFacts.refused(reason), Collections.singletonList(confirmedId));
        return "refused:" + reason;
    }

    /**
     * Opens the other app, if the gate allows it: the capability is on, this confirmation was not already carried out, and the number is
     * one that can be written as a link. The release is **recorded before** the app is opened; if nothing handles the link, a refusal
     * follows it. Returns `released` or `refused:<why>`. **The number is used to build the link and is never recorded.**
     */
    static String release(Journal journal, String confirmedId, String channel, String number, Launcher launcher) throws IOException {
        List<String> lines = journal.readLines();
        if (!enabled(lines)) return refuse(journal, confirmedId, HandoffFacts.SWITCHED_OFF);
        if (releasedAlready(lines, confirmedId)) return refuse(journal, confirmedId, HandoffFacts.ALREADY_RELEASED);
        String link = uri(channel, number);
        if (link == null) return refuse(journal, confirmedId, HandoffFacts.BAD_NUMBER);
        // Recorded first: an action Orb took is never missing from history.
        if (journal.append(HandoffFacts.RELEASED, HandoffFacts.released(channel), Collections.singletonList(confirmedId)) == null) {
            return "refused:journalFailed";
        }
        if (!launcher.open(channel, link)) return refuse(journal, confirmedId, HandoffFacts.APP_MISSING);
        return RELEASED;
    }
}
