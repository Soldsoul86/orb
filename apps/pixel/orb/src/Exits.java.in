package @PKG@;

import android.app.ActivityManager;
import android.app.ApplicationExitInfo;
import android.content.Context;
import java.util.ArrayList;
import java.util.List;
import java.util.Map;

/**
 * Why the previous process died — asked of the platform, not of a person.
 *
 * `docs/DEVICE_LOOP.md` §7b13. **P20** says a `signal:…BOOT_COMPLETED` at
 * non-zero uptime marks a force-stop since the app last ran. Both halves of that
 * prediction depend on a fact **no instrument recorded**: whether a force-stop
 * happened. A force-stopped app cannot write anything — that is what being
 * force-stopped means — so the journal of the app that was stopped is
 * structurally unable to hold the answer, and the only witness has been human
 * recall.
 *
 * On 2026-09-28 that failed in the way it was always going to: an absence was
 * written up as a confirmed control, and retracted the same day because the
 * operator did not know and habitually force-kills. **The same evidence is either
 * the control half or a counterexample**, and nothing in the lane can say which.
 *
 * `ActivityManager.getHistoricalProcessExitReasons` is the second source. The
 * platform survives the force-stop and remembers it, so the next start can read
 * why the last process ended — `REASON_USER_REQUESTED`, `REASON_USER_STOPPED`,
 * `REASON_LOW_MEMORY`, a crash — from the OS rather than from memory. That turns
 * P20's subject from something reconstructed into something observed.
 *
 * **It is a second *source*, not a second *machine*** — the same principle
 * `CLAIMS.md` §5 reached for C1's vantage. When a fact cannot be supplied
 * reliably by the actor, find something else that already knows it.
 *
 * **What it cannot see, carried on every reading as `exitScope`.** These are
 * process exits. A package force-stopped while it has no running process leaves
 * no record here at all, so the absence of a `user.requested` is never evidence
 * that no stop occurred (§7b20). The probe answers *why the last process died*;
 * it does not answer *whether the package was stopped*, and the two were
 * conflated once already at the cost of a refutation withdrawn the same day.
 */
final class Exits {
    private Exits() {}

    /**
     * How many exits to ask for.
     *
     * The platform keeps a bounded history of its own (a handful per package) and
     * trims it; asking for more than it holds is not an error, it simply returns
     * fewer. Sixteen is past anything observed and still bounds the work on a
     * start path that §7b11 established must stay cheap.
     */
    private static final int MAX = 16;

    /**
     * The reason codes, by name.
     *
     * **Recorded as the platform's integer *and* this label.** The integer is what
     * was observed; the label is this code's reading of it, and the two are not
     * the same kind of fact. A future Android adding a constant would otherwise
     * have its new reason silently rendered as one of these — the same failure as
     * an unreadable grant recorded as an empty one, so an unmapped code becomes
     * `unmapped:<n>` and says so.
     */
    static String name(int reason) {
        switch (reason) {
            case ApplicationExitInfo.REASON_ANR: return "anr";
            case ApplicationExitInfo.REASON_CRASH: return "crash";
            case ApplicationExitInfo.REASON_CRASH_NATIVE: return "crash.native";
            case ApplicationExitInfo.REASON_DEPENDENCY_DIED: return "dependency.died";
            case ApplicationExitInfo.REASON_EXCESSIVE_RESOURCE_USAGE: return "excessive.resources";
            case ApplicationExitInfo.REASON_EXIT_SELF: return "exit.self";
            case ApplicationExitInfo.REASON_FREEZER: return "freezer";
            case ApplicationExitInfo.REASON_INITIALIZATION_FAILURE: return "init.failure";
            case ApplicationExitInfo.REASON_LOW_MEMORY: return "low.memory";
            case ApplicationExitInfo.REASON_OTHER: return "other";
            case ApplicationExitInfo.REASON_PACKAGE_STATE_CHANGE: return "package.state.change";
            case ApplicationExitInfo.REASON_PACKAGE_UPDATED: return "package.updated";
            case ApplicationExitInfo.REASON_PERMISSION_CHANGE: return "permission.change";
            case ApplicationExitInfo.REASON_SIGNALED: return "signaled";
            case ApplicationExitInfo.REASON_UNKNOWN: return "unknown";
            case ApplicationExitInfo.REASON_USER_REQUESTED: return "user.requested";
            case ApplicationExitInfo.REASON_USER_STOPPED: return "user.stopped";
            default: return "unmapped:" + reason;
        }
    }

    /**
     * What kind of event this probe can see at all.
     *
     * **`process`, and the distinction is load-bearing.** This API reports
     * *process exits*. A force-stop is a *package stop*, and a package stopped
     * while it has no running process has no process to exit — so **nothing is
     * recorded** and the newest entry stays whatever killed the process earlier
     * (`DEVICE_LOOP.md` §7b20, where that gap produced a refutation that had to be
     * withdrawn the same day).
     *
     * So the scope travels on every reading, exactly as `installedPackageScope`
     * does and for the same reason: **a reader must be able to tell what kind of
     * look produced the answer.** If a later build ever observes package-stop
     * transitions directly this becomes `package`, and a comparison across the
     * change can refuse rather than silently diff two different measurements.
     */
    static final String SCOPE = "process";

    /**
     * Whether a reason is one a person caused deliberately.
     *
     * `REASON_USER_REQUESTED` is the force-stop from Settings and the swipe from
     * recents on builds that treat it as one; `REASON_USER_STOPPED` is the
     * package being stopped. **This is a reading, recorded alongside the code
     * rather than instead of it**, so a reader who disagrees can recompute from
     * the integer — the answer to P20 must not depend on this function being
     * right.
     *
     * Deliberately narrow. `REASON_OTHER` and `REASON_UNKNOWN` are *not* counted:
     * an exit the platform could not classify is not evidence that a person
     * caused it, and treating it as such would rebuild by inference exactly the
     * guesswork this probe exists to remove.
     */
    static boolean userInitiated(int reason) {
        return reason == ApplicationExitInfo.REASON_USER_REQUESTED
            || reason == ApplicationExitInfo.REASON_USER_STOPPED;
    }

    /**
     * Read the exits newer than `through`, newest first.
     *
     * Returns `null` on any failure, which the caller records as
     * `exitsReadable: false`. **Cannot-check is never rendered as nothing-found**
     * — an empty list here would say *this process has never died*, which of a
     * running app on its second start is a false and load-bearing claim.
     */
    static List<ApplicationExitInfo> since(Context context, long through) {
        try {
            ActivityManager manager =
                (ActivityManager) context.getSystemService(Context.ACTIVITY_SERVICE);
            if (manager == null) return null;

            List<ApplicationExitInfo> all =
                manager.getHistoricalProcessExitReasons(context.getPackageName(), 0, MAX);
            if (all == null) return null;

            List<ApplicationExitInfo> fresh = new ArrayList<>();
            for (ApplicationExitInfo info : all) {
                if (info.getTimestamp() > through) fresh.add(info);
            }
            return fresh;
        } catch (RuntimeException error) {
            // Includes SecurityException on a build that restricts this, and any
            // service failure. Which one is not worth a branch; that it could not
            // be read is the fact that matters and the caller records it.
            return null;
        }
    }

    /**
     * The newest exit timestamp a previous report recorded, or 0 if none.
     *
     * The same single-field extraction `Grants.previousScope` uses, and for the
     * same reason: the journal's own `last()` does no more, and a parser here
     * would be a second implementation of something §7 R2 says must not diverge.
     *
     * **Zero means baseline, not "nothing has ever exited".** The caller
     * distinguishes them by whether a prior line existed at all.
     */
    static long previousThrough(String line) {
        if (line == null) return 0L;
        String key = "\"exitsThrough\":";
        int at = line.indexOf(key);
        if (at < 0) return 0L;
        int from = at + key.length();
        int to = from;
        while (to < line.length() && (Character.isDigit(line.charAt(to)) || line.charAt(to) == '-')) {
            to++;
        }
        if (to == from) return 0L;
        try {
            return Long.parseLong(line.substring(from, to));
        } catch (NumberFormatException error) {
            return 0L;
        }
    }

    /**
     * Build the report for a set of exits.
     *
     * **`baseline` carries the same meaning it does everywhere else here**: no
     * prior record to compare against, so what is listed is what was already
     * there rather than what just happened. A first run finds every exit the
     * platform still remembers, and reporting those as news would be §5j's
     * always-failing check in a new place.
     */
    static Map<String, Object> report(List<ApplicationExitInfo> exits, boolean baseline) {
        Map<String, Object> payload = Json.obj();

        if (exits == null) {
            // The whole point of the field. Absent is not empty.
            payload.put("exitsReadable", false);
            // Scope even here: what this probe would have looked at is known even
            // when the look failed, and a reader needs it to interpret the failure.
            payload.put("exitScope", SCOPE);
            return payload;
        }

        payload.put("exitsReadable", true);
        payload.put("exitScope", SCOPE);
        payload.put("baseline", baseline);
        payload.put("exitCount", (long) exits.size());

        long newest = 0L;
        // The newest exit, tracked separately from the batch. **This is the one
        // that pairs with this process start**, and the reason the old any-of
        // flag was wrong: on a baseline report it read `true` because one of
        // three historical exits was user-initiated, while the death immediately
        // before this start was `low.memory` (`DEVICE_LOOP.md` §7b15).
        int newestReason = -1;
        StringBuilder reasons = new StringBuilder();
        StringBuilder codes = new StringBuilder();
        StringBuilder times = new StringBuilder();

        for (ApplicationExitInfo info : exits) {
            int reason = info.getReason();
            long at = info.getTimestamp();
            if (at > newest) {
                newest = at;
                newestReason = reason;
            }

            if (reasons.length() > 0) {
                reasons.append(':');
                codes.append(':');
                times.append(':');
            }
            reasons.append(name(reason));
            codes.append(reason);
            times.append(at);
        }

        payload.put("exitReasons", reasons.toString());
        // The integers beside the names, so the reading above is checkable and a
        // reason this build could not name is still recoverable from the record.
        payload.put("exitCodes", codes.toString());
        payload.put("exitTimestamps", times.toString());

        // The newest exit, named for what it is.
        //
        // **`exitsUserInitiated` is gone, deliberately.** It was an any-of across
        // the batch under a name that read as a statement about *this* start, and
        // it is not replaced by a better aggregate: anything of that shape is
        // derivable from `exitCodes`, and a second copy would be a second source
        // of truth for one fact (Art. IX §33).
        //
        // The name says *last recorded process death*, never *was force-stopped*.
        // Under `exitScope: process` a stop of an already-dead package leaves no
        // record at all, so **`false` here is never evidence that no stop
        // occurred** — it is the absence of a process exit, which is a different
        // fact and a weaker one.
        if (newestReason >= 0) {
            payload.put("lastExitReason", name(newestReason));
            payload.put("lastExitUserInitiated", userInitiated(newestReason));
        }
        // The watermark the next start compares against. Newest-seen rather than
        // a count, because the platform trims its own history and a count would
        // drift the moment it did.
        payload.put("exitsThrough", newest);

        return payload;
    }
}
