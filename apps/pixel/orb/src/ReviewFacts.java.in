package @PKG@;

import android.content.Context;
import java.util.HashMap;
import java.util.HashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;

/**
 * What the person's answer in the review writes to the journal (`docs/MONEY_PHONE.md` \u00a717, DR-46): one event, `orb.candidate.judged` \u2014 a **label**. It holds blinded
 * keys for the obligation and the payment, the verdict, what was shown, whether a movement was missed, and the name and version of the rule that proposed the
 * pair. **Never an amount, a sender, a day or a word.** It opens, closes and changes nothing: not a loop, not a commitment, not the ledger.
 *
 * The answers are read back as sets, so any order \u2014 and a restore \u2014 gives the same review.
 */
final class ReviewFacts {
    private ReviewFacts() {}

    static final String JUDGED = "orb.candidate.judged";
    static final String SCHEMA = "candidate.judged.v1";

    static final String PAID = "paid";
    static final String NOT_THIS = "notThis";
    static final String ALREADY_PAID = "alreadyPaid";
    /** What the person was shown: a payment that looks like the end of the bill, or an open obligation with none. */
    static final String CANDIDATE = "candidate";
    static final String OPEN = "open";

    /** The blinded key of an obligation or a payment, made from its namespaced id. */
    interface Keyer {
        String key(String namespaced) throws Exception;
    }

    static Keyer keyer(final Context context) {
        return new Keyer() {
            @Override public String key(String namespaced) throws Exception {
                return Attachments.address(context, namespaced).substring(0, 16);
            }
        };
    }

    static Map<String, Object> judged(String obligation, String payment, String verdict, String shown, boolean missed, String ruleId, long ruleVersion, long windowDays) {
        if (obligation == null || !obligation.matches("[0-9a-f]{16}")) throw new IllegalArgumentException("an obligation is recorded by its blinded key");
        boolean candidate = CANDIDATE.equals(shown);
        if (!candidate && !OPEN.equals(shown)) throw new IllegalArgumentException("what was shown is a candidate or an open obligation");
        if (candidate && (payment == null || !payment.matches("[0-9a-f]{16}"))) throw new IllegalArgumentException("a candidate names its payment by a blinded key");
        if (!candidate && payment != null && !payment.isEmpty()) throw new IllegalArgumentException("an open obligation has no payment");
        if (candidate ? !(PAID.equals(verdict) || NOT_THIS.equals(verdict)) : !ALREADY_PAID.equals(verdict)) throw new IllegalArgumentException("a verdict fits what was shown");
        if (missed && !ALREADY_PAID.equals(verdict)) throw new IllegalArgumentException("only an answer of already paid can have missed a payment");
        if (ruleId == null || !ruleId.matches("[a-z0-9._-]{0,64}")) throw new IllegalArgumentException("a rule is named by a short lower-case dotted name, never by free text");
        Map<String, Object> p = Json.obj();
        p.put("schema", SCHEMA);
        p.put("obligation", obligation);
        if (candidate) p.put("payment", payment);
        p.put("verdict", verdict);
        p.put("shown", shown);
        p.put("missed", missed);
        p.put("ruleId", ruleId);
        p.put("ruleVersion", Math.max(0L, ruleVersion));
        p.put("windowDays", Math.max(0L, windowDays));
        return p;
    }

    /**
     * Everything the journal says the person has answered, as **sets**: an answer repeated (a duplicated or restored journal) is one answer. The unit of a label is the
     * **pair** \u2014 this bill, this payment \u2014 because an obligation can be a chain of reminders with a payment for each (on a real inbox 13 of the 20 candidates sit in
     * such a chain), and one answer must not hide a question that was never asked.
     */
    static final class Judged {
        /** Obligations answered *already paid*, or with a payment marked paid: the review does not offer them as open again. */
        final Set<String> settled = new HashSet<>();
        /** `obligation|payment` pairs marked paid, and pairs the person said were not it: neither is asked again. */
        final Set<String> paidPairs = new HashSet<>();
        final Set<String> refused = new HashSet<>();
        /** Obligations answered already paid, and of those the ones that had missed a payment. */
        final Set<String> alreadyPaidSet = new HashSet<>();
        final Set<String> missedSet = new HashSet<>();

        long paid() { return paidPairs.size(); }
        long notThis() { return refused.size(); }
        long alreadyPaid() { return alreadyPaidSet.size(); }
        long missed() { return missedSet.size(); }
    }

    /** One answer, as read back from the journal. */
    private static final class Answer {
        String obligation, payment, verdict, shown;
        boolean missed;
    }

    private static final java.util.Set<String> FIELDS = new java.util.HashSet<>(java.util.Arrays.asList("schema", "obligation", "payment", "verdict", "shown", "missed", "ruleId", "ruleVersion", "windowDays"));

    /**
     * What identifies a question about a payment: **the payment**. Which reminder of a chain it was matched to can change when an older reminder is sealed later or one
     * leaves the kept facts; the payment does not, so an answer given about it holds.
     */
    static String pairKey(String obligation, String payment) {
        return payment;
    }

    /** The payload object of an event line, or null if there is none or it holds anything nested: an answer is one flat object. */
    private static String flatPayload(String line) {
        int at = line.indexOf("\"payload\":");
        if (at < 0) return null;
        int i = at + "\"payload\":".length();
        if (i >= line.length() || line.charAt(i) != '{') return null;
        int start = i;
        boolean inString = false;
        for (i = start + 1; i < line.length(); i++) {
            char c = line.charAt(i);
            if (inString) {
                if (c == '\\') i++;
                else if (c == '"') inString = false;
            } else if (c == '"') inString = true;
            else if (c == '{' || c == '[') return null;
            else if (c == '}') return line.substring(start, i + 1);
        }
        return null;
    }

    /** A flat object of strings, numbers and booleans, read strictly; null if it is anything else. */
    private static Map<String, Object> parseFlat(String object) {
        Map<String, Object> out = new HashMap<>();
        int i = 1;
        int n = object.length() - 1;   // the closing brace
        while (i < n) {
            if (object.charAt(i) != '"') return null;
            int[] end = new int[1];
            String key = readString(object, i, end);
            if (key == null || end[0] >= n || object.charAt(end[0]) != ':') return null;
            i = end[0] + 1;
            Object value;
            if (i < n && object.charAt(i) == '"') {
                value = readString(object, i, end);
                if (value == null) return null;
                i = end[0];
            } else {
                int j = i;
                while (j < n && object.charAt(j) != ',') j++;
                String raw = object.substring(i, j);
                if ("true".equals(raw)) value = Boolean.TRUE;
                else if ("false".equals(raw)) value = Boolean.FALSE;
                else if (raw.matches("[0-9]{1,18}")) value = Long.valueOf(raw);
                else return null;
                i = j;
            }
            if (out.containsKey(key)) return null;
            out.put(key, value);
            if (i < n) {
                if (object.charAt(i) != ',') return null;
                i++;
            }
        }
        return out;
    }

    /** The string that starts at `from` (a quote), with the index just past its closing quote in `end[0]`; null if it is not terminated. */
    private static String readString(String s, int from, int[] end) {
        StringBuilder sb = new StringBuilder();
        for (int i = from + 1; i < s.length(); i++) {
            char c = s.charAt(i);
            if (c == '"') {
                end[0] = i + 1;
                return sb.toString();
            }
            if (c == '\\') {
                if (++i >= s.length()) return null;
                sb.append(s.charAt(i));
            } else sb.append(c);
        }
        return null;
    }

    /** An answer as the writer would have written it, or null: an unknown schema, an unknown or missing field, a value the writer would refuse. */
    private static Answer parse(String line) {
        String object = flatPayload(line);
        if (object == null) return null;
        Map<String, Object> m = parseFlat(object);
        if (m == null || !FIELDS.containsAll(m.keySet()) || !SCHEMA.equals(m.get("schema"))) return null;
        for (String required : new String[] {"obligation", "verdict", "shown", "missed", "ruleId", "ruleVersion", "windowDays"}) if (!m.containsKey(required)) return null;
        if (!(m.get("obligation") instanceof String) || !(m.get("verdict") instanceof String) || !(m.get("shown") instanceof String) || !(m.get("missed") instanceof Boolean)
            || !(m.get("ruleId") instanceof String) || !(m.get("ruleVersion") instanceof Long) || !(m.get("windowDays") instanceof Long)
            || (m.containsKey("payment") && !(m.get("payment") instanceof String))) return null;
        Answer a = new Answer();
        a.obligation = (String) m.get("obligation");
        a.payment = m.containsKey("payment") ? (String) m.get("payment") : "";
        a.verdict = (String) m.get("verdict");
        a.shown = (String) m.get("shown");
        a.missed = (Boolean) m.get("missed");
        try {
            judged(a.obligation, a.payment, a.verdict, a.shown, a.missed, (String) m.get("ruleId"), (Long) m.get("ruleVersion"), (Long) m.get("windowDays"));
        } catch (IllegalArgumentException writerWouldRefuse) {
            return null;
        }
        return a;
    }

    /**
     * The journal's answers, read as strictly as they are written: one flat object of the known fields of the known schema, passing the same checks. **One label per
     * pair (per obligation for an open one), the last in the journal's order** \u2014 an answer given twice, or changed, counts once.
     */
    static Judged fold(List<String> lines) {
        Map<String, Answer> last = new java.util.LinkedHashMap<>();
        for (String line : lines) {
            if (!JUDGED.equals(Journal.typeOf(line))) continue;
            Answer a = parse(line);
            if (a == null) continue;
            last.put(CANDIDATE.equals(a.shown) ? pairKey(a.obligation, a.payment) : "open|" + a.obligation, a);
        }
        Judged out = new Judged();
        for (Answer a : last.values()) {
            if (PAID.equals(a.verdict)) {
                out.settled.add(a.obligation);
                out.paidPairs.add(pairKey(a.obligation, a.payment));
            } else if (ALREADY_PAID.equals(a.verdict)) {
                out.settled.add(a.obligation);
                out.alreadyPaidSet.add(a.obligation);
                if (a.missed) out.missedSet.add(a.obligation);
            } else if (NOT_THIS.equals(a.verdict)) {
                out.refused.add(pairKey(a.obligation, a.payment));
            }
        }
        return out;
    }

    /** What one answer writes, from the item the person was shown. Pure: the same item and verdict give the same event. */
    static Map<String, Object> payloadFor(ReviewRules.Item item, String verdict) {
        boolean candidate = item.closer != null;
        return judged(item.obligationKey, item.paymentKey, verdict, candidate ? CANDIDATE : OPEN, !candidate && item.missed,
            candidate ? item.closer.ruleId : "", candidate ? item.closer.ruleVersion : 1L, Correlator.WINDOW_DAYS);
    }

    /** **The one place an answer is written:** one event, a label, and nothing else. Returns whether the journal took it. */
    static boolean record(Journal journal, ReviewRules.Item item, String verdict) {
        if (journal == null) return false;
        Map<String, Object> payload;
        try {
            payload = payloadFor(item, verdict);
        } catch (IllegalArgumentException cannotBeWritten) {
            return false;
        }
        return journal.append(JUDGED, payload) != null;
    }

    /** The first 20 answers are too few to report a precision from: below this it says so, and it never gates anything. */
    static final int MIN_ANSWERS = 20;

    static String precisionLine(long paid, long notThis) {
        long n = paid + notThis;
        if (n < MIN_ANSWERS) return "Precision: insufficient sample (" + n + " of " + MIN_ANSWERS + " answers).";
        return "Precision: " + Math.round(100.0 * paid / n) + "% of " + n + " answers (paid \u00f7 paid + not this).";
    }

    static String missedLine(long alreadyPaid, long missed) {
        return "Missed correlations: " + missed + " of " + alreadyPaid + " \u201calready paid\u201d answers.";
    }
}
