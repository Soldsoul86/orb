package @PKG@;

import android.content.Context;
import java.io.ByteArrayOutputStream;
import java.io.File;
import java.io.FileInputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.RandomAccessFile;
import java.security.MessageDigest;
import java.security.SecureRandom;
import java.util.Locale;
import javax.crypto.Cipher;
import javax.crypto.Mac;
import javax.crypto.spec.GCMParameterSpec;
import javax.crypto.spec.SecretKeySpec;

/**
 * Attachments on the device — content-addressed, blind-addressed, and sealed.
 *
 * `contracts/Attachment.md` is **Accepted**, so this is not a place to improvise.
 * Three of its invariants have to hold the moment a photograph's bytes land here,
 * and each is a few lines rather than a project:
 *
 * **inv. 1–2, identity is the content hash.** `sha256:<hex>`, scheme-tagged from
 * the first one so a later scheme can be added rather than guessed at (§5).
 *
 * **inv. 7, the address is blinded.** `HMAC(addressSecret, identity)`. A store
 * addressed by identity is *a list of identities*: anyone who can read the
 * directory can test any file they already hold against it, so **encrypting the
 * bytes hides the content and never which content.** The secret is
 * derived-by-design, recomputable, and rotatable — and explicitly **not** an
 * erasure key.
 *
 * **inv. 8, sealed under its own key.** AES-256-GCM, one key per Attachment, so
 * erasure is *destroy that key* rather than *delete those bytes* — which reaches
 * a copy on a peer's disk and residue in flash, neither of which deleting
 * reaches (`ERASURE.md` §2a).
 *
 * **Deliberately matching `runtime/journal/src/attachment.ts`.** Same hash, same
 * tag, same HMAC construction. §7 R2: two implementations of one thing must not
 * diverge, and the cheapest way to keep them from diverging is to write the
 * second one against the first rather than against its description.
 *
 * **Keys are stored, never derived** (`ERASURE.md` §2a). Anything derivable is
 * re-derivable, so destroying a derived key destroys nothing.
 */
final class Attachments {
    private Attachments() {}

    static final String IDENTITY_SCHEME = "sha256";

    /**
     * The largest thing this will take into memory.
     *
     * A shared video can be gigabytes, and a phone reading one into a byte array
     * dies. The cap is **refused and recorded** rather than truncated: half a
     * photograph under a hash of the whole would fail inv. 5's re-check and look
     * like corruption, which is a worse answer than *too large*.
     */
    static final int MAX_BYTES = 64 * 1024 * 1024;

    private static final String KEYS = "attachment-keys";
    private static final String BLOBS = "attachments";
    private static final String DESTROYED = "attachment-destroyed";
    private static final String ADDRESS_SECRET = "address.secret";
    private static final int IV_BYTES = 12;
    private static final int TAG_BITS = 128;

    /** What happened, and enough to record it honestly. */
    static final class Stored {
        final String identity;
        final long bytes;
        final String outcome;
        final String detail;

        private Stored(String identity, long bytes, String outcome, String detail) {
            this.identity = identity;
            this.bytes = bytes;
            this.outcome = outcome;
            this.detail = detail;
        }

        /** Written now. */
        static Stored stored(String identity, long bytes) {
            return new Stored(identity, bytes, "stored", null);
        }

        /**
         * Already present, and not written again.
         *
         * **Distinct from `stored` deliberately** (`DEVICE_LOOP.md` §7b35). Both
         * mean *the content is here*, and only one of them cost disk. Collapsing
         * them makes *how much is Orb storing* underivable from history — two
         * different facts sharing one value, which is the `Readable: false`
         * argument in its fifth costume.
         */
        static Stored held(String identity, long bytes) {
            return new Stored(identity, bytes, "held", null);
        }

        static Stored failed(String outcome, String detail) {
            return new Stored(null, 0L, outcome, detail);
        }
    }

    /**
     * Reads a stream to its end, seals it, and stores it at its blinded address.
     *
     * **The caller must still hold the URI grant** — that is the whole point of
     * resolving during the share (`DEVICE_LOOP.md` §7b33). This never opens
     * anything itself.
     *
     * Idempotent by identity: the same bytes stored twice land at the same
     * address under the same key, so re-sharing one photograph costs one copy.
     */
    static Stored store(Context context, InputStream in) {
        byte[] bytes;
        try {
            bytes = readAll(in);
        } catch (TooLarge tooLarge) {
            return Stored.failed("tooLarge", "over " + MAX_BYTES + " bytes");
        } catch (IOException error) {
            return Stored.failed("readFailed", error.getClass().getName() + ": " + error.getMessage());
        }

        try {
            String identity = identity(bytes);
            if (state(context, identity).equals(DESTROYED_STATE)) {
                // inv. 8: an erasure is not undone by the same bytes arriving again. A
                // fresh key here would make the content readable again by an accident
                // of timing, which is the erasure quietly reversed. Refused, recorded,
                // and said to the person — never a silent no-op.
                return Stored.failed("erased", "this exact content was erased and is not kept again");
            }
            File blob = new File(dir(context, BLOBS), address(context, identity));
            if (blob.exists()) {
                // Same content, already here. Not an error, not a second copy,
                // and **not the same outcome as having just written it**.
                return Stored.held(identity, bytes.length);
            }

            byte[] key = mintKey(context, identity);
            byte[] iv = new byte[IV_BYTES];
            new SecureRandom().nextBytes(iv);

            Cipher cipher = Cipher.getInstance("AES/GCM/NoPadding");
            cipher.init(Cipher.ENCRYPT_MODE, new SecretKeySpec(key, "AES"), new GCMParameterSpec(TAG_BITS, iv));
            byte[] sealed = cipher.doFinal(bytes);

            try (RandomAccessFile out = new RandomAccessFile(blob, "rws")) {
                out.write(iv);
                out.write(sealed);
                out.getFD().sync();
            }
            return Stored.stored(identity, bytes.length);
        } catch (Exception error) {
            return Stored.failed("sealFailed", error.getClass().getName() + ": " + error.getMessage());
        }
    }

    /**
     * How many keys this phone holds and how many identities it has destroyed, as two
     * numbers. Written into the export so a reader can see the *state* of the store, not
     * only the declarations: a declaration says an erasure was committed to, and only a
     * count of keys can say the key is gone (`DEVICE_LOOP.md` §7b47).
     */
    static long[] counts(Context context) {
        String[] held = dir(context, KEYS).list();
        String[] gone = dir(context, DESTROYED).list();
        return new long[] {held == null ? 0L : held.length, gone == null ? 0L : gone.length};
    }

    /** Whether a key or ciphertext for this identity is still on disk — what destruction removes. */
    static boolean remains(Context context, String identity) throws Exception {
        String address = address(context, identity);
        return new File(dir(context, KEYS), address).exists() || new File(dir(context, BLOBS), address).exists();
    }

    /** What this phone holds for an identity. */
    static final String HELD_STATE = "held";
    static final String DESTROYED_STATE = "destroyed";
    static final String NEVER_STATE = "never";

    /**
     * `held` (a key is here), `destroyed` (the erasure marker is here), or `never`.
     *
     * **The marker wins.** Destruction writes the marker first and removes the key after,
     * so a crash between the two leaves both on disk — and that must read as destroyed,
     * not held, or the half-finished erasure would look like it never started.
     */
    static String state(Context context, String identity) throws Exception {
        String address = address(context, identity);
        if (new File(dir(context, DESTROYED), address).exists()) return DESTROYED_STATE;
        if (new File(dir(context, KEYS), address).exists()) return HELD_STATE;
        return NEVER_STATE;
    }

    /**
     * Destroys this Attachment's key. **Irreversible, and the act erasure consists of**
     * (`ERASURE.md` §2a, `Attachment.md` inv. 8).
     *
     * The caller decides *whether* — `Erasure.plan` is the guard (nothing readable still
     * cites it). This only does it, in an order that survives being killed half-way:
     *
     * 1. **the marker**, so nothing can mint a fresh key for this identity again;
     * 2. **the key**, overwritten with zeros and synced, then deleted;
     * 3. **the ciphertext**, deleted. Belt and braces: the key going is what makes any
     *    copy of it inert, and dropping the local bytes is tidiness.
     *
     * The marker holds the *blinded address*, never the identity, so it is no more a
     * list of what was kept than the key directory already was.
     *
     * **What this does not promise.** Overwriting then deleting a file on flash does not
     * guarantee the old bytes are physically gone: the storage may keep a stale copy.
     * What makes the content unrecoverable is that the key was never anywhere but here,
     * and that file-based encryption keeps what is left of it unreadable without the
     * device. A stronger answer is a hardware-backed key (a port, not built).
     *
     * @return whether a key was there to destroy
     */
    static boolean destroy(Context context, String identity) throws Exception {
        String address = address(context, identity);

        File marker = new File(dir(context, DESTROYED), address);
        if (!marker.exists()) writeBytes(marker, new byte[] {1});

        boolean hadKey = false;
        File key = new File(dir(context, KEYS), address);
        if (key.exists()) {
            hadKey = true;
            try (RandomAccessFile out = new RandomAccessFile(key, "rws")) {
                out.write(new byte[(int) Math.max(out.length(), 32)]);
                out.getFD().sync();
            }
            if (!key.delete()) throw new IOException("key could not be removed");
        }

        File blob = new File(dir(context, BLOBS), address);
        if (blob.exists() && !blob.delete()) throw new IOException("ciphertext could not be removed");
        return hadKey;
    }

    /** `sha256:<hex>` — inv. 1 and 2, scheme-tagged from the first one. */
    static String identity(byte[] bytes) throws Exception {
        byte[] digest = MessageDigest.getInstance("SHA-256").digest(bytes);
        return IDENTITY_SCHEME + ":" + hex(digest);
    }

    /**
     * `HMAC(addressSecret, identity)` — inv. 7.
     *
     * The secret is minted once and kept; rotating it voids every address an
     * adversary has collected and breaks nothing, because only the local store
     * layout depends on it while *identity* is what history references.
     */
    static String address(Context context, String identity) throws Exception {
        Mac mac = Mac.getInstance("HmacSHA256");
        mac.init(new SecretKeySpec(addressSecret(context), "HmacSHA256"));
        return hex(mac.doFinal(identity.getBytes("UTF-8")));
    }

    /**
     * This Attachment's own key, minted on first store.
     *
     * One key per Attachment is what makes inv. 8's erasure possible at all: a
     * store-wide key cannot be destroyed for one photograph.
     */
    private static byte[] mintKey(Context context, String identity) throws Exception {
        File file = new File(dir(context, KEYS), address(context, identity));
        if (file.exists()) return readBytes(file);
        // Second line of the same guard `store` applies: no path mints a key for an
        // identity that was destroyed.
        if (new File(dir(context, DESTROYED), address(context, identity)).exists()) {
            throw new IOException("destroyed identity: not re-minted");
        }
        byte[] key = new byte[32];
        new SecureRandom().nextBytes(key);
        writeBytes(file, key);
        return key;
    }

    private static byte[] addressSecret(Context context) throws IOException {
        File file = new File(context.getFilesDir(), ADDRESS_SECRET);
        if (file.exists()) return readBytes(file);
        byte[] secret = new byte[32];
        new SecureRandom().nextBytes(secret);
        writeBytes(file, secret);
        return secret;
    }

    private static File dir(Context context, String name) {
        File dir = new File(context.getFilesDir(), name);
        if (!dir.exists()) dir.mkdirs();
        return dir;
    }

    private static byte[] readBytes(File file) throws IOException {
        try (RandomAccessFile in = new RandomAccessFile(file, "r")) {
            byte[] bytes = new byte[(int) in.length()];
            in.readFully(bytes);
            return bytes;
        }
    }

    private static void writeBytes(File file, byte[] bytes) throws IOException {
        try (RandomAccessFile out = new RandomAccessFile(file, "rws")) {
            out.write(bytes);
            out.getFD().sync();
        }
    }

    /** Raised rather than truncating: a partial read under a whole-content hash is corruption. */
    private static final class TooLarge extends IOException {
        TooLarge() {
            super("attachment over " + MAX_BYTES + " bytes");
        }
    }

    private static byte[] readAll(InputStream in) throws IOException {
        ByteArrayOutputStream out = new ByteArrayOutputStream();
        byte[] buffer = new byte[1 << 16];
        int read;
        while ((read = in.read(buffer)) != -1) {
            if (out.size() + read > MAX_BYTES) throw new TooLarge();
            out.write(buffer, 0, read);
        }
        return out.toByteArray();
    }

    private static String hex(byte[] bytes) {
        StringBuilder out = new StringBuilder(bytes.length * 2);
        for (byte b : bytes) out.append(String.format(Locale.US, "%02x", b));
        return out.toString();
    }
}
