package @PKG@;

import android.content.Context;
import android.os.SystemClock;
import java.io.File;
import java.io.IOException;
import java.io.RandomAccessFile;
import java.util.Map;

/**
 * Whether Orb may read the contacts — a **recorded decision of the person's**, the same shape as `PackageAccess`
 * (`docs/PEOPLE_PHONE.md`, DR-24). Android's own permission is asked separately, at the first grant; this is Orb's side: the
 * grant is an event, the flag follows it, a revocation removes the flag and then says so, and the history is made to agree with
 * the phone after a restore.
 *
 * **Nothing here reads a contact.** `ContactsReader` does, only after this says yes; the grant is not a copy of anything.
 */
final class ContactsAccess {
    private ContactsAccess() {}

    private static final String FILE = "contacts-access.granted";

    static boolean granted(Context context) {
        return new File(context.getFilesDir(), FILE).exists();
    }

    /** Event first, then the flag: a crash in between leaves a grant on record that the device does not yet exercise — the harmless direction. */
    static void grant(Context context, Journal journal) throws IOException {
        if (granted(context)) return;
        record(journal, PackageGrants.GRANTED, "operator");
        try (RandomAccessFile out = new RandomAccessFile(new File(context.getFilesDir(), FILE), "rws")) {
            out.write(new byte[] {1});
            out.getFD().sync();
        }
    }

    /** Flag first, then the event: stop reading, then say so — a crash in between fails toward not reading. */
    static void revoke(Context context, Journal journal) {
        new File(context.getFilesDir(), FILE).delete();
        record(journal, PackageGrants.REVOKED, "operator");
    }

    /** A restore brings the journal back and grants nothing: if it says *granted* and the flag is absent, record the revocation. */
    static void reconcile(Context context, Journal journal) {
        if (journal == null || granted(context)) return;
        try {
            if (PackageGrants.lastIsGrant(journal.readLines(), Capabilities.CONTACTS)) record(journal, PackageGrants.REVOKED, "reconcile");
        } catch (IOException unreadable) {
            // Cannot read the history, so cannot say what it claims. Write nothing.
        }
    }

    private static void record(Journal journal, String type, String by) {
        if (journal == null) return;
        Map<String, Object> payload = Json.obj();
        payload.put("capability", Capabilities.CONTACTS);
        payload.put("tier", Capabilities.TIER_OBSERVE);
        payload.put("scope", "names, phone numbers and email addresses in your contacts, read only while the People screen is open");
        payload.put("by", by);
        payload.put("elapsedRealtimeMs", SystemClock.elapsedRealtime());
        journal.append(type, payload);
    }
}
