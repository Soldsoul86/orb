package @PKG@;

import android.app.Activity;
import android.os.Bundle;
import android.graphics.Typeface;
import android.view.View;
import android.view.WindowManager;
import android.widget.Button;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import java.io.IOException;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;
import java.util.Locale;

/**
 * What Orb may do — the capability as it was declared, in plain words, the reminders waiting, and the switch
 * (`docs/GATE_PHONE.md` §5). **The same sentences the gate is held to.** Anything Orb does to the world is listed here and
 * can be withdrawn here; turning it off cancels every pending reminder, each one recorded.
 *
 * Secure like Recall: a reminder's note is the person's own words.
 */
public final class MayDoActivity extends Activity {
    private LinearLayout list;

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);
        getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        ScrollView scroll = new ScrollView(this);
        list = new LinearLayout(this);
        list.setOrientation(LinearLayout.VERTICAL);
        list.setPadding(40, 120, 40, 40);
        scroll.addView(list);
        setContentView(scroll);
    }

    @Override
    protected void onResume() {
        super.onResume();
        render();
    }

    private TextView text(String s, int size, boolean bold) {
        TextView t = new TextView(this);
        t.setTextSize(size);
        t.setPadding(0, 8, 0, 8);
        if (bold) t.setTypeface(Typeface.DEFAULT_BOLD);
        t.setText(s);
        return t;
    }

    /** The one control that withdraws a capability — each the control that already existed for it. */
    private void addControl(final Capabilities.Declaration d, List<String> lines, final Journal journal) {
        Button b = new Button(this);
        if (d.id.equals(Capabilities.PACKAGES)) {
            boolean known;
            try {
                known = PackageGrants.lastIsGrant(lines);
            } catch (IOException unreadable) {
                return;   // The history cannot say whether it is granted, so no control is offered on a guess.
            }
            final boolean granted = known;
            b.setText(granted ? "Revoke package scanning" : "Grant package scanning");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    try {
                        if (granted) PackageAccess.revoke(MayDoActivity.this, journal);
                        else PackageAccess.grant(MayDoActivity.this, journal);
                    } catch (IOException ignored) {
                        // Nothing changed if the grant could not be recorded.
                    }
                    render();
                }
            });
        } else if (d.id.equals(Capabilities.SCREEN)) {
            b.setText("Apps Orb may remember from");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) { startActivity(new android.content.Intent(MayDoActivity.this, AllowActivity.class)); }
            });
        } else if (d.id.equals(Capabilities.CONTACTS)) {
            boolean known;
            try {
                known = PackageGrants.lastIsGrant(lines, Capabilities.CONTACTS);
            } catch (IOException unreadable) {
                return;   // The history cannot say whether it is granted, so no control is offered on a guess.
            }
            final boolean contactsOn = known;
            b.setText(contactsOn ? "Revoke contacts access" : "Allow contacts (opens People)");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (contactsOn) {
                        ContactsAccess.revoke(MayDoActivity.this, journal);
                        render();
                    } else {
                        startActivity(new android.content.Intent(MayDoActivity.this, PeopleActivity.class));
                    }
                }
            });
        } else if (d.id.equals(Capabilities.APPSEC)) {
            boolean known;
            try {
                known = PackageGrants.lastIsGrant(lines, Capabilities.APPSEC);
            } catch (IOException unreadable) {
                return;   // The history cannot say whether it is granted, so no control is offered on a guess.
            }
            final boolean checkOn = known;
            b.setText(checkOn ? "Revoke the safety check" : "Allow the safety check (opens it)");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (checkOn) {
                        SafetyAccess.revoke(MayDoActivity.this, journal);
                        render();
                    } else {
                        startActivity(new android.content.Intent(MayDoActivity.this, SafetyActivity.class));
                    }
                }
            });
        } else if (d.id.equals(Capabilities.MESSAGES)) {
            boolean known;
            try {
                known = PackageGrants.lastIsGrant(lines, Capabilities.MESSAGES);
            } catch (IOException unreadable) {
                return;   // The history cannot say whether it is granted, so no control is offered on a guess.
            }
            final boolean messagesOn = known;
            b.setText(messagesOn ? "Switch off the Messages source" : "Turn on (opens Sources)");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (messagesOn) {
                        MessagesAccess.revoke(MayDoActivity.this, journal);
                        render();
                    } else {
                        startActivity(new android.content.Intent(MayDoActivity.this, SourcesActivity.class));
                    }
                }
            });
        } else if (d.id.equals(Capabilities.BRIEF)) {
            boolean known;
            try {
                known = PackageGrants.lastIsGrant(lines, Capabilities.BRIEF);
            } catch (IOException unreadable) {
                return;   // The history cannot say whether it is on, so no control is offered on a guess.
            }
            final boolean briefOn = known;
            b.setText(briefOn ? "Switch off the morning brief" : "Turn on (opens Today)");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (briefOn) {
                        Brief.turnOff(journal, new BriefAlarms(MayDoActivity.this));
                        render();
                    } else {
                        startActivity(new android.content.Intent(MayDoActivity.this, TodayActivity.class));
                    }
                }
            });
        } else if (d.id.equals(Capabilities.SENDERS)) {
            boolean known;
            try {
                known = PackageGrants.lastIsGrant(lines, Capabilities.SENDERS);
            } catch (IOException unreadable) {
                return;   // The history cannot say whether it is on, so no control is offered on a guess.
            }
            final boolean sendersOn = known;
            b.setText(sendersOn ? "Switch off sender marks" : "Turn on (opens Sources)");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (sendersOn) {
                        SendersAccess.revoke(MayDoActivity.this, journal);
                        render();
                    } else {
                        startActivity(new android.content.Intent(MayDoActivity.this, SourcesActivity.class));
                    }
                }
            });
        } else if (d.id.equals(Capabilities.OBS_KEEP)) {
            boolean known;
            try {
                known = PackageGrants.lastIsGrant(lines, Capabilities.OBS_KEEP);
            } catch (IOException unreadable) {
                return;   // The history cannot say whether it is on, so no control is offered on a guess.
            }
            final boolean keepOn = known;
            b.setText(keepOn ? "Switch off keeping facts" : "Turn on keeping facts");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (keepOn) {
                        KeepAccess.revoke(MayDoActivity.this, journal);
                        render();
                    } else {
                        // A yes is the person's, asked first, in the words the capability is pinned to. Turning it on keeps nothing: keeping is the Keep button.
                        new android.app.AlertDialog.Builder(MayDoActivity.this)
                            .setTitle("Turn on keeping facts?")
                            .setMessage(Capabilities.OBS_KEEP_SAYS + "\n\nTurning it on keeps nothing by itself: you still choose Keep on the Sources screen each time.")
                            .setPositiveButton("Turn on", new android.content.DialogInterface.OnClickListener() {
                                @Override public void onClick(android.content.DialogInterface d, int which) {
                                    try {
                                        KeepAccess.grant(MayDoActivity.this, journal);
                                    } catch (IOException notRecorded) {
                                        // Not recorded, so not on.
                                    }
                                    render();
                                }
                            })
                            .setNegativeButton("Not now", null)
                            .show();
                    }
                }
            });
        } else if (d.id.equals(Capabilities.UNDERSTAND)) {
            boolean known;
            try {
                known = PackageGrants.lastIsGrant(lines, Capabilities.UNDERSTAND);
            } catch (IOException unreadable) {
                return;   // The history cannot say whether it is granted, so no control is offered on a guess.
            }
            final boolean noticeOn = known;
            b.setText(noticeOn ? "Switch off What Orb has noticed" : "Turn on (opens People)");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (noticeOn) {
                        UnderstandingAccess.revoke(MayDoActivity.this, journal);
                        render();
                    } else {
                        startActivity(new android.content.Intent(MayDoActivity.this, PeopleActivity.class));
                    }
                }
            });
        } else if (d.id.equals(Capabilities.CALLS)) {
            if (!CallsAccess.available(this)) {
                b.setText("Not in this build of Orb");
                b.setEnabled(false);
            } else {
                boolean known;
                try {
                    known = PackageGrants.lastIsGrant(lines, Capabilities.CALLS);
                } catch (IOException unreadable) {
                    return;   // The history cannot say whether it is granted, so no control is offered on a guess.
                }
                final boolean callsOn = known;
                b.setText(callsOn ? "Switch off the call-history line" : "Turn on (opens People)");
                b.setOnClickListener(new View.OnClickListener() {
                    @Override public void onClick(View view) {
                        if (callsOn) {
                            CallsAccess.revoke(MayDoActivity.this, journal);
                            render();
                        } else {
                            startActivity(new android.content.Intent(MayDoActivity.this, PeopleActivity.class));
                        }
                    }
                });
            }
        } else if (d.id.equals(Capabilities.DOCUMENTS)) {
            boolean known;
            try {
                known = PackageGrants.lastIsGrant(lines, Capabilities.DOCUMENTS);
            } catch (IOException unreadable) {
                return;   // The history cannot say whether it is granted, so no control is offered on a guess.
            }
            final boolean sourceOn = known;
            b.setText(sourceOn ? "Switch off the Documents source" : "Turn on (opens Sources)");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (sourceOn) {
                        DocumentsAccess.revoke(MayDoActivity.this, journal);
                        render();
                    } else {
                        startActivity(new android.content.Intent(MayDoActivity.this, SourcesActivity.class));
                    }
                }
            });
        } else if (d.id.equals(Reminders.CAPABILITY)) {
            final boolean on = Reminders.enabled(lines);
            b.setText(on ? "Turn off (cancels every pending reminder)" : "Turn on");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    try {
                        if (on) Remind.turnOff(journal, new ReminderAlarms(MayDoActivity.this));
                        else Remind.turnOn(journal);
                    } catch (IOException ignored) {
                        // Nothing changed if the history cannot be read.
                    }
                    render();
                }
            });
        } else if (d.id.equals(Handoff.CAPABILITY)) {
            final boolean handoffOn = Handoff.enabled(lines);
            b.setText(handoffOn ? "Turn off (no person's page can open another app)" : "Turn on");
            b.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    if (handoffOn) Handoff.turnOff(journal);
                    else Handoff.turnOn(journal);
                    render();
                }
            });
        } else {
            return;   // The grants watch is always on: shown, with no control.
        }
        list.addView(b);
    }

    private void render() {
        list.removeAllViews();
        list.addView(text("What Orb may do", 17, true));
        final Orb app = Orb.get();
        final Journal journal = app == null ? null : app.journal();
        if (journal == null) {
            list.addView(text("journal unavailable", 13, false));
            return;
        }
        List<String> lines;
        try {
            lines = journal.readLines();
        } catch (IOException error) {
            list.addView(text("read failed: " + error, 13, false));
            return;
        }

        SimpleDateFormat when = new SimpleDateFormat("EEE d MMM yyyy HH:mm", Locale.getDefault());
        list.addView(text("Everything Orb may do or read, in one place. Each says what it does, whether it is on, when it was last used "
            + "(times and counts only, never what was read), and how to withdraw it.", 12, false));
        for (final Capabilities.Declaration d : Capabilities.ALL) {
            Capabilities.Status st = Capabilities.status(d.id, lines);
            list.addView(text(d.title, 15, true));
            list.addView(text(d.says, 13, false));
            list.addView(text(d.id + " \u00b7 version " + d.version + " \u00b7 tier " + d.tier, 11, false));
            list.addView(text("Allowed by: " + d.authorizedBy, 12, false));
            list.addView(text(st.state, 14, true));
            list.addView(text("Last used: " + (st.lastAtMs < 0 ? "never" : when.format(new Date(st.lastAtMs))) + " \u00b7 " + st.lastDetail, 12, false));
            addControl(d, lines, journal);
        }

        List<Reminders.Reminder> pending = Reminders.pending(lines);
        list.addView(text("Reminders waiting", 14, true));
        list.addView(text(pending.isEmpty() ? "No reminders waiting." : pending.size() + (pending.size() == 1 ? " reminder waiting" : " reminders waiting"), 13, false));
        for (final Reminders.Reminder r : pending) {
            LinearLayout row = new LinearLayout(this);
            row.setOrientation(LinearLayout.VERTICAL);
            row.setPadding(0, 16, 0, 16);
            row.addView(text(when.format(new Date(r.dueAtMs)) + (r.noteIdentity == null ? "" : "  \u00b7  with a note"), 14, false));
            Button cancel = new Button(this);
            cancel.setText("Cancel this reminder");
            cancel.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) {
                    Remind.withdraw(journal, r, new ReminderAlarms(MayDoActivity.this));
                    render();
                }
            });
            row.addView(cancel);
            list.addView(row);
        }
        list.addView(text("Orb records every reminder it is asked for, confirms, shows, refuses or cancels. The words of a note are sealed and never in that record. "
            + "When a reminder is shown, Android holds its text like any app's notification until you dismiss it.", 12, false));
    }
}
