package @PKG@;

import android.content.Context;
import java.io.IOException;
import java.util.ArrayList;
import java.util.Calendar;
import java.util.Collections;
import java.util.Comparator;
import java.util.List;
import java.util.Locale;
import java.util.TimeZone;

/**
 * What the kept words say is still ahead — **a view, not a record** (`docs/COMING_UP_PHONE.md`, DR-21).
 *
 * Orb may *propose*; only the person confirms, and confirming goes through the gate that already exists. So this reads the
 * kept words in memory (as `Mentions` does), finds the dates they name that are today or later, groups the items under each
 * date, and says which already have a reminder. **It writes nothing, shows nothing outside its own screen, and reaches no
 * notification, alarm or journal-append** — `ComingUpTest` holds it to that by reading its source. A proposal that is not
 * taken leaves no trace, because there is nothing to leave: declining is not recorded, and an erased item simply is not in the list.
 *
 * Dates that name themselves (day-first, as `Handles` reads them) **and, marked as guesses, relative days** — *Friday*, *tomorrow*, *in two weeks* —
 * read from the day the item was kept (`Mentions.relative`, `docs/RELATIVE_DAYS_PHONE.md`).
 */
final class ComingUp {
    private ComingUp() {}

    /** One kept item that names a date. */
    static final class Item {
        final Recall.Entry entry;
        /** A reminder about this item on this date is already waiting. */
        final boolean reminded;
        /** The date was **guessed** from a relative phrase (*Friday*), not written down. */
        final boolean guess;
        /** For a guess: what was found (`friday`, `tomorrow`), and the day it was read from (`YYYY-MM-DD`, when the item was kept). */
        final String phrase;
        final String anchor;
        /** For a date in a document: the line it was written on (`DocumentDates`). Null for everything else, which shows `entry.snippet`. */
        final String line;

        Item(Recall.Entry entry, boolean reminded, boolean guess, String phrase, String anchor) {
            this(entry, reminded, guess, phrase, anchor, null);
        }

        Item(Recall.Entry entry, boolean reminded, boolean guess, String phrase, String anchor, String line) {
            this.entry = entry;
            this.reminded = reminded;
            this.guess = guess;
            this.phrase = phrase;
            this.anchor = anchor;
            this.line = line;
        }

        /** What to show under the date: the line it is on, or the item's first words. */
        String shown() { return line != null ? line : entry.snippet; }
    }

    /** One folded date and what to show for it. */
    static final class Dated {
        /** `YYYY-MM-DD`. */
        final String date;
        final Item item;

        Dated(String date, Item item) {
            this.date = date;
            this.item = item;
        }
    }

    /** The dates of one document that do not look like a deadline — folded under *Other dates in this document*, never hidden. */
    static final class Fold {
        final Recall.Entry entry;
        final List<Dated> dates = new ArrayList<>();
        /** Dates in the document beyond `DocumentDates.MAX_LISTED`, not listed. */
        final int more;

        Fold(Recall.Entry entry, int more) {
            this.entry = entry;
            this.more = more;
        }
    }

    /** A date, and the kept items that name it — newest kept first. */
    static final class Day {
        /** `YYYY-MM-DD`. */
        final String date;
        final List<Item> items = new ArrayList<>();

        Day(String date) {
            this.date = date;
        }
    }

    static final class Result {
        /** Soonest first. */
        final List<Day> days = new ArrayList<>();
        /** One per document that has dates beyond its deadlines (or more than could be listed). */
        final List<Fold> folds = new ArrayList<>();
        final Recall.Results looked = new Recall.Results();
    }

    /** `YYYY-MM-DD` for a moment, in a time zone. */
    static String dateOf(long atMs, String zoneId) {
        Calendar c = Calendar.getInstance(TimeZone.getTimeZone(zoneId));
        c.setTimeInMillis(atMs);
        return String.format(Locale.ROOT, "%04d-%02d-%02d", c.get(Calendar.YEAR), c.get(Calendar.MONTH) + 1, c.get(Calendar.DAY_OF_MONTH));
    }

    /** The date `days` after a `YYYY-MM-DD` date. */
    static String plusDays(String date, int days) {
        String[] p = date.split("-");
        Calendar c = Calendar.getInstance(TimeZone.getTimeZone("UTC"));
        c.clear();
        c.set(Integer.parseInt(p[0]), Integer.parseInt(p[1]) - 1, Integer.parseInt(p[2]));
        c.add(Calendar.DAY_OF_MONTH, days);
        return String.format(Locale.ROOT, "%04d-%02d-%02d", c.get(Calendar.YEAR), c.get(Calendar.MONTH) + 1, c.get(Calendar.DAY_OF_MONTH));
    }

    /**
     * The dates ahead, from the kept items. **Today is ahead; yesterday is not** — in the person's zone, so a date that
     * is still today for them is shown even where it is already tomorrow in UTC.
     */
    static Result compute(Context context, Journal journal, final long nowMs, final String zoneId) throws IOException {
        final String today = dateOf(nowMs, zoneId);
        final List<String> lines = journal.readLines();
        final List<Reminders.Reminder> waiting = Reminders.pending(lines);
        final Result result = new Result();
        final java.util.Map<String, Day> byDate = new java.util.TreeMap<>();
        final java.util.Set<String> documents = DocumentsFacts.documentHashes(lines);
        Recall.walk(context, journal, null, result.looked, new Recall.Visitor() {
            @Override public void kept(Erasure.Item item, String app, boolean screen, Recall.Doc doc) {
                if (documents.contains(item.hash)) {
                    // A document: written dates only, each with its own line, deadlines first, the rest folded (`DocumentDates`).
                    DocumentDates.Result found = DocumentDates.of(doc.body, today);
                    if (found.deadlines.isEmpty() && found.others.isEmpty()) return;
                    Recall.Entry docEntry = Recall.entryFor(item, app, screen, doc, null);
                    for (DocumentDates.Found f : found.deadlines) {
                        place(byDate, docEntry, f.date, new Item(docEntry, remindedOn(waiting, docEntry, f.date, zoneId), false, null, null, f.line));
                    }
                    if (!found.others.isEmpty() || found.more > 0) {
                        Fold fold = new Fold(docEntry, found.more);
                        for (DocumentDates.Found f : found.others) {
                            fold.dates.add(new Dated(f.date, new Item(docEntry, remindedOn(waiting, docEntry, f.date, zoneId), false, null, null, f.line)));
                        }
                        result.folds.add(fold);
                    }
                    return;
                }
                Recall.Entry entry = null;
                java.util.Set<String> written = new java.util.HashSet<>();
                // `Handles` returns each (kind, value) once, so a date an item names twice is one proposal.
                for (Mentions.Handle h : Mentions.in(doc)) {
                    if (!h.kind.equals("date")) continue;
                    written.add(h.value);
                    if (h.value.compareTo(today) < 0) continue;
                    if (entry == null) entry = Recall.entryFor(item, app, screen, doc, null);
                    place(byDate, entry, h.value, new Item(entry, remindedOn(waiting, entry, h.value, zoneId), false, null, null));
                }
                // Relative days: a guess, read from the day the item was kept. A guess that lands on a date the item wrote down is
                // that date, not a second proposal; a guess in the past is not shown.
                String anchor = dateOf(item.wallClock, zoneId);
                for (Mentions.Relative r : Mentions.relative(doc, anchor)) {
                    if (r.date.compareTo(today) < 0 || written.contains(r.date)) continue;
                    if (entry == null) entry = Recall.entryFor(item, app, screen, doc, null);
                    place(byDate, entry, r.date, new Item(entry, remindedOn(waiting, entry, r.date, zoneId), true, r.phrase, anchor));
                }
            }
        });
        // Within a date, what was written down comes before what was guessed (each in the order the items were kept, newest first).
        for (Day day : byDate.values()) {
            List<Item> written = new ArrayList<>();
            List<Item> guessed = new ArrayList<>();
            for (Item i : day.items) (i.guess ? guessed : written).add(i);
            day.items.clear();
            day.items.addAll(written);
            day.items.addAll(guessed);
        }
        result.days.addAll(byDate.values());   // a TreeMap: soonest first
        return result;
    }

    /** Only the proposals from these kept items (by event id) — a person's dates ahead are the dates in the items that mention them. */
    static Result restrict(Result all, java.util.Set<String> entryIds) {
        Result out = new Result();
        for (Day day : all.days) {
            Day kept = new Day(day.date);
            for (Item item : day.items) if (item.entry.id != null && entryIds.contains(item.entry.id)) kept.items.add(item);
            if (!kept.items.isEmpty()) out.days.add(kept);
        }
        for (Fold fold : all.folds) if (fold.entry.id != null && entryIds.contains(fold.entry.id)) out.folds.add(fold);
        return out;
    }

    private static boolean remindedOn(List<Reminders.Reminder> waiting, Recall.Entry entry, String date, String zoneId) {
        for (Reminders.Reminder r : waiting) {
            if (entry.id != null && entry.id.equals(r.itemEventId) && dateOf(r.dueAtMs, zoneId).equals(date)) return true;
        }
        return false;
    }

    private static void place(java.util.Map<String, Day> byDate, Recall.Entry entry, String date, Item item) {
        Day day = byDate.get(date);
        if (day == null) { day = new Day(date); byDate.put(date, day); }
        day.items.add(item);
    }

    /**
     * How many proposals within the next `withinDays` days (today included) have no reminder yet — what the quiet dot counts.
     * **A guess never counts**: the dot means *a date you wrote down is near*, and a suggestion should not tug at you.
     */
    static int soon(Result result, long nowMs, String zoneId, int withinDays) {
        String today = dateOf(nowMs, zoneId);
        String last = plusDays(today, withinDays);
        int n = 0;
        for (Day day : result.days) {
            if (day.date.compareTo(today) < 0 || day.date.compareTo(last) > 0) continue;
            for (Item item : day.items) if (!item.reminded && !item.guess) n++;
        }
        return n;
    }
}
