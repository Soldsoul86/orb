package @PKG@;

import android.app.Activity;
import android.app.AlertDialog;
import android.content.DialogInterface;
import android.graphics.Bitmap;
import android.graphics.BitmapFactory;
import android.graphics.Typeface;
import android.os.Bundle;
import android.text.Editable;
import android.text.TextWatcher;
import android.view.View;
import android.view.WindowManager;
import android.widget.Button;
import android.widget.EditText;
import android.widget.ImageView;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import java.io.IOException;
import java.text.SimpleDateFormat;
import java.util.Date;
import java.util.List;
import java.util.Locale;

/**
 * What Orb remembered, to search and read — and the way to erase it.
 *
 * **This screen shows the person's own words, so it hides itself.** It is marked secure: the
 * system will not screenshot it, record it, or show it in the recent-apps view, and no assistant —
 * Orb's own included — is handed its contents. Reading is on the phone only and the text is held
 * in memory for as long as the screen shows it.
 *
 * It draws; `Recall` does the reading (`AssistGuardTest` keeps the sealed store out of this
 * file). Search is by opening each item (DR-15); a search over more than `Recall.SCAN_LIMIT`
 * items says how many it did not look at.
 */
public final class RecallActivity extends Activity {
    private LinearLayout list;
    private TextView summary;
    private EditText query;
    /** What the person typed, kept from the text watcher so this file never needs a text accessor. */
    private String queryText = "";
    private Button appButton;
    private List<String> apps;
    private int appIndex = -1;           // -1 = all apps
    /** Showing the files and pictures shared to Orb, instead of the words of remembered screens. */
    private boolean showShared;
    private Button modeButton;

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);
        getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        root.setPadding(40, 120, 40, 40);

        TextView title = new TextView(this);
        title.setText("What Orb remembered");
        title.setTextSize(17);
        title.setTypeface(Typeface.DEFAULT_BOLD);
        root.addView(title);

        query = new EditText(this);
        query.setHint("Search your words");
        query.setSingleLine(true);
        query.addTextChangedListener(new TextWatcher() {
            @Override public void beforeTextChanged(CharSequence s, int a, int b, int c) {}
            @Override public void onTextChanged(CharSequence s, int a, int b, int c) {}
            @Override public void afterTextChanged(Editable s) { queryText = s.toString(); render(); }
        });
        root.addView(query);

        modeButton = new Button(this);
        modeButton.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { showShared = !showShared; applyMode(); render(); }
        });
        root.addView(modeButton);

        appButton = new Button(this);
        appButton.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { nextApp(); }
        });
        root.addView(appButton);

        summary = new TextView(this);
        summary.setTextSize(12);
        summary.setPadding(0, 16, 0, 16);
        root.addView(summary);

        list = new LinearLayout(this);
        list.setOrientation(LinearLayout.VERTICAL);
        root.addView(list);

        ScrollView scroll = new ScrollView(this);
        scroll.addView(root);
        setContentView(scroll);
    }

    @Override
    protected void onResume() {
        super.onResume();
        loadApps();
        applyMode();
        render();
    }

    /** Words are searched; pictures are not (Orb does not read them), so those controls rest in that mode. */
    private void applyMode() {
        modeButton.setText(showShared ? "Showing: shared files and pictures  (tap for remembered screens)"
            : "Showing: remembered screens  (tap for shared files and pictures)");
        query.setHint(showShared ? "Pictures can't be searched" : "Search your words");
        query.setEnabled(!showShared);
        appButton.setVisibility(showShared ? View.GONE : View.VISIBLE);
    }

    private Journal journal() {
        Orb app = Orb.get();
        return app == null ? null : app.journal();
    }

    private void loadApps() {
        Journal journal = journal();
        try {
            apps = journal == null ? new java.util.ArrayList<String>() : Recall.apps(journal);
        } catch (IOException unreadable) {
            apps = new java.util.ArrayList<String>();
        }
        if (appIndex >= apps.size()) appIndex = -1;
        appButton.setText("App: " + (appIndex < 0 ? "all" : apps.get(appIndex)));
    }

    /** Cycles through *all*, then each app something was remembered from. */
    private void nextApp() {
        appIndex = appIndex + 1 >= apps.size() ? -1 : appIndex + 1;
        appButton.setText("App: " + (appIndex < 0 ? "all" : apps.get(appIndex)));
        render();
    }

    private void render() {
        list.removeAllViews();
        Journal journal = journal();
        if (journal == null) {
            summary.setText("journal unavailable");
            return;
        }
        if (showShared) {
            renderShared(journal);
            return;
        }
        Recall.Results results;
        try {
            results = Recall.search(this, journal, queryText, appIndex < 0 ? null : apps.get(appIndex));
        } catch (IOException error) {
            summary.setText("read failed: " + error);
            return;
        }

        StringBuilder said = new StringBuilder();
        said.append(results.entries.size()).append(results.entries.size() == 1 ? " result" : " results");
        if (results.unreadable > 0) said.append(" · ").append(results.unreadable).append(" could not be read");
        if (results.skipped > 0) said.append(" · searched the newest ").append(Recall.SCAN_LIMIT).append(", ").append(results.skipped).append(" not looked at");
        summary.setText(said.toString());

        if (results.entries.isEmpty()) {
            TextView none = new TextView(this);
            none.setTextSize(13);
            none.setText(queryText.isEmpty()
                ? "Nothing remembered yet. Invoke Orb on an allowed app and choose Remember."
                : "Nothing matches.");
            list.addView(none);
            return;
        }

        SimpleDateFormat when = new SimpleDateFormat("d MMM yyyy HH:mm", Locale.getDefault());
        for (final Recall.Entry entry : results.entries) {
            LinearLayout row = new LinearLayout(this);
            row.setOrientation(LinearLayout.VERTICAL);
            row.setPadding(0, 20, 0, 20);

            TextView head = new TextView(this);
            head.setTextSize(12);
            head.setTypeface(Typeface.DEFAULT_BOLD);
            head.setText(when.format(new Date(entry.wallClock)) + "  ·  " + (entry.packageName == null ? "" : entry.packageName)
                + (Provenance.SHARED_TEXT.equals(entry.type) ? "  ·  shared" : ""));
            row.addView(head);

            TextView body = new TextView(this);
            body.setTextSize(14);
            body.setText(entry.snippet);
            row.addView(body);

            row.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) { open(entry); }
            });
            list.addView(row);
        }
    }

    /** The files and pictures shared to Orb — listed from the clear record, so listing decrypts nothing. */
    private void renderShared(Journal journal) {
        List<Recall.Entry> shared;
        try {
            shared = Recall.shared(journal);
        } catch (IOException error) {
            summary.setText("read failed: " + error);
            return;
        }
        summary.setText(shared.size() + (shared.size() == 1 ? " shared file or picture" : " shared files and pictures")
            + " \u00b7 kept sealed on this phone. Orb does not read pictures, so these cannot be searched.");
        if (shared.isEmpty()) {
            TextView none = new TextView(this);
            none.setTextSize(13);
            none.setText("Nothing shared to Orb yet.");
            list.addView(none);
            return;
        }
        SimpleDateFormat when = new SimpleDateFormat("d MMM yyyy HH:mm", Locale.getDefault());
        for (final Recall.Entry entry : shared) {
            LinearLayout row = new LinearLayout(this);
            row.setOrientation(LinearLayout.VERTICAL);
            row.setPadding(0, 20, 0, 20);
            TextView head = new TextView(this);
            head.setTextSize(12);
            head.setTypeface(Typeface.DEFAULT_BOLD);
            head.setText(when.format(new Date(entry.wallClock)));
            row.addView(head);
            TextView body = new TextView(this);
            body.setTextSize(14);
            body.setText(Recall.sharedLabel(entry));
            row.addView(body);
            row.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) { openShared(entry); }
            });
            list.addView(row);
        }
    }

    /**
     * A shared picture, drawn in a window the system will not screenshot or record. **Held in memory only**:
     * decrypted, shrunk to fit, drawn, and let go when the window closes — never written anywhere, never
     * handed to another app. A file that is not a picture, or is too large, stays sealed and can still be erased.
     */
    private void openShared(final Recall.Entry entry) {
        if (!Recall.canShow(entry)) {
            String why = Recall.isPicture(entry.mime)
                ? "This picture is too large for Orb to show here (or its size is unknown)."
                : "Orb can only show pictures.";
            showSharedWindow(entry, textView(why + " It is kept sealed on this phone, and you can erase it here."), null);
            return;
        }
        byte[] bytes = Recall.openBytes(this, entry.identity);
        if (bytes == null) {
            new AlertDialog.Builder(this).setMessage("This can no longer be read.").setPositiveButton("OK", null).show();
            render();
            return;
        }
        Bitmap bitmap = null;
        try {
            BitmapFactory.Options bounds = new BitmapFactory.Options();
            bounds.inJustDecodeBounds = true;
            BitmapFactory.decodeByteArray(bytes, 0, bytes.length, bounds);
            if (bounds.outWidth > 0 && bounds.outHeight > 0) {
                BitmapFactory.Options decode = new BitmapFactory.Options();
                decode.inSampleSize = Recall.sampleSize(bounds.outWidth, bounds.outHeight, Recall.MAX_SIDE);
                bitmap = BitmapFactory.decodeByteArray(bytes, 0, bytes.length, decode);
            }
        } catch (RuntimeException | OutOfMemoryError cannotDraw) {
            bitmap = null;
        }
        bytes = null;
        if (bitmap == null) {
            showSharedWindow(entry, textView("Orb could not draw this picture. It is kept sealed, and you can erase it here."), null);
            return;
        }
        ImageView image = new ImageView(this);
        image.setAdjustViewBounds(true);
        image.setImageBitmap(bitmap);
        ScrollView scroll = new ScrollView(this);
        scroll.addView(image);
        showSharedWindow(entry, scroll, bitmap);
    }

    private TextView textView(String words) {
        TextView t = new TextView(this);
        t.setTextSize(14);
        t.setPadding(48, 24, 48, 24);
        t.setText(words);
        return t;
    }

    private void showSharedWindow(final Recall.Entry entry, View content, final Bitmap drawn) {
        AlertDialog dialog = new AlertDialog.Builder(this)
            .setTitle(Recall.sharedLabel(entry))
            .setView(content)
            .setPositiveButton("Close", null)
            .setNegativeButton("Erase", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) { confirmErase(entry); }
            })
            .setNeutralButton("Where from?", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) { whereFrom(entry); }
            })
            .create();
        // The picture is the person's own: no screenshots, no recording, no assistant.
        dialog.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        if (drawn != null) {
            dialog.setOnDismissListener(new DialogInterface.OnDismissListener() {
                @Override public void onDismiss(DialogInterface d) { drawn.recycle(); }
            });
        }
        dialog.show();
    }

    private void open(final Recall.Entry entry) {
        Recall.Doc doc = Recall.open(this, entry.identity);
        if (doc == null) {
            new AlertDialog.Builder(this).setMessage("This can no longer be read.").setPositiveButton("OK", null).show();
            render();
            return;
        }
        ScrollView scroll = new ScrollView(this);
        LinearLayout column = new LinearLayout(this);
        column.setOrientation(LinearLayout.VERTICAL);
        TextView text = new TextView(this);
        text.setTextSize(14);
        text.setPadding(48, 24, 48, 24);
        text.setTextIsSelectable(true);
        text.setText((doc.uri.isEmpty() ? "" : doc.uri + "\n\n") + doc.body);
        column.addView(text);
        addMentions(column, doc);
        addRemind(column, entry, doc);
        scroll.addView(column);

        AlertDialog dialog = new AlertDialog.Builder(this)
            .setTitle(Provenance.SHARED_TEXT.equals(entry.type)
                ? "Shared" + (entry.packageName == null ? "" : " from " + entry.packageName)
                : entry.packageName == null ? "Remembered" : entry.packageName)
            .setView(scroll)
            .setPositiveButton("Close", null)
            .setNegativeButton("Erase", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) { confirmErase(entry); }
            })
            .setNeutralButton("Where from?", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) { whereFrom(entry); }
            })
            .create();
        // The words on screen are the person's own: no screenshots, no recording, no assistant.
        dialog.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        dialog.show();
    }

    // ---- Remind me… (docs/GATE_PHONE.md): the person asks, reviews exactly what will happen, and confirms.

    private static final int REQUEST_NOTIFICATIONS = 71;
    /** What was being confirmed when Android's permission question was asked. */
    private Runnable afterPermission;
    private Runnable permissionDenied;

    private void addRemind(LinearLayout column, final Recall.Entry entry, final Recall.Doc doc) {
        TextView row = new TextView(this);
        row.setTextSize(14);
        row.setPadding(48, 24, 48, 24);
        row.setTypeface(Typeface.DEFAULT_BOLD);
        row.setText("Remind me\u2026");
        row.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { startRemind(entry, doc); }
        });
        column.addView(row);
    }

    private void say(String message) {
        new AlertDialog.Builder(this).setMessage(message).setPositiveButton("OK", null).show();
    }

    /** Step 1: when. Starts from a date the words name, if they name one, else tomorrow at nine. */
    private void startRemind(final Recall.Entry entry, Recall.Doc doc) {
        final Journal journal = journal();
        if (journal == null) return;
        try {
            if (!Reminders.enabled(journal.readLines())) {
                say("Reminders are turned off. You can turn them on in What Orb may do.");
                return;
            }
        } catch (IOException unreadable) {
            say("Orb could not read its history, so it did not set anything.");
            return;
        }
        java.util.Calendar start = java.util.Calendar.getInstance();
        start.add(java.util.Calendar.DAY_OF_MONTH, 1);
        for (Mentions.Handle h : Mentions.in(doc)) {
            if (!h.kind.equals("date")) continue;
            String[] ymd = h.value.split("-");
            start.set(Integer.parseInt(ymd[0]), Integer.parseInt(ymd[1]) - 1, Integer.parseInt(ymd[2]));
            break;
        }
        new android.app.DatePickerDialog(this, new android.app.DatePickerDialog.OnDateSetListener() {
            @Override public void onDateSet(android.widget.DatePicker picker, final int year, final int month, final int day) {
                new android.app.TimePickerDialog(RecallActivity.this, new android.app.TimePickerDialog.OnTimeSetListener() {
                    @Override public void onTimeSet(android.widget.TimePicker timePicker, int hour, int minute) {
                        java.util.Calendar due = java.util.Calendar.getInstance();
                        due.clear();
                        due.set(year, month, day, hour, minute, 0);
                        askNote(entry, due.getTimeInMillis());
                    }
                }, 9, 0, android.text.format.DateFormat.is24HourFormat(RecallActivity.this)).show();
            }
        }, start.get(java.util.Calendar.YEAR), start.get(java.util.Calendar.MONTH), start.get(java.util.Calendar.DAY_OF_MONTH)).show();
    }

    /** Step 2: an optional note, in the person's own words. */
    private void askNote(final Recall.Entry entry, final long dueAtMs) {
        if (dueAtMs < System.currentTimeMillis() + 60_000L) {
            say("That time has passed. Pick a time in the future.");
            return;
        }
        final EditText note = new EditText(this);
        note.setHint("A note (optional)");
        note.setFilters(new android.text.InputFilter[] {new android.text.InputFilter.LengthFilter(200)});
        // Kept from the text watcher, as the search box is, so this file never needs a text accessor.
        final String[] typed = {""};
        note.addTextChangedListener(new TextWatcher() {
            @Override public void beforeTextChanged(CharSequence s, int a, int b, int c) {}
            @Override public void onTextChanged(CharSequence s, int a, int b, int c) {}
            @Override public void afterTextChanged(Editable s) { typed[0] = s.toString().trim(); }
        });
        new AlertDialog.Builder(this)
            .setTitle("Remind you when?")
            .setMessage(new SimpleDateFormat("EEE d MMM yyyy HH:mm", Locale.getDefault()).format(new Date(dueAtMs)))
            .setView(note)
            .setNegativeButton("Cancel", null)
            .setPositiveButton("Next", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) { review(entry, dueAtMs, typed[0]); }
            })
            .show();
    }

    /** Step 3: the review card — exactly what will happen — and the intent recorded. Not confirming is recorded too. */
    private void review(final Recall.Entry entry, final long dueAtMs, final String note) {
        final Journal journal = journal();
        if (journal == null) return;
        final String zone = java.util.TimeZone.getDefault().getID();
        Orb orb = Orb.get();
        final String intentId = Remind.intend(journal, entry.id, dueAtMs, zone, orb == null ? Start.VERSION_UNREADABLE : orb.versionCode());
        if (intentId == null) {
            say("Orb could not record this, so it did not set anything.");
            return;
        }
        final boolean[] answered = {false};
        AlertDialog card = new AlertDialog.Builder(this)
            .setTitle("Set this reminder?")
            .setMessage("Orb will show a notification on this phone on\n"
                + new SimpleDateFormat("EEE d MMM yyyy HH:mm", Locale.getDefault()).format(new Date(dueAtMs))
                + (note.isEmpty() ? "" : "\n\nYour note: " + note)
                + "\n\nNothing is sent anywhere. If the phone is dozing it may come a few minutes late. "
                + "You can cancel it any time in What Orb may do.")
            .setNegativeButton("Cancel", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) { answered[0] = true; Remind.cancel(journal, intentId, ActionFacts.DECLINED); }
            })
            .setPositiveButton("Confirm", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) { answered[0] = true; confirmReminder(journal, intentId, entry, dueAtMs, zone, note); }
            })
            .setOnCancelListener(new DialogInterface.OnCancelListener() {
                @Override public void onCancel(DialogInterface d) { if (!answered[0]) { answered[0] = true; Remind.cancel(journal, intentId, ActionFacts.DECLINED); } }
            })
            .create();
        // The note is the person's own words: no screenshots of the card.
        card.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        card.show();
        card.getButton(AlertDialog.BUTTON_NEGATIVE).requestFocus();
    }

    /** Step 4: Android's own permission if it is missing, then the confirmation is recorded and the alarm set. */
    private void confirmReminder(final Journal journal, final String intentId, final Recall.Entry entry, final long dueAtMs, final String zone, final String note) {
        final Runnable record = new Runnable() {
            @Override public void run() {
                Remind.Confirmed done = Remind.confirm(RecallActivity.this, journal, intentId, entry.id, dueAtMs, zone, note);
                if (done.reminder == null) {
                    say("noteErased".equals(done.failure)
                        ? "Orb will not keep that exact note again because you erased it. Change a word and try again."
                        : "Orb could not record this, so it did not set anything.");
                    return;
                }
                new ReminderAlarms(RecallActivity.this).schedule(done.reminder.confirmedId, dueAtMs);
                say("Reminder set for " + new SimpleDateFormat("EEE d MMM yyyy HH:mm", Locale.getDefault()).format(new Date(dueAtMs)) + ".");
            }
        };
        if (ReminderNotifier.permitted(this)) {
            record.run();
            return;
        }
        if (checkSelfPermission("android.permission.POST_NOTIFICATIONS") == android.content.pm.PackageManager.PERMISSION_GRANTED) {
            // Granted to Orb, but switched off in Android's settings for it.
            Remind.cancel(journal, intentId, ActionFacts.PERMISSION_DENIED);
            say("Notifications are switched off for Orb in Android's settings, so a reminder could not be shown. Nothing was set.");
            return;
        }
        afterPermission = record;
        permissionDenied = new Runnable() {
            @Override public void run() {
                Remind.cancel(journal, intentId, ActionFacts.PERMISSION_DENIED);
                say("Without permission to show notifications Orb cannot remind you, so nothing was set.");
            }
        };
        requestPermissions(new String[] {"android.permission.POST_NOTIFICATIONS"}, REQUEST_NOTIFICATIONS);
    }

    @Override
    public void onRequestPermissionsResult(int code, String[] permissions, int[] results) {
        super.onRequestPermissionsResult(code, permissions, results);
        if (code != REQUEST_NOTIFICATIONS) return;
        Runnable granted = afterPermission;
        Runnable denied = permissionDenied;
        afterPermission = null;
        permissionDenied = null;
        boolean ok = results.length > 0 && results[0] == android.content.pm.PackageManager.PERMISSION_GRANTED;
        if (ok && granted != null) granted.run();
        else if (denied != null) denied.run();
    }

    /**
     * What these words mention — phone numbers, sites, UPI ids, emails, amounts, dates — each a tap away from
     * everything else that mentions the same thing. Found now, from the words in memory; written nowhere
     * (`Mentions`, DR-19).
     */
    private void addMentions(LinearLayout column, Recall.Doc doc) {
        List<Mentions.Handle> handles = Mentions.in(doc);
        if (handles.isEmpty()) return;
        TextView head = new TextView(this);
        head.setTextSize(12);
        head.setTypeface(Typeface.DEFAULT_BOLD);
        head.setPadding(48, 24, 48, 8);
        head.setText("Mentions");
        column.addView(head);
        for (final Mentions.Handle handle : handles) {
            TextView row = new TextView(this);
            row.setTextSize(14);
            row.setPadding(48, 16, 48, 16);
            row.setText(Mentions.line(handle) + "   \u203a");
            row.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) { showMentioning(handle); }
            });
            column.addView(row);
        }
    }

    /** Everything kept that mentions one handle, and what most often appears beside it. */
    private void showMentioning(final Mentions.Handle handle) {
        Journal journal = journal();
        if (journal == null) return;
        Mentions.Result result;
        try {
            result = Mentions.of(this, journal, handle);
        } catch (IOException error) {
            new AlertDialog.Builder(this).setMessage("Could not look: " + error).setPositiveButton("OK", null).show();
            return;
        }
        ScrollView scroll = new ScrollView(this);
        LinearLayout column = new LinearLayout(this);
        column.setOrientation(LinearLayout.VERTICAL);
        column.setPadding(48, 24, 48, 24);
        int n = result.found.entries.size();
        TextView said = new TextView(this);
        said.setTextSize(13);
        StringBuilder summaryText = new StringBuilder();
        summaryText.append(n).append(n == 1 ? " kept item mentions this" : " kept items mention this");
        if (result.found.unreadable > 0) summaryText.append(" \u00b7 ").append(result.found.unreadable).append(" could not be read");
        if (result.found.skipped > 0) summaryText.append(" \u00b7 looked at the newest ").append(Recall.SCAN_LIMIT).append(", ").append(result.found.skipped).append(" not looked at");
        said.setText(summaryText.toString());
        column.addView(said);
        if (!result.alsoWith.isEmpty()) {
            TextView also = new TextView(this);
            also.setTextSize(13);
            also.setPadding(0, 16, 0, 0);
            StringBuilder with = new StringBuilder("Often beside it:");
            for (Mentions.Handle other : result.alsoWith) with.append("\n  ").append(Mentions.line(other));
            also.setText(with.toString());
            column.addView(also);
        }
        SimpleDateFormat when = new SimpleDateFormat("d MMM yyyy HH:mm", Locale.getDefault());
        for (final Recall.Entry entry : result.found.entries) {
            LinearLayout row = new LinearLayout(this);
            row.setOrientation(LinearLayout.VERTICAL);
            row.setPadding(0, 20, 0, 20);
            TextView head = new TextView(this);
            head.setTextSize(12);
            head.setTypeface(Typeface.DEFAULT_BOLD);
            head.setText(when.format(new Date(entry.wallClock)) + "  \u00b7  " + (entry.packageName == null ? "" : entry.packageName)
                + (Provenance.SHARED_TEXT.equals(entry.type) ? "  \u00b7  shared" : ""));
            row.addView(head);
            TextView body = new TextView(this);
            body.setTextSize(14);
            body.setText(entry.snippet);
            row.addView(body);
            row.setOnClickListener(new View.OnClickListener() {
                @Override public void onClick(View view) { open(entry); }
            });
            column.addView(row);
        }
        scroll.addView(column);
        AlertDialog dialog = new AlertDialog.Builder(this)
            .setTitle(Mentions.line(handle))
            .setView(scroll)
            .setPositiveButton("Close", null)
            .create();
        // A list of what a person's words mention is as private as the words.
        dialog.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        dialog.show();
    }

    /**
     * Where this came from, in plain words: the app, when it happened, when Orb noted it, what rests on it.
     * No words of the item, no address, no identity — and a secure window like the one it was opened from.
     */
    private void whereFrom(Recall.Entry entry) {
        Journal journal = journal();
        String text = Provenance.render(Provenance.of(journal, entry.id),
            new SimpleDateFormat("d MMM yyyy HH:mm", Locale.getDefault()));
        TextView view = new TextView(this);
        view.setTextSize(14);
        view.setPadding(48, 24, 48, 24);
        view.setText(text);
        AlertDialog provenance = new AlertDialog.Builder(this)
            .setTitle("Where from?")
            .setView(view)
            .setPositiveButton("Close", null)
            .create();
        provenance.getWindow().setFlags(WindowManager.LayoutParams.FLAG_SECURE, WindowManager.LayoutParams.FLAG_SECURE);
        provenance.show();
    }

    private void confirmErase(final Recall.Entry entry) {
        Journal journal = journal();
        if (journal == null) return;
        Erasure.Plan plan;
        try {
            plan = Erasure.plan(journal.readLines(), entry.hash);
        } catch (IOException error) {
            return;
        }
        String noun = entry.isShared() ? "content" : "words";
        String words = plan.outcome.equals(Erasure.KEPT_BY_OTHERS)
            ? "The same " + noun + " is also kept by " + plan.others + " other item" + (plan.others == 1 ? "" : "s")
                + ". This one will be marked erased and disappear from here; the " + noun + " stays until the last of them is erased too."
            : "Nothing else keeps this " + noun + ". Its key will be destroyed and it can never be read again. This cannot be undone.";
        new AlertDialog.Builder(this)
            .setTitle("Erase this?")
            .setMessage(words + "\n\n" + Provenance.eraseNote(journal, entry.type, entry.id))
            .setNegativeButton("Keep", null)
            .setPositiveButton("Erase", new DialogInterface.OnClickListener() {
                @Override public void onClick(DialogInterface d, int which) { erase(entry); }
            })
            .show();
    }

    private void erase(Recall.Entry entry) {
        Journal journal = journal();
        if (journal == null) return;
        try {
            Erase.Result done = Erase.execute(this, journal, entry.hash);
            // Reminders about this item are stopped with it, and say why (`GATE_PHONE.md` §6).
            if (done.outcome.equals(Erase.DESTROYED) || done.outcome.equals(Erase.KEPT_BY_OTHERS)) {
                Remind.itemErased(this, journal, entry.id, new ReminderAlarms(this));
            }
        } catch (IOException error) {
            new AlertDialog.Builder(this).setMessage("Not erased: " + error).setPositiveButton("OK", null).show();
        }
        loadApps();
        render();
    }
}
