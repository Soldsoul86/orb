package @PKG@;

import android.app.Application;
import android.content.pm.PackageManager;
import android.os.Build;
import android.os.SystemClock;
import java.io.IOException;
import java.util.Map;

/**
 * Orb — one app, with an identity of its own.
 *
 * The consolidated runtime. Pass 1 and pass 2 were instruments: they existed to
 * answer P1–P22 and they did (`DEVICE_LOOP.md`). This is the first build whose
 * purpose is to be useful rather than to be measured, and it starts by paying the
 * debt those instruments left: **AD-8**, the identity that named a handset where
 * it should have named an install.
 *
 * The grants watch arrived in §7b36, once the identity scheme had been confirmed
 * on the device — porting it in the same change would have made a failure in
 * either indistinguishable from a failure in the other.
 */
public final class Orb extends Application {

    static final String SHARED = "orb.shared";
    static final String STARTED = "orb.process.start";

    private static Orb instance;
    private Journal journal;
    private String install;
    private Watch watch;

    public static Orb get() {
        return instance;
    }

    Journal journal() {
        return journal;
    }

    String install() {
        return install;
    }

    Watch watch() {
        return watch;
    }

    @Override
    public void onCreate() {
        super.onCreate();
        instance = this;

        // A restore that was verified and not finished is finished first — before the identity or the journal
        // is opened, so Orb never opens a lane that is not the one it is about to become.
        Backup.finishRestore(this);

        try {
            // Minted here, before anything can want a lane. A first run is the
            // only run that writes to disk before it reads.
            install = Install.id(this);
            // Lane *and* device are the install identity: one writer, one lane,
            // one name for both (AD-8). The handset's identity is recorded in
            // the start event below, where it is context rather than identity —
            // and an envelope that named the phone model would tell a witness
            // holding no payloads which phone it was watching.
            journal = Journal.open(this, Install.lane(this), install);
        } catch (IOException error) {
            // No journal means no recording. Everything below checks, and
            // nothing invents a journal to write to.
            return;
        }

        if (journal.discontinuous()) {
            Map<String, Object> payload = Json.obj();
            payload.put("reason", "previous chain head unreadable on open");
            journal.append("orb.chain.discontinuity", payload);
        }

        recordStart();

        // If this start follows a restore, the history says so.
        Backup.noteRestored(this, journal);

        // Finish any erasure that was declared and not completed (the crash window between
        // the declaration and the key's destruction). Idempotent; never blocks launching.
        Erase.reconcile(this, journal);

        // A restored journal may say the package scan is granted when the device has granted nothing.
        PackageAccess.reconcile(this, journal);
        ContactsAccess.reconcile(this, journal);
        SafetyAccess.reconcile(this, journal);
        DocumentsAccess.reconcile(this, journal);
        CallsAccess.reconcile(this, journal);
        MessagesAccess.reconcile(this, journal);
        PersonLink.reconcile(this, journal);

        // Turn anything kept and not yet observed into an Observation (B2a). Idempotent;
        // refuses to write if any line cannot be read; never blocks launching.
        Observe.run(journal);

        // Reminders: set the alarms again (they do not survive a reboot or an update) and release any whose time has
        // passed — late, and recorded as late. The gate decides each one (`Remind`, `Reminders`); never blocks launching.
        try {
            Remind.rearm(this, journal, ReminderNotifier.permitted(this), System.currentTimeMillis(),
                new ReminderAlarms(this), new ReminderNotifier(this));
        } catch (IOException unreadable) {
            // History that cannot be read releases nothing.
        }

        // Ported from pass 2 B (§7b36). The grant reads cost nothing and run
        // unconditionally; the package scan is gated by `PackageAccess`.
        watch = new Watch(this, journal);
        watch.recordExits();
        watch.observe("process.start");
        watch.scanPackagesIfDue("process.start");
        watch.watchSettings();
    }

    /**
     * The process started, and what the platform looked like when it did.
     *
     * The hardware fields live **here** rather than in `device`, which is the
     * AD-8 correction in one line: the envelope carries who wrote, the payload
     * carries what they were running on. A reader wanting the phone model reads
     * an event; a witness holding envelopes alone learns nothing about the
     * handset.
     */
    /** This build's version code, or `Start.VERSION_UNREADABLE` — never 0, never a guess. */
    long versionCode() {
        try {
            return getPackageManager().getPackageInfo(getPackageName(), 0).getLongVersionCode();
        } catch (PackageManager.NameNotFoundException | RuntimeException unreadable) {
            return Start.VERSION_UNREADABLE;
        }
    }

    private void recordStart() {
        long versionCode = versionCode();
        String versionName = "";
        try {
            versionName = getPackageManager().getPackageInfo(getPackageName(), 0).versionName;
        } catch (PackageManager.NameNotFoundException | RuntimeException unreadable) {
            // Recorded as unreadable, not as a version; see `Start`.
        }
        journal.append(STARTED, Start.record(
            Build.VERSION.RELEASE, (long) Build.VERSION.SDK_INT, Build.VERSION.SECURITY_PATCH,
            Build.DISPLAY, Build.MODEL, Build.DEVICE, SystemClock.elapsedRealtime(),
            versionCode, versionName));
    }
}
