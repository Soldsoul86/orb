package @PKG@;

import java.io.IOException;
import java.util.List;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * What the journal says about the morning brief — read, never stored (`docs/MORNING_BRIEF_PHONE.md` §5): whether it is on, the time and the words option the
 * person last chose, and what has already been done today. A projection over the lines, so a reboot, a restore and a replay all agree.
 */
final class BriefConfig {
    private BriefConfig() {}

    private static final Pattern MINUTE = Pattern.compile("\"minuteOfDay\":(\\d+)");
    private static final Pattern WORDS = Pattern.compile("\"words\":(true|false)");
    private static final Pattern DAY = Pattern.compile("\"day\":\"(\\d{4}-\\d{2}-\\d{2})\"");
    private static final Pattern REASON = Pattern.compile("\"reason\":\"([A-Za-z]+)\"");

    /** Whether the person's last decision about the brief was to turn it on. A line whose type cannot be read is an error, not a skip. */
    static boolean enabled(List<String> lines) throws IOException {
        return PackageGrants.lastIsGrant(lines, Capabilities.BRIEF);
    }

    private static String lastOf(List<String> lines, String type) {
        String found = null;
        for (String line : lines) if (type.equals(Journal.typeOf(line))) found = line;
        return found;
    }

    private static String field(Pattern pattern, String line) {
        if (line == null) return null;
        int payload = line.indexOf("\"payload\":");
        Matcher m = pattern.matcher(line);
        return payload >= 0 && m.find(payload) ? m.group(1) : null;
    }

    /** The time the person last chose, as minutes after midnight; `DEFAULT_MINUTE` if none. */
    static int minute(List<String> lines) {
        String v = field(MINUTE, lastOf(lines, BriefFacts.CONFIGURED));
        if (v == null) return BriefRules.DEFAULT_MINUTE;
        int m = Integer.parseInt(v);
        return m >= 0 && m < 24 * 60 ? m : BriefRules.DEFAULT_MINUTE;
    }

    /** Whether the person asked for the first words to be shown; false unless they did. */
    static boolean words(List<String> lines) {
        return "true".equals(field(WORDS, lastOf(lines, BriefFacts.CONFIGURED)));
    }

    /** The day of the last brief shown, or null. */
    static String lastShownDay(List<String> lines) {
        return field(DAY, lastOf(lines, BriefFacts.SHOWN));
    }

    /** The day and reason of the last skip, as `day|reason`, or null. */
    static String lastSkip(List<String> lines) {
        String line = lastOf(lines, BriefFacts.SKIPPED);
        String day = field(DAY, line);
        String reason = field(REASON, line);
        return day == null || reason == null ? null : day + "|" + reason;
    }

    private static int lastIndex(List<String> lines, String type) {
        int found = -1;
        for (int i = 0; i < lines.size(); i++) if (type.equals(Journal.typeOf(lines.get(i)))) found = i;
        return found;
    }

    /**
     * The brief was already shown today **under the time now set**. A brief shown under an earlier time does not count: choosing a new time is asking for the
     * brief at that time, so it starts afresh (the once-a-day rule is about a day under one choice, not about a person who changed their mind).
     */
    static boolean shownToday(List<String> lines, String day) {
        return day.equals(lastShownDay(lines)) && lastIndex(lines, BriefFacts.SHOWN) > lastIndex(lines, BriefFacts.CONFIGURED);
    }

    /** Whether the last skip on record came after the person's last choice of time: a skip belongs to the time that was set when it was made, so a new choice starts a fresh decision. */
    private static boolean skipIsCurrent(List<String> lines) {
        int skip = -1;
        int configured = -1;
        for (int i = 0; i < lines.size(); i++) {
            String type = Journal.typeOf(lines.get(i));
            if (BriefFacts.SKIPPED.equals(type)) skip = i;
            else if (BriefFacts.CONFIGURED.equals(type)) configured = i;
        }
        return skip > configured;
    }

    /**
     * The brief for this day is done: shown, or skipped — **under the time now set** — because there was nothing or it was too late. A skip for no permission is not
     * done (the person may allow it), and a skip made under an earlier time does not count: choosing a new time starts a fresh decision.
     */
    static boolean handledToday(List<String> lines, String day) {
        if (shownToday(lines, day)) return true;
        return skippedForTheDay(lines, day);
    }

    /** The day is finished by a skip made under the time now set: there was nothing to say, or it was too late. */
    static boolean skippedForTheDay(List<String> lines, String day) {
        String skip = lastSkip(lines);
        return skip != null && skipIsCurrent(lines) && (skip.equals(day + "|" + BriefRules.NOTHING) || skip.equals(day + "|" + BriefRules.LATE));
    }

    /** The alarm already left a record for this day under the time now set: a second firing is not written again, but a new time gets its own. */
    static boolean alarmRecorded(List<String> lines, String day) {
        int alarm = -1;
        int configured = -1;
        for (int i = 0; i < lines.size(); i++) {
            String type = Journal.typeOf(lines.get(i));
            if (BriefFacts.ALARM.equals(type) && lines.get(i).contains("\"day\":\"" + day + "\"")) alarm = i;
            else if (BriefFacts.CONFIGURED.equals(type)) configured = i;
        }
        return alarm > configured;
    }

    /** This exact skip is already the last one on record, under the time now set: it is not written again. */
    static boolean skipRecorded(List<String> lines, String day, String reason) {
        return skipIsCurrent(lines) && (day + "|" + reason).equals(lastSkip(lines));
    }
}
