package @PKG@;

import java.math.BigDecimal;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.LinkedHashMap;
import java.util.List;
import java.util.Map;
import java.util.regex.Matcher;
import java.util.regex.Pattern;

/**
 * The SMS normalizer — the first reference implementation of the Observation seam (`docs/OBSERVATION_SEAM.md` §10, §13, DR-43). **Pure and deterministic**: one
 * service message in, **what happened** out — a list of `Observation`s, or the reason nothing was kept (`code`, `promo`, `unreadable`, `ambiguous`). It decides
 * nothing about what a fact means for a person; that is the `Interpreter`'s. The words are read once and dropped; only the normalized fact is returned.
 *
 * Every rule is a documented guess, tried in the order of `rules()`; each carries a declared `confidencePercent` (rule metadata, kept for the kernel contract and
 * **never read by anything that decides**), and a legacy **reading class** (`role.kind.owner`) that is used only to decide whether two rules that matched
 * the same message disagree — so the fit report's numbers stay comparable across the refactor.
 */
final class SmsNormalizer {
    private SmsNormalizer() {}

    static final String ADAPTER = "sms";
    static final long VERSION = 1L;
    static final String SOURCE_KIND = "sms.sender";
    /** The rule that makes an SMS observation's subject: same sender, same amount, near in time. The only way a subject is known here. */
    static final String CORRELATION_RULE = "sms.payment.correlation";

    /** Why nothing was kept. */
    static final String CODE = "code";
    static final String PROMO = "promo";
    static final String UNREADABLE = "unreadable";
    static final String AMBIGUOUS = "ambiguous";

    private static final String RS = "(?:rs\\.?|inr|\\u20b9)";
    private static final Pattern AMOUNT = Pattern.compile("(?i)" + RS + "\\s*([0-9][0-9,]*(?:\\.[0-9]{1,2})?)");
    private static final Pattern FAILED = Pattern.compile("(?i)\\b(fail(?:ed|ure)?|declined|unsuccessful|reversed|could not be processed|insufficient (?:funds|balance))\\b");
    private static final Pattern FAILED_ABOUT = Pattern.compile("(?i)\\b(payment|transaction|txn|debit|upi|autopay|mandate|emi|transfer)\\b");
    private static final Pattern WILL_CREDIT = Pattern.compile("(?i)\\b(?:will|to|would|shall) be (?:credited|refunded|processed|reversed)\\b");
    private static final Pattern REFUND_STARTED = Pattern.compile("(?i)\\brefund\\b.*\\b(?:initiated|in process|processing|raised|will)\\b");
    private static final Pattern PAYMENT_DONE = Pattern.compile("(?i)\\bpayment\\b.*\\b(?:successful|received|credited|done|confirmed)\\b");
    private static final Pattern PAYMENT_OF = Pattern.compile("(?i)\\b(?:card|bill|loan|emi|policy|invoice|a/c|account|merchant|towards|upi)\\b");
    /** Money going out. Not "not debited", not "will be debited", and not "if already paid, ignore" — a word about a payment is not a payment. */
    private static final Pattern OUT = Pattern.compile("(?i)\\b(?<!not )(?<!no )(?<!be )(?<!already )(?<!if )(?:debited|withdrawn|deducted|spent|purchase|paid)\\b|\\bsent " + RS + "|\\btransfer(?:red)?\\b.{0,80}\\bfrom\\b.{0,40}\\b(?:a/c|acct|account)\\b");
    private static final Pattern IN = Pattern.compile("(?i)\\b(?:credited|deposited|salary|refund(?:ed)? (?:processed|credited))\\b|\\breceived " + RS);
    private static final Pattern WILL_DELIVER = Pattern.compile("(?i)\\b(?:will be delivered|expected (?:delivery|on|by)|estimated delivery|order (?:is )?(?:placed|confirmed|received))\\b");
    private static final Pattern DELIVERED = Pattern.compile("(?i)\\b(?:has been delivered|was delivered|delivered successfully|delivered)\\b");
    private static final Pattern TRANSIT = Pattern.compile("(?i)\\b(?:out for delivery|shipped|dispatched|in transit|picked up|arriving|arrives)\\b");
    private static final Pattern DUE = Pattern.compile("(?i)\\b(?:due|payable|overdue|outstanding|minimum amount|min\\.? ?amt|pay (?:before|by|on)|last date|bill (?:is )?generated|statement (?:is )?generated|emi of)\\b");
    private static final Pattern RENEW = Pattern.compile("(?i)\\b(?:renew|renewal|expir(?:e|es|ed|y)|validity)\\b");
    private static final Pattern COLLECT = Pattern.compile("(?i)collect request|requested money|\\brequests? " + RS);
    private static final Pattern DECIDE = Pattern.compile("(?i)\\b(?:approve|authori[sz]e)\\b");
    private static final Pattern ATTEND = Pattern.compile("(?i)\\b(?:pnr|boarding|check-?in|appointment|reservation|booking (?:id|confirmed)|e-?ticket|ticket|flight|train|departure|journey|your slot|scheduled (?:for|on))\\b");
    private static final Pattern TRADE_FILL = Pattern.compile("(?i)\\border\\b.*\\b(?:filled|executed)\\b|\\b(?:filled|executed)\\b.*\\border\\b");
    private static final Pattern BALANCE = Pattern.compile("(?i)\\b(?:avl\\.? ?bal|avail(?:able)?\\.? ?bal(?:ance)?|a/c bal|acct bal|closing balance|balance (?:is|:))");
    private static final Pattern PROMO_WORDS = Pattern.compile("(?i)\\b(?:offer|discount|cashback|congratulations?|pre-?approved|limited (?:period|time)|sale|win|exclusive|upgrade|reward|coupon|voucher|lucky|free|earn|apply now|t ?& ?c|tnc)\\b|% ?off");

    /** The first amount in the words, in minor units, or 0. */
    static long minorOf(String body) {
        Matcher m = AMOUNT.matcher(body);
        if (!m.find()) return 0L;
        try {
            return new BigDecimal(m.group(1).replace(",", "")).movePointRight(2).longValueExact();
        } catch (ArithmeticException | NumberFormatException tooBig) {
            return 0L;
        }
    }


    /** One rule that matched: its name, the legacy reading it stands for, and the facts it states. */
    private static final class Hit {
        final String rule;
        final LoopFit.Reading legacy;
        final List<Observation> facts;

        Hit(String rule, LoopFit.Reading legacy, List<Observation> facts) {
            this.rule = rule;
            this.legacy = legacy;
            this.facts = facts;
        }
    }

    /** What one message came to. */
    static final class Result {
        final List<Observation> observations;
        /** Why nothing was kept, or null. */
        final String discarded;
        /** For `ambiguous`: the first two rules, joined with `+`. */
        final String detail;
        /** The role the fit report has always given the message (`opens`, `closes`, `evidence`, `noise`, `ambiguous`, `unmapped`), kept so the regression is exact. */
        final LoopFit.Reading legacy;

        Result(List<Observation> observations, String discarded, String detail, LoopFit.Reading legacy) {
            this.observations = observations;
            this.discarded = discarded;
            this.detail = detail;
            this.legacy = legacy;
        }
    }

    private static Observation.Builder base(String type, String senderId, long occurredMs, long seenMs, String rule, int confidence) {
        return Observation.of(type).source(SOURCE_KIND, senderId == null ? "" : senderId, Observation.T0).adapter(ADAPTER, VERSION).times(occurredMs, seenMs)
            .counterparty(senderId).read(rule).confidence(confidence).subject("payment", "", LoopRules.INFERRED, CORRELATION_RULE, 1L);
    }

    private static List<Observation> one(Observation o) {
        List<Observation> out = new ArrayList<>();
        out.add(o);
        return out;
    }

    private static String currencyOf(long minor) {
        return minor > 0 ? "INR" : "";
    }

    /** Every rule that matches, each judged on its own, in the order below. */
    private static List<Hit> hits(String body, String senderId, long occurredMs, long seenMs) {
        String b = body == null ? "" : body;
        long minor = minorOf(b);
        boolean hasAmount = minor > 0;
        boolean promo = PROMO_WORDS.matcher(b).find();
        boolean willDeliver = WILL_DELIVER.matcher(b).find();
        String cur = currencyOf(minor);
        List<Hit> out = new ArrayList<>();
        if (MessagesRules.looksLikeCode(b)) out.add(new Hit("code", new LoopFit.Reading(LoopFit.NOISE, null, null, 0L, "code", "code"), new ArrayList<Observation>()));
        if (FAILED.matcher(b).find() && FAILED_ABOUT.matcher(b).find()) {
            out.add(new Hit("failed", new LoopFit.Reading(LoopFit.ADVANCES, LoopRules.GIVE, LoopRules.ME, minor, null, "failed"),
                one(base(Observation.OBLIGATION_PROGRESSED, senderId, occurredMs, seenMs, "failed", 80).bearer(LoopRules.ME).stage("failed").object(hasAmount ? Observation.MONEY : Observation.OTHER, minor, cur).build())));
        }
        if (WILL_CREDIT.matcher(b).find() || REFUND_STARTED.matcher(b).find()) {
            out.add(new Hit("refund-started", new LoopFit.Reading(LoopFit.ADVANCES, LoopRules.GIVE, LoopRules.THEM, minor, null, "refund-started"),
                one(base(Observation.OBLIGATION_PROGRESSED, senderId, occurredMs, seenMs, "refund-started", 70).bearer(LoopRules.THEM).stage("refund-started").object(hasAmount ? Observation.MONEY : Observation.OTHER, minor, cur).build())));
        }
        if (hasAmount && PAYMENT_DONE.matcher(b).find() && PAYMENT_OF.matcher(b).find()) {
            List<Observation> facts = new ArrayList<>();
            facts.add(base(Observation.VALUE_MOVED, senderId, occurredMs, seenMs, "payment-done", 90).direction(Observation.OUT).object(Observation.MONEY, minor, cur).build());
            facts.add(base(Observation.OBLIGATION_FULFILLED, senderId, occurredMs, seenMs, "payment-done", 90).bearer(LoopRules.ME).object(Observation.MONEY, minor, cur).build());
            out.add(new Hit("payment-done", new LoopFit.Reading(LoopFit.CLOSES, LoopRules.GIVE, LoopRules.ME, minor, null, "payment-done"), facts));
        }
        // A message that names both ends of one transfer ("debited … ; payee credited") is about the end it names first.
        Matcher outAt = OUT.matcher(b), inAt = IN.matcher(b);
        int outFirst = outAt.find() ? outAt.start() : -1, inFirst = inAt.find() ? inAt.start() : -1;
        if (hasAmount && outFirst >= 0 && (inFirst < 0 || outFirst < inFirst)) {
            out.add(new Hit("money-out", new LoopFit.Reading(LoopFit.CLOSES, LoopRules.GIVE, LoopRules.ME, minor, null, "money-out"),
                one(base(Observation.VALUE_MOVED, senderId, occurredMs, seenMs, "money-out", 90).direction(Observation.OUT).object(Observation.MONEY, minor, cur).build())));
        }
        if (hasAmount && inFirst >= 0 && (outFirst < 0 || inFirst < outFirst)) {
            out.add(new Hit("money-in", new LoopFit.Reading(LoopFit.CLOSES, LoopRules.GIVE, LoopRules.THEM, minor, null, "money-in"),
                one(base(Observation.VALUE_MOVED, senderId, occurredMs, seenMs, "money-in", 90).direction(Observation.IN).object(Observation.MONEY, minor, cur).build())));
        }
        if (willDeliver) {
            out.add(new Hit("order", new LoopFit.Reading(LoopFit.OPENS, LoopRules.GIVE, LoopRules.THEM, 0L, null, "order"),
                one(base(Observation.OBLIGATION_STATED, senderId, occurredMs, seenMs, "order", 80).bearer(LoopRules.THEM).object(Observation.ITEM, 0L, "").build())));
        }
        if (!willDeliver && DELIVERED.matcher(b).find()) {
            out.add(new Hit("delivered", new LoopFit.Reading(LoopFit.CLOSES, LoopRules.GIVE, LoopRules.THEM, 0L, null, "delivered"),
                one(base(Observation.OBLIGATION_FULFILLED, senderId, occurredMs, seenMs, "delivered", 80).bearer(LoopRules.THEM).object(Observation.ITEM, 0L, "").build())));
        }
        if (TRANSIT.matcher(b).find()) {
            out.add(new Hit("in-transit", new LoopFit.Reading(LoopFit.ADVANCES, LoopRules.GIVE, LoopRules.THEM, 0L, null, "in-transit"),
                one(base(Observation.OBLIGATION_PROGRESSED, senderId, occurredMs, seenMs, "in-transit", 80).bearer(LoopRules.THEM).stage("in-transit").object(Observation.ITEM, 0L, "").build())));
        }
        if (hasAmount && DUE.matcher(b).find() && !promo) {
            out.add(new Hit("bill-due", new LoopFit.Reading(LoopFit.OPENS, LoopRules.GIVE, LoopRules.ME, minor, null, "bill-due"),
                one(base(Observation.OBLIGATION_STATED, senderId, occurredMs, seenMs, "bill-due", 80).bearer(LoopRules.ME).object(Observation.MONEY, minor, cur).build())));
        }
        if (COLLECT.matcher(b).find()) {
            out.add(new Hit("collect-request", new LoopFit.Reading(LoopFit.OPENS, LoopRules.GIVE, LoopRules.ME, minor, null, "collect-request"),
                one(base(Observation.REQUEST_RECEIVED, senderId, occurredMs, seenMs, "collect-request", 80).bearer(LoopRules.ME).object(hasAmount ? Observation.MONEY : Observation.OTHER, minor, cur).build())));
        }
        if (DECIDE.matcher(b).find() && !promo) {
            out.add(new Hit("approve", new LoopFit.Reading(LoopFit.OPENS, LoopRules.DECIDE, LoopRules.ME, 0L, null, "approve"),
                one(base(Observation.DECISION_REQUESTED, senderId, occurredMs, seenMs, "approve", 60).bearer(LoopRules.ME).object(Observation.OTHER, 0L, "").build())));
        }
        // "Premium due … renewal" is one obligation (pay it), not a bill and a renewal.
        if (RENEW.matcher(b).find() && !promo && !(hasAmount && DUE.matcher(b).find())) {
            out.add(new Hit("renew", new LoopFit.Reading(LoopFit.OPENS, LoopRules.DO, LoopRules.ME, 0L, null, "renew"),
                one(base(Observation.OBLIGATION_STATED, senderId, occurredMs, seenMs, "renew", 60).bearer(LoopRules.ME).object(Observation.ACT, 0L, "").build())));
        }
        if (ATTEND.matcher(b).find() && !promo) {
            out.add(new Hit("attend", new LoopFit.Reading(LoopFit.OPENS, LoopRules.ATTEND, LoopRules.ME, 0L, null, "attend"),
                one(base(Observation.ATTENDANCE_SCHEDULED, senderId, occurredMs, seenMs, "attend", 60).bearer(LoopRules.ME).object(Observation.OTHER, 0L, "").build())));
        }
        // A completed exchange is information for now; what it means (a trade, a fee, a portfolio) is a Money question, not the seam's.
        if (TRADE_FILL.matcher(b).find()) {
            out.add(new Hit("trade-fill", new LoopFit.Reading(LoopFit.EVIDENCE, null, null, 0L, null, "trade-fill"),
                one(base(Observation.INFORMATION_NOTED, senderId, occurredMs, seenMs, "trade-fill", 80).object(Observation.OTHER, 0L, "").build())));
        }
        if (BALANCE.matcher(b).find()) {
            out.add(new Hit("balance", new LoopFit.Reading(LoopFit.EVIDENCE, null, null, 0L, null, "balance"),
                one(base(Observation.INFORMATION_NOTED, senderId, occurredMs, seenMs, "balance", 90).object(Observation.MONEY, 0L, "").build())));
        }
        if (promo) out.add(new Hit("promo", new LoopFit.Reading(LoopFit.NOISE, null, null, 0L, "promo", "promo"), new ArrayList<Observation>()));
        return out;
    }

    /** The rules that matched, as the readings the fit report has always given them. */
    static List<LoopFit.Reading> readings(String body) {
        List<LoopFit.Reading> out = new ArrayList<>();
        for (Hit h : hits(body, "", 0L, 0L)) out.add(h.legacy);
        return out;
    }

    /**
     * What one service message came to. If the rules that state a fact disagree — a different kind of fact, a different next mover, or one opening what another
     * closes — it is **ambiguous** (nothing is kept, and the first two rules are named); otherwise the first rule that matched decides, and every rule of its class
     * contributes its facts; if none matched, **unreadable**. Information alongside a loop (a balance after a debit) does not make it ambiguous.
     */
    static Result normalize(String senderId, String body, long occurredMs, long seenMs) {
        List<Hit> all = hits(body, senderId, occurredMs, seenMs);
        if (all.isEmpty()) return new Result(new ArrayList<Observation>(), UNREADABLE, null, new LoopFit.Reading(LoopFit.UNMAPPED, null, null, 0L, null, "none"));
        Hit first = all.get(0);
        Hit other = null;
        if (first.legacy.forms()) {
            for (Hit h : all) if (h.legacy.forms() && !h.legacy.signature().equals(first.legacy.signature())) { other = h; break; }
        } else {
            for (Hit h : all) if (h.legacy.forms()) { first = h; break; }
            for (Hit h : all) if (h.legacy.forms() && !h.legacy.signature().equals(first.legacy.signature())) { other = h; break; }
        }
        if (other != null) return new Result(new ArrayList<Observation>(), AMBIGUOUS, first.rule + "+" + other.rule,
            new LoopFit.Reading(LoopFit.AMBIGUOUS, null, null, 0L, null, first.rule + "+" + other.rule));
        if (first.legacy.forms()) {
            Map<String, Observation> facts = new LinkedHashMap<>();
            for (Hit h : all) if (h.legacy.forms() && h.legacy.signature().equals(first.legacy.signature())) for (Observation o : h.facts) facts.put(o.id, o);
            return new Result(new ArrayList<>(facts.values()), null, null, first.legacy);
        }
        if (LoopFit.EVIDENCE.equals(first.legacy.role)) return new Result(first.facts, null, null, first.legacy);
        return new Result(new ArrayList<Observation>(), first.legacy.tag, null, first.legacy);   // noise: a code or a promotion
    }

    /** The rule names in the order they are tried — for the docs and for a test that every one is reached. */
    static List<String> rules() {
        return Arrays.asList("code", "failed", "refund-started", "payment-done", "money-out", "money-in", "order", "delivered", "in-transit",
            "bill-due", "collect-request", "approve", "renew", "attend", "trade-fill", "balance", "promo", "none");
    }
}
