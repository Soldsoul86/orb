package @PKG@;

import android.accessibilityservice.AccessibilityServiceInfo;
import android.app.Activity;
import android.app.admin.DevicePolicyManager;
import android.content.ComponentName;
import android.content.ContentResolver;
import android.content.ContentValues;
import android.content.Intent;
import android.content.pm.PackageManager;
import android.content.pm.ResolveInfo;
import android.graphics.Typeface;
import android.net.Uri;
import android.os.Build;
import android.os.Bundle;
import android.os.Environment;
import android.provider.MediaStore;
import android.provider.Settings;
import android.view.View;
import android.view.accessibility.AccessibilityManager;
import android.widget.Button;
import android.widget.CheckBox;
import android.widget.CompoundButton;
import android.widget.LinearLayout;
import android.widget.ScrollView;
import android.widget.TextView;
import java.io.FileInputStream;
import java.io.IOException;
import java.io.OutputStream;
import java.nio.charset.StandardCharsets;
import java.text.SimpleDateFormat;
import java.util.ArrayList;
import java.util.Date;
import java.util.List;
import java.util.Locale;

/**
 * Answers DEVICE_LOOP.md P12, P13 and P14 on the device it is running on.
 *
 * Throwaway by design. Its own package and its own signing key, so it cannot
 * upgrade, disturb or share storage with pass 1, which is mid-run (§7 R4). It
 * records nothing to a journal and starts nothing: it reads five sources once,
 * scores each against the prediction it belongs to, and offers the result as a
 * file. Everything it learns is a finding about *this* device at *this* build
 * (§7 R3), which is why the build fingerprint is printed above the results and
 * travels in the export.
 *
 * The operator supplies the one thing the device cannot: whether an entry is
 * known to exist. Three checkboxes, unchecked by default, because a hardcoded
 * "an accessibility service is enabled here" would go stale the moment it was
 * switched off and would then turn a correct empty answer into a false
 * falsification. Nothing about the scoring is assumed; it is stated.
 */
public final class MainActivity extends Activity {
    private TextView body;
    private CheckBox knownAccessibility;
    private CheckBox knownListener;
    private CheckBox knownAdmin;
    private String latest = "";

    @Override
    protected void onCreate(Bundle state) {
        super.onCreate(state);

        LinearLayout root = new LinearLayout(this);
        root.setOrientation(LinearLayout.VERTICAL);
        // SDK 35+ draws edge to edge whether it asks to or not, so the first
        // control needs clearance or it lands under the status bar.
        root.setPadding(40, 120, 40, 40);

        TextView title = new TextView(this);
        title.setText("Orb grants probe — P12 / P13 / P14");
        title.setTextSize(18);
        title.setTypeface(Typeface.DEFAULT_BOLD);
        root.addView(title);

        TextView note = new TextView(this);
        note.setText("Tick only what you can see for yourself in Settings. "
            + "An empty answer proves nothing unless something is known to be there.");
        note.setTextSize(13);
        root.addView(note);

        knownAccessibility = addClaim(root, "Accessibility: a downloaded service reads On");
        knownListener = addClaim(root, "Notification access: an app is allowed");
        // Named the way it is because the Device admin screen lists Find Hub and
        // Repair mode whether or not either is switched on, and reading "there
        // are apps on this screen" as "an admin is active" is how this box got
        // ticked wrongly on a device that had none.
        knownAdmin = addClaim(root, "Device admin: a toggle is ON (the screen lists apps even when all are off)");

        Button export = new Button(this);
        export.setText("Export and share readout");
        export.setOnClickListener(new View.OnClickListener() {
            @Override public void onClick(View view) { export(); }
        });
        root.addView(export);

        body = new TextView(this);
        body.setTextSize(12);
        body.setTypeface(Typeface.MONOSPACE);
        body.setTextIsSelectable(true);
        root.addView(body);

        ScrollView scroll = new ScrollView(this);
        scroll.addView(root);
        setContentView(scroll);

        render();
    }

    /**
     * Read again every time this screen comes back to the front.
     *
     * The whole point of this probe is that the operator goes to Settings,
     * changes a grant, and comes back — and on 2026-09-26 at 13:21 a readout
     * rendered before that trip was exported two minutes after it, with the
     * device admin toggle moved in between. The file said 13:21:38 and nothing
     * said the device had changed since. A readout that can silently be older
     * than the device is not a measurement of the device.
     */
    @Override
    protected void onResume() {
        super.onResume();
        render();
    }

    private CheckBox addClaim(LinearLayout root, String label) {
        CheckBox box = new CheckBox(this);
        box.setText(label);
        box.setTextSize(13);
        box.setOnCheckedChangeListener(new CompoundButton.OnCheckedChangeListener() {
            @Override public void onCheckedChanged(CompoundButton button, boolean checked) {
                render();
            }
        });
        root.addView(box);
        return box;
    }

    /** Reads everything and scores it. Called again whenever a claim changes. */
    private void render() {
        StringBuilder out = new StringBuilder();
        out.append("device:   ").append(Build.MODEL).append("  (").append(Build.DEVICE).append(")\n");
        out.append("android:  ").append(Build.VERSION.RELEASE)
           .append("  API ").append(Build.VERSION.SDK_INT).append('\n');
        out.append("patch:    ").append(Build.VERSION.SECURITY_PATCH).append('\n');
        out.append("build:    ").append(Build.DISPLAY).append('\n');
        out.append("read at:  ")
           .append(new SimpleDateFormat("yyyy-MM-dd HH:mm:ss Z", Locale.US).format(new Date()))
           .append('\n');
        out.append("package:  @PKG@  (no permissions declared)\n");

        // Read first, score second. The master toggle is an independent witness
        // to what the accessibility checkbox asserts, so a disagreement between
        // them has to be known before either P12 read is scored.
        Readout master = secure(Settings.Secure.ACCESSIBILITY_ENABLED);
        String unscored = Readout.contradiction(knownAccessibility.isChecked(), master);

        out.append("\n=== P12  accessibility services enabled on this device ===\n\n");
        if (unscored != null) out.append("  ").append(unscored).append("\n\n");
        out.append(secure(Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES)
            .render(knownAccessibility.isChecked(), unscored));
        out.append('\n');
        // A second, independent path to the same fact. If the setting is
        // withheld but this works, P12 holds by another route; if both fail, it
        // is the platform and not one API.
        out.append(enabledAccessibilityServices()
            .render(knownAccessibility.isChecked(), unscored));

        out.append("\n=== P13  notification listeners enabled on this device ===\n\n");
        // The constant is @hide, so the key is spelled out. Reading a key by
        // name is exactly what a third-party app can do, which is the point.
        out.append(secure("enabled_notification_listeners").render(knownListener.isChecked()));

        // P14 is scored from the device alone. The installed receivers give the
        // components to ask about, isAdminActive answers per component without
        // any permission, and the two together decide what a null enumeration
        // means. The checkbox below is printed for comparison and no longer
        // decides anything: every P14 verdict this probe produced from a tick
        // turned out to be an artefact of how it was operated.
        Readout installed = installedAdminReceivers();
        Readout enumerated = activeAdmins();
        Readout byComponent = adminsByComponentQuery(installed);

        out.append("\n=== P14  device admins active on this device ===\n\n");
        out.append(enumerated.render(knownAdmin.isChecked(),
            Readout.adminVerdict(enumerated, byComponent)));
        out.append('\n');
        out.append(byComponent.renderList());
        if (Readout.VALUE.equals(byComponent.outcome)
                && byComponent.populated() != knownAdmin.isChecked()) {
            out.append("  note: this disagrees with your checkbox, which is not used to")
               .append(" score P14. The device is the authority here.\n");
        }

        out.append("\n=== context (not a prediction) ===\n\n");
        out.append(master.renderScalar());
        out.append("  (1 = some accessibility service is On, 0 = none)\n\n");
        // Which admin receivers are installed is a different fact from which are
        // active, and the two failures look alike from outside. If the candidates
        // are visible while getActiveAdmins() returns null, the withheld thing is
        // the active set and not the packages; if neither is visible, it is
        // package visibility and P14 was never the right question.
        out.append(installed.renderList());

        out.append("\n=== control: a read that must fail ===\n\n");
        out.append(control());

        latest = out.toString();
        body.setText(latest);
    }

    /** One `Settings.Secure` read, with the failure kept as a failure. */
    private Readout secure(String key) {
        String source = "Settings.Secure.getString(\"" + key + "\")";
        try {
            ContentResolver resolver = getContentResolver();
            return Readout.of(source, Settings.Secure.getString(resolver, key));
        } catch (Throwable error) {
            return Readout.failed(source, error);
        }
    }

    private Readout enabledAccessibilityServices() {
        String source = "AccessibilityManager.getEnabledAccessibilityServiceList(ALL)";
        try {
            AccessibilityManager manager =
                (AccessibilityManager) getSystemService(ACCESSIBILITY_SERVICE);
            if (manager == null) return Readout.ofEntries(source, null);
            List<AccessibilityServiceInfo> enabled =
                manager.getEnabledAccessibilityServiceList(AccessibilityServiceInfo.FEEDBACK_ALL_MASK);
            if (enabled == null) return Readout.ofEntries(source, null);
            List<String> ids = new ArrayList<>();
            for (AccessibilityServiceInfo info : enabled) ids.add(info.getId());
            return Readout.ofEntries(source, ids);
        } catch (Throwable error) {
            return Readout.failed(source, error);
        }
    }

    private Readout activeAdmins() {
        String source = "DevicePolicyManager.getActiveAdmins()";
        try {
            DevicePolicyManager policy =
                (DevicePolicyManager) getSystemService(DEVICE_POLICY_SERVICE);
            if (policy == null) return Readout.ofEntries(source, null);
            List<ComponentName> admins = policy.getActiveAdmins();
            if (admins == null) return Readout.ofEntries(source, null);
            List<String> names = new ArrayList<>();
            for (ComponentName admin : admins) names.add(admin.flattenToShortString());
            return Readout.ofEntries(source, names);
        } catch (Throwable error) {
            return Readout.failed(source, error);
        }
    }

    /** Admin receivers present on the device — installed, not necessarily active. */
    private Readout installedAdminReceivers() {
        String source = "PackageManager.queryBroadcastReceivers(DEVICE_ADMIN_ENABLED)";
        try {
            Intent intent = new Intent("android.app.action.DEVICE_ADMIN_ENABLED");
            List<ResolveInfo> found =
                getPackageManager().queryBroadcastReceivers(intent, PackageManager.MATCH_ALL);
            if (found == null) return Readout.ofEntries(source, null);
            List<String> names = new ArrayList<>();
            for (ResolveInfo info : found) {
                names.add(info.activityInfo.packageName + "/" + info.activityInfo.name);
            }
            return Readout.ofEntries(source, names);
        } catch (Throwable error) {
            return Readout.failed(source, error);
        }
    }

    /**
     * Whether each installed admin receiver is active, asked one at a time.
     *
     * `isAdminActive` is public, takes any component, and does not require being
     * that admin — so it is a second, permissionless route to the fact
     * `getActiveAdmins()` reports in bulk. If the bulk call is withheld and this
     * one is not, that difference is the finding.
     */
    private Readout adminsByComponentQuery(Readout installed) {
        String source = "DevicePolicyManager.isAdminActive(each installed receiver)";
        try {
            DevicePolicyManager policy =
                (DevicePolicyManager) getSystemService(DEVICE_POLICY_SERVICE);
            if (policy == null) return Readout.ofEntries(source, null);
            List<String> active = new ArrayList<>();
            for (String flattened : installed.entries) {
                ComponentName component = ComponentName.unflattenFromString(flattened);
                if (component != null && policy.isAdminActive(component)) {
                    active.add(flattened);
                }
            }
            return Readout.ofEntries(source, active);
        } catch (Throwable error) {
            return Readout.failed(source, error);
        }
    }

    /**
     * A positive control for the failure path.
     *
     * Reads the settings database file directly, which a sandboxed app cannot
     * do. Without it, three CONFIRMED lines would be unfalsifiable: a probe
     * that reported success no matter what would look exactly like this one.
     * The control failing is what makes the successes mean something — and if
     * the control ever *succeeded*, the device is not the device we think it is.
     */
    private String control() {
        String path = "/data/system/users/0/settings_secure.xml";
        String source = "FileInputStream(\"" + path + "\")";
        Readout reading;
        try (FileInputStream in = new FileInputStream(path)) {
            reading = Readout.of(source, "opened, first byte " + in.read());
        } catch (Throwable error) {
            reading = Readout.failed(source, error);
        }
        boolean failedAsItShould = Readout.THREW.equals(reading.outcome);
        return source + '\n'
            + "  outcome: " + reading.outcome + '\n'
            + "  " + (failedAsItShould
                ? "CONTROL HELD — the sandbox refuses a direct read, so the reads above"
                  + " went through the framework and not around it"
                : "CONTROL BROKEN — a direct read succeeded; treat every result above"
                  + " as unexplained until this is understood") + '\n'
            + "  detail: " + reading.raw + '\n';
    }

    /**
     * Writes the readout to Downloads and hands it to the share sheet.
     *
     * A finding that cannot leave the phone is not a finding. No permission is
     * involved: an app may always write the entries it creates itself.
     */
    private void export() {
        try {
            // Read now, not whenever the screen last rendered. An export is the
            // artifact that gets quoted; it has to be current by construction
            // rather than by the operator happening not to have changed anything.
            render();
            String name = "orb-probeg-"
                + new SimpleDateFormat("yyyyMMdd-HHmmss", Locale.US).format(new Date())
                + ".txt";

            ContentValues values = new ContentValues();
            values.put(MediaStore.Downloads.DISPLAY_NAME, name);
            values.put(MediaStore.Downloads.MIME_TYPE, "text/plain");
            values.put(MediaStore.Downloads.RELATIVE_PATH, Environment.DIRECTORY_DOWNLOADS);

            ContentResolver resolver = getContentResolver();
            Uri target = resolver.insert(MediaStore.Downloads.EXTERNAL_CONTENT_URI, values);
            if (target == null) {
                body.setText("export failed: no destination\n\n" + latest);
                return;
            }
            String stamped = latest + "\nexported at: "
                + new SimpleDateFormat("yyyy-MM-dd HH:mm:ss Z", Locale.US).format(new Date())
                + "\n  (re-read immediately before this; compare with 'read at' above)\n";
            try (OutputStream out = resolver.openOutputStream(target)) {
                out.write(stamped.getBytes(StandardCharsets.UTF_8));
            }

            Intent send = new Intent(Intent.ACTION_SEND);
            send.setType("text/plain");
            send.putExtra(Intent.EXTRA_STREAM, target);
            send.putExtra(Intent.EXTRA_SUBJECT, name);
            send.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION);
            startActivity(Intent.createChooser(send, "Send readout"));
        } catch (IOException error) {
            body.setText("export failed: " + error + "\n\n" + latest);
        }
    }
}
