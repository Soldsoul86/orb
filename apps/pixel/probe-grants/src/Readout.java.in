package @PKG@;

import java.util.ArrayList;
import java.util.Collections;
import java.util.List;

/**
 * What one read of one platform source actually told us.
 *
 * Three outcomes, kept strictly apart, because collapsing them is the mistake
 * this whole probe exists to avoid:
 *
 *   threw   the read failed — we learned nothing about the contents
 *   absent  the read succeeded and returned null — either never set, or
 *           withheld from us; the call cannot tell us which
 *   value   the read succeeded and returned a string, possibly empty
 *
 * `Grants.split` already refuses to turn a null into an empty list. This goes
 * one step further and refuses to turn *either* into a finding: an empty list
 * handed to a permissionless app looks exactly like a full list being filtered
 * out of it, so an empty result is not evidence that reads work. That is the
 * difference between "cannot check" and "checked, and the answer is none",
 * and every prediction below is scored against it.
 */
final class Readout {
    static final String THREW = "threw";
    static final String ABSENT = "absent";
    static final String VALUE = "value";

    /** Exactly what was read, named so the result can be reproduced. */
    final String source;
    final String outcome;
    /** The string as returned, or the failure's text. Never invented. */
    final String raw;
    /** Parsed entries. Empty when absent or threw — see `populated`. */
    final List<String> entries;

    private Readout(String source, String outcome, String raw, List<String> entries) {
        this.source = source;
        this.outcome = outcome;
        this.raw = raw;
        this.entries = Collections.unmodifiableList(entries);
    }

    /**
     * A read that completed. `raw` may be null, which is `ABSENT` and not empty.
     *
     * Parsing goes through pass 2's `Grants.split`, not a private copy, so this
     * probe tests the parser that would actually ship against the string the
     * device actually returns. A copy here could agree with the device while
     * the real one disagreed, which is the one failure a probe must not have.
     */
    static Readout of(String source, String raw) {
        if (raw == null) return new Readout(source, ABSENT, null, new ArrayList<String>());
        return new Readout(source, VALUE, raw, Grants.split(raw));
    }

    /** A read that already produced its entries, e.g. a framework list API. */
    static Readout ofEntries(String source, List<String> entries) {
        if (entries == null) return new Readout(source, ABSENT, null, new ArrayList<String>());
        return new Readout(source, VALUE, String.join(":", entries), new ArrayList<>(entries));
    }

    /** A read that failed. The exception's own words, not a summary of them. */
    static Readout failed(String source, Throwable error) {
        String text = error.getClass().getName()
            + (error.getMessage() == null ? "" : ": " + error.getMessage());
        return new Readout(source, THREW, text, new ArrayList<String>());
    }

    boolean populated() {
        return VALUE.equals(outcome) && !entries.isEmpty();
    }

    /**
     * Whether this read settles the prediction that the source is readable
     * without permission.
     *
     * `knownPopulated` is the operator's independent knowledge that at least one
     * entry exists — the Settings screen showing a service On, say. Without it,
     * a readable-but-empty answer is INCONCLUSIVE rather than confirming: the
     * call worked, but nothing proves contents would have come through if there
     * had been any. With it, an empty answer is a falsification, because we know
     * what the correct answer was and this is not it.
     */
    String verdict(boolean knownPopulated) {
        if (THREW.equals(outcome)) {
            return "FALSIFIED — the read threw; the source is not readable this way";
        }
        if (ABSENT.equals(outcome)) {
            return knownPopulated
                ? "FALSIFIED — null, although an entry is known to exist: withheld, not empty"
                : "INCONCLUSIVE — null, and no entry is known to exist: unset and withheld"
                  + " look the same from here";
        }
        if (entries.isEmpty()) {
            return knownPopulated
                ? "FALSIFIED — readable but empty, although an entry is known to exist"
                : "INCONCLUSIVE — readable and empty: the call works, but an empty list"
                  + " and a filtered list are the same bytes";
        }
        return "CONFIRMED — readable without permission, " + entries.size()
            + (entries.size() == 1 ? " entry" : " entries") + " returned";
    }

    /**
     * Whether the operator's claim is contradicted by something the device
     * itself says, in which case the reading scores nothing at all.
     *
     * `accessibility_enabled` is the master toggle: `1` when some accessibility
     * service is on, `0` when none is. It is an independent witness to the same
     * fact the checkbox asserts, and when the two disagree the honest move is to
     * score neither. Resolving it in favour of the device would be a guess
     * dressed as a measurement, and resolving it in favour of the checkbox is
     * how the first run of this probe reported a falsification that was really a
     * mis-tick. Surfaced, not settled — settling it is the operator's to do by
     * looking at the screen again.
     *
     * Returns null when there is nothing to complain about, which includes the
     * case where the corroborant could not be read: no witness is not a
     * disagreeing witness.
     */
    static String contradiction(boolean claimed, Readout master) {
        if (master == null || !VALUE.equals(master.outcome)) return null;
        String value = master.raw.trim();
        if (claimed && value.equals("0")) {
            return "UNSCORED — you ticked that an accessibility service is On, but this"
                + " device's own master toggle (accessibility_enabled) reads 0, meaning"
                + " none is. Settle that in Settings and read again; until then this"
                + " proves nothing either way.";
        }
        if (!claimed && value.equals("1")) {
            return "UNSCORED — you left the accessibility box unticked, but this device's"
                + " own master toggle (accessibility_enabled) reads 1, meaning something"
                + " is On. Settle that in Settings and read again.";
        }
        return null;
    }

    /** The reading as text, for the screen and for the exported file. */
    String render(boolean knownPopulated) {
        return render(knownPopulated, null);
    }

    /**
     * As `render`, but a non-null `unscored` replaces the verdict entirely.
     *
     * Replaces rather than accompanies: a CONFIRMED or FALSIFIED line printed
     * next to a warning would be the line that got quoted, and the warning is
     * precisely the statement that no verdict is available.
     */
    String render(boolean knownPopulated, String unscored) {
        StringBuilder out = new StringBuilder();
        out.append(source).append('\n');
        out.append("  outcome: ").append(outcome);
        if (VALUE.equals(outcome)) out.append(" (").append(raw.length()).append(" chars)");
        out.append('\n');
        out.append("  ").append(unscored == null ? verdict(knownPopulated) : unscored).append('\n');
        if (THREW.equals(outcome)) {
            out.append("  failure: ").append(raw).append('\n');
        } else if (VALUE.equals(outcome)) {
            // The raw string as well as the parse. A parse that quietly dropped
            // something would be invisible if only the entries were shown.
            out.append("  raw: ").append(raw.isEmpty() ? "(empty string)" : raw).append('\n');
            for (String entry : entries) out.append("  - ").append(entry).append('\n');
        }
        return out.toString();
    }

    /**
     * P14's verdict, taken from two reads of the same fact and no human claim.
     *
     * `enumerated` is `getActiveAdmins()`, the list under test. `byComponent` is
     * `isAdminActive()` asked once per installed admin receiver — a public call
     * that needs no permission and does not require being that admin. Together
     * they decide what a `null` enumeration means, which is the thing a checkbox
     * was being asked to decide and kept getting wrong:
     *
     *   per-component says some admin is active, enumeration says nothing
     *       → the list is withheld. Not empty, not "none". FALSIFIED.
     *   per-component says none is active, enumeration says nothing
     *       → the null is correct and carries no information. INCONCLUSIVE, and
     *         it will stay that way until an admin is actually enabled.
     *   both say the same admins
     *       → CONFIRMED.
     *
     * The operator can still be wrong about their own phone; the phone cannot be
     * wrong about it. Every earlier P14 verdict in this probe's history came from
     * a tick, and every one of them was an artefact.
     */
    static String adminVerdict(Readout enumerated, Readout byComponent) {
        if (byComponent == null || !VALUE.equals(byComponent.outcome)) {
            return "INCONCLUSIVE — the per-component query did not answer, so there is"
                + " nothing to check the enumeration against";
        }
        boolean someActive = byComponent.populated();
        if (THREW.equals(enumerated.outcome)) {
            return "FALSIFIED — the enumeration threw; the active set is not readable this way";
        }
        boolean enumeratedAny = enumerated.populated();
        if (someActive && !enumeratedAny) {
            return "FALSIFIED — isAdminActive answers yes for " + byComponent.entries.size()
                + (byComponent.entries.size() == 1 ? " admin" : " admins")
                + " while getActiveAdmins() returns nothing: the list is withheld, not empty";
        }
        if (someActive) {
            return "CONFIRMED — enumeration returned " + enumerated.entries.size()
                + ", and the per-component query agrees that "
                + byComponent.entries.size() + " active";
        }
        if (enumeratedAny) {
            return "UNEXPLAINED — the enumeration returned entries that isAdminActive denies;"
                + " neither read can be trusted until this is understood";
        }
        return "INCONCLUSIVE — no admin is active on this device, so an empty answer is"
            + " correct and proves nothing about whether an active one would be shown";
    }

    /**
     * A list printed for context, with no verdict attached.
     *
     * Context is not a prediction, and a CONFIRMED line next to a reading nobody
     * is scoring is a sentence someone will later quote as a result.
     */
    String renderList() {
        StringBuilder out = new StringBuilder();
        out.append(source).append('\n');
        out.append("  outcome: ").append(outcome).append('\n');
        if (THREW.equals(outcome)) {
            out.append("  failure: ").append(raw).append('\n');
        } else if (ABSENT.equals(outcome)) {
            out.append("  (null — never set, or withheld)").append('\n');
        } else if (entries.isEmpty()) {
            out.append("  (readable, nothing returned)").append('\n');
        } else {
            out.append("  ").append(entries.size())
               .append(entries.size() == 1 ? " entry" : " entries").append('\n');
            for (String entry : entries) out.append("  - ").append(entry).append('\n');
        }
        return out.toString();
    }

    /**
     * A single value, not a list — printed without a verdict or an entry list.
     *
     * The master toggle went through the list renderer on the first run and came
     * out as "readable without permission, 1 entry returned" over a raw value of
     * `0`, which reads as a confirmation of something that is in fact switched
     * off. A scalar is not a list of one, and a reading nobody is scoring should
     * not print a score.
     */
    String renderScalar() {
        StringBuilder out = new StringBuilder();
        out.append(source).append('\n');
        out.append("  outcome: ").append(outcome).append('\n');
        if (THREW.equals(outcome)) {
            out.append("  failure: ").append(raw).append('\n');
        } else if (ABSENT.equals(outcome)) {
            out.append("  value: (null — never set, or withheld)").append('\n');
        } else {
            out.append("  value: ").append(raw.isEmpty() ? "(empty string)" : raw).append('\n');
        }
        return out.toString();
    }
}
