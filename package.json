{
  "name": "orb",
  "private": true,
  "version": "0.0.0",
  "description": "Orb — a personal runtime that continuously learns, reasons and acts alongside its user.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.6.0"
  },
  "workspaces": [
    "runtime/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -b",
    "typecheck": "tsc -b && node scripts/typecheck-independently.mjs",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build && node --test --test-reporter=spec \"runtime/*/dist/tests/**/*.test.js\" \"packages/*/dist/tests/**/*.test.js\"",
    "test:unit": "npm run build && node --test --test-reporter=spec \"runtime/*/dist/tests/**/*.test.js\" \"packages/*/dist/tests/**/*.test.js\"",
    "verify": "npm run lint && npm run build && npm run test && npm run test:tools",
    "test:tools": "node --test --test-reporter=spec \"tools/*/tests/*.test.mjs\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
