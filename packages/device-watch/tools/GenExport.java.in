package @PKG@;

import android.content.Context;
import java.io.File;
import java.nio.file.Files;
import java.util.ArrayList;
import java.util.Arrays;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

/**
 * Writes a pass-2 export the way the phone writes one, for the TypeScript
 * importer to be tested against.
 *
 * The same pattern as `apps/pixel/pass1/tools/gen-vectors.py`: the fixture is
 * **generated by the implementation it is a fixture for**, so the test checks
 * the TypeScript reader against the Java writer rather than against someone's
 * idea of what the Java writer produces. A hand-written fixture would agree with
 * the reader by construction and prove nothing about the pair.
 */
public final class GenExport {
    public static void main(String[] args) throws Exception {
        File dir = Files.createTempDirectory("orb-gen").toFile();
        Journal journal = Journal.open(new Context(dir), "grants", "Pixel 10a/stallion");

        Map<String, Object> start = Json.obj();
        start.put("androidRelease", "16");
        start.put("sdkInt", 36L);
        journal.append("grants.process.start", start);

        // A first look: every kind a baseline, so nothing is news.
        journal.append("grants.observed", Grants.report("process.start", observed(
            Arrays.asList("app.orb/app.actionlock.guard.PayGuardService"),
            Arrays.asList("com.google.android.apps.dreamliner/com.google.android.apps.dreamliner.notification.DreamlinerNotificationService"),
            new ArrayList<String>()), null));

        // Then a change: something gains accessibility.
        Map<String, List<String>> before = new HashMap<>();
        before.put("accessibility", Arrays.asList("app.orb/app.actionlock.guard.PayGuardService"));
        before.put("notificationListener", Arrays.asList("com.google.android.apps.dreamliner/com.google.android.apps.dreamliner.notification.DreamlinerNotificationService"));
        before.put("deviceAdmin", new ArrayList<String>());
        journal.append("grants.observed", Grants.report("signal:android.intent.action.PACKAGE_ADDED", observed(
            Arrays.asList("app.orb/app.actionlock.guard.PayGuardService", "com.unknown/.Watcher"),
            Arrays.asList("com.google.android.apps.dreamliner/com.google.android.apps.dreamliner.notification.DreamlinerNotificationService"),
            new ArrayList<String>()), before));

        // And a kind that could not be read, which must never look like none.
        Map<String, List<String>> now = new HashMap<>();
        now.put("accessibility", null);
        now.put("notificationListener", Arrays.asList("com.google.android.apps.dreamliner/com.google.android.apps.dreamliner.notification.DreamlinerNotificationService"));
        now.put("deviceAdmin", new ArrayList<String>());
        Map<String, List<String>> prior = new HashMap<>(before);
        prior.put("accessibility", Arrays.asList("app.orb/app.actionlock.guard.PayGuardService", "com.unknown/.Watcher"));
        journal.append("grants.observed", Grants.report("app.opened", now, prior));

        for (String line : journal.readLines()) System.out.println(line);
    }

    private static Map<String, List<String>> observed(
            List<String> accessibility, List<String> listeners, List<String> admins) {
        Map<String, List<String>> out = new HashMap<>();
        out.put("accessibility", accessibility);
        out.put("notificationListener", listeners);
        out.put("deviceAdmin", admins);
        return out;
    }
}
