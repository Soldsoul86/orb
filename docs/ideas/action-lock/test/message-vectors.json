{
  "cases": [
    {
      "label": "ordinary message",
      "draft": "5pm today at Sathya's or Dolphins koramangala",
      "ctx": {
        "unknownSender": false,
        "onCall": false
      },
      "expected": {
        "mode": "pass",
        "seconds": 0,
        "reasons": [],
        "findings": []
      }
    },
    {
      "label": "a price is not a code",
      "draft": "1500",
      "ctx": {
        "unknownSender": false,
        "onCall": false
      },
      "expected": {
        "mode": "pass",
        "seconds": 0,
        "reasons": [],
        "findings": []
      }
    },
    {
      "label": "a year is not a code",
      "draft": "See you in 2026",
      "ctx": {
        "unknownSender": false,
        "onCall": false
      },
      "expected": {
        "mode": "pass",
        "seconds": 0,
        "reasons": [],
        "findings": []
      }
    },
    {
      "label": "bare 6-digit code",
      "draft": "482913",
      "ctx": {
        "unknownSender": false,
        "onCall": false
      },
      "expected": {
        "mode": "wait",
        "seconds": 10,
        "reasons": [
          "This looks like a one-time code (OTP). Banks, couriers and support staff never need it; sharing it is how most accounts are taken over."
        ],
        "findings": [
          "code"
        ]
      }
    },
    {
      "label": "code with a word, to a stranger",
      "draft": "the otp is 4829",
      "ctx": {
        "unknownSender": true,
        "onCall": false
      },
      "expected": {
        "mode": "confirm",
        "seconds": 20,
        "reasons": [
          "This looks like a one-time code (OTP). Banks, couriers and support staff never need it; sharing it is how most accounts are taken over.",
          "You're sending it to a number that isn't in your contacts."
        ],
        "findings": [
          "code"
        ]
      }
    },
    {
      "label": "code while on a call",
      "draft": "Code 482913",
      "ctx": {
        "unknownSender": false,
        "onCall": true
      },
      "expected": {
        "mode": "confirm",
        "seconds": 20,
        "reasons": [
          "This looks like a one-time code (OTP). Banks, couriers and support staff never need it; sharing it is how most accounts are taken over.",
          "You're on a call. Scammers ask for codes while they keep you talking."
        ],
        "findings": [
          "code"
        ]
      }
    },
