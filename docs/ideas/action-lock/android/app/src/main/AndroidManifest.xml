<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Orb's sensors: read-only access to what the phone already keeps. The app
         has no internet permission, so none of it can leave the phone. -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.READ_CALL_LOG" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />

    <!-- No network at all. A library (the Play services QR scanner) asks for these;
         they are removed so nothing Orb reads can leave the phone. The scanner
         itself runs inside Google Play services, which has its own access. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <!-- Android 11+ package visibility: lets the app find installed UPI apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="upi" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.ActionLock">

        <!-- configChanges: rotating or switching dark mode must not restart the
             page, because a restart stops every payment still in its buffer. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode|density|fontScale">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Receives upi://pay links tapped anywhere (WhatsApp, SMS, browser,
                 QR apps), so a payment passes through the lock first. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="upi" android:host="pay" />
            </intent-filter>
        </activity>
        <!-- The pay guard (Accessibility): pauses unusual payments on PhonePe and Google Pay. -->
        <service
            android:name=".guard.PayGuardService"
            android:exported="false"
            android:label="@string/guard_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/pay_guard" />
        </service>

        <activity
            android:name=".guard.GuardConfirmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Orb.Translucent" />
    </application>
</manifest>
