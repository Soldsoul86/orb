<?xml version="1.0" encoding="utf-8"?>
<!-- Events from every app arrive, so the pause can be removed when you leave a
     UPI app; only PhonePe and Google Pay screens are read (PayScreen.apps). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged|typeViewTextChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canRetrieveWindowContent="true"
    android:description="@string/guard_description"
    android:notificationTimeout="150" />
